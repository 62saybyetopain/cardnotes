// @depends-on ../api.ts (listLiterature, createLiterature, getLiterature, patchLiterature, literatureDeletePreview, deleteLiterature 與收藏夾方法；僅電腦端)
// @depends-on ./Editor.tsx (save／allowMention／plainPaste：文獻編輯沿用卡片編輯器；card 參數以 asEditorCard 轉接，Editor 只用到 id／title／body／updated_at／warnings)
// @depends-on ./Markdown.tsx (Markdown：唯讀顯示；整段只有一個 YouTube 網址會渲染成點擊播放)
// @depends-on ../styles.css (.lit-*)
// @depends-on ../App.tsx (focusId：從卡片側跳進來時指定要顯示哪一份；顯示後由 onFocusConsumed 清除)
import { useEffect, useRef, useState } from "react";
import { api } from "../api";
import type { CardDetail, Literature, LiteratureCollection, LiteratureSummary } from "../types";
import { Editor } from "./Editor";
import { Markdown } from "./Markdown";

const ALL = "all";
const UNCITED = "uncited";

// 擷取日期預設為使用者本機日期（後端不自動填，避免時區造成差一天）
function todayLocal(): string {
  const d = new Date();
  const p = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
}

function asEditorCard(l: Literature): CardDetail {
  return {
    id: l.id,
    title: l.title,
    body: l.body,
    updated_at: l.updated_at,
    created_at: l.created_at,
    tags: [],
    links: [],
    boards: [],
    warnings: l.warnings,
  };
}

export function LiteratureLibrary(props: {
  version: number;
  focusId: string | null;
  onFocusConsumed(): void;
  onOpenCard(id: string): void;
  report(e: unknown, prefix?: string): void;
  info(text: string): void;
}) {
  const { version, focusId, onFocusConsumed, onOpenCard, report, info } = props;
  const [items, setItems] = useState<LiteratureSummary[]>([]);
  const [collections, setCollections] = useState<LiteratureCollection[]>([]);
  const [q, setQ] = useState("");
  const [dq, setDq] = useState("");
  const [filter, setFilter] = useState<string>(ALL);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [detail, setDetail] = useState<Literature | null>(null);
  const [detailErr, setDetailErr] = useState("");
  const [editing, setEditing] = useState(false);
  const [editorDirty, setEditorDirty] = useState(false);
  const [nonce, setNonce] = useState(0);
  const [tick, setTick] = useState(0); // 清單與收藏夾重抓
  const [dtick, setDtick] = useState(0); // 詳情重抓
  const [meta, setMeta] = useState({ author: "", url: "", captured_on: "" });
  const seq = useRef(0);

  const refreshList = () => setTick((n) => n + 1);
  const colId = filter.startsWith("c:") ? filter.slice(2) : undefined;
  const curCol = colId ? collections.find((c) => c.id === colId) : undefined;

  useEffect(() => {
    const t = setTimeout(() => setDq(q), 250);
    return () => clearTimeout(t);
  }, [q]);

  useEffect(() => {
    let alive = true;
    api
      .listLiteratureCollections()
      .then((r) => alive && setCollections(r.collections))
      .catch((e) => alive && report(e, "載入收藏夾失敗"));
    return () => {
      alive = false;
    };
  }, [tick, version, report]);

  useEffect(() => {
    const my = ++seq.current;
    api
      .listLiterature({ q: dq, collection_id: colId, uncited: filter === UNCITED, limit: 200 })
      .then((r) => {
        if (my === seq.current) setItems(r.items);
      })
      .catch((e) => {
        if (my === seq.current) report(e, "載入文獻清單失敗");
      });
  }, [dq, filter, colId, tick, version, report]);

  useEffect(() => {
    if (!focusId) return;
    setSelectedId(focusId);
    setEditing(false);
    onFocusConsumed();
  }, [focusId, onFocusConsumed]);

  useEffect(() => {
    if (!selectedId) {
      setDetail(null);
      setDetailErr("");
      return;
    }
    let alive = true;
    api
      .getLiterature(selectedId)
      .then((d) => {
        if (!alive) return;
        setDetail(d);
        setDetailErr("");
      })
      .catch((e) => {
        if (!alive) return;
        setDetail(null);
        setDetailErr(e instanceof Error ? e.message : String(e));
      });
    return () => {
      alive = false;
    };
  }, [selectedId, version, dtick]);

  useEffect(() => {
    if (!editing) setEditorDirty(false);
  }, [editing]);

  // 內文還沒存進資料庫時，任何會換版本號、切換或刪除的動作都先擋下，不讓自動儲存與它互相覆蓋
  const blockedByDirty = (what: string): boolean => {
    if (!editorDirty) return false;
    report(new Error("內文尚有未儲存的變更，請稍候自動儲存完成再操作"), what);
    return true;
  };

  const selectItem = (id: string) => {
    if (blockedByDirty("切換文獻失敗")) return;
    setEditing(false);
    setSelectedId(id);
  };

  const createNew = async () => {
    if (blockedByDirty("新增文獻失敗")) return;
    const title = window.prompt("新文獻標題（可留空，之後再填）", "");
    if (title === null) return;
    try {
      const d = await api.createLiterature({ title: title.trim(), captured_on: todayLocal(), collection_id: colId });
      refreshList();
      setSelectedId(d.id);
      setMeta({ author: d.author, url: d.url, captured_on: d.captured_on });
      setEditing(true);
    } catch (e) {
      report(e, "新增文獻失敗");
    }
  };

  const startEdit = () => {
    if (!detail) return;
    setMeta({ author: detail.author, url: detail.url, captured_on: detail.captured_on });
    setEditing(true);
  };

  const saveMeta = async () => {
    if (!detail || blockedByDirty("儲存文獻欄位失敗")) return;
    const url = meta.url.trim();
    if (url && !/^https?:\/\/\S+$/.test(url)) {
      report(new Error("網址必須以 http:// 或 https:// 開頭"), "儲存文獻欄位失敗");
      return;
    }
    try {
      const updated = await api.patchLiterature(
        detail.id,
        { author: meta.author, url, captured_on: meta.captured_on.trim() },
        detail.updated_at,
      );
      setDetail(updated);
      setNonce((n) => n + 1); // 版本號已變，重建編輯器才不會下次自動儲存就 409
      refreshList();
      info("已儲存文獻欄位");
    } catch (e) {
      report(e, "儲存文獻欄位失敗");
    }
  };

  // 衝突後重新載入：先取回最新版本，再重建編輯器，否則編輯器會用舊版本號再次衝突
  const reloadDetail = async () => {
    if (!detail) return;
    try {
      const d = await api.getLiterature(detail.id);
      setDetail(d);
      setNonce((n) => n + 1);
    } catch (e) {
      report(e, "重新載入文獻失敗");
    }
  };

  const onEditorSaved = (c: CardDetail) => {
    setDetail((cur) =>
      cur && cur.id === c.id
        ? { ...cur, title: c.title, body: c.body, updated_at: c.updated_at, warnings: c.warnings }
        : cur,
    );
    setItems((prev) =>
      prev.map((it) =>
        it.id === c.id ? { ...it, title: c.title, snippet: c.body.slice(0, 160), updated_at: c.updated_at } : it,
      ),
    );
  };

  const removeLiterature = async () => {
    if (!detail || blockedByDirty("刪除文獻失敗")) return;
    try {
      const i = await api.literatureDeletePreview(detail.id);
      const msg =
        `確定要刪除文獻「${detail.title || "（無標題）"}」？（此動作無法復原）\n` +
        `・被 ${i.card_count} 張卡片引用（共 ${i.citation_count} 處），只會移除引用，卡片本身不會被刪除`;
      if (!window.confirm(msg)) return;
      await api.deleteLiterature(detail.id);
      setSelectedId(null);
      setEditing(false);
      refreshList();
      info("已刪除文獻，引用已一併移除");
    } catch (e) {
      report(e, "刪除文獻失敗");
    }
  };

  const createCollection = async () => {
    const name = window.prompt("新收藏夾名稱");
    if (!name?.trim()) return;
    try {
      const c = await api.createLiteratureCollection(name.trim());
      refreshList();
      setFilter(`c:${c.id}`);
    } catch (e) {
      report(e, "新增收藏夾失敗");
    }
  };

  const renameCollection = async () => {
    if (!curCol) return;
    const name = window.prompt("收藏夾新名稱", curCol.name);
    if (!name?.trim() || name.trim() === curCol.name) return;
    try {
      await api.renameLiteratureCollection(curCol.id, name.trim());
      refreshList();
      setDtick((n) => n + 1);
    } catch (e) {
      report(e, "重新命名收藏夾失敗");
    }
  };

  const deleteCollection = async () => {
    if (!curCol) return;
    if (!window.confirm(`刪除收藏夾「${curCol.name}」？\n只會移除收藏夾，裡面的 ${curCol.item_count} 份文獻不會被刪除。`)) return;
    try {
      await api.deleteLiteratureCollection(curCol.id);
      setFilter(ALL);
      refreshList();
      setDtick((n) => n + 1);
    } catch (e) {
      report(e, "刪除收藏夾失敗");
    }
  };

  const addToCollection = async (cid: string) => {
    if (!detail || !cid) return;
    try {
      await api.addLiteratureToCollection(cid, detail.id);
      refreshList();
      setDtick((n) => n + 1);
    } catch (e) {
      report(e, "加入收藏夾失敗");
    }
  };

  const removeFromCollection = async (cid: string) => {
    if (!detail) return;
    try {
      await api.removeLiteratureFromCollection(cid, detail.id);
      refreshList();
      setDtick((n) => n + 1);
    } catch (e) {
      report(e, "移出收藏夾失敗");
    }
  };

  const availableCols = detail ? collections.filter((c) => !detail.collections.some((d) => d.id === c.id)) : [];
  const missingMedia = detail
    ? detail.warnings.filter((w) => w.code === "MISSING_MEDIA").reduce((n, w) => n + w.ids.length, 0)
    : 0;
  const citedCardCount = detail ? new Set(detail.citations.map((c) => c.card_id)).size : 0;

  return (
    <div className="lit-view" role="region" aria-label="文獻庫">
      <div className="lit-head">
        <strong>文獻庫</strong>
        <span className="muted" style={{ fontSize: 12 }}>
          完整引用的原文；卡片可掛文獻作為出處
        </span>
      </div>
      <div className="lit-body">
        <div className="lit-list">
          <div className="lit-list-tools">
            <input
              value={q}
              onChange={(e) => setQ(e.target.value)}
              placeholder="搜尋標題、內文、作者、網址"
              aria-label="搜尋文獻"
            />
            <select value={filter} onChange={(e) => setFilter(e.target.value)} aria-label="文獻篩選">
              <option value={ALL}>全部文獻</option>
              <option value={UNCITED}>尚未被任何卡片引用（待消化）</option>
              {collections.map((c) => (
                <option key={c.id} value={`c:${c.id}`}>
                  收藏夾：{c.name}（{c.item_count}）
                </option>
              ))}
            </select>
            <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
              <button className="primary" onClick={() => void createNew()}>
                ＋ 新增文獻
              </button>
              <button onClick={() => void createCollection()}>＋ 收藏夾</button>
              {curCol && (
                <>
                  <button onClick={() => void renameCollection()}>改名</button>
                  <button onClick={() => void deleteCollection()}>刪除收藏夾</button>
                </>
              )}
            </div>
          </div>
          <div className="lit-list-scroll">
            {items.length === 0 && <div className="empty">沒有符合的文獻</div>}
            <ul className="results">
              {items.map((it) => (
                <li key={it.id} className={it.id === selectedId ? "previewing-row" : undefined}>
                  <button className="result-main" onClick={() => selectItem(it.id)}>
                    <strong>{it.title || "（無標題）"}</strong>
                    <span className="snippet">{[it.author, it.captured_on].filter(Boolean).join(" · ") || "\u00A0"}</span>
                    <span className="snippet">{it.snippet || "\u00A0"}</span>
                  </button>
                  <span className="count" title="被幾張卡片引用">
                    {it.cited_card_count}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div className="lit-detail">
          {!selectedId && <div className="empty">從左側選一份文獻，或按「＋ 新增文獻」。</div>}
          {selectedId && detailErr && (
            <div className="banner danger">
              載入文獻失敗：{detailErr}
              <button onClick={() => setDtick((n) => n + 1)}>重試</button>
            </div>
          )}
          {selectedId && !detailErr && !detail && <div className="empty">載入中…</div>}
          {detail && (
            <>
              <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
                <h3 style={{ margin: 0, flex: 1, fontSize: 18, color: "var(--text)" }}>
                  {detail.title || "（無標題）"}
                </h3>
                {!editing ? (
                  <button onClick={startEdit}>✎ 編輯</button>
                ) : (
                  <button
                    className="primary"
                    disabled={editorDirty}
                    onClick={() => setEditing(false)}
                    title={editorDirty ? "內文尚在儲存中" : "結束編輯"}
                  >
                    完成
                  </button>
                )}
                <button className="danger" style={{ marginTop: 0 }} onClick={() => void removeLiterature()}>
                  刪除
                </button>
              </div>

              {!editing && (
                <div className="lit-meta">
                  {detail.author && <span>作者／來源：{detail.author}</span>}
                  {detail.url && (
                    <a href={detail.url} target="_blank" rel="noreferrer noopener">
                      {detail.url}
                    </a>
                  )}
                  {detail.captured_on && <span>擷取日期：{detail.captured_on}</span>}
                  {!detail.author && !detail.url && !detail.captured_on && <span>尚未填寫來源資訊</span>}
                </div>
              )}

              {editing && (
                <div className="resolve-box">
                  <div className="field-row">
                    <span className="muted">作者／來源說明：</span>
                    <input value={meta.author} onChange={(e) => setMeta({ ...meta, author: e.target.value })} maxLength={500} />
                  </div>
                  <div className="field-row">
                    <span className="muted">原始網址（http:// 或 https://）：</span>
                    <input value={meta.url} onChange={(e) => setMeta({ ...meta, url: e.target.value })} maxLength={2000} />
                  </div>
                  <div className="field-row">
                    <span className="muted">擷取日期：</span>
                    <input
                      type="date"
                      value={meta.captured_on}
                      onChange={(e) => setMeta({ ...meta, captured_on: e.target.value })}
                    />
                  </div>
                  <div className="resolve-actions">
                    <button className="primary" onClick={() => void saveMeta()}>
                      儲存欄位
                    </button>
                  </div>
                </div>
              )}

              <div className="chips">
                <span className="muted">收藏夾：</span>
                {detail.collections.length === 0 && <span className="muted">未放入任何收藏夾</span>}
                {detail.collections.map((c) => (
                  <span key={c.id} className="chip">
                    {c.name}
                    <button aria-label={`移出收藏夾 ${c.name}`} onClick={() => void removeFromCollection(c.id)}>
                      ✕
                    </button>
                  </span>
                ))}
                {availableCols.length > 0 && (
                  <select
                    className="loc-select"
                    value=""
                    onChange={(e) => void addToCollection(e.target.value)}
                    aria-label="加入收藏夾"
                  >
                    <option value="">＋加入收藏夾…</option>
                    {availableCols.map((c) => (
                      <option key={c.id} value={c.id}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                )}
              </div>

              {editing && detail.citations.length > 0 && (
                <div className="banner warn" role="alert">
                  這份文獻被 {citedCardCount} 張卡片引用，修改內文可能使引用位置（頁碼、段落）對不上。
                </div>
              )}
              {!editing && missingMedia > 0 && (
                <div className="banner warn" role="alert">
                  內文引用了 {missingMedia} 個不存在的媒體。
                </div>
              )}

              {editing ? (
                <Editor
                  key={`${detail.id}:${nonce}`}
                  card={asEditorCard(detail)}
                  save={async (patch, expected) => asEditorCard(await api.patchLiterature(detail.id, patch, expected))}
                  allowMention={false}
                  plainPaste={true}
                  onSaved={onEditorSaved}
                  onReload={() => void reloadDetail()}
                  onDirtyChange={setEditorDirty}
                  report={report}
                />
              ) : (
                <div className="lit-read">
                  {detail.body.trim() ? (
                    <Markdown source={detail.body} />
                  ) : (
                    <span className="muted">內文是空的，按「編輯」貼上原文。</span>
                  )}
                </div>
              )}

              <h4>被引用（{detail.citations.length}）</h4>
              {detail.citations.length === 0 && (
                <div className="muted">還沒有卡片引用這份文獻。在卡片的「展開型態與收納位置」區塊裡掛上文獻即可。</div>
              )}
              <ul className="results">
                {detail.citations.map((c) => (
                  <li key={c.id}>
                    <button className="result-main" onClick={() => onOpenCard(c.card_id)} title="開啟這張卡片">
                      <strong>{c.card_title || "（無標題）"}</strong>
                      <span className="snippet">{c.locator ? `位置：${c.locator}` : "整份引用"}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
    </div>
  );
}