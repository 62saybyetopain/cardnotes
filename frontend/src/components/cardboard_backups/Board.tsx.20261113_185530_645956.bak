}

interface Geometry {
  x: number;
  y: number;
  w: number | null;
  h: number | null;
}

interface SavedViewport {
  x: number;
  y: number;
  zoom: number;
}

const vpKey = (boardId: string) => `cardboard:viewport:${boardId}`;

function loadViewport(boardId: string): SavedViewport | null {
  try {
    const raw = localStorage.getItem(vpKey(boardId));
    if (!raw) return null;
    const v = JSON.parse(raw);
    if (
      typeof v?.x === "number" &&
      Number.isFinite(v.x) &&
      typeof v?.y === "number" &&
      Number.isFinite(v.y) &&
      typeof v?.zoom === "number" &&
      Number.isFinite(v.zoom)
    ) {
      return { x: v.x, y: v.y, zoom: v.zoom };
    }
  } catch {
    /* localStorage 不可用或資料損毀時忽略 */
  }
  return null;
}

function saveViewport(boardId: string, vp: SavedViewport): void {
  try {
    localStorage.setItem(vpKey(boardId), JSON.stringify({ x: vp.x, y: vp.y, zoom: vp.zoom }));
  } catch {
    /* localStorage 無法寫入時忽略 */
  }
}

const SNAP_KEY = "cardboard:snap-to-grid";

function loadSnapToGrid(): boolean {
  try {
    const raw = localStorage.getItem(SNAP_KEY);
    return raw === null ? true : raw === "true";
  } catch {
    return true;
  }
}

function saveSnapToGrid(enabled: boolean): void {
  try {
    localStorage.setItem(SNAP_KEY, enabled ? "true" : "false");
  } catch {
    /* localStorage 無法寫入時忽略 */
  }
}

function nodeBox(n: CardFlowNode): LayoutBox {
  return {
    id: n.id,
    x: n.position.x,
    y: n.position.y,
    w: n.measured?.width ?? n.width ?? DEFAULT_CARD_W,
    h: n.measured?.height ?? n.height ?? DEFAULT_CARD_H,
  };
}

function normalizeLink(l: Partial<BoardLink> & { source_id: string; target_id: string }): BoardLink {
  return {
    ...l,
    source_id: l.source_id,
    target_id: l.target_id,
    relation_type: l.relation_type ?? "延伸",
    status: l.status ?? "confirmed",
    reason: l.reason ?? "",
  };
}

// 複製用：移除圖片／影片引用，代碼塊內的內容原樣保留
function stripImagesKeepCode(body: string): string {
  const FENCE = "`".repeat(3);
  const out: string[] = [];
  let fenceLen = 0;
  let prevBlank = false;
  for (const line of body.replace(/\r\n/g, "\n").split("\n")) {
    const t = line.trim();
    if (fenceLen > 0) {
      out.push(line);
      if (t.length >= fenceLen && t.replace(/`/g, "") === "") fenceLen = 0;
      prevBlank = false;
      continue;
    }
    if (t.startsWith(FENCE)) {
      let n = 0;
      while (t[n] === "`") n++;
      fenceLen = n;
      out.push(line);
      prevBlank = false;
      continue;
    }
    const stripped = line.replace(/!\[[^\]]*\]\([^)]*\)/g, "");
    if (stripped !== line && stripped.trim() === "") continue; // 整行只有圖片：整行丟掉
    const blank = stripped.trim() === "";
    if (blank && prevBlank) continue; // 避免移除圖片後留下連續空行
    prevBlank = blank;
    out.push(stripped);
  }
  return out.join("\n").trim();
}

// 圖片連線的刪除確認：在連線旁彈出 ✕（刪除）與 ○（關閉）。Esc、點到別處都視為關閉；焦點預設在 ○，避免只按 Enter 就誤刪。
// 位置是相對 .board 容器的像素座標，畫布平移或縮放時由 Board 關閉，所以不需要跟著畫布縮放。
// @depends-on ../styles.css (.img-link-confirm)
function ImageLinkConfirm(props: { x: number; y: number; onConfirm(): void; onCancel(): void }) {
  const { x, y, onConfirm, onCancel } = props;
  const ref = useRef<HTMLDivElement>(null);
  const cancelRef = useRef(onCancel);
  cancelRef.current = onCancel;
  useEffect(() => {
    const down = (e: PointerEvent) => {
      if (!ref.current?.contains(e.target as HTMLElement)) cancelRef.current();
    };
    const key = (e: KeyboardEvent) => {
      if (e.key === "Escape") cancelRef.current();
    };
    document.addEventListener("pointerdown", down, true);
    document.addEventListener("keydown", key);
    return () => {
      document.removeEventListener("pointerdown", down, true);
      document.removeEventListener("keydown", key);
    };
  }, []);
  const icon = { width: 18, height: 18, viewBox: "0 0 18 18", fill: "none", stroke: "currentColor", strokeWidth: 1.9, strokeLinecap: "round" as const, "aria-hidden": true };
  return (
    <div ref={ref} className="img-link-confirm" role="group" aria-label="確認移除圖片連線" style={{ left: x, top: y }}>
      <button type="button" className="cancel" autoFocus onClick={onCancel} title="關閉" aria-label="關閉">
        <svg {...icon}>
          <circle cx="9" cy="9" r="5.6" />
        </svg>
      </button>
      <button type="button" className="confirm" onClick={onConfirm} title="刪除這條連線（圖片與卡片都不會被刪除）" aria-label="刪除連線">
        <svg {...icon}>
          <path d="M5.4 5.4l7.2 7.2M12.6 5.4l-7.2 7.2" />
        </svg>
      </button>
    </div>
  );
}

function BoardInner(props: Props & { innerRef: Ref<BoardHandle> }) {
  const { boardId: boardIdProp, selectedCardId, active = true, onSelectCard, onOpenCard, onLinksChanged, onCountChanged, report, info, innerRef } = props;
  // 內部實際顯示的白板 id：轉場時比 props.boardId 晚約 0.5 秒才換，下面所有 boardId 都指這個
  const [boardId, setBoardId] = useState<string | null>(boardIdProp);
  const rf = useReactFlow();
  const wrapRef = useRef<HTMLDivElement>(null);
  const [navOpen, setNavOpen] = useState(false);
  const { boards: navBoards, onSelectBoard: navSelectBoard, onBoardsChanged: navBoardsChanged } = props;
  const navAvailable = !!navBoards && !!navSelectBoard && !!navBoardsChanged && getPreferredDriverType() !== "dexie";
  const [nodes, setNodes] = useState<AnyFlowNode[]>([]);
  const [links, setLinks] = useState<BoardLink[]>([]);
  const [imageLinks, setImageLinks] = useState<BoardImageLink[]>([]); // 圖片—卡片的純視覺連線，與 links（語意連結）完全分開
  const [imgLinkConfirm, setImgLinkConfirm] = useState<{ link: BoardImageLink; x: number; y: number } | null>(null); // 待確認移除的圖片連線與浮層位置
  const [editingLink, setEditingLink] = useState<BoardLink | null>(null);
  const [loading, setLoading] = useState(false);

  // ---- 自動對齊與心智圖／網格自動排版狀態 ----
  const [snapToGrid, setSnapToGrid] = useState<boolean>(() => loadSnapToGrid());
  const snapRef = useRef(snapToGrid);
  snapRef.current = snapToGrid;

  const [layoutMode, setLayoutMode] = useState<LayoutMode>("grid");
  const [layoutGap, setLayoutGap] = useState<number>(DEFAULT_LAYOUT_GAP);
  const [clusterThreshold, setClusterThreshold] = useState<number>(4);
  const [gridCols, setGridCols] = useState<number | null>(null);
  const [gridRows, setGridRows] = useState<number | null>(null);
  const [splitMode, setSplitMode] = useState<SplitMode>("type");
  const [typeSideMap, setTypeSideMap] = useState<Record<RelationType, "left" | "right">>(() => ({
    ...DEFAULT_TYPE_SIDE_MAP,
  }));
  const [showSplitConfig, setShowSplitConfig] = useState(false);

  // 中心卡片指定狀態（可由拖曳中心圖標或點選卡片指定）
  const [designatedCenterId, setDesignatedCenterId] = useState<string | null>(null);
  const [lastClickedCardId, setLastClickedCardId] = useState<string | null>(null);
  const [pickingCenterDrag, setPickingCenterDrag] = useState(false);

  // 自動排版單次復原快照
    const [undoSnapshot, setUndoSnapshot] = useState<{ card_id: string; x: number; y: number }[] | null>(null);

  // 貼上內容並定位卡片狀態
  const [showLocateModal, setShowLocateModal] = useState(false);
  const [locateText, setLocateText] = useState("");

      const handleLocateCard = () => {
        const raw = locateText.trim();
        if (!raw) {
          report(new Error("請先貼上代碼段落或 AI 回覆內容"), "定位失敗");
          return;
        }
        const allCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card");
        if (allCards.length === 0) {
          report(new Error("目前白板內尚無任何卡片可供定位"), "定位失敗");
          return;
        }

        const normRaw = raw.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        const rawLines = normRaw
          .split("\n")
          .map((l) => l.trim())
          .filter((l) => l.length >= 6 && !/^[{}\]();,]+$/.test(l));

        // 1. 抽取可能的檔名/標題候選
        const titleRegex = /(?:```[a-zA-Z0-9_-]*:|^#+\s+|^[a-zA-Z0-9_./-]+\/)?([a-zA-Z0-9_./-]+\.[a-zA-Z0-9]+)/gm;
        const extractedNames = new Set<string>();
        let match: RegExpExecArray | null;
        while ((match = titleRegex.exec(raw)) !== null) {
          const fn = match[1].split("/").pop();
          if (fn) extractedNames.add(fn.trim().toLowerCase());
        }

        // 2. 抽取【尋找這段代碼】標記區塊（若有）
        const findMarker = "【尋找這段代碼】";
        const replaceMarker = "【替換為以下代碼】";
        const FENCE = "`".repeat(3);
        const langHeaderRe =
          /^(typescript|javascript|ts|tsx|js|jsx|python|py|sql|sqlite|json|html|css|scss|bash|sh|shell|yaml|yml|toml|markdown|md|diff|plaintext|text|c|cpp|csharp|java|go|rust|ruby|php|swift|kotlin)(\s+(copy(\s+code)?|複製(\s*代碼|\s*程式碼)?))?$/i;
        const fileInLineRe = /([a-zA-Z0-9_.-]+\.(?:tsx|ts|jsx|js|py|sql|css|html|json|md|yaml|yml|toml|rs|go))/i;
        const primaryNames = new Set<string>();
        const findSnippets: string[][] = [];
        const lines = normRaw.replace(/\u00A0/g, " ").split("\n");
        for (let i = 0; i < lines.length; i++) {
          const lineTrim = lines[i].trim();
          if (lineTrim.includes(findMarker) && !/^(const|let|var)\s+/.test(lineTrim)) {
            for (let k = i - 1; k >= Math.max(0, i - 12); k--) {
              if (lines[k].includes(replaceMarker)) break;
              const m = fileInLineRe.exec(lines[k]);
              if (m) {
                primaryNames.add(m[1].toLowerCase());
                break;
              }
            }
            const nextLines: string[] = [];
            for (let j = i + 1; j < lines.length; j++) {
              if (lines[j].includes(replaceMarker) || lines[j].includes(findMarker)) break;
              const t = lines[j].trim();
              if (!t || t.startsWith(FENCE)) continue;
              if (nextLines.length === 0 && langHeaderRe.test(t)) continue;
              nextLines.push(t);
            }
            if (nextLines.length > 0) {
              findSnippets.push(nextLines);
            }
          }
        }
        const matchesFullSnippet = (src: string, snipLines: string[]): boolean => {
          const normSrcLines = src.replace(/\u00A0/g, " ").split("\n");
          const nonEmptySrc = normSrcLines.map((l) => l.trim()).filter((l) => l.length > 0);
          if (snipLines.length === 0 || snipLines.length > nonEmptySrc.length) return false;
          for (let i = 0; i <= nonEmptySrc.length - snipLines.length; i++) {
            let ok = true;
            for (let j = 0; j < snipLines.length; j++) {
              if (nonEmptySrc[i + j] !== snipLines[j]) {
                ok = false;
                break;
              }
            }
            if (ok) return true;
          }
          return false;
        };

        // 3. 多層級計分比對白板所有卡片
        let bestCard: CardFlowNode | null = null;
        let maxScore = 0;

        for (const card of allCards) {
          let score = 0;
          const title = (card.data.title || "").trim();
          const titleLower = title.toLowerCase();
          const body = (card.data.body || "").replace(/\r\n/g, "\n");

          // 層級 A: 卡片內文全文直接精確包含貼上的內容（最高權重）
          if (body.includes(normRaw)) {
            score += 1000;
          }

          // 層級 B: 代碼實質特徵行命中統計（支援純代碼段落檢索）
          if (rawLines.length > 0) {
            let hitCount = 0;
            let continuousHit = 0;
            let maxContinuous = 0;
            for (const line of rawLines) {
              if (body.includes(line)) {
                hitCount++;
                continuousHit++;
                if (continuousHit > maxContinuous) maxContinuous = continuousHit;
              } else {
                continuousHit = 0;
              }
            }
            const hitRate = hitCount / rawLines.length;
            if (hitRate >= 0.4) {
              score += Math.round(hitRate * 400);
              score += maxContinuous * 25;
            }
          }

          // 層級 C: 標題或檔名吻合
          if (title && extractedNames.has(titleLower)) {
            score += 250;
          }
          if (title && normRaw.includes(title)) {
            score += 100;
          }

          // 層級 D: 命中【尋找這段代碼】區塊
          if (findSnippets.length > 0) {
            let matchedSnippets = 0;
            for (const snip of findSnippets) {
              if (matchesFullSnippet(body, snip)) {
                matchedSnippets++;
              }
            }
            if (matchedSnippets === 0) {
              score = 0;
            } else {
              score += matchedSnippets * 2000;
              if (title && primaryNames.has(titleLower)) {
                score += 500;
              }
            }
          }

          if (score > maxScore) {
            maxScore = score;
            bestCard = card;
          }
        }

        if (!bestCard || maxScore < 30) {
          report(
            new Error(
              findSnippets.length > 0
                ? "當前白板內沒有任何卡片完整包含所貼上的定位代碼段落，請確認目標卡片是否已放入此白板"
                : "在當前白板的卡片中找不到吻合的內容或代碼，請確認貼上的段落是否屬於此白板內的卡片",
            ),
            "找不到目標卡片",
          );
          return;
        }

        setShowLocateModal(false);
        setLocateText("");
        info(`已成功定位至卡片「${bestCard.data.title || "（無標題）"}」`);
        onOpenCard?.(bestCard.id, { smartPasteText: raw });
      };

  // 拖入同名檔案衝突佇列與對話框狀態
  interface DropConflictItem {
    file: File;
    content: string;
    lang: string;
    dropX: number;
    dropY: number;
    matchedCard: CardFlowNode;
    scopeLabel: string;
  }
  const [conflictQueue, setConflictQueue] = useState<DropConflictItem[]>([]);

  const saved = useRef(new Map<string, Geometry>()); // 伺服器上確認過的位置，失敗時回復用
  const groupDragRef = useRef<{ groupId: string; startX: number; startY: number; memberIds: string[] } | null>(null);
  const activeDragRef = useRef<{ id: string; type: string } | null>(null);
  const lastSnappedPosRef = useRef(new Map<string, { x: number; y: number }>());
  const viewportReady = useRef(false);
  const dragStartRef = useRef(new Map<string, { x: number; y: number }>()); // 拖曳開始時各節點位置，Shift 以起點為基準取整
  const shiftRef = useRef(false);
  const [magnetGuides, setMagnetGuides] = useState<MagnetGuide[]>([]);

  useEffect(() => {
    const sync = (e: KeyboardEvent) => {
      shiftRef.current = e.shiftKey;
    };
    const clear = () => {
      shiftRef.current = false;
    };
    window.addEventListener("keydown", sync);
    window.addEventListener("keyup", sync);
    window.addEventListener("blur", clear);
    return () => {
      window.removeEventListener("keydown", sync);
      window.removeEventListener("keyup", sync);
      window.removeEventListener("blur", clear);
    };
  }, []);
  const nodesRef = useRef(nodes);
  nodesRef.current = nodes;
  // 貼上圖片是多段非同步（量尺寸、上傳、建立）：完成時要確認使用者還在同一塊白板
  const boardIdRef = useRef(boardId);
  boardIdRef.current = boardId;

  // ---- 切換白板的鏡頭轉場：同一個 ReactFlow 暫時同時渲染兩張白板 ----
  // 出發白板 A＝正式 nodes（視野外的節點暫時 hidden）；目的白板 B＝預覽節點（previewNodes／previewLinks，只建視野內的）。
  // 預覽節點 id 一律是 "pv:<原 id>"，只活在轉場期間的 state：不進 nodes／saved、不寫資料庫（同一張卡片可以同時在 A、B）。
  // B 只做平移（offset）、尺寸不變；offset 讓「抵達時的鏡頭＝B 的正式 viewport」成立，所以 A、B 的 zoom 不同也不必縮放節點。
  // 鏡頭用 rf.setViewport 逐幀推進；抵達時 setBoardId，由下方載入 effect（useLayoutEffect）在同一次 commit 內換成 B 的正式 nodes 並設好鏡頭。
  // @depends-on ../App.tsx（props.boardId 變更後，由 Board 負責預載與轉場完成後切換內部 boardId）
  // @depends-on ../styles.css（.board 需為 position:relative；stage 以 absolute inset:0 包住 ReactFlow）
  // @depends-on ../api.ts（api.getBoard 提供預載與正式載入共用 DTO）
  // @depends-on ./QuestionNode.tsx（節點 id "q:<board_id>" 與 BoardData.questions[].board_id：轉場方向由「子問題節點在母白板上的位置」決定；改 id 規則或座標語意要同步）
  // @depends-on ../types.ts（BoardSummary.question.parent_board_id：轉場以母白板鏈找共同祖先）
  // @depends-on ../api.ts（boardQuestionPage 的 children[].x/y/w/h：同層／跨分支的方向取自共同祖先畫布上兩個分支節點的中心差，與導航器的排列順序無關）
  // @depends-on ./CardNode.tsx 等節點元件：data 內的回呼會以 node id 寫資料庫；預覽節點的回呼一律換成報錯 guard（只有 report 保留）
  const stageRef = useRef<HTMLDivElement>(null);
  const [transitioning, setTransitioning] = useState(false);
  const preloadedBoardRef = useRef<{ id: string; data: any; vp: SavedViewport } | null>(null);
  const [previewNodes, setPreviewNodes] = useState<AnyFlowNode[]>([]);
  const [previewLinks, setPreviewLinks] = useState<BoardLink[]>([]);
  const [scene, setScene] = useState<{
    hidden: Set<string>;
    frames: { x: number; y: number; w: number; h: number; label: string }[];
  } | null>(null);
  const previewRef = useRef(previewNodes);
  previewRef.current = previewNodes;
  // 抵達時預覽節點已量到的尺寸（key＝原 id）：正式節點先帶著，React Flow 才不會把自動高度的卡片當成「未量測」而隱藏一幀
  const transitionMeasuredRef = useRef<Map<string, { width?: number; height?: number }> | null>(null);
  // 往下進入時用的方向（key＝"來源>目的"）：返回時直接取反重播，不用返回當下的視野重算
  const enterDirRef = useRef(new Map<string, { x: number; y: number }>());

  useEffect(() => {
    if (boardIdProp === boardId) return;
    const stage = stageRef.current;
    const reduce =
      typeof window.matchMedia === "function" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!active || !stage || !boardId || !boardIdProp || reduce) {
      setBoardId(boardIdProp);
      return;
    }

    const targetId = boardIdProp;
    let cancelled = false;
    let finished = false; // 已抵達並 setBoardId：之後的 cleanup 不能再還原鏡頭
    let startedVp: SavedViewport | null = null; // 場景建立時 A 的鏡頭，取消時還原用
    let raf = 0;

    // 沿母白板鏈找最近共同祖先；stepA／stepB＝A、B 各自在共同祖先底下的那一支（自己就是祖先時為 null）
    const parentOf = (id: string) => navBoards?.find((b) => b.id === id)?.question?.parent_board_id ?? null;
    const chainOf = (id: string) => {
      const out = [id];
      for (let p = parentOf(id); p && !out.includes(p); p = parentOf(p)) out.push(p);
      return out;
    };
    const chainA = chainOf(boardId);
    const chainB = chainOf(targetId);
    const lcaIdxA = chainA.findIndex((id) => chainB.includes(id));
    const lcaIdxB = lcaIdxA >= 0 ? chainB.indexOf(chainA[lcaIdxA]) : -1;
    const stepA = lcaIdxA > 0 ? chainA[lcaIdxA - 1] : null;
    const stepB = lcaIdxB > 0 ? chainB[lcaIdxB - 1] : null;
    // 同層／跨分支才需要共同祖先那一頁（兩個分支節點在它畫布上的座標）；失敗要報錯，方向退回向右
    const lcaPagePromise =
      stepA && stepB
        ? api.boardQuestionPage(chainA[lcaIdxA]).catch((e) => {
            report(e, "取得共同母白板失敗，轉場方向退回向右：");
            return null;
          })
        : Promise.resolve(null);

    Promise.all([api.getBoard(targetId), lcaPagePromise])
      .then(([boardData, lcaPage]) => {
        if (cancelled) return;

        const r = stage.getBoundingClientRect();
        const W = r.width || window.innerWidth;
        const H = r.height || window.innerHeight;

        // B 的正式鏡頭：儲存值；沒有就框住所有卡片
        let found = loadViewport(targetId);
        if (!found) {
          const cards = boardData.cards || [];
          if (cards.length > 0) {
            const minX = Math.min(...cards.map((c: any) => c.x));
            const maxX = Math.max(...cards.map((c: any) => c.x + (c.w || DEFAULT_CARD_W)));
            const minY = Math.min(...cards.map((c: any) => c.y));
            const maxY = Math.max(...cards.map((c: any) => c.y + (c.h || DEFAULT_CARD_H)));
            const bw = Math.max(100, maxX - minX);
            const bh = Math.max(100, maxY - minY);
            const zoom = Math.min(1, Math.min((W * 0.8) / bw, (H * 0.8) / bh));
            found = {
              x: W / 2 - (minX + bw / 2) * zoom,
              y: H / 2 - (minY + bh / 2) * zoom,
              zoom,
            };
          } else {
            found = { x: W / 2, y: H / 2, zoom: 1 };
          }
        }
        const vpB: SavedViewport = found;
        const vpA = rf.getViewport();
        startedVp = vpA;

        // 場景座標（world）：A 的視野中心 cA；B 的視野中心放在 cA 沿 dir 方向 sep 之外（cEnd）
        const centerOf = (v: SavedViewport) => ({ x: (W / 2 - v.x) / v.zoom, y: (H / 2 - v.y) / v.zoom });
        const cA = centerOf(vpA);
        const cB = centerOf(vpB);
        // B 相對 A 的方向（單位向量）。往下（A 是 B 的祖先）：A 視野中心指向通往 B 的子問題節點；往上：進入時方向的反向；
        // 同層／跨分支：依兩支在共同祖先底下的建立順序向右或向左。資料不足或向量過短時退回向右
        const unit = (vx: number, vy: number) => {
          const len = Math.hypot(vx, vy);
          return len < 1 ? null : { x: vx / len, y: vy / len };
        };
        // 沿母白板鏈找最近共同祖先；stepA／stepB＝A、B 各自在共同祖先底下的那一支（自己就是祖先時為 null）
        const parentOf = (id: string) => navBoards?.find((b) => b.id === id)?.question?.parent_board_id ?? null;
        const chainOf = (id: string) => {
          const out = [id];
          for (let p = parentOf(id); p && !out.includes(p); p = parentOf(p)) out.push(p);
          return out;
        };
        const chainA = chainOf(boardId);
        const chainB = chainOf(targetId);
        const lcaIdxA = chainA.findIndex((id) => chainB.includes(id));
        const lcaIdxB = lcaIdxA >= 0 ? chainB.indexOf(chainA[lcaIdxA]) : -1;
        const stepA = lcaIdxA > 0 ? chainA[lcaIdxA - 1] : null;
        const stepB = lcaIdxB > 0 ? chainB[lcaIdxB - 1] : null;
        // A 是 B 的祖先：看 A 畫布上通往 B 的子問題；B 是 A 的祖先：看 B 畫布上通往 A 的子問題；直接母子時就是 target／board 本身
        const downId = stepA === null && stepB ? stepB : targetId;
        const upId = stepB === null && stepA ? stepA : boardId;
        const childNode = nodesRef.current.find((n) => n.id === `q:${downId}`);
        const asChild = (boardData.questions ?? []).find((q) => q.board_id === upId);
        let dir = { x: 1, y: 0 };
        if (childNode) {
          const cw = childNode.measured?.width ?? childNode.width ?? 0;
          const ch = childNode.measured?.height ?? childNode.height ?? 0;
          dir = unit(childNode.position.x + cw / 2 - cA.x, childNode.position.y + ch / 2 - cA.y) ?? dir;
          enterDirRef.current.set(`${boardId}>${targetId}`, dir);
        } else if (asChild) {
          const entered = enterDirRef.current.get(`${targetId}>${boardId}`);
          dir = entered
            ? { x: -entered.x, y: -entered.y }
            : (unit(cB.x - (asChild.x + asChild.w / 2), cB.y - (asChild.y + asChild.h / 2)) ?? dir);
        } else if (stepA && stepB && lcaPage) {
          // 同層／跨分支：兩支在共同祖先畫布上的節點中心差。A→B 與 B→A 用同一組座標互減，必然互為反向
          const na = lcaPage.children.find((c) => c.board_id === stepA);
          const nb = lcaPage.children.find((c) => c.board_id === stepB);
          if (na && nb) {
            dir = unit(nb.x + nb.w / 2 - (na.x + na.w / 2), nb.y + nb.h / 2 - (na.y + na.h / 2)) ?? dir;
          } else {
            console.warn("[board-transition] 共同母白板上找不到分支節點，方向退回向右", { stepA, stepB });
          }
        }
        const extent = (z: number) => (Math.abs(dir.x) * W + Math.abs(dir.y) * H) / z;
        console.debug("[board-transition] dir", {
          from: boardId,
          to: targetId,
          branch: childNode ? "down" : asChild ? "up" : stepA && stepB ? "sibling" : "fallback",
          dir: `${dir.x.toFixed(2)}, ${dir.y.toFixed(2)}`,
          navHasQuestion: !!navBoards?.some((b) => b.question),
        });
        const sep = ((extent(vpA.zoom) + extent(vpB.zoom)) / 2) * 1.35;
        const cEnd = { x: cA.x + dir.x * sep, y: cA.y + dir.y * sep };
        const offset = { x: cEnd.x - cB.x, y: cEnd.y - cB.y };

        const rect = (c: { x: number; y: number }, z: number, pad = 0) => ({
          x: c.x - W / (2 * z) - pad,
          y: c.y - H / (2 * z) - pad,
          w: W / z + pad * 2,
          h: H / z + pad * 2,
        });
        const hit = (n: AnyFlowNode, q: { x: number; y: number; w: number; h: number }) => {
          const w = n.measured?.width ?? n.width ?? DEFAULT_CARD_W;
          const h = n.measured?.height ?? n.height ?? DEFAULT_CARD_H;
          return n.position.x < q.x + q.w && n.position.x + w > q.x && n.position.y < q.y + q.h && n.position.y + h > q.y;
        };

        // A：視野外的節點暫時 hidden（只影響顯示，不動 nodes 狀態），避免 A 視野外的節點闖進 B 的區域
        const rectA = rect(cA, vpA.zoom);
        const hidden = new Set(nodesRef.current.filter((n) => !hit(n, rectA)).map((n) => n.id));

        // B：只建視野（加邊界）內的預覽節點；子問題節點不放進預覽，抵達後才出現
        const bd = boardData as any;
        const sourceNodes: AnyFlowNode[] = [
          ...(bd.groups ?? []).map((g: any) => toGroupNode(g)),
          ...(bd.notes ?? []).map((n: any) => toNoteNode(n)),
          ...(bd.images ?? []).map((im: any) => toImageNode(im)),
          ...(bd.literatures ?? []).map((l: any) => toLiteratureNode(l)),
          ...(bd.cards ?? []).map((c: any) => toNode(c)),
        ];
        const rectBNative = rect(cB, vpB.zoom, 160);
        const guard = () => report(new Error("轉場預覽節點不可操作"), "轉場預覽");
        const preview = sourceNodes
          .filter((n) => hit(n, rectBNative))
          .map(
            (n) =>
              ({
                ...n,
                id: PV_PREFIX + n.id,
                position: { x: n.position.x + offset.x, y: n.position.y + offset.y },
                draggable: false,
                selectable: false,
                connectable: false,
                focusable: false,
                deletable: false,
                selected: false,
                data: Object.fromEntries(
                  Object.entries(n.data).map(([k, v]) => [k, typeof v === "function" && k !== "report" ? guard : v]),
                ),
              }) as AnyFlowNode,
          );
        const pvIds = new Set(preview.map((n) => n.id));
        const pvLinks = ((bd.links ?? []) as BoardLink[])
          .map(normalizeLink)
          .map((l) => ({ ...l, source_id: PV_PREFIX + l.source_id, target_id: PV_PREFIX + l.target_id }))
          .filter((l) => pvIds.has(l.source_id) && pvIds.has(l.target_id));

        preloadedBoardRef.current = { id: targetId, data: boardData, vp: vpB };
        viewportReady.current = false; // 轉場期間的鏡頭移動不可存成任何白板的 viewport
        setPreviewNodes(preview);
        setPreviewLinks(pvLinks);
        setScene({
          hidden,
          frames: [
            { ...rectA, label: navBoards?.find((b) => b.id === boardId)?.name || "目前白板" },
            { ...rect(cEnd, vpB.zoom), label: boardData.name || "目的白板" },
          ],
        });
        setTransitioning(true);

        // 縮放曲線：A 的 zoom → 中途縮到能同時看到兩塊白板 → B 的 zoom
        const TRANSITION_MS = 350;
        const zFit = (Math.abs(dir.x) * W + Math.abs(dir.y) * H) / (extent(vpA.zoom) / 2 + sep + extent(vpB.zoom) / 2);
        const zMid = Math.min(vpA.zoom, vpB.zoom, Math.max(0.2, zFit * 0.92));
        const lnA = Math.log(vpA.zoom);
        const lnB = Math.log(vpB.zoom);
        const lnMid = Math.log(zMid);
        const smootherstep = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);

        const run = () => {
          const start = performance.now();
          const step = (now: number) => {
            if (cancelled) return;
            const t = Math.min(1, Math.max(0, (now - start) / TRANSITION_MS));
            const e = smootherstep(t);
            const s = Math.sin(Math.PI * e);
            const z = Math.exp((1 - s) * (lnA + (lnB - lnA) * e) + s * lnMid);
            const cx = cA.x + (cEnd.x - cA.x) * e;
            const cy = cA.y + (cEnd.y - cA.y) * e;
            void rf.setViewport({ x: W / 2 - cx * z, y: H / 2 - cy * z, zoom: z });
            if (t < 1) {
              raf = requestAnimationFrame(step);
              return;
            }
            // 抵達：鏡頭已等於 B 的正式 viewport。換成正式節點由載入 effect（layout）在繪製前完成
            finished = true;
            transitionMeasuredRef.current = new Map(
              previewRef.current
                .filter((n) => n.measured?.width != null && n.measured?.height != null)
                .map((n): [string, { width?: number; height?: number }] => [
                  n.id.slice(PV_PREFIX.length),
                  { width: n.measured!.width, height: n.measured!.height },
                ]),
            );
            setBoardId(targetId);
          };
          raf = requestAnimationFrame(step);
        };

        // 等預覽節點掛載並量完尺寸才開始移動鏡頭（最多等 45 幀），動畫期間才不會一邊掛載 Markdown 一邊掉幀
        let waited = 0;
        const begin = () => {
          if (cancelled) return;
          const ready =
            previewRef.current.length === preview.length &&
            previewRef.current.every((n) => n.measured?.width != null && n.measured?.height != null);
          if (!ready && waited++ < 45) {
            raf = requestAnimationFrame(begin);
            return;
          }
          if (!ready) console.warn("[board-transition] 預覽節點尚未量測完成，仍開始轉場");
          run();
        };
        raf = requestAnimationFrame(begin);
      })
      .catch((err) => {
        if (cancelled) return;
        report(err, "載入目的白板失敗，直接切換");
        setBoardId(targetId);
      });

    return () => {
      cancelled = true;
      cancelAnimationFrame(raf);
      if (finished) return;
      // 轉場被中途取消：清掉預覽、還原 A 的鏡頭；預載資料作廢，避免之後無動畫切到同一塊白板時用到舊資料
      preloadedBoardRef.current = null;
      setPreviewNodes([]);
      setPreviewLinks([]);
      setScene(null);
      setTransitioning(false);
      if (startedVp) {
        void rf.setViewport(startedVp);
        viewportReady.current = true;
      }
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [boardIdProp]);

  // ---- 畫布上的問題節點（子問題）：載入、拖曳／縮放儲存、進入、新增、改名、狀態、刪除／封存；僅電腦版 ----
  // 白板圖片只有電腦端（SQLite）支援；Dexie 不註冊貼上與右鍵項目
  const imagesAvailable = getPreferredDriverType() !== "dexie";
  const pasteAtImpl = useRef<((at: { x: number; y: number }) => Promise<void>) | undefined>(undefined);
  const questions = useBoardQuestions<AnyFlowNode>({
    boardId,
    enabled: navAvailable,
    wrapRef,
    screenToFlow: (p) => rf.screenToFlowPosition(p),
    getNodes: () => nodesRef.current,
    setNodes,
    saved,
    snapRef,
    onSelectBoard: navSelectBoard,
    onBoardsChanged: navBoardsChanged,
    paneExtras: imagesAvailable
      ? (spot) => [{ label: "貼上圖片", onClick: () => void pasteAtImpl.current?.(spot) }]
      : undefined,
    report,
  });
  const persistQuestionMoved = questions.persistMoved;
  const askQuestionDelete = questions.askDelete;
  const selectedRef = useRef(selectedCardId);
  selectedRef.current = selectedCardId;
  // 上一次已同步進 nodes 的 selectedCardId。App 已改選取、[selectedCardId] effect 尚未寫進 nodes 的空窗內，
  // React Flow 回報的選取是過期的，不能寫回 App（否則會把剛指定的卡片蓋回舊選取）
  const syncedSelectedRef = useRef(selectedCardId);

  const toggleSnapToGrid = useCallback((checked: boolean) => {
    setSnapToGrid(checked);
    saveSnapToGrid(checked);
  }, []);

  // ---- 卡片縮放結束：開啟自動對齊時取整到格距；位置與尺寸一起寫回，失敗就回復 ----
  const resizeImpl = useRef<((id: string, p: { x: number; y: number; width: number; height: number }) => Promise<void>) | undefined>(undefined);
  resizeImpl.current = async (id, p) => {
    if (!boardId) return;
    const nextX = snapRef.current ? snapToGridValue(p.x, GRID_SIZE) : p.x;
    const nextY = snapRef.current ? snapToGridValue(p.y, GRID_SIZE) : p.y;
    const nextW = snapRef.current ? snapDimension(p.width, 180, GRID_SIZE) : p.width;
    const nextH = snapRef.current ? snapDimension(p.height, 80, GRID_SIZE) : p.height;
    try {
      await api.patchBoardCards(boardId, [{ card_id: id, x: nextX, y: nextY, w: nextW, h: nextH }]);
      saved.current.set(id, { x: nextX, y: nextY, w: nextW, h: nextH });
      setNodes((ns) =>
        ns.map((n) =>
          n.id === id && n.type === "card"
            ? {
                ...n,
                position: { x: nextX, y: nextY },
                width: nextW,
                height: nextH,
                style: { width: nextW, height: nextH },
                data: { ...n.data, sized: true },
              }
            : n,
        ),
      );
    } catch (e) {
      const g = saved.current.get(id);
      if (g)
        setNodes((ns) =>
          ns.map((n) =>
            n.id === id && n.type === "card"
              ? {
                  ...n,
                  position: { x: g.x, y: g.y },
                  width: g.w ?? 280,
                  height: g.h ?? undefined,
                  style: { width: g.w ?? 280, height: g.h ?? undefined },
                }
              : n,
          ),
        );
      report(e, "儲存卡片大小失敗，已回復");
    }
  };
  const onResizeEnd = useCallback(
    (id: string, p: { x: number; y: number; width: number; height: number }) => void resizeImpl.current?.(id, p),
    [],
  );

  // ---- 雙擊縮放把手：四角回預設大小（預設寬＋h=NULL 即自動高度）；底邊在「全文高度」與「自動高度」間切換 ----
  // 原因：雙擊由 CardNode 依 .react-flow__resize-control 的 handle／bottom 類別分流；這裡只負責判斷狀態與寫入。
  // assumption: api.patchBoardCards 接受 h: null 並把資料庫的 h 設為 NULL（api.ts／後端未提供，無法確認）
  // if broken: 型別錯誤（大聲），或重新載入後尺寸回到舊值（靜默，見驗證 J-1）
  const cardSizeImpl = useRef<((id: string, h: number | null, w?: number) => Promise<void>) | undefined>(undefined);
  cardSizeImpl.current = async (id, h, w) => {
    if (!boardId) return;
    const n = nodesRef.current.find((x): x is CardFlowNode => x.type === "card" && x.id === id);
    if (!n) return;
    const prev = saved.current.get(id);
    const x = prev?.x ?? n.position.x;
    const y = prev?.y ?? n.position.y;
    const nextW = w ?? prev?.w ?? n.width ?? DEFAULT_CARD_W;
    try {
      await api.patchBoardCards(boardId, [{ card_id: id, x, y, w: nextW, h }]);
      saved.current.set(id, { x, y, w: nextW, h });
      setNodes((ns) =>
        ns.map((m) =>
          m.id === id && m.type === "card"
            ? {
                ...m,
                width: nextW,
                height: h ?? undefined,
                style: { width: nextW, height: h ?? undefined },
                data: { ...m.data, sized: h != null },
              }
            : m,
        ),
      );
    } catch (e) {
      report(e, "儲存卡片大小失敗");
    }
  };
  const onResetCardSize = useCallback((id: string) => void cardSizeImpl.current?.(id, null, DEFAULT_CARD_W), []);
  const onFitCardHeight = useCallback((id: string, fullH: number) => {
    const n = nodesRef.current.find((x): x is CardFlowNode => x.type === "card" && x.id === id);
    if (!n) return;
    // 開啟自動對齊時向上取整到格距，才不會因取整切到內文最後幾 px
    const target = snapRef.current ? Math.ceil(fullH / GRID_SIZE) * GRID_SIZE : Math.ceil(fullH);
    const cur = n.measured?.height ?? n.height ?? 0;
    void cardSizeImpl.current?.(id, Math.abs(cur - target) <= 1 ? null : target);
  }, []);

  // ---- 分組框操作（縮放、改名、換色、刪除）----
  const groupResizeImpl = useRef<((gid: string, p: { x: number; y: number; width: number; height: number }) => Promise<void>) | undefined>(undefined);
  groupResizeImpl.current = async (gid, p) => {
    if (!boardId) return;
    const nodeId = `group:${gid}`;
    const prev = saved.current.get(nodeId);
    try {
      await api.patchBoardGroup(boardId, gid, { x: p.x, y: p.y, w: p.width, h: p.height });
      saved.current.set(nodeId, { x: p.x, y: p.y, w: p.width, h: p.height });
      setNodes((ns) =>
        ns.map((n) =>
          n.id === nodeId
            ? { ...n, position: { x: p.x, y: p.y }, width: p.width, height: p.height, style: { width: p.width, height: p.height, zIndex: -1 } }
            : n,
        ),
      );
      if (prev) {
        // 縮放後撞到別的框就整組推開；owned＝縮放前屬於這個框的卡片
        const oldRect = { x: prev.x, y: prev.y, w: prev.w ?? p.width, h: prev.h ?? p.height };
        const groupsBefore = savedGroupRects().map((g) => (g.id === nodeId ? { ...g, ...oldRect } : g));
        const owned = new Set(
          nodesRef.current
            .filter((n): n is CardFlowNode => n.type === "card" && groupAtCenter(nodeBox(n), groupsBefore)?.id === nodeId)
            .map((n) => n.id),
        );
        await refitGroupsImpl.current?.(new Map(), new Map(), false, undefined, new Map([[nodeId, { old: oldRect, owned }]]));
      }
    } catch (e) {
      const g = saved.current.get(nodeId);
      if (g)
        setNodes((ns) =>
          ns.map((n) =>
            n.id === nodeId
              ? { ...n, position: { x: g.x, y: g.y }, width: g.w ?? 360, height: g.h ?? 240, style: { width: g.w ?? 360, height: g.h ?? 240, zIndex: -1 } }
              : n,
          ),
        );
      report(e, "儲存分組框大小失敗，已回復");
    }
  };
  const onGroupResizeEnd = useCallback(
    (gid: string, p: { x: number; y: number; width: number; height: number }) => void groupResizeImpl.current?.(gid, p),
    [],
  );

  const renameGroupImpl = useRef<((gid: string, cur: string) => Promise<void>) | undefined>(undefined);
  renameGroupImpl.current = async (gid, cur) => {
    if (!boardId) return;
    const next = window.prompt("視覺分組名稱", cur);
    if (next === null) return;
    try {
      const updated = await api.patchBoardGroup(boardId, gid, { label: next.trim() });
      setNodes((ns) =>
        ns.map((n) => (n.id === `group:${gid}` && n.type === "boardGroup" ? { ...n, data: { ...n.data, label: updated.label } } : n)),
      );
    } catch (e) {
      report(e, "修改分組名稱失敗");
    }
  };
  const onGroupRename = useCallback((gid: string, cur: string) => void renameGroupImpl.current?.(gid, cur), []);

  const cycleGroupColorImpl = useRef<((gid: string, cur: string) => Promise<void>) | undefined>(undefined);
  cycleGroupColorImpl.current = async (gid, cur) => {
    if (!boardId) return;
    const idx = GROUP_COLORS.indexOf(cur as (typeof GROUP_COLORS)[number]);
    const nextColor = GROUP_COLORS[(idx + 1) % GROUP_COLORS.length];
    try {
      const updated = await api.patchBoardGroup(boardId, gid, { color: nextColor });
      setNodes((ns) =>
        ns.map((n) => (n.id === `group:${gid}` && n.type === "boardGroup" ? { ...n, data: { ...n.data, color: updated.color } } : n)),
      );
    } catch (e) {
      report(e, "切換分組顏色失敗");
    }
  };
  const onGroupCycleColor = useCallback((gid: string, cur: string) => void cycleGroupColorImpl.current?.(gid, cur), []);

  const removeGroupImpl = useRef<((gid: string) => Promise<void>) | undefined>(undefined);
  removeGroupImpl.current = async (gid) => {
    if (!boardId) return;
    try {
      await api.deleteBoardGroup(boardId, gid);
      const nodeId = `group:${gid}`;
      setNodes((ns) => ns.filter((n) => n.id !== nodeId));
      saved.current.delete(nodeId);
    } catch (e) {
      report(e, "刪除分組框失敗");
    }
  };
  const onGroupRemove = useCallback((gid: string) => void removeGroupImpl.current?.(gid), []);

  // ---- 靈感筆記（便利貼）：只屬於這塊白板、純文字；刪除直接生效，不做復原 ----
  const noteResizeImpl = useRef<((nid: string, p: { x: number; y: number; width: number; height: number }) => Promise<void>) | undefined>(undefined);
  noteResizeImpl.current = async (nid, p) => {
    if (!boardId) return;
    const nodeId = `note:${nid}`;
    const nextW = snapRef.current ? snapDimension(p.width, NOTE_MIN_W, GRID_SIZE) : p.width;
    const nextH = snapRef.current ? snapDimension(p.height, NOTE_MIN_H, GRID_SIZE) : p.height;
    const nextX = snapRef.current ? snapToGridValue(p.x, GRID_SIZE) : p.x;
    const nextY = snapRef.current ? snapToGridValue(p.y, GRID_SIZE) : p.y;
    try {
      await api.patchBoardNote(boardId, nid, { x: nextX, y: nextY, w: nextW, h: nextH });
      saved.current.set(nodeId, { x: nextX, y: nextY, w: nextW, h: nextH });
      setNodes((ns) =>
        ns.map((n) =>
          n.id === nodeId && n.type === "boardNote"
            ? {
                ...n,
                position: { x: nextX, y: nextY },
                width: nextW,
                height: nextH,
                style: { width: nextW, height: nextH },
                data: { ...n.data, w: nextW, h: nextH },
              }
            : n,
        ),
      );
    } catch (e) {
      const g = saved.current.get(nodeId);
      if (g)
        setNodes((ns) =>
          ns.map((n) =>
            n.id === nodeId && n.type === "boardNote"
              ? {
                  ...n,
                  position: { x: g.x, y: g.y },
                  width: g.w ?? NOTE_DEFAULT_W,
                  height: g.h ?? NOTE_DEFAULT_H,
                  style: { width: g.w ?? NOTE_DEFAULT_W, height: g.h ?? NOTE_DEFAULT_H },
                  data: { ...n.data, w: g.w ?? NOTE_DEFAULT_W, h: g.h ?? NOTE_DEFAULT_H },
                }
              : n,
          ),
        );
      report(e, "儲存便利貼大小失敗，已回復");
    }
  };
  const onNoteResizeEnd = useCallback(
    (nid: string, p: { x: number; y: number; width: number; height: number }) => void noteResizeImpl.current?.(nid, p),
    [],
  );

  // 儲存失敗時不動畫面上的文字（NoteNode 仍保留使用者輸入），下次失焦會再試一次
  const noteTextImpl = useRef<((nid: string, text: string) => Promise<void>) | undefined>(undefined);
  noteTextImpl.current = async (nid, text) => {
    if (!boardId) return;
    try {
      const updated = await api.patchBoardNote(boardId, nid, { text });
      setNodes((ns) =>
        ns.map((n) => (n.id === `note:${nid}` && n.type === "boardNote" ? { ...n, data: { ...n.data, text: updated.text } } : n)),
      );
    } catch (e) {
      report(e, "儲存便利貼內容失敗，內容仍保留在便利貼上");
    }
  };
  const onNoteCommitText = useCallback((nid: string, text: string) => void noteTextImpl.current?.(nid, text), []);

  const noteColorImpl = useRef<((nid: string, targetColor: string) => Promise<void>) | undefined>(undefined);
  noteColorImpl.current = async (nid, targetColor) => {
    if (!boardId) return;
    try {
      const updated = await api.patchBoardNote(boardId, nid, { color: targetColor });
      setNodes((ns) =>
        ns.map((n) => (n.id === `note:${nid}` && n.type === "boardNote" ? { ...n, data: { ...n.data, color: updated.color } } : n)),
      );
    } catch (e) {
      report(e, "切換便利貼顏色失敗");
    }
  };
  const onNoteCycleColor = useCallback((nid: string, cur: string) => void noteColorImpl.current?.(nid, cur), []);

  const noteRemoveImpl = useRef<((nid: string) => Promise<void>) | undefined>(undefined);
  noteRemoveImpl.current = async (nid) => {
    if (!boardId) return;
    try {
      await api.deleteBoardNote(boardId, nid);
      const nodeId = `note:${nid}`;
      setNodes((ns) => ns.filter((n) => n.id !== nodeId));
      saved.current.delete(nodeId);
    } catch (e) {
      report(e, "刪除便利貼失敗");
    }
  };
  const onNoteRemove = useCallback((nid: string) => void noteRemoveImpl.current?.(nid), []);

  // ---- 白板上的文獻節點：參照（只存 literature_id＋座標＋大小），標題與內容永遠讀文獻庫；Delete 只從白板移除，不刪文獻 ----
  const litResizeImpl = useRef<((lid: string, p: { x: number; y: number; width: number; height: number }) => Promise<void>) | undefined>(undefined);
  litResizeImpl.current = async (lid, p) => {
    if (!boardId) return;
    const nodeId = `lit:${lid}`;
    const nextX = snapRef.current ? snapToGridValue(p.x, GRID_SIZE) : p.x;
    const nextY = snapRef.current ? snapToGridValue(p.y, GRID_SIZE) : p.y;
    const nextW = snapRef.current ? snapDimension(p.width, 180, GRID_SIZE) : p.width;
    const nextH = snapRef.current ? snapDimension(p.height, 80, GRID_SIZE) : p.height;
    try {
      await api.patchBoardLiterature(boardId, lid, { x: nextX, y: nextY, w: nextW, h: nextH });
      saved.current.set(nodeId, { x: nextX, y: nextY, w: nextW, h: nextH });
      setNodes((ns) =>
        ns.map((n) =>
          n.id === nodeId && n.type === "boardLiterature"
            ? { ...n, position: { x: nextX, y: nextY }, width: nextW, height: nextH, style: { width: nextW, height: nextH } }
            : n,
        ),
      );
    } catch (e) {
      const g = saved.current.get(nodeId);
      if (g)
        setNodes((ns) =>
          ns.map((n) =>
            n.id === nodeId && n.type === "boardLiterature"
              ? {
                  ...n,
                  position: { x: g.x, y: g.y },
                  width: g.w ?? LIT_DEFAULT_W,
                  height: g.h ?? LIT_DEFAULT_H,
                  style: { width: g.w ?? LIT_DEFAULT_W, height: g.h ?? LIT_DEFAULT_H },
                }
              : n,
          ),
        );
      report(e, "儲存文獻大小失敗，已回復");
    }
  };
  const onLitResizeEnd = useCallback(
    (lid: string, p: { x: number; y: number; width: number; height: number }) => void litResizeImpl.current?.(lid, p),
    [],
  );

  const toLiteratureNode = useCallback(
    (l: BoardLiterature): LiteratureFlowNode => {
      const w = l.w ?? LIT_DEFAULT_W;
      const h = l.h ?? LIT_DEFAULT_H;
      return {
        id: `lit:${l.literature_id}`,
        type: "boardLiterature",
        position: { x: l.x, y: l.y },
        width: w,
        height: h,
        style: { width: w, height: h },
        data: { litId: l.literature_id, title: l.title, snippet: l.snippet, author: l.author, onResizeEnd: onLitResizeEnd },
      };
    },
    [onLitResizeEnd],
  );

  // ---- 白板圖片：只屬於這塊白板；圖檔在媒體庫，白板只存 media_id＋位置＋大小＋裁切比例（非破壞式）----
  const imageResizeImpl = useRef<((iid: string, p: { x: number; y: number; width: number; height: number }) => Promise<void>) | undefined>(undefined);
  imageResizeImpl.current = async (iid, p) => {
    if (!boardId) return;
    const nodeId = `img:${iid}`;
    try {
      await api.patchBoardImage(boardId, iid, { x: p.x, y: p.y, w: p.width, h: p.height }); // 等比例縮放，不取整以保持長寬比
      saved.current.set(nodeId, { x: p.x, y: p.y, w: p.width, h: p.height });
      setNodes((ns) =>
        ns.map((n) =>
          n.id === nodeId && n.type === "boardImage"
            ? {
                ...n,
                position: { x: p.x, y: p.y },
                width: p.width,
                height: p.height,
                style: { width: p.width, height: p.height },
                data: { ...n.data, w: p.width, h: p.height },
              }
            : n,
        ),
      );
    } catch (e) {
      const g = saved.current.get(nodeId);
      if (g && g.w != null && g.h != null) {
        const gw = g.w;
        const gh = g.h;
        setNodes((ns) =>
          ns.map((n) =>
            n.id === nodeId && n.type === "boardImage"
              ? { ...n, position: { x: g.x, y: g.y }, width: gw, height: gh, style: { width: gw, height: gh }, data: { ...n.data, w: gw, h: gh } }
              : n,
          ),
        );
      }
      report(e, "儲存圖片大小失敗，已回復");
    }
  };
  const onImageResizeEnd = useCallback(
    (iid: string, p: { x: number; y: number; width: number; height: number }) => void imageResizeImpl.current?.(iid, p),
    [],
  );

  // 套用裁切：框內的內容在畫面上不動（位置依裁切框相對原圖的偏移換算），所以裁切前後看起來是「框收縮／擴張」
  const imageCropImpl = useRef<((iid: string, r: CropRect) => Promise<boolean>) | undefined>(undefined);
  imageCropImpl.current = async (iid, r) => {
    if (!boardId) return false;
    const nodeId = `img:${iid}`;
    const n = nodesRef.current.find((m): m is ImageFlowNode => m.type === "boardImage" && m.id === nodeId);
    if (!n) return false;
    const d = n.data;
    const fullW = d.w / d.cropW;
    const fullH = d.h / d.cropH;
    const nx = n.position.x + (r.x - d.cropX) * fullW;
    const ny = n.position.y + (r.y - d.cropY) * fullH;
    const nw = r.w * fullW;
    const nh = r.h * fullH;
    try {
      await api.patchBoardImage(boardId, iid, { x: nx, y: ny, w: nw, h: nh, crop_x: r.x, crop_y: r.y, crop_w: r.w, crop_h: r.h });
      saved.current.set(nodeId, { x: nx, y: ny, w: nw, h: nh });
      setNodes((ns) =>
        ns.map((m) =>
          m.id === nodeId && m.type === "boardImage"
            ? {
                ...m,
                position: { x: nx, y: ny },
                width: nw,
                height: nh,
                style: { width: nw, height: nh },
                data: { ...m.data, w: nw, h: nh, cropX: r.x, cropY: r.y, cropW: r.w, cropH: r.h },
              }
            : m,
        ),
      );
      return true;
    } catch (e) {
      report(e, "儲存圖片裁切失敗");
      return false;
    }
  };
  const onImageCropCommit = useCallback((iid: string, r: CropRect) => imageCropImpl.current?.(iid, r) ?? Promise.resolve(false), []);

  // 刪除直接生效、不做復原（與便利貼一致）；圖檔留在媒體庫，由清理媒體回收
  const imageRemoveImpl = useRef<((iid: string) => Promise<void>) | undefined>(undefined);
  imageRemoveImpl.current = async (iid) => {
    if (!boardId) return;
    try {
      await api.deleteBoardImage(boardId, iid);
      setNodes((ns) => ns.filter((n) => n.id !== `img:${iid}`));
      setImageLinks((ls) => ls.filter((l) => l.image_id !== iid));
      saved.current.delete(`img:${iid}`);
    } catch (e) {
      report(e, "刪除圖片失敗");
    }
  };
  const onImageRemove = useCallback((iid: string) => void imageRemoveImpl.current?.(iid), []);

  const removeImageLinkImpl = useRef<((l: BoardImageLink) => Promise<void>) | undefined>(undefined);
  removeImageLinkImpl.current = async (l) => {
    if (!boardId) return; // 確認已由 ImageLinkConfirm 的 ○ 鈕完成，這裡直接刪除
    try {
      await api.deleteBoardImageLink(boardId, l.image_id, l.card_id);
      setImageLinks((ls) => ls.filter((x) => !(x.image_id === l.image_id && x.card_id === l.card_id)));
    } catch (e) {
      report(e, "移除圖片連線失敗");
    }
  };

  const toImageNode = useCallback(
    (im: BoardImage): ImageFlowNode => ({
      id: `img:${im.id}`,
      type: "boardImage",
      position: { x: im.x, y: im.y },
      width: im.w,
      height: im.h,
      style: { width: im.w, height: im.h },
      data: {
        imageId: im.id,
        mediaId: im.media_id,
        w: im.w,
        h: im.h,
        cropX: im.crop_x,
        cropY: im.crop_y,
        cropW: im.crop_w,
        cropH: im.crop_h,
        onResizeEnd: onImageResizeEnd,
        onCropCommit: onImageCropCommit,
        onRemove: onImageRemove,
        report,
      },
    }),
    [onImageCropCommit, onImageRemove, onImageResizeEnd, report],
  );

  // 貼上：量原圖尺寸 → 上傳媒體 → 建立白板圖片。at＝右鍵位置（左上角）；沒給就放在視窗中心。
  // 上傳成功但建立失敗時明講圖檔已上傳；中途切換白板時，圖片仍存在原白板，不畫到新白板上
  const placeImage = useCallback(
    async (file: File, at?: { x: number; y: number }) => {
      const bid = boardIdRef.current;
      if (!bid) {
        report(new Error("請先在左側建立或選擇一塊白板"));
        return;
      }
      try {
        const nat = await measureImage(file);
        const s = Math.min(1, IMAGE_MAX_SIDE / Math.max(nat.w, nat.h));
        const w = nat.w * s;
        const h = nat.h * s;
        const b = wrapRef.current?.getBoundingClientRect();
        const center = b
          ? rf.screenToFlowPosition({ x: b.left + b.width / 2, y: b.top + b.height / 2 })
          : { x: 200, y: 150 };
        const off = at ? 0 : (nodesRef.current.filter((n) => n.type === "boardImage").length % 6) * 24;
        const rawX = (at ? at.x : center.x - w / 2) + off;
        const rawY = (at ? at.y : center.y - h / 2) + off;
        const x = snapRef.current ? snapToGridValue(rawX, GRID_SIZE) : Math.round(rawX);
        const y = snapRef.current ? snapToGridValue(rawY, GRID_SIZE) : Math.round(rawY);
        const media = await api.uploadMedia(file);
        let created: BoardImage;
        try {
          created = await api.createBoardImage(bid, { media_id: media.id, x, y, w, h });
        } catch (e) {
          report(e, "圖檔已上傳，但放上白板失敗（沒用到的圖檔可用「清理媒體」回收）");
          return;
        }
        if (boardIdRef.current !== bid) {
          info("圖片已貼到先前的白板（你已切換白板）");
          return;
        }
        saved.current.set(`img:${created.id}`, { x: created.x, y: created.y, w: created.w, h: created.h });
        setNodes((ns) => [...ns.map((m) => ({ ...m, selected: false })), { ...toImageNode(created), selected: true }]);
      } catch (e) {
        report(e, "貼上圖片失敗");
      }
    },
    [info, report, rf, toImageNode],
  );

  pasteAtImpl.current = async (at) => {
    try {
      const f = await readClipboardImage();
      if (!f) {
        info("剪貼簿裡沒有圖片");
        return;
      }
      await placeImage(f, at);
    } catch (e) {
      report(e, "讀取剪貼簿失敗");
    }
  };

  // 快捷鍵貼上：只在白板為 active、焦點不在可編輯元素、且剪貼簿含圖片時處理；文字貼上完全不攔截
  useEffect(() => {
    if (!active || !boardId || !imagesAvailable) return;
    const onPaste = (e: ClipboardEvent) => {
      if (isEditableTarget(e.target)) return;
      const item = Array.from(e.clipboardData?.items ?? []).find((i) => i.kind === "file" && i.type.startsWith("image/"));
      const file = item?.getAsFile();
      if (!file) return;
      e.preventDefault();
      void placeImage(file);
    };
    document.addEventListener("paste", onPaste);
    return () => document.removeEventListener("paste", onPaste);
  }, [active, boardId, imagesAvailable, placeImage]);

  // 升級為卡片：建卡片 → 寫標題與內文 → 放上白板（原位）→ 刪便利貼。
  // 中途失敗時便利貼一律保留；若卡片已建立，訊息會告知，避免使用者重試後不知道多了一張。
  const notePromoteImpl = useRef<((nid: string, text: string) => Promise<void>) | undefined>(undefined);
  notePromoteImpl.current = async (nid, text) => {
    if (!boardId) return;
    const nodeId = `note:${nid}`;
    const noteNode = nodesRef.current.find((n): n is NoteFlowNode => n.type === "boardNote" && n.id === nodeId);
    if (!noteNode) return;

    // 方案 A：第一個非空行當標題，其餘當內文；單行時標題＝全文、內文為空
    const lines = text.replace(/\r\n?/g, "\n").split("\n");
    const first = lines.findIndex((l) => l.trim() !== "");
    if (first < 0) {
      report(new Error("便利貼是空的，沒有內容可以升級"), "無法升級為卡片");
      return;
    }
    const title = lines[first].trim();
    const body = lines.slice(first + 1).join("\n").replace(/^\n+/, "").trimEnd();
    // @depends-on backend schemas.py::CardPatch.title（max_length=500）：超過就明確報錯，不截斷內容
    if (title.length > 500) {
      report(new Error("第一行超過 500 字，請先在第一行適當位置換行再升級"), "無法升級為卡片");
      return;
    }

    let createdId: string | null = null;
    try {
      const created = await api.createCard();
      createdId = created.id;
      const updated = await api.patchCard(created.id, { title, body }, created.updated_at);
      const added = await api.addToBoard(boardId, created.id, noteNode.position.x, noteNode.position.y);
      saved.current.set(created.id, { x: added.x, y: added.y, w: added.w, h: added.h });
      const cardNode = toNode({ ...added, title: updated.title, body: updated.body, updated_at: updated.updated_at });
      setNodes((ns) => [...ns, cardNode]);
      await api.deleteBoardNote(boardId, nid);
      setNodes((ns) =>
        ns
          .filter((m) => m.id !== nodeId)
          .map((m) => (m.id === created.id ? { ...m, selected: true } : { ...m, selected: false })),
      );
      saved.current.delete(nodeId);
      onSelectCard(created.id);
      onCountChanged();
      info("已將便利貼升級為卡片");
    } catch (e) {
      report(
        e,
        createdId
          ? `升級中斷：卡片（${createdId.slice(0, 8)}）已建立，便利貼仍保留，請確認是否有重複的卡片`
          : "升級為卡片失敗，便利貼未變動",
      );
    }
  };
  const onNotePromote = useCallback((nid: string, text: string) => void notePromoteImpl.current?.(nid, text), []);

  // ---- 分組框自動貼合框內卡片，長大碰到其他框時推開該框與其卡片 ----
  // before／after：被移動卡片的舊／新座標。其餘卡片與所有分組框一律取伺服器已確認的 saved，不依賴 React 何時 commit。
  // keepOldMembers=true（自動排版／復原）：舊座標在框內的卡片仍算成員，避免排版把卡片排出舊框範圍後被誤判為「已離開」。
  // 拖曳則為 false：拖出框外的卡片不再算成員，框才會縮小。
  const refitGroupsImpl = useRef<
    | ((
        before: Map<string, { x: number; y: number }>,
        after: Map<string, { x: number; y: number }>,
        keepOldMembers: boolean,
        forced?: Map<string, string>, // 卡片 id → 放開時意圖歸入的分組框節點 id（被推出框外也算成員）
        movedGroups?: Map<string, MovedGroup>, // 被拖動／縮放過的框（saved 已是新矩形）：把撞到的別框連同卡片整組推開
      ) => Promise<void>)
    | undefined
  >(undefined);
  refitGroupsImpl.current = async (before, after, keepOldMembers, forced, movedGroups) => {
    if (!boardId) return;
    try {
      const boxes: LayoutBox[] = nodesRef.current
        .filter((n): n is CardFlowNode => n.type === "card")
        .map((n) => {
          const b = nodeBox(n);
          const p = after.get(n.id) ?? saved.current.get(n.id);
          return p ? { ...b, x: p.x, y: p.y } : b;
        });
      const groups: GroupRect[] = nodesRef.current
        .filter((n): n is GroupFlowNode => n.type === "boardGroup")
        .map((n) => {
          const g = saved.current.get(n.id);
          return { id: n.id, x: g?.x ?? n.position.x, y: g?.y ?? n.position.y, w: g?.w ?? n.width ?? 360, h: g?.h ?? n.height ?? 240 };
        });
      if (groups.length === 0) return;

      // 只處理「有被移動的卡片進出過」的分組框
      const members = new Map<string, string[]>();
      for (const g of groups) {
        let affected = false;
        const ids: string[] = [];
        for (const b of boxes) {
          const old = before.get(b.id);
          const moved = !!old;
          // 原因：重疊的框各自用 centerInRect 判定，會同時認領同一張卡片，框就越長越大去「搶」別框的卡片；
          // 一張卡片同時只屬於一個框（中心點所在、面積最小者）
          const inNow = groupAtCenter(b, groups)?.id === g.id;
          const inOld = !!old && groupAtCenter({ ...b, x: old.x, y: old.y }, groups)?.id === g.id;
          // 原因：歸屬在避讓之前判定；被推到框外的卡片中心出框，不算意圖就會被丟出成員，框也不會長大
          const wantsIn = forced?.get(b.id) === g.id;
          if (moved && (inNow || inOld || wantsIn)) affected = true;
          if (inNow || wantsIn || (moved && keepOldMembers && inOld)) ids.push(b.id);
        }
        if (affected) members.set(g.id, ids);
      }
      if (members.size === 0 && !movedGroups?.size) return;

      const result = fitGroups(groups, boxes, members, movedGroups);
      if (result.groups.size === 0 && result.cards.size === 0) return;

      // 先更新畫面，儲存失敗再回復
      setNodes((ns) =>
        ns.map((n) => {
          if (n.type === "boardGroup") {
            const r = result.groups.get(n.id);
            return r
              ? { ...n, position: { x: r.x, y: r.y }, width: r.w, height: r.h, style: { width: r.w, height: r.h, zIndex: -1 } }
              : n;
          }
          const p = result.cards.get(n.id);
          return p ? { ...n, position: { x: p.x, y: p.y } } : n;
        }),
      );

      const groupEntries = Array.from(result.groups.entries());
      const settled = await Promise.allSettled(
        groupEntries.map(([id, r]) =>
          api.patchBoardGroup(boardId, id.slice("group:".length), { x: r.x, y: r.y, w: r.w, h: r.h }),
        ),
      );
      let failed = false;
      for (let i = 0; i < settled.length; i++) {
        const [id, r] = groupEntries[i];
        const s = settled[i];
        if (s.status === "fulfilled") {
          saved.current.set(id, { x: r.x, y: r.y, w: r.w, h: r.h });
          continue;
        }
        failed = true;
        const g = saved.current.get(id);
        if (g) {
          setNodes((ns) =>
            ns.map((n) =>
              n.id === id && n.type === "boardGroup"
                ? {
                    ...n,
                    position: { x: g.x, y: g.y },
                    width: g.w ?? 360,
                    height: g.h ?? 240,
                    style: { width: g.w ?? 360, height: g.h ?? 240, zIndex: -1 },
                  }
                : n,
            ),
          );
        }
        report(s.reason, "儲存分組框自動調整失敗，已回復");
      }

      const cardItems = Array.from(result.cards.entries()).map(([card_id, p]) => ({ card_id, x: p.x, y: p.y }));
      if (cardItems.length === 0) return;
      const revertCards = () =>
        setNodes((ns) =>
          ns.map((n) => {
            const g = saved.current.get(n.id);
            return n.type === "card" && result.cards.has(n.id) && g ? { ...n, position: { x: g.x, y: g.y } } : n;
          }),
        );
      if (failed) {
        // 有框沒存成功：被推開的卡片也不寫入，避免卡片與框的位置在伺服器上不一致
        revertCards();
        return;
      }
      try {
        await api.patchBoardCards(boardId, cardItems);
        cardItems.forEach((i) => {
          const g = saved.current.get(i.card_id);
          saved.current.set(i.card_id, { x: i.x, y: i.y, w: g?.w ?? null, h: g?.h ?? null });
        });
      } catch (e) {
        revertCards();
        report(e, "儲存被推開的卡片位置失敗，已回復");
      }
    } catch (e) {
      report(e, "分組框自動調整失敗");
    }
  };

  const toNode = useCallback(
    (c: BoardCard): CardFlowNode => ({
      id: c.card_id,
      type: "card",
      position: { x: c.x, y: c.y },
      width: c.w ?? 280,
      height: c.h ?? undefined,
      style: { width: c.w ?? 280, height: c.h ?? undefined },
      data: {
        title: c.title,
        body: c.body,
        updatedAt: c.updated_at,
        sized: c.h != null,
        onResizeEnd,
        onResetSize: onResetCardSize,
        onFitHeight: onFitCardHeight,
        elsewhere: c.elsewhere,
        onOpenBoard: navSelectBoard,
        onOpenCard,
        report,
      },
    }),
    [onOpenCard, onResizeEnd, onResetCardSize, onFitCardHeight, navSelectBoard, report],
  );

  const toGroupNode = useCallback(
    (g: BoardGroup): GroupFlowNode => ({
      id: `group:${g.id}`,
      type: "boardGroup",
      position: { x: g.x, y: g.y },
      width: g.w,
      height: g.h,
      zIndex: -1,
      style: { width: g.w, height: g.h, zIndex: -1 },
      data: {
        groupId: g.id,
        label: g.label,
        color: g.color || "slate",
        onResizeEnd: onGroupResizeEnd,
        onRename: onGroupRename,
        onCycleColor: onGroupCycleColor,
        onRemoveGroup: onGroupRemove,
      },
    }),
    [onGroupCycleColor, onGroupRemove, onGroupRename, onGroupResizeEnd],
  );

  const toNoteNode = useCallback(
    (n: BoardNote, autoFocus = false): NoteFlowNode => ({
      id: `note:${n.id}`,
      type: "boardNote",
      position: { x: n.x, y: n.y },
      width: n.w,
      height: n.h ?? NOTE_DEFAULT_H,
      style: { width: n.w, height: n.h ?? NOTE_DEFAULT_H },
      data: {
        noteId: n.id,
        text: n.text,
        color: n.color || "amber",
        w: n.w,
        h: n.h ?? NOTE_DEFAULT_H,
        autoFocus,
        onResizeEnd: onNoteResizeEnd,
        onCommitText: onNoteCommitText,
        onCycleColor: onNoteCycleColor,
        onRemove: onNoteRemove,
        onPromote: onNotePromote,
        onOpen: (nid) => onOpenCard?.(`note:${nid}`),
      },
    }),
    [onNoteCommitText, onNoteCycleColor, onNotePromote, onNoteRemove, onNoteResizeEnd, onOpenCard],
  );

  // ---- 載入白板 ----
  // useLayoutEffect：轉場抵達時，換成 B 的正式 nodes、設好鏡頭、移除預覽，必須在繪製前的同一個 commit 內完成
  useLayoutEffect(() => {
    const preloaded =
      preloadedBoardRef.current && preloadedBoardRef.current.id === boardId
        ? preloadedBoardRef.current
        : null;

    if (!preloaded) {
      setNodes([]);
      setLinks([]);
      setImageLinks([]);
    }
    setEditingLink(null);
    setImgLinkConfirm(null);
    setUndoSnapshot(null);
    setDesignatedCenterId(null);
    setLastClickedCardId(null);
    saved.current.clear();
    viewportReady.current = false;
    if (!boardId) return;
    let alive = true;
    setLoading(!preloaded);

    const applyBoard = (b: any, presetVp?: SavedViewport, measured?: Map<string, { width?: number; height?: number }>) => {
      if (!alive) return;
      const groups = b.groups ?? [];
      groups.forEach((g: any) => saved.current.set(`group:${g.id}`, { x: g.x, y: g.y, w: g.w, h: g.h }));
      b.cards.forEach((c: any) => saved.current.set(c.card_id, { x: c.x, y: c.y, w: c.w, h: c.h }));
      const groupNodes = groups.map((g: any) => toGroupNode(g));
      const notes = b.notes ?? [];
      notes.forEach((n: any) => saved.current.set(`note:${n.id}`, { x: n.x, y: n.y, w: n.w, h: n.h ?? NOTE_DEFAULT_H }));
      const noteNodes = notes.map((n: any) => toNoteNode(n));
      const lits = b.literatures ?? [];
      lits.forEach((l: any) =>
        saved.current.set(`lit:${l.literature_id}`, { x: l.x, y: l.y, w: l.w ?? LIT_DEFAULT_W, h: l.h ?? LIT_DEFAULT_H }),
      );
      const litNodes = lits.map((l: any) => toLiteratureNode(l));
      const questionNodes = questions.loadFrom(b);
      const cardNodes = b.cards.map((c: any) => ({ ...toNode(c), selected: c.card_id === selectedRef.current }));
      const imgs = b.images ?? [];
      imgs.forEach((im: any) => saved.current.set(`img:${im.id}`, { x: im.x, y: im.y, w: im.w, h: im.h }));
      const imageNodes = imgs.map((im: any) => toImageNode(im));
      const allNodes = [...groupNodes, ...noteNodes, ...imageNodes, ...litNodes, ...questionNodes, ...cardNodes];
      setNodes(
        measured ? allNodes.map((n) => (measured.has(n.id) ? { ...n, measured: measured.get(n.id) } : n)) : allNodes,
      );
      setLinks((b.links ?? []).map(normalizeLink));
      setImageLinks(b.image_links ?? []);

      if (presetVp) {
        // 轉場預載：鏡頭在這個 layout effect 內同步設好（與預覽節點被移除同一個 commit，繪製前一起生效），不經 rAF
        void rf.setViewport(presetVp);
        preloadedBoardRef.current = null;
        transitionMeasuredRef.current = null;
        setTransitioning(false);
        setPreviewNodes([]);
        setPreviewLinks([]);
        setScene(null);
        // 稍後才允許存 viewport：動畫逐幀的 onMoveEnd 是非同步回報的，必須等它們都過去
        window.setTimeout(() => {
          if (alive) viewportReady.current = true;
        }, 60);
        return;
      }
      const vp = loadViewport(boardId);
      requestAnimationFrame(() => {
        if (!alive) return;
        if (vp && typeof rf.setViewport === "function") {
          void rf.setViewport(vp);
        } else if (b.cards.length) {
          void rf.fitView({ padding: 0.2, maxZoom: 1 });
        }
        viewportReady.current = true;
      });
    };

    if (preloaded) {
      applyBoard(preloaded.data, preloaded.vp, transitionMeasuredRef.current ?? undefined);
      setLoading(false);
    } else {
      api
        .getBoard(boardId)
        .then((b) => applyBoard(b))
        .catch((e) => alive && report(e, "載入白板失敗"))
        .finally(() => alive && setLoading(false));
    }

    return () => {
      alive = false;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [boardId]);

  const onMoveEnd = useCallback(
    (_e: unknown, vp: SavedViewport) => {
      if (boardId && viewportReady.current) {
        saveViewport(boardId, vp);
      }
    },
    [boardId],
  );

  // 右側面板選了別張卡片，白板上同步選取（若白板目前正在多選且已包含該卡，則不洗掉多選；有選取卡片時一併清除分組框選取）
  useEffect(() => {
    syncedSelectedRef.current = selectedCardId;
    setNodes((ns) => {
      const selectedCards = ns.filter((n) => n.type === "card" && n.selected);
      if (selectedCards.length > 1 && selectedCardId && selectedCards.some((n) => n.id === selectedCardId)) {
        return ns.some((n) => n.type === "boardGroup" && n.selected)
          ? ns.map((n) => (n.type === "boardGroup" && n.selected ? { ...n, selected: false } : n))
          : ns;
      }
      // 卡片、便利貼、文獻都以 selectedCardId 為準（便利貼／文獻的節點 id 就是 "note:…"／"lit:…"）；只有分組框在選了別的東西時才被清掉
      const follows = (n: AnyFlowNode) => n.type === "card" || n.type === "boardNote" || n.type === "boardLiterature";
      const needUpdate = ns.some((n) =>
        follows(n) ? !!n.selected !== (n.id === selectedCardId) : Boolean(selectedCardId && n.selected),
      );
      if (!needUpdate) return ns;
      return ns.map((n) => {
        if (follows(n)) return { ...n, selected: n.id === selectedCardId };
        if (selectedCardId && n.selected) return { ...n, selected: false };
        return n;
      });
    });
  }, [selectedCardId]);

  const onNodesChange = useCallback(
    (allChanges: NodeChange<AnyFlowNode>[]) => {
      // 轉場預覽節點（id 以 "pv:" 開頭）只讓它量尺寸，不進正式 nodes
      const pvChanges = allChanges.filter((c) => ("id" in c ? c.id : c.item.id).startsWith(PV_PREFIX));
      if (pvChanges.length) setPreviewNodes((ns) => applyNodeChanges(pvChanges, ns));
      const changes = pvChanges.length ? allChanges.filter((c) => !pvChanges.includes(c)) : allChanges;
      if (changes.length === 0) return;
      const drags = changes.filter(
        (c): c is PositionChange => c.type === "position" && c.dragging === true && !!c.position,
      );
      let next = changes;
      let guides: MagnetGuide[] = [];

      // 若使用者主動抓取的是卡片，鎖定同批誤被帶入的 boardGroup 不移動（防止在分組框內拖卡片時把分組框一起拖走）
      const activeType = activeDragRef.current?.type;
      const cardDrags =
        activeType === "boardGroup"
          ? []
          : drags.filter(
              (d) =>
                !d.id.startsWith("group:") &&
                !d.id.startsWith("note:") &&
                !d.id.startsWith("lit:") &&
                !d.id.startsWith("q:") &&
                !d.id.startsWith("img:"),
            );

      if (drags.length > 0 && shiftRef.current) {
        // Shift：以拖曳起點為基準，位移取固定間距的整數倍
        next = changes.map((c) => {
          if (c.type !== "position" || !c.dragging || !c.position) return c;
          const start = dragStartRef.current.get(c.id);
          if (!start) return c;
          if (
            (activeType === "card" || activeType === "boardNote" || activeType === "boardLiterature" || activeType === "boardImage") &&
            c.id.startsWith("group:")
          ) {
            return { ...c, position: { x: start.x, y: start.y } };
          }
          const qPos = { x: quantizeFromStart(start.x, c.position.x), y: quantizeFromStart(start.y, c.position.y) };
          lastSnappedPosRef.current.set(c.id, qPos);
          return { ...c, position: qPos };
        });
      } else if (cardDrags.length >= 1 && snapRef.current) {
        // 單張或多張卡片拖曳（含分組框內卡片）：磁吸對齊其他未移動卡片的邊緣／中線，並吸到固定間距
        const movingCardIds = new Set(cardDrags.map((d) => d.id));
        const movingBoxes: LayoutBox[] = [];
        for (const d of cardDrags) {
          const moving = nodesRef.current.find((n): n is CardFlowNode => n.type === "card" && n.id === d.id);
          if (moving && d.position) {
            movingBoxes.push({ ...nodeBox(moving), x: d.position.x, y: d.position.y });
          }
        }
        const others = nodesRef.current
          .filter((n): n is CardFlowNode => n.type === "card" && !movingCardIds.has(n.id))
          .map(nodeBox);

        let snapDx = 0;
        let snapDy = 0;
        if (movingBoxes.length === 1) {
          const r = computeMagnetSnap(
            movingBoxes[0],
            others,
            MAGNET_THRESHOLD_PX / rf.getZoom(),
            undefined,
            true, // 只吸到放開後不會被推開的位置，紅線才可信
          );
          snapDx = r.x - movingBoxes[0].x;
          snapDy = r.y - movingBoxes[0].y;
          guides = r.guides;
        } else if (movingBoxes.length >= 2) {
          const threshold = MAGNET_THRESHOLD_PX / rf.getZoom();
          const minX = Math.min(...movingBoxes.map((b) => b.x));
          const minY = Math.min(...movingBoxes.map((b) => b.y));
          const maxX = Math.max(...movingBoxes.map((b) => b.x + b.w));
          const maxY = Math.max(...movingBoxes.map((b) => b.y + b.h));
          const unionBox: LayoutBox = {
            id: "__multi__",
            x: minX,
            y: minY,
            w: maxX - minX,
            h: maxY - minY,
          };
          const rUnion = computeMagnetSnap(unionBox, others, threshold);
          snapDx = rUnion.x - unionBox.x;
          snapDy = rUnion.y - unionBox.y;
          let vGuides = rUnion.guides.filter((g) => g.x1 === g.x2);
          let hGuides = rUnion.guides.filter((g) => g.y1 === g.y2);

          // 同時檢查滑鼠主動抓取的主卡片，若主卡片能更近距離對齊其他卡片，優先採用主卡片的軸向吸附
          const primaryId = activeDragRef.current?.id;
          const primaryBox = movingBoxes.find((b) => b.id === primaryId) ?? movingBoxes[0];
          const rPri = computeMagnetSnap(primaryBox, others, threshold);
          const dxPri = rPri.x - primaryBox.x;
          const dyPri = rPri.y - primaryBox.y;
          const priVGuides = rPri.guides.filter((g) => g.x1 === g.x2);
          const priHGuides = rPri.guides.filter((g) => g.y1 === g.y2);

          if (
            (dxPri !== 0 || priVGuides.length > 0) &&
            ((snapDx === 0 && vGuides.length === 0) || Math.abs(dxPri) < Math.abs(snapDx))
          ) {
            snapDx = dxPri;
            vGuides = priVGuides;
          }
          if (
            (dyPri !== 0 || priHGuides.length > 0) &&
            ((snapDy === 0 && hGuides.length === 0) || Math.abs(dyPri) < Math.abs(snapDy))
          ) {
            snapDy = dyPri;
            hGuides = priHGuides;
          }
          guides = [...vGuides, ...hGuides];
        }

        next = changes.map((c) => {
          if (c.type !== "position" || !c.dragging || !c.position) return c;
          if (c.id.startsWith("group:")) {
            const start = dragStartRef.current.get(c.id);
            return start ? { ...c, position: { x: start.x, y: start.y } } : c;
          }
          if (!movingCardIds.has(c.id)) return c;
          const pos = { x: c.position.x + snapDx, y: c.position.y + snapDy };
          lastSnappedPosRef.current.set(c.id, pos);
          return { ...c, position: pos };
        });
      } else if (
        (activeType === "card" || activeType === "boardNote" || activeType === "boardLiterature" || activeType === "boardImage") &&
        drags.length > 0
      ) {
        // 未開啟自動對齊但主動拖曳卡片時，仍防止誤被選中的分組框跟著移動
        next = changes.map((c) => {
          if (c.type === "position" && c.dragging && c.id.startsWith("group:")) {
            const start = dragStartRef.current.get(c.id);
            return start ? { ...c, position: { x: start.x, y: start.y } } : c;
          }
          return c;
        });
      }

      // 放開滑鼠瞬間（dragging === false），若 React Flow 帶入未吸附座標，保留最後一次磁吸座標
      next = next.map((c) => {
        if (c.type === "position" && c.dragging === false && c.position) {
          const snapped = lastSnappedPosRef.current.get(c.id);
          if (snapped) return { ...c, position: snapped };
        }
        return c;
      });

      setMagnetGuides((cur) => (cur.length === 0 && guides.length === 0 ? cur : guides));
      setNodes((ns) => {
        const updated = applyNodeChanges(next, ns);
        // 若在分組框內框選導致卡片與分組框同時被選取，自動取消分組框的選取，確保後續拖曳只作用於卡片
        const hasSelectedCard = updated.some((n) => n.type === "card" && n.selected);
        const hasSelectedGroup = updated.some((n) => n.type === "boardGroup" && n.selected);
        if (hasSelectedCard && hasSelectedGroup) {
          return updated.map((n) => (n.type === "boardGroup" && n.selected ? { ...n, selected: false } : n));
        }
        return updated;
      });
    },
    [rf],
  );

  const onSelectionChange = useCallback(
    ({ nodes: sel }: { nodes: { id: string; type?: string }[] }) => {
      const cardSel = sel.filter(
        (n) =>
          !n.id.startsWith("group:") &&
          !n.id.startsWith("note:") &&
          !n.id.startsWith("lit:") &&
          !n.id.startsWith("q:") &&
          !n.id.startsWith("img:"),
      );
      // App 的選取已變、nodes 還沒同步：這次回報是舊選取，丟棄；nodes 追上後 React Flow 會再回報一次
      if (syncedSelectedRef.current !== selectedRef.current) return;
      // React Flow 的 store 比 nodes state 晚一個 commit 才同步，回報的選取可能是上一刻的過期快照。
      // 以 nodes 為準：不一致就丟棄，等 store 追上後的下一次回報再處理；
      // 否則會與 [selectedCardId] effect 互相覆寫，形成無限迴圈（React error #185）
      const current = nodesRef.current.filter((n) => n.type === "card" && n.selected).map((n) => n.id);
      if (cardSel.length !== current.length || cardSel.some((n) => !current.includes(n.id))) {
        return;
      }
      if (cardSel.length === 1 && cardSel[0].id !== selectedRef.current) {
        onSelectCard(cardSel[0].id);
      }
      if (cardSel.length < 2) {
        setDesignatedCenterId(null);
        setShowSplitConfig(false);
      } else {
        setDesignatedCenterId((cur) => (cur && cardSel.some((c) => c.id === cur) ? cur : null));
      }
    },
    [onSelectCard],
  );

  // 分組框的伺服器已確認矩形（拖曳中的畫面位置不可信，取法與 refitGroupsImpl 一致）
  const savedGroupRects = useCallback(
    (): GroupRect[] =>
      nodesRef.current
        .filter((n): n is GroupFlowNode => n.type === "boardGroup")
        .map((n) => {
          const g = saved.current.get(n.id);
          return { id: n.id, x: g?.x ?? n.position.x, y: g?.y ?? n.position.y, w: g?.w ?? n.width ?? 360, h: g?.h ?? n.height ?? 240 };
        }),
    [],
  );

  // 拖曳卡片時亮起「放開後會歸入」的分組框；只在亮框集合改變時才更新 nodes
  const dropTargetKeyRef = useRef("");
  const setDropTargets = useCallback((ids: string[]) => {
    const key = [...ids].sort().join("|");
    if (key === dropTargetKeyRef.current) return;
    dropTargetKeyRef.current = key;
    const on = new Set(ids);
    setNodes((ns) =>
      ns.map((n) =>
        n.type === "boardGroup" && (n.className === "drop-target") !== on.has(n.id)
          ? { ...n, className: on.has(n.id) ? "drop-target" : undefined }
          : n,
      ),
    );
  }, []);

  // ---- 拖曳分組框時，框內卡片同步跟隨移動 ----
  const onNodeDragStart: OnNodeDrag<AnyFlowNode> = useCallback((_e, node, dragged) => {
    activeDragRef.current = { id: node.id, type: node.type ?? "card" };
    lastSnappedPosRef.current.clear();
    dragStartRef.current = new Map(dragged.map((n) => [n.id, { x: n.position.x, y: n.position.y }]));
    if (node.type !== "boardGroup") {
      groupDragRef.current = null;
      return;
    }
    const g = saved.current.get(node.id);
    const gx = g?.x ?? node.position.x;
    const gy = g?.y ?? node.position.y;
    // 原因：純幾何判定會把重疊區內別框的卡片一起拖走；改用唯一歸屬（與貼合、亮框同一判定）
    const rects = savedGroupRects();
    const members = nodesRef.current
      .filter((n): n is CardFlowNode => n.type === "card" && groupAtCenter(nodeBox(n), rects)?.id === node.id)
      .map((n) => n.id);
    groupDragRef.current = { groupId: node.id, startX: gx, startY: gy, memberIds: members };
  }, [savedGroupRects]);

  const onNodeDrag: OnNodeDrag<AnyFlowNode> = useCallback((_e, node, dragged) => {
    if (node.type === "card") {
      // 判定與 onNodeDragStop 相同：中心點、磁吸後座標、伺服器已確認的框
      const gs = savedGroupRects();
      const hits = new Set<string>();
      for (const n of dragged) {
        if (n.type !== "card") continue;
        const b = nodeBox(n as CardFlowNode);
        const p = lastSnappedPosRef.current.get(n.id);
        const hit = groupAtCenter(p ? { ...b, x: p.x, y: p.y } : b, gs);
        if (hit) hits.add(hit.id);
      }
      setDropTargets(Array.from(hits));
      return;
    }
    const gd = groupDragRef.current;
    if (!gd || node.id !== gd.groupId || gd.memberIds.length === 0) return;
    const dx = node.position.x - gd.startX;
    const dy = node.position.y - gd.startY;
    const memberSet = new Set(gd.memberIds);
    setNodes((ns) =>
      ns.map((n) => {
        if (!memberSet.has(n.id)) return n;
        const orig = saved.current.get(n.id);
        if (!orig) return n;
        return { ...n, position: { x: orig.x + dx, y: orig.y + dy } };
      }),
    );
  }, [savedGroupRects, setDropTargets]);

  // ---- 拖曳結束才寫入；開啟自動對齊時吸附格線並避開重疊卡片；失敗回復 ----
  const onNodeDragStop: OnNodeDrag<AnyFlowNode> = useCallback(
    async (_e, node, dragged) => {
      const activeType = activeDragRef.current?.type ?? node.type;
      activeDragRef.current = null;
      setMagnetGuides([]);
      setDropTargets([]);
      if (!boardId) return;
      const gd = groupDragRef.current;
      groupDragRef.current = null;

      const groupNodes =
        activeType === "boardGroup"
          ? dragged.filter((n): n is GroupFlowNode => n.type === "boardGroup")
          : [];
      // 框實際落地的位移（吸附後）與落地前的矩形；null＝沒動或沒存成功
      let groupMove: { dx: number; dy: number; old: { x: number; y: number; w: number; h: number } } | null = null;
      for (const gn of groupNodes) {
        const nextX = snapRef.current ? snapToGridValue(gn.position.x, GRID_SIZE) : gn.position.x;
        const nextY = snapRef.current ? snapToGridValue(gn.position.y, GRID_SIZE) : gn.position.y;
        const prev = saved.current.get(gn.id);
        if (prev && prev.x === nextX && prev.y === nextY) continue;
        try {
          await api.patchBoardGroup(boardId, gn.data.groupId, { x: nextX, y: nextY });
          saved.current.set(gn.id, {
            x: nextX,
            y: nextY,
            w: prev?.w ?? gn.width ?? 360,
            h: prev?.h ?? gn.height ?? 240,
          });
          if (gd && gn.id === gd.groupId) {
            groupMove = {
              dx: nextX - gd.startX,
              dy: nextY - gd.startY,
              old: { x: gd.startX, y: gd.startY, w: prev?.w ?? gn.width ?? 360, h: prev?.h ?? gn.height ?? 240 },
            };
          }
          if (nextX !== gn.position.x || nextY !== gn.position.y) {
            setNodes((ns) => ns.map((n) => (n.id === gn.id ? { ...n, position: { x: nextX, y: nextY } } : n)));
          }
        } catch (e) {
          if (prev) {
            setNodes((ns) => ns.map((n) => (n.id === gn.id ? { ...n, position: { x: prev.x, y: prev.y } } : n)));
          }
          report(e, "儲存分組框位置失敗，已回到原位");
        }
      }

      // 框對框：被框碰到的別的框連同它的卡片整組推開。owned＝這個框自己的成員，不會被當成別框的卡片帶走
      if (groupMove && gd) {
        await refitGroupsImpl.current?.(
          new Map(),
          new Map(),
          false,
          undefined,
          new Map([[gd.groupId, { old: groupMove.old, owned: new Set(gd.memberIds) }]]),
        );
      }

      // 便利貼：只存位置（開啟自動對齊時取整到格距），不參與分組框歸屬與避讓
      for (const nn of dragged.filter((n): n is NoteFlowNode => n.type === "boardNote")) {
        const nextX = snapRef.current ? snapToGridValue(nn.position.x, GRID_SIZE) : nn.position.x;
        const nextY = snapRef.current ? snapToGridValue(nn.position.y, GRID_SIZE) : nn.position.y;
        const prev = saved.current.get(nn.id);
        if (prev && prev.x === nextX && prev.y === nextY) continue;
        try {
          await api.patchBoardNote(boardId, nn.data.noteId, { x: nextX, y: nextY });
          saved.current.set(nn.id, { x: nextX, y: nextY, w: prev?.w ?? nn.data.w, h: prev?.h ?? nn.data.h });
          if (nextX !== nn.position.x || nextY !== nn.position.y) {
            setNodes((ns) => ns.map((n) => (n.id === nn.id ? { ...n, position: { x: nextX, y: nextY } } : n)));
          }
        } catch (e) {
          if (prev) {
            setNodes((ns) => ns.map((n) => (n.id === nn.id ? { ...n, position: { x: prev.x, y: prev.y } } : n)));
          }
          report(e, "儲存便利貼位置失敗，已回到原位");
        }
      }

      // 文獻節點：只存位置（開啟自動對齊時取整到格距），不參與分組框歸屬與避讓
      for (const ln of dragged.filter((n): n is LiteratureFlowNode => n.type === "boardLiterature")) {
        const nextX = snapRef.current ? snapToGridValue(ln.position.x, GRID_SIZE) : ln.position.x;
        const nextY = snapRef.current ? snapToGridValue(ln.position.y, GRID_SIZE) : ln.position.y;
        const prev = saved.current.get(ln.id);
        if (prev && prev.x === nextX && prev.y === nextY) continue;
        try {
          await api.patchBoardLiterature(boardId, ln.data.litId, { x: nextX, y: nextY });
          saved.current.set(ln.id, { x: nextX, y: nextY, w: prev?.w ?? LIT_DEFAULT_W, h: prev?.h ?? LIT_DEFAULT_H });
          if (nextX !== ln.position.x || nextY !== ln.position.y) {
            setNodes((ns) => ns.map((n) => (n.id === ln.id ? { ...n, position: { x: nextX, y: nextY } } : n)));
          }
        } catch (e) {
          if (prev) {
            setNodes((ns) => ns.map((n) => (n.id === ln.id ? { ...n, position: { x: prev.x, y: prev.y } } : n)));
          }
          report(e, "儲存文獻位置失敗，已回到原位");
        }
      }

      // 圖片：只存位置（開啟自動對齊時取整到格距），不參與分組框歸屬與避讓
      for (const imn of dragged.filter((n): n is ImageFlowNode => n.type === "boardImage")) {
        const nextX = snapRef.current ? snapToGridValue(imn.position.x, GRID_SIZE) : imn.position.x;
        const nextY = snapRef.current ? snapToGridValue(imn.position.y, GRID_SIZE) : imn.position.y;
        const prev = saved.current.get(imn.id);
        if (prev && prev.x === nextX && prev.y === nextY) continue;
        try {
          await api.patchBoardImage(boardId, imn.data.imageId, { x: nextX, y: nextY });
          saved.current.set(imn.id, { x: nextX, y: nextY, w: prev?.w ?? imn.data.w, h: prev?.h ?? imn.data.h });
          if (nextX !== imn.position.x || nextY !== imn.position.y) {
            setNodes((ns) => ns.map((n) => (n.id === imn.id ? { ...n, position: { x: nextX, y: nextY } } : n)));
          }
        } catch (e) {
          if (prev) {
            setNodes((ns) => ns.map((n) => (n.id === imn.id ? { ...n, position: { x: prev.x, y: prev.y } } : n)));
          }
          report(e, "儲存圖片位置失敗，已回到原位");
        }
      }

      // 問題節點：只存位置，不參與分組框歸屬與避讓
      await persistQuestionMoved(dragged);

      const movedCardIds = new Set<string>(
        dragged.filter((n) => n.type === "card").map((n) => n.id),
      );
      if (gd) gd.memberIds.forEach((id) => movedCardIds.add(id));
      if (movedCardIds.size === 0) {
        lastSnappedPosRef.current.clear();
        return;
      }

      const allCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card");
      const movingBoxes = allCards
        .filter((n) => movedCardIds.has(n.id))
        .map((n) => {
          const b = nodeBox(n);
          const snapped = lastSnappedPosRef.current.get(n.id);
          return snapped ? { ...b, x: snapped.x, y: snapped.y } : b;
        });
      lastSnappedPosRef.current.clear();
      const fixedBoxes = allCards.filter((n) => !movedCardIds.has(n.id)).map(nodeBox);

      // 歸屬以「放開當下中心點在哪個框內」為準（與亮框同一判定）：
      // 中心進框＝不避讓自己要進的框，之後框長大包住它；中心沒進＝框是障礙物，卡片被推開、框不動。
      // 拖的是分組框時（成員剛體跟著走）不在此處理，維持原行為（檢查點 3 處理）。
      const groupRects = activeType === "card" ? savedGroupRects() : [];
      const intent = new Map<string, string>();
      for (const b of movingBoxes) {
        const hit = groupAtCenter(b, groupRects);
        if (hit) intent.set(b.id, hit.id);
      }

      const resolvedMap = new Map<string, { x: number; y: number }>();
      if (activeType === "boardGroup") {
        // 原因：成員被當成獨立卡片逐張避讓，整組相對位置會被打散。框是剛體：成員位移＝框實際落地（吸附後）的位移；
        // 框沒動或沒存成功（groupMove 為 null）就全部回到伺服器已確認的位置。碰撞由上面的框對框推開處理。
        for (const b of movingBoxes) {
          const o = saved.current.get(b.id);
          resolvedMap.set(b.id, o ? { x: o.x + (groupMove?.dx ?? 0), y: o.y + (groupMove?.dy ?? 0) } : { x: b.x, y: b.y });
        }
      } else if (!snapRef.current) {
        movingBoxes.forEach((b) => resolvedMap.set(b.id, { x: b.x, y: b.y }));
      } else {
        const fixed: LayoutBox[] = [...fixedBoxes];
        for (const key of Array.from(new Set(movingBoxes.map((b) => intent.get(b.id) ?? "")))) {
          const part = movingBoxes.filter((b) => (intent.get(b.id) ?? "") === key);
          const placed = placeCardsAvoidingCollisions(
            part,
            [...fixed, ...groupRects.filter((g) => g.id !== key)],
            GRID_SIZE,
          );
          for (const b of part) {
            const p = placed.get(b.id) ?? { x: b.x, y: b.y };
            resolvedMap.set(b.id, p);
            fixed.push({ ...b, x: p.x, y: p.y });
          }
        }
      }

      // 更新視覺位置（若有被推開或吸附調整）
      setNodes((ns) =>
        ns.map((n) => {
          const pos = resolvedMap.get(n.id);
          return pos && (n.position.x !== pos.x || n.position.y !== pos.y)
            ? { ...n, position: { x: pos.x, y: pos.y } }
            : n;
        }),
      );

      const items = Array.from(resolvedMap.entries())
        .map(([card_id, pos]) => ({ card_id, x: pos.x, y: pos.y }))
        .filter((i) => {
          const g = saved.current.get(i.card_id);
          return !g || g.x !== i.x || g.y !== i.y;
        });

      if (!items.length) return;
      const before = new Map<string, { x: number; y: number }>(
        items.map((i) => {
          const g = saved.current.get(i.card_id);
          return [i.card_id, { x: g?.x ?? i.x, y: g?.y ?? i.y }];
        }),
      );
      try {
        await api.patchBoardCards(boardId, items);
        items.forEach((i) => {
          const g = saved.current.get(i.card_id);
          saved.current.set(i.card_id, { x: i.x, y: i.y, w: g?.w ?? null, h: g?.h ?? null });
        });
        // 拖的是分組框時成員跟著框走、相對位置不變，不需要貼合；只有拖卡片才會進出框
        if (activeType === "card") {
          await refitGroupsImpl.current?.(
            before,
            new Map<string, { x: number; y: number }>(items.map((i) => [i.card_id, { x: i.x, y: i.y }])),
            false,
            intent,
          );
        }
      } catch (e) {
        const ids = new Set(items.map((i) => i.card_id));
        setNodes((ns) =>
          ns.map((n) => {
            const g = saved.current.get(n.id);
            return ids.has(n.id) && g ? { ...n, position: { x: g.x, y: g.y } } : n;
          }),
        );
        report(e, "儲存位置失敗，已回到原位");
      }
    },
    [boardId, persistQuestionMoved, report, savedGroupRects, setDropTargets],
  );

  // ---- 拉線建立有向具名連結（成功後顯示線，並開啟關係設定視窗）----
  const onConnect = useCallback(
    async (c: Connection) => {
      if (!c.source || !c.target || c.source === c.target) return;
      if (c.source.startsWith("group:") || c.target.startsWith("group:")) return;
      const srcImg = c.source.startsWith("img:");
      const tgtImg = c.target.startsWith("img:");
      if (srcImg || tgtImg) {
        // 圖片連線純視覺：不進語意連結（putLink），從哪一端拉都存成同一筆
        if (srcImg && tgtImg) {
          info("圖片之間不能連線，請連到卡片");
          return;
        }
        if (!boardId) return;
        const cardId = srcImg ? c.target : c.source;
        const imageId = (srcImg ? c.source : c.target).slice("img:".length);
        if (!nodesRef.current.some((n) => n.type === "card" && n.id === cardId)) {
          info("圖片只能連到卡片");
          return;
        }
        try {
          const r = await api.putBoardImageLink(boardId, imageId, cardId);
          setImageLinks((ls) =>
            ls.some((l) => l.image_id === imageId && l.card_id === cardId) ? ls : [...ls, { image_id: imageId, card_id: cardId }],
          );
          if (r.existed) info("這條連線已存在");
        } catch (e) {
          report(e, "建立圖片連線失敗");
        }
        return;
      }
      try {
        const r = await api.putLink(c.source, c.target, {
          relation_type: "延伸",
          status: "confirmed",
          reason: "",
        });
        const norm = normalizeLink(r);
        setLinks((ls) =>
          ls.some(
            (l) =>
              l.source_id === norm.source_id &&
              l.target_id === norm.target_id &&
              l.relation_type === norm.relation_type,
          )
            ? ls
            : [...ls, norm],
        );
        setEditingLink(norm);
        if (r.existed) info("已開啟既有連結設定");
        else onLinksChanged();
      } catch (e) {
        report(e, "建立連結失敗");
      }
    },
    [boardId, info, onLinksChanged, report],
  );

  // 轉場期間 React Flow 實際渲染的節點／連結：A 視野外的暫時 hidden、再加上 B 的預覽；不轉場時就是 nodes／links 本身
  const displayNodes = useMemo<AnyFlowNode[]>(() => {
    if (!scene && previewNodes.length === 0) return nodes;
    const base = scene ? nodes.map((n) => (scene.hidden.has(n.id) ? ({ ...n, hidden: true } as AnyFlowNode) : n)) : nodes;
    return [...base, ...previewNodes];
  }, [nodes, previewNodes, scene]);
  const edgeLinks = useMemo<BoardLink[]>(() => {
    const shown = scene ? links.filter((l) => !scene.hidden.has(l.source_id) && !scene.hidden.has(l.target_id)) : links;
    return previewLinks.length ? [...shown, ...previewLinks] : shown;
  }, [links, previewLinks, scene]);

  const edges = useMemo<Edge[]>(
    () =>
      edgeLinks.map((l) => {
        const color = RELATION_COLORS[l.relation_type] ?? "#2f6fed";
        const typeLabel = RELATION_LABELS[l.relation_type] ?? l.relation_type;
        const statusSuffix = l.status === "hypothesis" ? " (假說)" : "";
        return {
          id: `${l.source_id}__${l.target_id}__${l.relation_type}`,
          type: "floating",
          source: l.source_id,
          target: l.target_id,
          label: `${typeLabel}${statusSuffix}`,
          deletable: false,
          selectable: true,
          focusable: true,
          // 對稱類型（類比、互補、鄰接、張力）沒有方向，不畫箭頭
          markerEnd: isSymmetricRelation(l.relation_type)
            ? undefined
            : {
                type: MarkerType.ArrowClosed,
                color,
                width: 18,
                height: 18,
              },
          style: {
            stroke: color,
            strokeWidth: 2,
            strokeDasharray: l.status === "hypothesis" ? "6 4" : undefined,
          },
          labelStyle: {
            fill: "var(--text)",
            fontWeight: 600,
            fontSize: 11,
            cursor: "pointer",
          },
          labelBgStyle: {
            fill: "var(--panel)",
            fillOpacity: 0.92,
            stroke: color,
            strokeWidth: 1,
          },
          labelBgPadding: [6, 3] as [number, number],
          labelBgBorderRadius: 6,
          data: { link: l },
        };
      }),
    [edgeLinks],
  );

  // 圖片連線的邊：純視覺、無方向、無標籤；點擊可移除。邊 id 前綴 "imglink:" 與語意連結的邊分開
  const imageEdges = useMemo<Edge[]>(
    () =>
      imageLinks
        .filter((l) => !scene || (!scene.hidden.has(`img:${l.image_id}`) && !scene.hidden.has(l.card_id)))
        .map((l) => ({
          id: `imglink:${l.image_id}__${l.card_id}`,
          type: "floating",
          source: `img:${l.image_id}`,
          target: l.card_id,
          deletable: false,
          selectable: true,
          focusable: true,
          style: { stroke: "var(--muted)", strokeWidth: 1.5, strokeDasharray: "2 4" },
          data: { imageLink: l },
        })),
    [imageLinks, scene],
  );
  const allEdges = useMemo(() => [...edges, ...imageEdges], [edges, imageEdges]);

  // ---- Delete / Backspace：卡片只「從白板移除」（絕不刪卡片本體）；分組框則刪除分組框 ----
  const removeSelected = useCallback(async () => {
    if (!boardId) return;
    // 問題節點背後是一整塊白板：Delete 不直接刪，改開「刪除或封存」對話框（有選到問題時，這次只處理它）
    const selQuestions = nodesRef.current.filter((n): n is QuestionFlowNode => n.type === "boardQuestion" && !!n.selected);
    if (selQuestions.length) {
      askQuestionDelete(selQuestions[0].data.boardId);
      return;
    }
    const selGroups = nodesRef.current.filter((n): n is GroupFlowNode => n.type === "boardGroup" && !!n.selected);
    const selCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card" && !!n.selected);
    const selNotes = nodesRef.current.filter((n): n is NoteFlowNode => n.type === "boardNote" && !!n.selected);
    const selLits = nodesRef.current.filter((n): n is LiteratureFlowNode => n.type === "boardLiterature" && !!n.selected);
    const selImages = nodesRef.current.filter((n): n is ImageFlowNode => n.type === "boardImage" && !!n.selected);
    if (!selGroups.length && !selCards.length && !selNotes.length && !selLits.length && !selImages.length) return;

    if (selGroups.length) {
      const gResults = await Promise.allSettled(
        selGroups.map((g) => api.deleteBoardGroup(boardId, g.data.groupId)),
      );
      const removedGroupNodes = new Set<string>();
      gResults.forEach((r, i) => {
        if (r.status === "fulfilled") removedGroupNodes.add(selGroups[i].id);
        else report(r.reason, "刪除分組框失敗");
      });
      if (removedGroupNodes.size) {
        setNodes((ns) => ns.filter((n) => !removedGroupNodes.has(n.id)));
        removedGroupNodes.forEach((id) => saved.current.delete(id));
      }
    }

    if (selNotes.length) {
      // 便利貼直接刪除、不做復原（已確認的設計決定）；失敗的那幾張留在畫面上並大聲報錯
      const nResults = await Promise.allSettled(selNotes.map((n) => api.deleteBoardNote(boardId, n.data.noteId)));
      const removedNotes = new Set<string>();
      nResults.forEach((r, i) => {
        if (r.status === "fulfilled") removedNotes.add(selNotes[i].id);
        else report(r.reason, "刪除便利貼失敗");
      });
      if (removedNotes.size) {
        setNodes((ns) => ns.filter((n) => !removedNotes.has(n.id)));
        removedNotes.forEach((id) => saved.current.delete(id));
      }
    }

    if (selLits.length) {
      // 只從這塊白板移除節點，文獻本身不動（與卡片相同）；失敗的那幾個留在畫面上並大聲報錯
      const lResults = await Promise.allSettled(selLits.map((l) => api.removeLiteratureFromBoard(boardId, l.data.litId)));
      const removedLits = new Set<string>();
      lResults.forEach((r, i) => {
        if (r.status === "fulfilled") removedLits.add(selLits[i].id);
        else report(r.reason, "從白板移除文獻失敗");
      });
      if (removedLits.size) {
        setNodes((ns) => ns.filter((n) => !removedLits.has(n.id)));
        removedLits.forEach((id) => saved.current.delete(id));
      }
    }

    if (selImages.length) {
      // 圖片直接刪除、不做復原；失敗的留在畫面上並大聲報錯
      const iResults = await Promise.allSettled(selImages.map((n) => api.deleteBoardImage(boardId, n.data.imageId)));
      const removedImgs = new Set<string>();
      iResults.forEach((r, i) => {
        if (r.status === "fulfilled") removedImgs.add(selImages[i].data.imageId);
        else report(r.reason, "刪除圖片失敗");
      });
      if (removedImgs.size) {
        setNodes((ns) => ns.filter((n) => !(n.type === "boardImage" && removedImgs.has(n.data.imageId))));
        setImageLinks((ls) => ls.filter((l) => !removedImgs.has(l.image_id)));
        removedImgs.forEach((id) => saved.current.delete(`img:${id}`));
      }
    }

    if (selCards.length) {
      const ids = selCards.map((n) => n.id);
      const results = await Promise.allSettled(ids.map((id) => api.removeFromBoard(boardId, id)));
      const removed = new Set<string>();
      results.forEach((r, i) => {
        if (r.status === "fulfilled") removed.add(ids[i]);
        else report(r.reason, "從白板移除失敗");
      });
      if (removed.size) {
        setNodes((ns) => ns.filter((n) => !removed.has(n.id)));
        setLinks((ls) => ls.filter((l) => !removed.has(l.source_id) && !removed.has(l.target_id)));
        setImageLinks((ls) => ls.filter((l) => !removed.has(l.card_id))); // 後端 trigger 已刪，這裡讓畫面同步
        removed.forEach((id) => saved.current.delete(id));
        onCountChanged();
      }
    }
  }, [askQuestionDelete, boardId, onCountChanged, report]);

  useEffect(() => {
    if (!active) return;
    const onKey = (e: KeyboardEvent) => {
      if (!isRemoveKey(e) || isEditableTarget(e.target)) return;
      if (!nodesRef.current.some((n) => n.selected)) return;
      e.preventDefault();
      void removeSelected();
    };
    document.addEventListener("keydown", onKey);
    return () => document.removeEventListener("keydown", onKey);
  }, [active, removeSelected]);

  // ---- 多選節點計算（卡片、文獻、圖片）與自動排版／批次轉移 ----
  const selectedCards = useMemo(
    () => nodes.filter((n): n is CardFlowNode => n.type === "card" && !!n.selected),
    [nodes],
  );
  const selectedLiteratures = useMemo(
    () => nodes.filter((n): n is LiteratureFlowNode => n.type === "boardLiterature" && !!n.selected),
    [nodes],
  );
  const selectedImages = useMemo(
    () => nodes.filter((n): n is ImageFlowNode => n.type === "boardImage" && !!n.selected),
    [nodes],
  );
  const selectedTransferCount = selectedCards.length + selectedLiteratures.length + selectedImages.length;
  const [showTransferModal, setShowTransferModal] = useState(false);

  // 批次複製或轉移已選取的卡片／文獻／圖片到指定白板或新建白板（嚴格先寫入目標白板成功，才從來源白板移除，確保零資料遺失）
  const executeBatchTransfer = useCallback(
    async (
      target: { type: "existing"; id: string; name: string } | { type: "new"; name: string },
      mode: "copy" | "move",
      switchAfter: boolean,
    ) => {
      if (!boardId) return;
      if (target.type === "existing" && target.id === boardId) return;

      const curCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card" && !!n.selected);
      const curLits = nodesRef.current.filter((n): n is LiteratureFlowNode => n.type === "boardLiterature" && !!n.selected);
      const curImgs = nodesRef.current.filter((n): n is ImageFlowNode => n.type === "boardImage" && !!n.selected);
      if (curCards.length + curLits.length + curImgs.length === 0) return;

      let targetBoardId = "";
      let targetBoardName = "";
      let createdNewBoard = false;

      if (target.type === "new") {
        const cleanName = target.name.trim();
        if (!cleanName) {
          report(new Error("請輸入新白板名稱"), "建立白板失敗");
          return;
        }
        try {
          const created = await api.createBoard(cleanName);
          targetBoardId = created.id;
          targetBoardName = created.name;
          createdNewBoard = true;
        } catch (e) {
          report(e, "建立新白板失敗，未移動任何資料");
          return;
        }
      } else {
        targetBoardId = target.id;
        targetBoardName = target.name;
      }
      // 移除重複宣告的 curLits / curImgs，直接沿用上方已取得之選取節點陣列。
      const allSel = [...curCards, ...curLits, ...curImgs];

      // 計算整批左上角基準點，保留各節點之間的相對排版位置並錨定於目標白板 (120, 120)
      const minX = Math.min(...allSel.map((n) => n.position.x));
      const minY = Math.min(...allSel.map((n) => n.position.y));
      const mapPos = (x: number, y: number) => ({
        x: snapRef.current ? snapToGridValue(120 + (x - minX), GRID_SIZE) : Math.round(120 + (x - minX)),
        y: snapRef.current ? snapToGridValue(120 + (y - minY), GRID_SIZE) : Math.round(120 + (y - minY)),
      });

      let addedCards = 0;
      let existedCards = 0;
      let addedLits = 0;
      let existedLits = 0;
      let addedImgs = 0;
      let failedCount = 0;

      const removedCardIds = new Set<string>();
      const removedLitIds = new Set<string>();
      const removedImgIds = new Set<string>();
      const transferredCardIds = new Set<string>();
      const oldToNewImageId = new Map<string, string>();

      // 1. 處理卡片
      for (const cn of curCards) {
        const pos = mapPos(cn.position.x, cn.position.y);
        const geom = saved.current.get(cn.id);
        const w = geom?.w ?? cn.width ?? DEFAULT_CARD_W;
        const h = geom?.h ?? (typeof cn.height === "number" ? cn.height : null);
        let okOnTarget = false;
        try {
          await api.addToBoard(targetBoardId, cn.id, pos.x, pos.y);
          if (w !== DEFAULT_CARD_W || h != null) {
            await api.patchBoardCards(targetBoardId, [{ card_id: cn.id, x: pos.x, y: pos.y, w, h }]);
          }
          addedCards++;
          okOnTarget = true;
        } catch (e: any) {
          if (e?.code === "CARD_ALREADY_ON_BOARD" || e?.status === 409) {
            existedCards++;
            okOnTarget = true;
          } else {
            failedCount++;
            report(e, `複製卡片「${cn.data.title || "（無標題）"}」失敗`);
          }
        }
        if (okOnTarget) {
          transferredCardIds.add(cn.id);
          if (mode === "move") {
            try {
              await api.removeFromBoard(boardId, cn.id);
              removedCardIds.add(cn.id);
            } catch (e) {
              failedCount++;
              report(e, `已複製到目標白板，但從目前白板移除卡片「${cn.data.title || "（無標題）"}」失敗`);
            }
          }
        }
      }

      // 2. 處理文獻
      for (const ln of curLits) {
        const pos = mapPos(ln.position.x, ln.position.y);
        const geom = saved.current.get(ln.id);
        const w = geom?.w ?? ln.width ?? LIT_DEFAULT_W;
        const h = geom?.h ?? ln.height ?? LIT_DEFAULT_H;
        let okOnTarget = false;
        try {
          await api.addLiteratureToBoard(targetBoardId, {
            literature_id: ln.data.litId,
            x: pos.x,
            y: pos.y,
            w,
            h,
          });
          addedLits++;
          okOnTarget = true;
        } catch (e: any) {
          if (e?.status === 409) {
            existedLits++;
            okOnTarget = true;
          } else {
            failedCount++;
            report(e, `複製文獻「${ln.data.title || "（無標題）"}」失敗`);
          }
        }
        if (okOnTarget && mode === "move") {
          try {
            await api.removeLiteratureFromBoard(boardId, ln.data.litId);
            removedLitIds.add(ln.data.litId);
          } catch (e) {
            failedCount++;
            report(e, `已複製到目標白板，但從目前白板移除文獻「${ln.data.title || "（無標題）"}」失敗`);
          }
        }
      }

      // 3. 處理圖片（含非破壞式裁切比例還原）
      for (const imn of curImgs) {
        const pos = mapPos(imn.position.x, imn.position.y);
        const { mediaId, w, h, cropX, cropY, cropW, cropH, imageId } = imn.data;
        let newImageId: string | null = null;
        try {
          const created = await api.createBoardImage(targetBoardId, { media_id: mediaId, x: pos.x, y: pos.y, w, h });
          newImageId = created.id;
          const hasCrop = cropX > 1e-6 || cropY > 1e-6 || cropW < 1 - 1e-6 || cropH < 1 - 1e-6;
          if (hasCrop) {
            await api.patchBoardImage(targetBoardId, created.id, {
              crop_x: cropX,
              crop_y: cropY,
              crop_w: cropW,
              crop_h: cropH,
            });
          }
          addedImgs++;
          oldToNewImageId.set(imageId, created.id);
        } catch (e) {
          failedCount++;
          report(e, "複製圖片至目標白板失敗");
        }
        if (newImageId && mode === "move") {
          try {
            await api.deleteBoardImage(boardId, imageId);
            removedImgIds.add(imageId);
          } catch (e) {
            failedCount++;
            report(e, "已複製圖片到目標白板，但從目前白板移除圖片失敗");
          }
        }
      }

      // 4. 若選取的圖片與選取的卡片原本有視覺連線，一併在目標白板重建連線
      if (oldToNewImageId.size > 0 && transferredCardIds.size > 0) {
        for (const il of imageLinks) {
          const mappedImgId = oldToNewImageId.get(il.image_id);
          if (mappedImgId && transferredCardIds.has(il.card_id)) {
            await api.putBoardImageLink(targetBoardId, mappedImgId, il.card_id).catch(() => {});
          }
        }
      }

      // 5. 若為「轉移」模式，同步更新目前白板的畫面狀態與計數
      if (mode === "move" && (removedCardIds.size > 0 || removedLitIds.size > 0 || removedImgIds.size > 0)) {
        setNodes((ns) =>
          ns.filter((n) => {
            if (n.type === "card" && removedCardIds.has(n.id)) return false;
            if (n.type === "boardLiterature" && removedLitIds.has(n.data.litId)) return false;
            if (n.type === "boardImage" && removedImgIds.has(n.data.imageId)) return false;
            return true;
          }),
        );
        if (removedCardIds.size > 0) {
          setLinks((ls) => ls.filter((l) => !removedCardIds.has(l.source_id) && !removedCardIds.has(l.target_id)));
          removedCardIds.forEach((id) => saved.current.delete(id));
          onCountChanged();
        }
        if (removedLitIds.size > 0) {
          removedLitIds.forEach((id) => saved.current.delete(`lit:${id}`));
        }
        if (removedImgIds.size > 0 || removedCardIds.size > 0) {
          setImageLinks((ls) => ls.filter((l) => !removedImgIds.has(l.image_id) && !removedCardIds.has(l.card_id)));
          removedImgIds.forEach((id) => saved.current.delete(`img:${id}`));
        }
      }

      const actionLabel = mode === "move" ? "轉移" : "複製";
      const parts: string[] = [];
      if (addedCards > 0) parts.push(`${addedCards} 張卡片`);
      if (addedLits > 0) parts.push(`${addedLits} 份文獻`);
      if (addedImgs > 0) parts.push(`${addedImgs} 張圖片`);
      const skipParts: string[] = [];
      if (existedCards > 0) skipParts.push(`${existedCards} 張卡片已存在`);
      if (existedLits > 0) skipParts.push(`${existedLits} 份文獻已存在`);

      if (createdNewBoard || addedCards > 0) {
        await props.onBoardsChanged?.();
        onCountChanged();
      }

      if (parts.length > 0 || skipParts.length > 0) {
        const prefix = createdNewBoard ? `已建立新白板「${targetBoardName}」並` : "已";
        const mainMsg =
          parts.length > 0
            ? `${prefix}${actionLabel} ${parts.join("、")}${createdNewBoard ? "" : `至「${targetBoardName}」`}`
            : `目標白板「${targetBoardName}」已包含所選項目`;
        const extraMsg = skipParts.length > 0 ? `（${skipParts.join("、")}）` : "";
        info(mainMsg + extraMsg);
      } else if (createdNewBoard) {
        info(`已建立新白板「${targetBoardName}」`);
      } else if (failedCount === 0) {
        info("未處理任何項目");
      }

      if (switchAfter && targetBoardId) {
        props.onSelectBoard?.(targetBoardId);
      }
    },
    [boardId, imageLinks, info, onCountChanged, props, report],
  );

  // 取消選取（少於 2 張）視為排版使用完畢：快照只對排版當下那批卡片有效，留著會讓之後的復原蓋掉新位置
  useEffect(() => {
    if (selectedCards.length < 2 && undoSnapshot) setUndoSnapshot(null);
  }, [selectedCards.length, undoSnapshot]);

  const runAutoLayout = useCallback(
    async (overrideOpts?: {
      mode?: LayoutMode;
      gap?: number;
      clusterThreshold?: number;
      centerCardId?: string | null;
      splitMode?: SplitMode;
      typeSideMap?: Record<RelationType, "left" | "right">;
      gridCols?: number | null;
      gridRows?: number | null;
    }) => {
      if (!boardId) return;
      const sel = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card" && !!n.selected);
      if (sel.length < 2) return;

      const prevSnapshot = sel.map((n) => {
        const g = saved.current.get(n.id);
        return { card_id: n.id, x: g?.x ?? n.position.x, y: g?.y ?? n.position.y };
      });

      const effectiveCenterId =
        overrideOpts && "centerCardId" in overrideOpts ? overrideOpts.centerCardId : designatedCenterId;

      const boxes = sel.map(nodeBox);
      const posMap = autoLayoutCards(boxes, links, {
        mode: overrideOpts?.mode ?? layoutMode,
        gap: overrideOpts?.gap ?? layoutGap,
        clusterThreshold: overrideOpts?.clusterThreshold ?? clusterThreshold,
        centerCardId: effectiveCenterId,
        splitMode: overrideOpts?.splitMode ?? splitMode,
        typeSideMap: overrideOpts?.typeSideMap ?? typeSideMap,
        gridCols: overrideOpts?.gridCols !== undefined ? overrideOpts.gridCols : gridCols,
        gridRows: overrideOpts?.gridRows !== undefined ? overrideOpts.gridRows : gridRows,
        snapToGrid: snapRef.current,
        gridSize: GRID_SIZE,
      });

      const patchItems = Array.from(posMap.entries()).map(([card_id, pos]) => ({
        card_id,
        x: pos.x,
        y: pos.y,
      }));

      if (patchItems.length === 0) return;

      // 先更新畫面預覽，若寫入失敗則立刻退回原座標
      setNodes((ns) =>
        ns.map((n) => {
          const next = posMap.get(n.id);
          return next && n.type === "card" ? { ...n, position: { x: next.x, y: next.y } } : n;
        }),
      );

      try {
        await api.patchBoardCards(boardId, patchItems);
        patchItems.forEach((item) => {
          const g = saved.current.get(item.card_id);
          saved.current.set(item.card_id, { x: item.x, y: item.y, w: g?.w ?? null, h: g?.h ?? null });
        });
        setUndoSnapshot(prevSnapshot);
        await refitGroupsImpl.current?.(
          new Map<string, { x: number; y: number }>(prevSnapshot.map((p) => [p.card_id, { x: p.x, y: p.y }])),
          new Map<string, { x: number; y: number }>(patchItems.map((p) => [p.card_id, { x: p.x, y: p.y }])),
          true,
        );
      } catch (e) {
        const snapMap = new Map(prevSnapshot.map((p) => [p.card_id, p]));
        setNodes((ns) =>
          ns.map((n) => {
            const orig = snapMap.get(n.id);
            return orig && n.type === "card" ? { ...n, position: { x: orig.x, y: orig.y } } : n;
          }),
        );
        report(e, "自動排版儲存失敗，已回到原位");
      }
    },
    [boardId, clusterThreshold, designatedCenterId, gridCols, gridRows, layoutGap, layoutMode, links, report, splitMode, typeSideMap],
  );

  const undoAutoLayout = useCallback(async () => {
    if (!boardId || !undoSnapshot || undoSnapshot.length === 0) return;
    const toRestore = undoSnapshot;
    const layoutPos = new Map<string, { x: number; y: number }>(
      toRestore.map((p) => {
        const g = saved.current.get(p.card_id);
        return [p.card_id, { x: g?.x ?? p.x, y: g?.y ?? p.y }];
      }),
    );
    const snapMap = new Map(toRestore.map((p) => [p.card_id, p]));
    setNodes((ns) =>
      ns.map((n) => {
        const orig = snapMap.get(n.id);
        return orig && n.type === "card" ? { ...n, position: { x: orig.x, y: orig.y } } : n;
      }),
    );
    try {
      await api.patchBoardCards(boardId, toRestore);
      toRestore.forEach((item) => {
        const g = saved.current.get(item.card_id);
        saved.current.set(item.card_id, { x: item.x, y: item.y, w: g?.w ?? null, h: g?.h ?? null });
      });
      setUndoSnapshot(null);
      await refitGroupsImpl.current?.(
        layoutPos,
        new Map<string, { x: number; y: number }>(toRestore.map((p) => [p.card_id, { x: p.x, y: p.y }])),
        true,
      );
    } catch (e) {
      report(e, "復原排版失敗");
    }
  }, [boardId, report, undoSnapshot]);

  // ---- 複製已選卡片：標題＋內文（不含圖片，保留代碼）----
  const copySelectedCards = useCallback(async () => {
    const sel = nodesRef.current
      .filter((n): n is CardFlowNode => n.type === "card" && !!n.selected)
      .sort((a, b) => a.position.y - b.position.y || a.position.x - b.position.x);
    if (sel.length === 0) return;
    const text = sel
      .map((n) => {
        const title = (n.data.title || "（無標題）").trim();
        const body = stripImagesKeepCode(n.data.body || "");
        return body ? "# " + title + "\n\n" + body : "# " + title;
      })
      .join("\n\n---\n\n");
    try {
      await navigator.clipboard.writeText(text);
      info("已複製 " + String(sel.length) + " 張卡片的標題與內容（不含圖片）");
    } catch (e) {
      report(e, "複製失敗");
    }
  }, [info, report]);

  // 建立新卡片並加入白板的輔助邏輯
  const createCardFromDrop = useCallback(
    async (fileName: string, body: string, dropX: number, dropY: number) => {
      if (!boardId) return;
      let initX = dropX;
      let initY = dropY;
      if (snapRef.current) {
        const placed = placeCardsAvoidingCollisions(
          [{ id: "temp", x: initX, y: initY, w: DEFAULT_CARD_W, h: DEFAULT_CARD_H }],
          nodesRef.current.filter((n): n is CardFlowNode => n.type === "card").map(nodeBox),
          GRID_SIZE,
        );
        const pos = placed.get("temp");
        if (pos) {
          initX = pos.x;
          initY = pos.y;
        }
      }

      const created = await api.createCard();
      const updated = await api.patchCard(created.id, { title: fileName, body }, created.updated_at);
      const added = await api.addToBoard(boardId, created.id, initX, initY);
      saved.current.set(created.id, { x: added.x, y: added.y, w: added.w, h: added.h });
      const node = toNode({ ...added, title: updated.title, body: updated.body, updated_at: updated.updated_at });
      setNodes((ns) => [...ns.map((n) => ({ ...n, selected: false })), { ...node, selected: true }]);
      onSelectCard(created.id);
      onCountChanged();
      info(`已由代碼檔案 ${fileName} 建立卡片`);
    },
    [boardId, info, onCountChanged, onSelectCard, toNode],
  );

  // 覆蓋既有同名卡片的輔助邏輯
  const overwriteCardFromDrop = useCallback(
    async (cardId: string, fileName: string, body: string) => {
      try {
        const cur = await api.getCard(cardId);
        const updated = await api.patchCard(cardId, { title: fileName, body }, cur.updated_at);
        notifyCardTitleUpdated(cardId, updated.title);
        setNodes((ns) =>
          ns.map((n) =>
            n.id === cardId && n.type === "card"
              ? { ...n, data: { ...n.data, title: updated.title, body: updated.body } }
              : n,
          ),
        );
        info(`已覆蓋卡片「${fileName}」`);
      } catch (err) {
        report(err, `覆蓋卡片「${fileName}」失敗`);
      }
    },
    [info, report],
  );

  // ---- 拖曳代碼檔案建立新卡片（含同名覆蓋與分組框範圍保險）----
  const onBoardDrop = useCallback(
    async (e: React.DragEvent) => {
      if (!boardId || !e.dataTransfer.files.length) return;
      e.preventDefault();

      const files = Array.from(e.dataTransfer.files);
      const flowPos = rf.screenToFlowPosition({ x: e.clientX, y: e.clientY });

      const allCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card");
      const groupNodes = nodesRef.current.filter((n): n is GroupFlowNode => n.type === "boardGroup");

      const conflicts: DropConflictItem[] = [];

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const ext = file.name.split(".").pop()?.toLowerCase() || "";
        const lang = CODE_EXT_MAP[ext];
        if (!lang) {
          report(new Error(`略過不支援的檔案「${file.name}」，僅支援代碼檔案`), "檔案格式不支援");
          continue;
        }

        let content = "";
        try {
          content = await file.text();
        } catch (err) {
          report(err, `讀取檔案「${file.name}」失敗`);
          continue;
        }

        const dropX = flowPos.x + i * 24;
        const dropY = flowPos.y + i * 24;

        // 偵測落點是否在任一分組框內
        const hitGroup = groupNodes.find((g) => {
          const gw = g.width ?? 360;
          const gh = g.height ?? 240;
          return dropX >= g.position.x && dropX <= g.position.x + gw && dropY >= g.position.y && dropY <= g.position.y + gh;
        });

        let targetCards: CardFlowNode[] = [];
        let scopeLabel = "白板";

        if (hitGroup) {
          // 在分組框內：只比對屬於該分組框的卡片
          const gx = hitGroup.position.x;
          const gy = hitGroup.position.y;
          const gw = hitGroup.width ?? 360;
          const gh = hitGroup.height ?? 240;
          targetCards = allCards.filter((c) => {
            const b = nodeBox(c);
            const cx = b.x + b.w / 2;
            const cy = b.y + b.h / 2;
            return cx >= gx && cx <= gx + gw && cy >= gy && cy <= gy + gh;
          });
          scopeLabel = `分組框「${hitGroup.data.label || "未命名分組"}」`;
        } else {
          // 在分組框外：比對該白板所有卡片
          targetCards = allCards;
          scopeLabel = "白板";
        }

        const matched = targetCards.find((c) => (c.data.title || "").trim() === file.name.trim());

        if (matched) {
          conflicts.push({
            file,
            content,
            lang,
            dropX,
            dropY,
            matchedCard: matched,
            scopeLabel,
          });
        } else {
          const body = "```" + lang + ":" + file.name + "\n" + content + "\n```\n";
          await createCardFromDrop(file.name, body, dropX, dropY);
        }
      }

      if (conflicts.length > 0) {
        setConflictQueue(conflicts);
      }
    },
    [boardId, createCardFromDrop, report, rf],
  );

  // ---- 拖曳「🎯 中心圖標」到目標卡片放開以指定中心 ----
  const startCenterIconDrag = useCallback(
    (e: React.MouseEvent) => {
      e.preventDefault();
      e.stopPropagation();
      setPickingCenterDrag(true);

      const onUp = (ev: MouseEvent) => {
        window.removeEventListener("mouseup", onUp);
        setPickingCenterDrag(false);
        const flowPos = rf.screenToFlowPosition({ x: ev.clientX, y: ev.clientY });
        const sel = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card" && !!n.selected);
        const hit = sel.find((n) => {
          const b = nodeBox(n);
          return flowPos.x >= b.x && flowPos.x <= b.x + b.w && flowPos.y >= b.y && flowPos.y <= b.y + b.h;
        });
        if (hit) {
          setDesignatedCenterId(hit.id);
          info(`已指定「${hit.data.title || "（無標題）"}」為排列中心`);
          if (layoutMode !== "grid") {
            void runAutoLayout({ centerCardId: hit.id });
          }
        }
      };

      window.addEventListener("mouseup", onUp);
    },
    [info, layoutMode, rf, runAutoLayout],
  );

  // ---- 提供給 App 的操作 ----
  useImperativeHandle(
    innerRef,
    () => ({
      async addCard(cardId) {
        if (!boardId) {
          report(new Error("請先在左側建立或選擇一塊白板"));
          return;
        }
        if (nodesRef.current.some((n) => n.id === cardId)) {
          info("這張卡片已經在這塊白板上");
          onSelectCard(cardId);
          return;
        }
        try {
          const card = await api.getCard(cardId);
          const b = wrapRef.current?.getBoundingClientRect();
          const center = b
            ? rf.screenToFlowPosition({ x: b.left + b.width / 2, y: b.top + b.height / 2 })
            : { x: 0, y: 0 };
          const existingCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card");
          const off = (existingCards.length % 6) * 24;
          let initX = center.x - 140 + off;
          let initY = center.y - 60 + off;

          // 新加到白板的卡片也走自動對齊與防重疊推開規則，不會疊在別張上
          if (snapRef.current) {
            const placed = placeCardsAvoidingCollisions(
              [{ id: cardId, x: initX, y: initY, w: DEFAULT_CARD_W, h: DEFAULT_CARD_H }],
              existingCards.map(nodeBox),
              GRID_SIZE,
            );
            const pos = placed.get(cardId);
            if (pos) {
              initX = pos.x;
              initY = pos.y;
            }
          }

          const added = await api.addToBoard(boardId, cardId, initX, initY);
          saved.current.set(cardId, { x: added.x, y: added.y, w: added.w, h: added.h });
          const node = toNode({ ...added, title: card.title, body: card.body, updated_at: card.updated_at });
          setNodes((ns) => [...ns.map((n) => ({ ...n, selected: false })), { ...node, selected: true }]);
          setLinks((ls) => {
            const onBoard = new Set(nodesRef.current.filter((n) => n.type === "card").map((n) => n.id));
            const extra = card.links
              .filter((l) => onBoard.has(l.id))
              .map((l) =>
                normalizeLink({
                  source_id: l.source_id ?? (l.direction === "incoming" ? l.id : cardId),
                  target_id: l.target_id ?? (l.direction === "incoming" ? cardId : l.id),
                  relation_type: l.relation_type ?? "延伸",
                  status: l.status ?? "confirmed",
                  reason: l.reason ?? "",
                }),
              );
            return [
              ...ls,
              ...extra.filter(
                (p) =>
                  !ls.some(
                    (l) =>
                      l.source_id === p.source_id &&
                      l.target_id === p.target_id &&
                      l.relation_type === p.relation_type,
                  ),
              ),
            ];
          });
          onSelectCard(cardId);
          onCountChanged();
        } catch (e) {
          report(e, "加到白板失敗");
        }
      },
      updateCard(card) {
        setNodes((ns) =>
          ns.map((n) =>
            n.id === card.id && n.type === "card"
              ? { ...n, data: { ...n.data, title: card.title, body: card.body } }
              : n,
          ),
        );
      },
      removeCard(cardId) {
        setNodes((ns) => ns.filter((n) => n.id !== cardId));
        setLinks((ls) => ls.filter((l) => l.source_id !== cardId && l.target_id !== cardId));
        setImageLinks((ls) => ls.filter((l) => l.card_id !== cardId));
        saved.current.delete(cardId);
      },
      removeLink(sourceId, targetId, relationType) {
        setLinks((ls) =>
          ls.filter((l) => {
            if (relationType) {
              return !(l.source_id === sourceId && l.target_id === targetId && l.relation_type === relationType);
            }
            return !(
              (l.source_id === sourceId && l.target_id === targetId) ||
              (l.source_id === targetId && l.target_id === sourceId)
            );
          }),
        );
      },
      addLink(sourceId, targetId, extra) {
        const onBoard = new Set(nodesRef.current.filter((n) => n.type === "card").map((n) => n.id));
        if (!onBoard.has(sourceId) || !onBoard.has(targetId)) return;
        const norm = normalizeLink({ source_id: sourceId, target_id: targetId, ...extra });
        setLinks((ls) => {
          const filtered = ls.filter(
            (l) =>
              !(
                l.source_id === norm.source_id &&
                l.target_id === norm.target_id &&
                l.relation_type === norm.relation_type
              ),
          );
          return [...filtered, norm];
        });
      },
      async createGroup() {
        if (!boardId) {
          report(new Error("請先在左側建立或選擇一塊白板"));
          return;
        }
        const selCards = nodesRef.current.filter((n): n is CardFlowNode => n.type === "card" && !!n.selected);
        let x = 0;
        let y = 0;
        let w = 420;
        let h = 280;
        if (selCards.length > 0) {
          const minX = Math.min(...selCards.map((c) => c.position.x));
          const minY = Math.min(...selCards.map((c) => c.position.y));
          const maxX = Math.max(...selCards.map((c) => c.position.x + (c.width ?? 280)));
          const maxY = Math.max(...selCards.map((c) => c.position.y + (c.height ?? 160)));
          x = minX - GROUP_PAD;
          y = minY - GROUP_PAD_TOP;
          w = Math.max(260, maxX - minX + GROUP_PAD * 2);
          h = Math.max(180, maxY - minY + GROUP_PAD_TOP + GROUP_PAD);
        } else {
          const b = wrapRef.current?.getBoundingClientRect();
          const center = b
            ? rf.screenToFlowPosition({ x: b.left + b.width / 2, y: b.top + b.height / 2 })
            : { x: 200, y: 150 };
          x = Math.round(center.x - w / 2);
          y = Math.round(center.y - h / 2);
        }
        const label = window.prompt("輸入視覺分組框名稱（表達相關但未定義明確關係的群組）", "相關觀察群組");
        if (label === null) return;
        try {
          const g = await api.createBoardGroup(boardId, { label: label.trim() || "視覺分組", x, y, w, h, color: "slate" });
          saved.current.set(`group:${g.id}`, { x: g.x, y: g.y, w: g.w, h: g.h });
          const gNode = toGroupNode(g);
          setNodes((ns) => [gNode, ...ns]);
        } catch (e) {
          report(e, "建立分組框失敗");
        }
      },
      async createNote() {
        if (!boardId) {
          report(new Error("請先在左側建立或選擇一塊白板"));
          return;
        }
        const b = wrapRef.current?.getBoundingClientRect();
        const center = b
          ? rf.screenToFlowPosition({ x: b.left + b.width / 2, y: b.top + b.height / 2 })
          : { x: 200, y: 150 };
        const off = (nodesRef.current.filter((n) => n.type === "boardNote").length % 6) * 24;
        const rawX = center.x - NOTE_DEFAULT_W / 2 + off;
        const rawY = center.y - 40 + off;
        const x = snapRef.current ? snapToGridValue(rawX, GRID_SIZE) : Math.round(rawX);
        const y = snapRef.current ? snapToGridValue(rawY, GRID_SIZE) : Math.round(rawY);
        try {
          const n = await api.createBoardNote(boardId, { x, y, w: NOTE_DEFAULT_W, h: NOTE_DEFAULT_H });
          saved.current.set(`note:${n.id}`, { x: n.x, y: n.y, w: n.w, h: n.h ?? NOTE_DEFAULT_H });
          setNodes((ns) => [...ns.map((m) => ({ ...m, selected: false })), { ...toNoteNode(n, true), selected: true }]);
        } catch (e) {
          report(e, "建立靈感筆記失敗");
        }
      },
      // 右側欄改了便利貼後同步節點顯示（資料庫已由呼叫端寫入，這裡只更新畫面）
      updateNote(noteId, patch) {
        setNodes((ns) =>
          ns.map((n) =>
            n.id === `note:${noteId}` && n.type === "boardNote" ? { ...n, data: { ...n.data, ...patch } } : n,
          ),
        );
      },
      // 文獻庫、中央編輯或右側欄改了文獻後同步節點顯示；snippet 與後端的 substr(body, 1, 300) 同長
      updateLiterature(litId, patch) {
        setNodes((ns) =>
          ns.map((n) =>
            n.id === `lit:${litId}` && n.type === "boardLiterature"
              ? {
                  ...n,
                  data: {
                    ...n.data,
                    ...(patch.title !== undefined ? { title: patch.title } : {}),
                    ...(patch.body !== undefined ? { snippet: patch.body.slice(0, 300) } : {}),
                    ...(patch.author !== undefined ? { author: patch.author } : {}),
                  },
                }
              : n,
          ),
        );
      },
      // 文獻已被刪除（後端由外鍵連鎖移除節點）：只清畫面，不再呼叫 API
      removeLiterature(litId) {
        setNodes((ns) => ns.filter((n) => n.id !== `lit:${litId}`));
        saved.current.delete(`lit:${litId}`);
      },
      async addLiterature(litId: string) {
        if (!boardId) {
          report(new Error("請先在左側建立或選擇一塊白板"));
          return false;
        }
        if (nodesRef.current.some((n) => n.id === `lit:${litId}`)) {
          info("這份文獻已經在這塊白板上");
          return true;
        }
        try {
          const b = wrapRef.current?.getBoundingClientRect();
          const center = b
            ? rf.screenToFlowPosition({ x: b.left + b.width / 2, y: b.top + b.height / 2 })
            : { x: 200, y: 150 };
          const off = (nodesRef.current.filter((n) => n.type === "boardLiterature").length % 6) * 24;
          const x = snapRef.current
            ? snapToGridValue(center.x - LIT_DEFAULT_W / 2 + off, GRID_SIZE)
            : Math.round(center.x - LIT_DEFAULT_W / 2 + off);
          const y = snapRef.current
            ? snapToGridValue(center.y - 60 + off, GRID_SIZE)
            : Math.round(center.y - 60 + off);
          const added = await api.addLiteratureToBoard(boardId, {
            literature_id: litId,
            x,
            y,
            w: LIT_DEFAULT_W,
            h: LIT_DEFAULT_H,
          });
          saved.current.set(`lit:${litId}`, { x: added.x, y: added.y, w: added.w ?? LIT_DEFAULT_W, h: added.h ?? LIT_DEFAULT_H });
          // 不改選取：從文獻庫放上白板時選取會讓右側欄同時開出同一份文獻的第二個編輯器
          setNodes((ns) => [...ns, toLiteratureNode(added)]);
          info("已將文獻放上白板");
          return true;
        } catch (e) {
          report(e, "加入文獻至白板失敗");
          return false;
        }
      },
    }),
    [boardId, info, onCountChanged, onOpenCard, onSelectCard, report, rf, toGroupNode, toLiteratureNode, toNode, toNoteNode],
  );

  const cardCount = nodes.filter((n) => n.type === "card").length;
  const designatedCenterNode = designatedCenterId
    ? selectedCards.find((n) => n.id === designatedCenterId)
    : undefined;
  const lastClickedInSelection =
    lastClickedCardId && selectedCards.some((n) => n.id === lastClickedCardId)
      ? selectedCards.find((n) => n.id === lastClickedCardId)
      : undefined;

  return (
    <div
      className={`board${pickingCenterDrag ? " picking-center" : ""}`}
      ref={wrapRef}
      onDragOver={(e) => {
        if (e.dataTransfer.types.includes("Files")) {
          e.preventDefault();
          e.dataTransfer.dropEffect = "copy";
        }
      }}
      onDrop={(e) => void onBoardDrop(e)}
    >
      {boardId &&
        props.toolsSlot &&
        createPortal(
          <>
            <button
              type="button"
              onClick={() => setShowLocateModal(true)}
              title="貼上代碼片段或 AI 回覆，自動搜尋白板卡片並跳轉中央定位取代"
            >
              <CrosshairIcon />
              定位
            </button>
            <button
              type="button"
              className={snapToGrid ? "on" : ""}
              onClick={() => toggleSnapToGrid(!snapToGrid)}
              title="勾選時：拖曳卡片靠近其他卡片會磁吸對齊（顯示提示線）並吸到固定間距 20px；按住 Shift 拖曳則以 20px 為單位移動；放開時若重疊則自動移到最近空位"
            >
              <input
                type="checkbox"
                checked={snapToGrid}
                onChange={() => {}}
                style={{ margin: 0, width: 14, height: 14, pointerEvents: "none" }}
              />
              自動對齊
            </button>
          </>,
          props.toolsSlot,
        )}

      {showLocateModal && (
        <div className="modal" role="dialog" aria-label="貼上 AI 回覆並定位卡片">
          <div className="modal-card" style={{ maxWidth: 520 }}>
            <h4 style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <CrosshairIcon size={16} />
              貼上 AI 回覆並自動定位卡片
            </h4>
            <div className="muted" style={{ fontSize: 12, margin: "6px 0 10px" }}>
              貼上 AI 輸出的修改指令或代碼段落，系統將自動比對當前白板內的所有卡片，找到後立即進入中央編輯並啟動定位取代。
            </div>
            <textarea
              rows={8}
              value={locateText}
              onChange={(e) => setLocateText(e.target.value)}
              placeholder="在此貼上 AI 回覆全文（包含【尋找這段代碼】或檔名）..."
              autoFocus
              style={{
                width: "100%",
                boxSizing: "border-box",
                fontFamily: "monospace",
                fontSize: 12,
                lineHeight: 1.45,
                resize: "vertical",
              }}
            />
            <div className="modal-actions" style={{ marginTop: 12, justifyContent: "flex-end", gap: 8 }}>
              <button
                type="button"
                onClick={() => {
                  setShowLocateModal(false);
                  setLocateText("");
                }}
              >
                取消
              </button>
              <button
                type="button"
                className="primary"
                onClick={handleLocateCard}
                disabled={!locateText.trim()}
              >
                搜尋定位並開啟取代
              </button>
            </div>
          </div>
        </div>
      )}

      {/* active=false（中央編輯、其他視圖）時 Board 仍掛載且保留選取，面板必須跟著隱藏，否則會浮在編輯器上擋住畫面 */}
      {active && boardId && selectedTransferCount >= 2 && (
        <div className="board-multi-toolbar" role="toolbar" aria-label="多選批次與自動排列工具列">
          <span className="multi-count">
            已選{" "}
            {[
              selectedCards.length > 0 ? `${selectedCards.length} 張卡片` : "",
              selectedLiteratures.length > 0 ? `${selectedLiteratures.length} 份文獻` : "",
              selectedImages.length > 0 ? `${selectedImages.length} 張圖片` : "",
            ]
              .filter(Boolean)
              .join("、")}
          </span>

          <button
            type="button"
            onClick={() => setShowTransferModal(true)}
            title="將選取的卡片、文獻或圖片批量複製或轉移（移動）到指定的其他白板"
          >
            📤 轉移／複製到白板…
          </button>

          {selectedCards.length >= 2 && (
            <button
              onClick={() => void copySelectedCards()}
              title="複製已選卡片的標題與內容（不含圖片，保留代碼）"
            >
              📋 複製內容
            </button>
          )}

          {selectedCards.length >= 2 && (
            <>
              <div className="layout-mode-group" role="group" aria-label="排列方式">
                <button
                  className={layoutMode === "grid" ? "on" : ""}
                  onClick={() => {
                    setLayoutMode("grid");
                    void runAutoLayout({ mode: "grid" });
                  }}
                  title="網格排列（保留閱讀順序）"
                >
                  網格
                </button>
                <button
                  className={layoutMode === "radial" ? "on" : ""}
                  onClick={() => {
                    setLayoutMode("radial");
                    void runAutoLayout({ mode: "radial" });
                  }}
                  title="放射狀排列（連線最多的在中心，依層級向外環繞）"
                >
                  放射
                </button>
                <button
                  className={layoutMode === "right" ? "on" : ""}
                  onClick={() => {
                    setLayoutMode("right");
                    void runAutoLayout({ mode: "right" });
                  }}
                  title="向右展開（中心在左，子節點全部放右邊逐欄展開）"
                >
                  向右展開
                </button>
                <button
                  className={layoutMode === "split" ? "on" : ""}
                  onClick={() => {
                    setLayoutMode("split");
                    void runAutoLayout({ mode: "split" });
                  }}
                  title="左右分邊（依方向或關係類型分置左右兩側）"
                >
                  左右分邊
                </button>
              </div>

              <label className="toolbar-ctrl" title="調整卡片邊到邊的固定間距">
                <span>間距 {layoutGap}px</span>
                <input
                  type="range"
                  min={10}
                  max={140}
                  step={10}
                  value={layoutGap}
                  onChange={(e) => {
                    const nextGap = Number(e.target.value);
                    setLayoutGap(nextGap);
                  }}
                  onMouseUp={() => void runAutoLayout({ gap: layoutGap })}
                  onKeyUp={() => void runAutoLayout({ gap: layoutGap })}
                  aria-label="排版間距"
                />
              </label>

              {layoutMode === "grid" && (
                <>
                  <label className="toolbar-ctrl" title="每排幾張卡片（橫排）。留空＝自動；兩者都填時以橫排為準">
                    <span>橫排</span>
                    <input
                      type="number"
                      min={1}
                      max={50}
                      placeholder="自動"
                      value={gridCols ?? ""}
                      onChange={(e) => {
                        const next =
                          e.target.value === "" ? null : Math.max(1, Math.min(50, Math.floor(Number(e.target.value)) || 1));
                        setGridCols(next);
                        void runAutoLayout({ gridCols: next });
                      }}
                      style={{ width: 56 }}
                      aria-label="每排卡片張數"
                    />
                    <span>張</span>
                  </label>
                  <label className="toolbar-ctrl" title="每欄幾張卡片（縱排）。留空＝自動；只在橫排留空時生效">
                    <span>縱排</span>
                    <input
                      type="number"
                      min={1}
                      max={50}
                      placeholder="自動"
                      value={gridRows ?? ""}
                      onChange={(e) => {
                        const next =
                          e.target.value === "" ? null : Math.max(1, Math.min(50, Math.floor(Number(e.target.value)) || 1));
                        setGridRows(next);
                        void runAutoLayout({ gridRows: next });
                      }}
                      style={{ width: 56 }}
                      aria-label="每欄卡片張數"
                    />
                    <span>張</span>
                  </label>
                </>
              )}

              {layoutMode !== "grid" && (
                <>
                  <label
                    className="toolbar-ctrl"
                    title="當子卡片在圈選範圍內的連線數達到 X 張時，自成一個獨立群落（保留連接線）"
                  >
                    <span>獨立群落連線數 X：</span>
                    <input
                      type="number"
                      min={2}
                      max={20}
                      value={clusterThreshold}
                      onChange={(e) => {
                        const val = Math.max(2, Math.min(20, Number(e.target.value) || 2));
                        setClusterThreshold(val);
                      }}
                      style={{ width: 52 }}
                      aria-label="獨立群落連線數閾值"
                    />
                  </label>

                  <div className="center-picker-group">
                    <span
                      className={`center-drag-pill${pickingCenterDrag ? " dragging" : ""}`}
                      onMouseDown={startCenterIconDrag}
                      title="按住此圖標並拖曳到任一張已選卡片上放開，即可指定該卡片為中心"
                      role="button"
                      tabIndex={0}
                      aria-label="拖曳指定中心卡片"
                    >
                      <CrosshairIcon size={12} />
                      {designatedCenterNode ? `中心：${designatedCenterNode.data.title || "（無標題）"}` : "拖曳指定中心"}
                    </span>
                    {!designatedCenterNode && lastClickedInSelection && (
                      <button
                        onClick={() => {
                          setDesignatedCenterId(lastClickedInSelection.id);
                          void runAutoLayout({ centerCardId: lastClickedInSelection.id });
                        }}
                        title={`以最後點選的「${lastClickedInSelection.data.title || "（無標題）"}」作為中心排列`}
                      >
                        以「{(lastClickedInSelection.data.title || "無標題").slice(0, 8)}」為中心
                      </button>
                    )}
                    {designatedCenterNode && (
                      <button
                        onClick={() => {
                          setDesignatedCenterId(null);
                          void runAutoLayout({ centerCardId: null });
                        }}
                        title="改回自動以連線數最多的卡片為中心"
                        aria-label="清除指定中心"
                      >
                        ✕ 自動中心
                      </button>
                    )}
                  </div>
                </>
              )}

              {layoutMode === "split" && (
                <div className="split-config-wrap">
                  <select
                    value={splitMode}
                    onChange={(e) => {
                      const next = e.target.value as SplitMode;
                      setSplitMode(next);
                      void runAutoLayout({ splitMode: next });
                    }}
                    aria-label="左右分邊依據"
                    title="選擇左右分邊的判斷依據"
                  >
                    <option value="type">依關係類型分邊</option>
                    <option value="direction">依方向（指向中心放左／指出放右）</option>
                  </select>
                  {splitMode === "type" && (
                    <button
                      onClick={() => setShowSplitConfig((v) => !v)}
                      className={showSplitConfig ? "on" : ""}
                      title="設定各關係類型要放左邊或右邊（預設：反駁放左、其餘放右）"
                    >
                      ⚙ 左右設定
                    </button>
                  )}
                  {splitMode === "type" && showSplitConfig && (
                    <div className="split-config-popover" role="dialog" aria-label="關係類型左右分邊設定">
                      <div className="muted" style={{ fontSize: 11, marginBottom: 4 }}>
                        指定各關係類型置於中心左側或右側：
                      </div>
                      {(Object.entries(RELATION_LABELS) as [RelationType, string][]).map(([rel, label]) => (
                        <div key={rel} className="split-config-row">
                          <span>{label}</span>
                          <div className="layout-mode-group">
                            <button
                              className={typeSideMap[rel] === "left" ? "on" : ""}
                              onClick={() => {
                                const nextMap = { ...typeSideMap, [rel]: "left" as const };
                                setTypeSideMap(nextMap);
                                void runAutoLayout({ typeSideMap: nextMap });
                              }}
                            >
                              放左
                            </button>
                            <button
                              className={typeSideMap[rel] === "right" ? "on" : ""}
                              onClick={() => {
                                const nextMap = { ...typeSideMap, [rel]: "right" as const };
                                setTypeSideMap(nextMap);
                                void runAutoLayout({ typeSideMap: nextMap });
                              }}
                            >
                              放右
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

              <button className="primary" onClick={() => void runAutoLayout()}>
                自動排版
              </button>
            </>
          )}

          {undoSnapshot && (
            <button onClick={() => void undoAutoLayout()} title="還原上一次自動排版前的位置">
              ↶ 復原排版
            </button>
          )}
        </div>
      )}
  
      <div style={{ position: "absolute", inset: 0, overflow: "hidden" }}>
      <div
        ref={stageRef}
        className="board-stage"
        style={{
          position: "absolute",
          inset: 0,
          willChange: transitioning ? "transform, opacity" : undefined,
          pointerEvents: transitioning ? "none" : undefined,
        }}
      >
      <ReactFlow
        nodes={displayNodes}
        edges={allEdges}
        nodeTypes={nodeTypes}
        edgeTypes={edgeTypes}
        onNodesChange={onNodesChange}
        onNodeClick={(e, node) => {
          const target = e.target as HTMLElement;
          if (target.closest(".media-size-bar") || target.closest(".nodrag")) return;
          if (node.type === "card" || node.type === "boardNote" || node.type === "boardLiterature") {
            if (node.type === "card") setLastClickedCardId(node.id);
            if (!e.shiftKey && !e.ctrlKey && !e.metaKey) {
              onSelectCard(node.id);
            }
          }
        }}
        onNodeDragStart={onNodeDragStart}
        onNodeDrag={onNodeDrag}
        onNodeDragStop={onNodeDragStop}
        onNodeDoubleClick={(e, node) => {
          const target = e.target as HTMLElement;
          if (target.closest(".media-size-bar") || target.closest(".nodrag")) return;
          if (node.type === "boardQuestion") {
            questions.enter((node as QuestionFlowNode).data.boardId);
            return;
          }
          if (node.type === "card" || node.type === "boardNote" || node.type === "boardLiterature") {
            onOpenCard?.(node.id);
          }
        }}
        onEdgeClick={(e, edge) => {
          const d = edge.data as { link?: BoardLink; imageLink?: BoardImageLink } | undefined;
          if (d?.link) setEditingLink(d.link);
          else if (d?.imageLink) {
            // 圖片連線：不跳對話框，在點擊處旁邊彈出 ○／✕ 確認鈕（座標相對 .board，並限制在容器內）
            const r = wrapRef.current?.getBoundingClientRect();
            const px = e.clientX - (r?.left ?? 0);
            const py = e.clientY - (r?.top ?? 0);
            setImgLinkConfirm({
              link: d.imageLink,
              x: r ? Math.max(0, Math.min(px, r.width - 90)) : px,
              y: r ? Math.max(0, Math.min(py, r.height - 56)) : py,
            });
          }
        }}
        onConnect={onConnect}
        onSelectionChange={onSelectionChange}
        onMoveEnd={onMoveEnd}
        onMoveStart={() => setImgLinkConfirm(null)}
        onPaneContextMenu={questions.onPaneContextMenu}
        isValidConnection={(c) =>
          c.source !== c.target &&
          !c.source?.startsWith("group:") &&
          !c.target?.startsWith("group:") &&
          !(c.source?.startsWith("img:") && c.target?.startsWith("img:"))
        }
        connectionMode={ConnectionMode.Loose}
        selectionOnDrag={false}
        selectionMode={SelectionMode.Partial}
        selectionKeyCode="Space"
        multiSelectionKeyCode={["Shift", "Control", "Meta"]}
        panOnDrag={[0, 1]}
        panActivationKeyCode={null}
        snapToGrid={false} // 拖曳吸附改由 onNodesChange 的磁吸邏輯負責，不與格線吸附並用
        deleteKeyCode={null} // 停用內建刪除鍵，改由上面的處理（只從白板移除）
        minZoom={0.2}
        maxZoom={2}
      >
        <Background gap={GRID_SIZE} />
        <Controls>
          {navAvailable && (
            <ControlButton
              onClick={() => setNavOpen((v) => !v)}
              title={navOpen ? "收起問題路徑導航器" : "問題路徑導航器"}
              aria-label="問題路徑導航器"
              aria-pressed={navOpen}
              style={navOpen ? { background: "var(--row-hover, rgba(59,130,246,0.15))" } : undefined}
            >
              <svg viewBox="0 0 12 12" aria-hidden="true">
                <path d="M6 2.6V5.2M6 5.2L2.6 8.6M6 5.2L9.4 8.6" stroke="currentColor" strokeWidth="1.1" fill="none" />
                <circle cx="6" cy="2" r="1.7" />
                <circle cx="2.4" cy="9.6" r="1.7" />
                <circle cx="9.6" cy="9.6" r="1.7" />
              </svg>
            </ControlButton>
          )}
        </Controls>
        <ViewportPortal>
          {magnetGuides.map((g, i) => (
            <div
              key={i}
              style={{
                position: "absolute",
                left: Math.min(g.x1, g.x2),
                top: Math.min(g.y1, g.y2),
                width: Math.abs(g.x2 - g.x1) || 2,
                height: Math.abs(g.y2 - g.y1) || 2,
                background: "#f43f5e",
                pointerEvents: "none",
                zIndex: 1000,
              }}
            />
          ))}
        </ViewportPortal>
      </ReactFlow>
      </div>
      </div>
      {questions.overlay}
      {imgLinkConfirm && (
        <ImageLinkConfirm
          x={imgLinkConfirm.x}
          y={imgLinkConfirm.y}
          onConfirm={() => {
            const l = imgLinkConfirm.link;
            setImgLinkConfirm(null);
            void removeImageLinkImpl.current?.(l);
          }}
          onCancel={() => setImgLinkConfirm(null)}
        />
      )}
      {navAvailable && (
        <QuestionNavigator
          open={navOpen && active}
          onClose={() => setNavOpen(false)}
          boardId={boardId}
          boards={navBoards!}
          onSelectBoard={navSelectBoard!}
          onBoardsChanged={async () => {
            await navBoardsChanged!();
            await questions.reload(); // 導航器改了問題結構（移動、新增）：目前畫布上的問題節點與子問題數要跟上
          }}
          report={report}
        />
      )}
      {!boardId && <div className="board-hint">請先在左側建立或選擇一塊白板</div>}
      {boardId && !loading && cardCount === 0 && (
        <div className="board-hint">這塊白板還沒有卡片。按右上角的「新增卡片」圖標，或從「搜尋」把卡片加進來。</div>
      )}
      {editingLink && (
        <LinkEditorModal
          link={editingLink}
          nodes={nodes}
          onClose={() => setEditingLink(null)}
          onUpdated={(oldRel, updated) => {
            setLinks((ls) =>
              ls.map((l) =>
                // 用舊連結的兩端比對：改成對稱類型時後端可能把方向對調，updated 的兩端不一定等於舊的
                l.source_id === editingLink.source_id &&
                l.target_id === editingLink.target_id &&
                l.relation_type === oldRel
                  ? normalizeLink(updated)
                  : l,
              ),
            );
            setEditingLink(null);
            onLinksChanged();
          }}
          onDeleted={(linkToDel) => {
            setLinks((ls) =>
              ls.filter(
                (l) =>
                  !(
                    l.source_id === linkToDel.source_id &&
                    l.target_id === linkToDel.target_id &&
                    l.relation_type === linkToDel.relation_type
                  ),
              ),
            );
            setEditingLink(null);
            onLinksChanged();
          }}
          report={report}
        />
      )}
      {conflictQueue.length > 0 && (
        <DropConflictModal
          item={conflictQueue[0]}
          remainingCount={conflictQueue.length}
          onResolve={async (decision, applyToAll) => {
            const currentItem = conflictQueue[0];
            const currentBody = "```" + currentItem.lang + ":" + currentItem.file.name + "\n" + currentItem.content + "\n```\n";

            if (applyToAll) {
              // 批次套用至當前及後續所有同名檔案
              for (const it of conflictQueue) {
                const b = "```" + it.lang + ":" + it.file.name + "\n" + it.content + "\n```\n";
                if (decision === "overwrite") {
                  await overwriteCardFromDrop(it.matchedCard.id, it.file.name, b);
                } else if (decision === "create_new") {
                  await createCardFromDrop(it.file.name, b, it.dropX, it.dropY);
                }
              }
              setConflictQueue([]);
            } else {
              // 單筆處理
              if (decision === "overwrite") {
                await overwriteCardFromDrop(currentItem.matchedCard.id, currentItem.file.name, currentBody);
              } else if (decision === "create_new") {
                await createCardFromDrop(currentItem.file.name, currentBody, currentItem.dropX, currentItem.dropY);
              }
              setConflictQueue((q) => q.slice(1));
            }
          }}
        />
      )}
      {showTransferModal && boardId && (
        <BatchTransferModal canSwitchBoard="{Boolean(props.onSelectBoard)}" cardCount="{selectedCards.length}" currentBoardId="{boardId}" imgCount="{selectedImages.length}" initialBoards="{props.boards}" litCount="{selectedLiteratures.length}" onClose="{()"> setShowTransferModal(false)}
          onConfirm={async (target, mode, switchAfter) => {
            setShowTransferModal(false);
            await executeBatchTransfer(target, mode, switchAfter);
          }}
          report={report}
        />
      )}
    </div>
  );
}

function BatchTransferModal(props: {
  currentBoardId: string;
  initialBoards?: BoardSummary[];
  cardCount: number;
  litCount: number;
  imgCount: number;
  canSwitchBoard: boolean;
  onClose(): void;
  onConfirm(
    target: { type: "existing"; id: string; name: string } | { type: "new"; name: string },
    mode: "copy" | "move",
    switchAfter: boolean,
  ): Promise<void>;
  report(e: unknown, prefix?: string): void;
}) {
  const { currentBoardId, initialBoards, cardCount, litCount, imgCount, canSwitchBoard, onClose, onConfirm, report } = props;
  const [boards, setBoards] = useState<BoardSummary[]>(() => initialBoards ?? []);
  const [loading, setLoading] = useState<boolean>(!initialBoards);
  const [targetType, setTargetType] = useState<"existing" | "new">("existing");
  const [targetId, setTargetId] = useState<string>("");
  const [newBoardName, setNewBoardName] = useState<string>("");
  const [mode, setMode] = useState<"copy" | "move">("copy");
  const [switchAfter, setSwitchAfter] = useState<boolean>(false);
  const [submitting, setSubmitting] = useState(false);

  const availableBoards = useMemo(
    () => boards.filter((b) => b.id !== currentBoardId && !b.question?.archived_at),
    [boards, currentBoardId],
  );

  useEffect(() => {
    let alive = true;
    setLoading(true);
    api
      .listBoards()
      .then((res) => {
        if (!alive) return;
        setBoards(res.boards);
      })
      .catch((e) => {
        if (alive) report(e, "讀取白板清單失敗");
      })
      .finally(() => {
        if (alive) setLoading(false);
      });
    return () => {
      alive = false;
    };
  }, [report]);

  useEffect(() => {
    if (availableBoards.length > 0) {
      if (!availableBoards.some((b) => b.id === targetId)) {
        setTargetId(availableBoards[0].id);
      }
    } else if (!loading) {
      setTargetType("new");
    }
  }, [availableBoards, loading, targetId]);

  const summaryText = [
    cardCount > 0 ? `${cardCount} 張卡片` : "",
    litCount > 0 ? `${litCount} 份文獻` : "",
    imgCount > 0 ? `${imgCount} 張圖片` : "",
  ]
    .filter(Boolean)
    .join("、");

  const selectedBoard = availableBoards.find((b) => b.id === targetId);
  const canSubmit =
    !submitting &&
    (targetType === "existing" ? Boolean(selectedBoard) : newBoardName.trim().length > 0);

  const handleSubmit = async () => {
    if (!canSubmit) return;
    setSubmitting(true);
    try {
      if (targetType === "new") {
        await onConfirm({ type: "new", name: newBoardName.trim() }, mode, switchAfter);
      } else if (selectedBoard) {
        await onConfirm({ type: "existing", id: selectedBoard.id, name: selectedBoard.name }, mode, switchAfter);
      }
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="modal" role="dialog" aria-label="批量轉移或複製到指定白板">
      <div className="modal-card" style={{ maxWidth: 460 }}>
        <h4>批量轉移／複製到白板</h4>
        <div style={{ fontSize: 13, margin: "8px 0 12px" }}>
          已選取：<strong>{summaryText}</strong>
        </div>

        <div className="field-row">
          <span className="muted">目標白板：</span>
          <div style={{ display: "flex", gap: 14, marginTop: 4, marginBottom: 6, fontSize: 13 }}>
            <label style={{ display: "inline-flex", alignItems: "center", gap: 5, cursor: "pointer" }}>
              <input
                type="radio"
                name="batchTargetType"
                checked={targetType === "existing"}
                onChange={() => setTargetType("existing")}
                disabled={submitting || availableBoards.length === 0}
              />
              <span>選擇既有白板</span>
            </label>
            <label style={{ display: "inline-flex", alignItems: "center", gap: 5, cursor: "pointer" }}>
              <input
                type="radio"
                name="batchTargetType"
                checked={targetType === "new"}
                onChange={() => setTargetType("new")}
                disabled={submitting}
              />
              <span>建立新白板</span>
            </label>
          </div>

          {targetType === "existing" ? (
            loading && availableBoards.length === 0 ? (
              <div className="muted" style={{ fontSize: 12 }}>
                正在載入白板清單…
              </div>
            ) : availableBoards.length === 0 ? (
              <div className="muted" style={{ fontSize: 12 }}>
                目前沒有其他可用的既有白板，請選擇「建立新白板」。
              </div>
            ) : (
              <select
                value={targetId}
                onChange={(e) => setTargetId(e.target.value)}
                disabled={submitting}
                autoFocus
              >
                {availableBoards.map((b) => (
                  <option key={b.id} value={b.id}>
                    {b.question ? `↳ ${b.name}` : b.name}（目前 {b.card_count} 張卡片）
                  </option>
                ))}
              </select>
            )
          ) : (
            <input
              type="text"
              value={newBoardName}
              onChange={(e) => setNewBoardName(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter" && canSubmit) {
                  e.preventDefault();
                  void handleSubmit();
                }
              }}
              placeholder="輸入新白板名稱（建立後將自動置入所選資料）"
              disabled={submitting}
              autoFocus
            />
          )}
        </div>

        <div className="field-row" style={{ marginTop: 12 }}>
          <span className="muted">操作方式：</span>
          <div style={{ display: "flex", flexDirection: "column", gap: 6, marginTop: 4, fontSize: 13 }}>
            <label style={{ display: "flex", alignItems: "center", gap: 6, cursor: "pointer" }}>
              <input
                type="radio"
                name="batchTransferMode"
                checked={mode === "copy"}
                onChange={() => setMode("copy")}
                disabled={submitting}
              />
              <span>
                <strong>複製</strong>（保留目前白板上的項目）
              </span>
            </label>
            <label style={{ display: "flex", alignItems: "center", gap: 6, cursor: "pointer" }}>
              <input
                type="radio"
                name="batchTransferMode"
                checked={mode === "move"}
                onChange={() => setMode("move")}
                disabled={submitting}
              />
              <span>
                <strong>轉移</strong>（置入目標白板後，從目前白板移除）
              </span>
            </label>
          </div>
        </div>

        {canSwitchBoard && (
          <label
            style={{
              display: "flex",
              alignItems: "center",
              gap: 6,
              marginTop: 12,
              fontSize: 12,
              cursor: "pointer",
            }}
          >
            <input
              type="checkbox"
              checked={switchAfter}
              onChange={(e) => setSwitchAfter(e.target.checked)}
              disabled={submitting}
            />
            <span>完成後直接切換至目標白板</span>
          </label>
        )}

        <div className="modal-actions" style={{ marginTop: 16, justifyContent: "flex-end", gap: 8 }}>
          <button type="button" onClick={onClose} disabled={submitting}>
            取消
          </button>
          <button
            type="button"
            className="primary"
            onClick={() => void handleSubmit()}
            disabled={!canSubmit}
          >
            {submitting
              ? "處理中…"
              : targetType === "new"
                ? mode === "move"
                  ? "建立新白板並轉移"
                  : "建立新白板並複製"
                : mode === "move"
                  ? `確認轉移至「${selectedBoard?.name ?? ""}」`
                  : `確認複製至「${selectedBoard?.name ?? ""}」`}
          </button>
        </div>
      </div>
    </div>
  );
}

function DropConflictModal(props: {
  item: {
    file: File;
    matchedCard: CardFlowNode;
    scopeLabel: string;
  };
  remainingCount: number;
  onResolve(decision: "overwrite" | "create_new" | "skip", applyToAll: boolean): void | Promise<void>;
}) {
  const { item, remainingCount, onResolve } = props;
  const [applyToAll, setApplyToAll] = useState(false);

  return (
    <div className="modal" role="dialog" aria-label="同名卡片覆蓋確認">
      <div className="modal-card" style={{ maxWidth: 440 }}>
        <h4>⚠️ 發現同名卡片</h4>
        <div style={{ fontSize: 13, lineHeight: 1.6, margin: "10px 0" }}>
          在<strong>【{item.scopeLabel}】</strong>已存在一張名為<strong>「{item.file.name}」</strong>的卡片。
          <br />
          您希望如何處理此檔案？
        </div>

        {remainingCount > 1 && (
          <label style={{ display: "flex", alignItems: "center", gap: 6, margin: "8px 0 14px", fontSize: 12 }}>
            <input
              type="checkbox"
              checked={applyToAll}
              onChange={(e) => setApplyToAll(e.target.checked)}
            />
            <span>套用此決定至本次其餘同名檔案（尚有 {remainingCount - 1} 個）</span>
          </label>
        )}

        <div className="modal-actions" style={{ display: "flex", justifyContent: "flex-end", gap: 8, flexWrap: "wrap" }}>
          <button type="button" onClick={() => void onResolve("skip", applyToAll)}>
            略過此檔案
          </button>
          <button type="button" onClick={() => void onResolve("create_new", applyToAll)}>
            另建新卡片
          </button>
          <button type="button" className="primary" onClick={() => void onResolve("overwrite", applyToAll)}>
            覆蓋既有卡片
          </button>
        </div>
      </div>
    </div>
  );
}

function LinkEditorModal(props: {
  link: BoardLink;
  nodes: AnyFlowNode[];
  onClose(): void;
  onUpdated(oldRel: RelationType, updated: BoardLink): void;
  onDeleted(link: BoardLink): void;
  report(e: unknown, prefix?: string): void;
}) {
  const { link, nodes, onClose, onUpdated, onDeleted, report } = props;
  const [relationType, setRelationType] = useState<RelationType>(link.relation_type);
  const [status, setStatus] = useState<LinkStatus>(link.status);
  const [reason, setReason] = useState<string>(link.reason ?? "");

  const titleOf = (id: string) => {
    const n = nodes.find((x): x is CardFlowNode => x.type === "card" && x.id === id);
    return n?.data.title || "（無標題）";
  };

  const save = async () => {
    try {
      const updated = await api.patchLink(link.source_id, link.target_id, {
        old_relation_type: link.relation_type,
        relation_type: relationType,
        status,
        reason,
      });
      onUpdated(link.relation_type, updated);
    } catch (e) {
      report(e, "更新連結關係失敗");
    }
  };

  const remove = async () => {
    try {
      await api.deleteLink(link.source_id, link.target_id, link.relation_type);
      onDeleted(link);
    } catch (e) {
      report(e, "刪除連結失敗");
    }
  };

  return (
    <div className="modal" role="dialog" aria-label="設定卡片語意關係">
      <div className="modal-card" style={{ minWidth: 380 }}>
        <h4>設定語意關係</h4>
        <div className="link-direction-preview">
          <strong>{titleOf(link.source_id)}</strong>
          <span className="muted">
            {isSymmetricRelation(relationType)
              ? ` ──(${RELATION_LABELS[relationType]})── `
              : ` ──(${RELATION_LABELS[relationType]})──▶ `}
          </span>
          <strong>{titleOf(link.target_id)}</strong>
        </div>
        <label className="field-row">
          <span className="muted">關係類型（A 對 B 的語意關係）：</span>
          <select value={relationType} onChange={(e) => setRelationType(e.target.value as RelationType)}>
            {(Object.entries(RELATION_LABELS) as [RelationType, string][]).map(([k, label]) => (
              <option key={k} value={k}>
                {label}
              </option>
            ))}
          </select>
        </label>
        <label className="field-row">
          <span className="muted">可信度狀態（實線＝已確認，虛線＝待驗證假說）：</span>
          <select value={status} onChange={(e) => setStatus(e.target.value as LinkStatus)}>
            {(Object.entries(LINK_STATUS_LABELS) as [LinkStatus, string][]).map(([k, label]) => (
              <option key={k} value={k}>
                {label}
              </option>
            ))}
          </select>
        </label>
        <label className="field-row">
          <span className="muted">連接理由（一句話說明為什麼這兩張卡片有此關係）：</span>
          <textarea
            rows={2}
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            placeholder="例如：橫膈膜離心控制不足時，斜角肌與上斜方肌會代償參與吸氣"
            autoFocus
          />
        </label>
        <div className="modal-actions" style={{ justifyContent: "space-between" }}>
          <button className="danger" style={{ marginTop: 0 }} onClick={() => void remove()}>
            刪除此連結
          </button>
          <div style={{ display: "flex", gap: 6 }}>
            <button onClick={onClose}>取消</button>
            <button className="primary" onClick={() => void save()}>
              儲存關係
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

export const Board = forwardRef<BoardHandle, Props>((props, ref) => (
  <ReactFlowProvider>
    <BoardInner {...props} innerRef={ref} />
  </ReactFlowProvider>
));
Board.displayName = "Board";