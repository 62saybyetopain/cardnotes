// 樣式選單用的符號：依選項順序對應原本 select 提示的順序；數量對不上就退回選項原文，不猜
const BULLET_GLYPHS = ["•", "◦", "▪", "▸", "✓"] as const;
const ORDERED_GLYPHS = ["1.", "(1)", "a.", "A.", "i."] as const;
function styleGlyph(glyphs: readonly string[], total: number, index: number, fallback: string): string {
  return glyphs.length === total ? glyphs[index] : fallback;
}

const STATUS_TEXT: Record<Status, string> = {
  saved: "已儲存",
  dirty: "未儲存",
  saving: "儲存中…",
  error: "儲存失敗",
  conflict: "版本衝突",
};

interface OutlineItem {
  id: string;
  title: string;
  level: number;
  lineIndex: number;
  kind: "heading" | "details";
}

function extractOutlineItems(body: string): OutlineItem[] {
  const lines = body.split("\n");
  const items: OutlineItem[] = [];
  // 代碼圍欄內的 # 與 <summary> 只是代碼文字，不是章節；與 splitBodySegments 共用同一份圍欄判定
  const fences = fencedRanges(body);
  let offset = 0;

  for (let i = 0; i < lines.length; i++) {
    const lineStart = offset;
    offset += lines[i].length + 1;
    if (fences.some(([a, b]) => lineStart >= a && lineStart < b)) continue;
    const line = lines[i].trim();
    const hMatch = line.match(/^(#{1,6})\s+(.*)$/);
    if (hMatch) {
      items.push({
        id: `h-${i}`,
        title: hMatch[2].trim(),
        level: hMatch[1].length,
        lineIndex: i,
        kind: "heading",
      });
      continue;
    }
    const sumMatch = line.match(/<summary>(.*?)<\/summary>/i);
    if (sumMatch) {
      const rawText = sumMatch[1].trim();
      const innerH = rawText.match(/^(#{1,6})\s+(.*)$/);
      items.push({
        id: `d-${i}`,
        title: innerH ? innerH[2].trim() : rawText,
        level: innerH ? innerH[1].length : 2,
        lineIndex: i,
        kind: "details",
      });
    }
  }
  return items;
}

function adjustOutlineLevel(body: string, item: OutlineItem, delta: 1 | -1): EditPatch | null {
  const lines = body.split("\n");
  if (item.lineIndex < 0 || item.lineIndex >= lines.length) return null;
  const line = lines[item.lineIndex];
  const nextLevel = Math.max(1, Math.min(6, item.level + delta));
  if (nextLevel === item.level) return null;

  let newLine = line;
  if (item.kind === "heading") {
    newLine = `${"#".repeat(nextLevel)} ${item.title}`;
  } else if (item.kind === "details") {
    newLine = `<summary>${"#".repeat(nextLevel)} ${item.title}</summary>`;
  }

  let lineOffset = 0;
  for (let i = 0; i < item.lineIndex; i++) {
    lineOffset += lines[i].length + 1;
  }

  const nextBody = body.slice(0, lineOffset) + newLine + body.slice(lineOffset + line.length);
  return {
    text: nextBody,
    selectionStart: lineOffset + newLine.length,
    selectionEnd: lineOffset + newLine.length,
    replaceFrom: lineOffset,
    replaceTo: lineOffset + line.length,
    insertText: newLine,
  };
}

const LINE_TYPE_BUTTONS: readonly { type: LineType; label: string }[] = [
  { type: "p", label: "段落" },
  { type: "h1", label: "標題 1" },
  { type: "h2", label: "標題 2" },
  { type: "h3", label: "標題 3" },
];

export function Editor({ card, save, allowMention = true, plainPaste = false, pasteTransform = transformPasteContent, compact = false, initialSmartPaste, onClearInitialSmartPaste, initialFind, onClearInitialFind, onSaved, onReload, onLinkAdded, onOpenCard, onDirtyChange, onReturnToBoard, report }: Props) {
  const [title, setTitle] = useState(card.title);
  const [body, setBody] = useState(() => normalizeNewlines(card.body));
  const [cursorPos, setCursorPos] = useState(0);
  const [previewing, setPreviewing] = useState(false);
  const [status, setStatus] = useState<Status>("saved");
  const [errorMsg, setErrorMsg] = useState("");
  const [uploading, setUploading] = useState(0);
  const [warnings, setWarnings] = useState(card.warnings);
  const [mentionState, setMentionState] = useState<{
    replaceFrom: number;
    replaceTo: number;
    initialQuery: string;
  } | null>(null);

  const scrollContainerRef = useRef<HTMLDivElement>(null);
  const [showScrollBottom, setShowScrollBottom] = useState(false);
  const [outlineOpen, setOutlineOpen] = useState(false);
  const [scrollbarDots, setScrollbarDots] = useState<{ id: string; topPercent: number; title: string; level: number }[]>([]);
  const [lineMenu, setLineMenu] = useState<{ segStart: number; lineTop: number; lineBottom: number } | null>(null);

  // 非 compact 時內文底部留出 35vh 空白：否則捲到底後，游標也無法被抬到視線中段
  const bottomPadVh = compact ? 0 : 35;

  const checkScrollBottom = useCallback(() => {
    const el = scrollContainerRef.current;
    if (!el) return;
    const diff = el.scrollHeight - el.scrollTop - el.clientHeight - (bottomPadVh * window.innerHeight) / 100;
    setShowScrollBottom(diff > 80);
  }, [bottomPadVh]);

  // @depends-on ./LiveSegmentEditor.tsx（CodeMirror 的 contenteditable；以瀏覽器 Selection 取得游標位置，不依賴 SegmentHandle）
  // 只在「打字造成的變動」呼叫：游標掉到捲動區 55% 以下時拉回 40% 高度；只往下捲，不把游標往上推
  const keepCaretComfortable = useCallback(() => {
    const box = scrollContainerRef.current;
    const sel = window.getSelection();
    if (!box || !sel || sel.rangeCount === 0 || !sel.isCollapsed) return;
    const range = sel.getRangeAt(0);
    if (!box.contains(range.startContainer)) return;
    const rects = range.getClientRects();
    const host =
      range.startContainer instanceof Element ? range.startContainer : range.startContainer.parentElement;
    const rect = rects.length > 0 ? rects[0] : host?.getBoundingClientRect();
    // 拿不到可信座標（全 0 或高度異常大＝量到整個容器）就不動，不猜
    if (!rect || (rect.top === 0 && rect.height === 0) || rect.height > 80) return;
    const b = box.getBoundingClientRect();
    const caretY = rect.top + rect.height / 2 - b.top;
    if (caretY > b.height * 0.55) {
      box.scrollTop += caretY - b.height * 0.4;
    }
  }, []);

  const scrollToBottom = useCallback(() => {
    const el = scrollContainerRef.current;
    if (!el) return;
    el.scrollTo({ top: el.scrollHeight, behavior: "smooth" });
  }, []);

  const updateScrollbarDots = useCallback(() => {
    const box = scrollContainerRef.current;
    if (!box) return;
    const totalHeight = box.scrollHeight;
    if (totalHeight <= 0) return;

    const headingEls = box.querySelectorAll<HTMLElement>("h1, h2, h3, h4, h5, h6, summary, .md-details-summary");
    const dots: { id: string; topPercent: number; title: string; level: number }[] = [];

    headingEls.forEach((el, idx) => {
      if (el.offsetParent === null && el.offsetHeight === 0) return;
      const topPercent = Math.min(98, Math.max(2, (el.offsetTop / totalHeight) * 100));
      const text = (el.textContent || "").trim().slice(0, 40);
      const tagName = el.tagName.toLowerCase();
      const level = tagName.startsWith("h") ? parseInt(tagName[1], 10) : 2;

      dots.push({
        id: `dot-${idx}-${el.offsetTop}`,
        topPercent,
        title: text || `標題 #${idx + 1}`,
        level,
      });
    });

    setScrollbarDots(dots);
  }, []);

  useEffect(() => {
    checkScrollBottom();
    const t = setTimeout(updateScrollbarDots, 120);
    return () => clearTimeout(t);
  }, [body, previewing, checkScrollBottom, updateScrollbarDots]);

  useEffect(() => {
    if (!lineMenu) return;
    const onDown = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest(".floating-line-toolbar") || target?.closest(".line-gutter-btn")) return;
      setLineMenu(null);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") setLineMenu(null);
    };
    window.addEventListener("mousedown", onDown);
    window.addEventListener("keydown", onKey);
    return () => {
      window.removeEventListener("mousedown", onDown);
      window.removeEventListener("keydown", onKey);
    };
  }, [lineMenu]);

  const versionRef = useRef(card.updated_at);
  const latest = useRef({ title: card.title, body: normalizeNewlines(card.body) });
  const savingRef = useRef(false);
  const pendingRef = useRef(false);
  const textRef = useRef<SegmentHandle | null>(null);
  const statusRef = useRef<Status>("saved");
  statusRef.current = status;

  const markDirty = () => setStatus((s) => (s === "conflict" ? s : "dirty"));

  const saveRef = useRef<(() => Promise<void>) | undefined>(undefined);
  saveRef.current = async () => {
    if (savingRef.current) {
      pendingRef.current = true;
      return;
    }
    savingRef.current = true;
    setStatus("saving");
    const snap = { ...latest.current };
    try {
      const updated = save ? await save(snap, versionRef.current) : await api.patchCard(card.id, snap, versionRef.current);
      versionRef.current = updated.updated_at;
      setWarnings(updated.warnings);
      onSaved(updated);
      const unchanged = latest.current.title === snap.title && latest.current.body === snap.body;
      setStatus(unchanged ? "saved" : "dirty");
    } catch (e) {
      if (e instanceof ApiError && e.code === "STALE_VERSION") setStatus("conflict");
      else {
        setStatus("error");
        setErrorMsg(messageOf(e));
      }
      pendingRef.current = false;
    } finally {
      savingRef.current = false;
      if (pendingRef.current) {
        pendingRef.current = false;
        void saveRef.current?.();
      }
    }
  };

  useEffect(() => {
    if (status !== "dirty" || uploading > 0) return;
    const t = setTimeout(() => void saveRef.current?.(), 1000);
    return () => clearTimeout(t);
  }, [title, body, status, uploading]);

  // 元件卸載（例如在白板結束內嵌編輯或切換卡片）時，若仍有未儲存變更則立即沖刷存檔
  useEffect(() => {
    return () => {
      if (statusRef.current === "dirty" && !savingRef.current) {
        void saveRef.current?.();
      }
    };
  }, []);

  // 讓外層（檔案連動列）知道目前畫面上的內文是否已存進資料庫
  useEffect(() => {
    onDirtyChange?.(status !== "saved" || uploading > 0);
  }, [status, uploading, onDirtyChange]);

  useEffect(() => {
    const unsafe = status !== "saved" || uploading > 0;
    if (!unsafe) return;
    const h = (e: BeforeUnloadEvent) => {
      e.preventDefault();
      e.returnValue = "";
    };
    window.addEventListener("beforeunload", h);
    return () => window.removeEventListener("beforeunload", h);
  }, [status, uploading]);

  const onTitle = (v: string) => {
    latest.current.title = v;
    setTitle(v);
    markDirty();
  };
  const onBody = (v: string) => {
    latest.current.body = v;
    setBody(v);
    markDirty();
  };

  const segRefs = useRef<Map<number, SegmentHandle>>(new Map());

  const getGlobalSelection = (): { start: number; end: number } => {
    // 目前段落若已被移除（例如刪掉圖片後前後段落合併），退回第一段，不讀已銷毀的 view
    let h = textRef.current;
    if (!h || !h.alive) h = segRefs.current.get(0) ?? null;
    if (!h) return { start: cursorPos, end: cursorPos };
    const sel = h.getSelection();
    return { start: h.start + sel.from, end: h.start + sel.to };
  };

  // 依「整份 body 的全域位置」找到對應段落並放置選取
  const placeSelection = useCallback((text: string, from: number, to: number) => {
    for (const s of splitBodySegments(text)) {
      // 一般文字段與收摺章節的內文都是可編輯區間；圖片不是
      const segStart = s.kind === "text" ? s.start : s.kind === "details" ? s.contentStart : -1;
      const segEnd = s.kind === "text" ? s.end : s.kind === "details" ? s.contentEnd : -1;
      if (segStart >= 0 && from >= segStart && from <= segEnd) {
        const h = segRefs.current.get(segStart);
        if (h) {
          textRef.current = h;
          const localStart = Math.max(0, from - segStart);
          const localEnd = Math.max(localStart, Math.min(segEnd - segStart, to - segStart));
          h.focus();
          h.setSelection(localStart, localEnd);
        }
        return;
      }
    }
  }, []);

  const applyEditPatch = useCallback(
    (patch: EditPatch) => {
      onBody(patch.text);
      setCursorPos(patch.selectionStart);
      // 新內容要等 React 提交後才由 LiveSegmentEditor 同步進 view，所以選取等下一個 frame 再放
      requestAnimationFrame(() => placeSelection(patch.text, patch.selectionStart, patch.selectionEnd));
    },
    [placeSelection],
  );

  // ---- 全文尋找：在整份 body 裡找，所以 CodeMirror 沒渲染到的行也找得到；標示只改外觀，不改文件 ----
  const [findOpen, setFindOpen] = useState(false);
  const [findQuery, setFindQuery] = useState("");
  const [findIdx, setFindIdx] = useState(0);
  const findInputRef = useRef<HTMLInputElement>(null);
  const findMatches = useMemo(() => (findOpen ? findInBody(body, findQuery) : []), [findOpen, body, findQuery]);
  const findCur = findMatches.length ? Math.min(findIdx, findMatches.length - 1) : -1;

  // 只捲動，不選取、不搶焦點：輸入框裡連按 Enter 才能連續找下一個，也不會有任何字被誤蓋掉
  const revealAt = useCallback((globalPos: number) => {
    for (const s of splitBodySegments(latest.current.body)) {
      if (s.kind === "text" && globalPos >= s.start && globalPos <= s.end) {
        segRefs.current.get(s.start)?.reveal(globalPos - s.start);
        return;
      }
    }
  }, []);

  const openFind = () => {
    const { start, end } = getGlobalSelection();
    const picked = latest.current.body.slice(start, end);
    if (picked && picked.length <= 200 && !picked.includes("\n")) {
      const hits = findInBody(latest.current.body, picked);
      const first = Math.max(0, hits.findIndex((h) => h >= start));
      setFindQuery(picked);
      setFindIdx(first);
      if (hits.length) requestAnimationFrame(() => revealAt(hits[first]));
    }
    setFindOpen(true);
    requestAnimationFrame(() => {
      findInputRef.current?.focus();
      findInputRef.current?.select();
    });
  };

  const changeFindQuery = (v: string) => {
    setFindQuery(v);
    setFindIdx(0);
    const hits = findInBody(latest.current.body, v);
    if (hits.length) revealAt(hits[0]);
  };

  const stepFind = (dir: 1 | -1) => {
    if (findMatches.length === 0) return;
    const next = (findCur + dir + findMatches.length) % findMatches.length;
    setFindIdx(next);
    revealAt(findMatches[next]);
  };

  const closeFind = () => {
    setFindOpen(false);
    textRef.current?.focus();
  };

  useEffect(() => {
    if (!initialFind) return;
    setFindQuery(initialFind);
    setFindIdx(0);
    setFindOpen(true);
    const hits = findInBody(latest.current.body, initialFind);
    if (hits.length) requestAnimationFrame(() => revealAt(hits[0]));
    onClearInitialFind?.();
  }, [initialFind]);

  // 預覽模式整篇都在 DOM 裡，瀏覽器原生 Ctrl+F 就搜得到，所以不攔截
  const onEditorKeyDown = (e: React.KeyboardEvent) => {
    if (previewing || e.nativeEvent.isComposing) return;
    if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && e.key.toLowerCase() === "f") {
      e.preventDefault();
      if (e.target === findInputRef.current) findInputRef.current?.select();
      else openFind();
    }
  };

  const [bulletStyle, setBulletStyle] = useState<BulletStyle>("dash");
  const [orderedStyle, setOrderedStyle] = useState<OrderedStyle>("decimal");
  const [highlightColor, setHighlightColor] = useState<HighlightColor>("amber");

  const handleToolbarLineType = (
    targetType: LineType,
    styleOpts?: { bulletStyle?: BulletStyle; orderedStyle?: OrderedStyle },
  ) => {
    const { start: selStart, end: selEnd } = getGlobalSelection();
    const patch = applyLineType(latest.current.body, selStart, selEnd, targetType, styleOpts);
    applyEditPatch(patch);
  };

  const handleToolbarInlineWrap = (marker: "**" | "++", placeholder: string) => {
    const { start: selStart, end: selEnd } = getGlobalSelection();
    const patch = applyInlineWrap(latest.current.body, selStart, selEnd, marker, placeholder);
    applyEditPatch(patch);
  };

  const handleToolbarHighlight = (color: HighlightColor | null) => {
    const { start: selStart, end: selEnd } = getGlobalSelection();
    if (color) setHighlightColor(color);
    const patch = applyHighlight(latest.current.body, selStart, selEnd, color);
    if (patch) applyEditPatch(patch);
  };

  const handleToolbarIndent = (direction: 1 | -1) => {
    const { start: selStart, end: selEnd } = getGlobalSelection();
    const patch = indentListLines(latest.current.body, selStart, selEnd, direction);
    if (patch) applyEditPatch(patch);
  };

  const handleToolbarFoldSection = () => {
    const { start: selStart, end: selEnd } = getGlobalSelection();
    const cur = latest.current.body;
    const selected = cur.slice(selStart, selEnd).trim();

    let summary = "章節標題";
    let content = selected;

    if (selected) {
      const lines = selected.split("\n");
      const firstLine = lines[0].trim();
      const cleanFirst = firstLine.replace(/^#{1,6}\s+/, "").replace(/^[*-]\s+/, "").trim();
      if (cleanFirst) {
        const headingMatch = firstLine.match(/^(#{1,6})/);
        summary = headingMatch ? `${headingMatch[1]} ${cleanFirst}` : cleanFirst;
        content = lines.slice(1).join("\n").trim();
      }
    }

    const prefix = selStart > 0 && cur[selStart - 1] !== "\n" ? "\n\n" : "";
    const suffix = selEnd < cur.length && cur[selEnd] !== "\n" ? "\n\n" : "\n";
    const block = `${prefix}<details open>\n<summary>${summary}</summary>\n\n${content || "在此輸入段落內容…"}\n</details>${suffix}`;

    const nextBody = cur.slice(0, selStart) + block + cur.slice(selEnd);
    const newCursor = selStart + block.length;

    applyEditPatch({
      text: nextBody,
      selectionStart: newCursor,
      selectionEnd: newCursor,
      replaceFrom: selStart,
      replaceTo: selEnd,
      insertText: block,
    });
  };

  const openMentionFromToolbar = () => {
    const { start, end } = getGlobalSelection();
    setMentionState({ replaceFrom: start, replaceTo: end, initialQuery: "" });
  };

  const handleSelectMention = async (target: { id: string; title: string }) => {
    if (!mentionState) return;
    try {
      const link = await api.putLink(card.id, target.id, {
        relation_type: "延伸",
        status: "confirmed",
        reason: "",
      });
      const refMarkdown = formatCardRef(target.id, target.title);
      const curBody = latest.current.body;
      const from = Math.max(0, Math.min(curBody.length, mentionState.replaceFrom));
      const to = Math.max(from, Math.min(curBody.length, mentionState.replaceTo));
      const nextText = curBody.slice(0, from) + refMarkdown + curBody.slice(to);
      const nextCursor = from + refMarkdown.length;

      setMentionState(null);
      applyEditPatch({
        text: nextText,
        selectionStart: nextCursor,
        selectionEnd: nextCursor,
        replaceFrom: from,
        replaceTo: to,
        insertText: refMarkdown,
      });
      onLinkAdded?.(card.id, target.id, link);
    } catch (e) {
      report(e, "建立引用連結失敗");
    }
  };

  const uploadFiles = async (files: File[], at: number) => {
    setUploading((n) => n + files.length);
    let cursor = at;
    for (const f of files) {
      try {
        const info = await api.uploadMedia(f);
        const r = insertAtCursor(latest.current.body, cursor, cursor, mediaRef(info.id) + "\n");
        cursor = r.cursor;
        onBody(r.text);
        requestAnimationFrame(() => placeSelection(r.text, r.cursor, r.cursor));
      } catch (e) {
        report(e, `上傳「${f.name}」失敗，未插入任何內容`);
      } finally {
        setUploading((n) => n - 1);
      }
    }
  };

  const takeFiles = (list: FileList | null | undefined): File[] => {
    const all = Array.from(list ?? []);
    if (!all.length) return [];
    const ok = all.filter((f) => isAcceptedMime(f.type));
    if (ok.length < all.length) {
      report(new Error("支援 PNG／JPEG／WebP／GIF 圖片與 MP4／WebM 影片"), "已略過不支援的檔案");
    }
    return ok;
  };

  const copyMine = useCallback(async () => {
    try {
      await navigator.clipboard.writeText(`${latest.current.title}\n\n${latest.current.body}`);
    } catch (e) {
      report(e, "複製失敗");
    }
  }, [report]);

  const [codePatchOpen, setCodePatchOpen] = useState(() => Boolean(initialSmartPaste));

  useEffect(() => {
    if (initialSmartPaste) {
      setCodePatchOpen(true);
    }
  }, [initialSmartPaste]);

  // 取代成功且卡片綁定了本機檔案時詢問是否寫檔；null＝不顯示
  const [filePrompt, setFilePrompt] = useState<{ writing: boolean; result: string | null } | null>(null);

  // 原因：取代後內文是 dirty，要等 1 秒自動存檔計時才會 saved，這段時間寫檔按鈕是 disabled，
  // 使用者按下去會被吞掉。彈窗開著時改成立刻存檔；saveRef 內已有 savingRef 防重入，不會重複存。
  useEffect(() => {
    if (filePrompt && status === "dirty" && uploading === 0) void saveRef.current?.();
  }, [filePrompt, status, uploading]);

  const writeBoundFile = async (force = false): Promise<void> => {
    setFilePrompt({ writing: true, result: null });
    try {
      // 後端寫的是資料庫裡的內文；按鈕只在 status 為 saved 時可按，此時 versionRef 就是資料庫版本
      const res = await api.writeCardFile(card.id, { expected_updated_at: versionRef.current, force });
      setFilePrompt({
        writing: false,
        result: `✓ ${res.message}${res.has_backup ? "（已於 cardboard_backups 保留備份）" : ""}`,
      });
    } catch (e) {
      if (e instanceof ApiError && e.code === "FILE_CONFLICT") {
        if (window.confirm(`⚠️ ${e.message}\n\n是否仍要強制覆寫？`)) {
          await writeBoundFile(true);
          return;
        }
        setFilePrompt({ writing: false, result: null });
        return;
      }
      setFilePrompt({ writing: false, result: null });
      report(e, "寫入檔案失敗");
    }
  };

  const insertCodeBlock = () => {
    const label = window.prompt("輸入代碼塊名稱或檔名（例如 Board.tsx，可留空）", "");
    if (label === null) return;
    const cleanLabel = label.trim().replace(/\s+/g, "_");
    const extIdx = cleanLabel.lastIndexOf(".");
    const ext = extIdx >= 0 ? cleanLabel.slice(extIdx + 1).toLowerCase() : "tsx";
    const lang = ext || "tsx";
    const header = cleanLabel ? "```" + lang + ":" + cleanLabel : "```" + lang;

    const cur = latest.current.body;
    const { start: from, end: to } = getGlobalSelection();
    const selectedText = cur.slice(from, to);
    const prefixNewline = from > 0 && cur[from - 1] !== "\n" ? "\n\n" : "";
    const insertText = prefixNewline + header + "\n" + selectedText + "\n```\n";
    const nextText = cur.slice(0, from) + insertText + cur.slice(to);
    const cursorInside = from + prefixNewline.length + header.length + 1 + selectedText.length;

    applyEditPatch({
      text: nextText,
      selectionStart: cursorInside,
      selectionEnd: cursorInside,
      replaceFrom: from,
      replaceTo: to,
      insertText,
    });
  };

  const insertTable = (cols: number, rows: number) => {
    const cur = latest.current.body;
    const { start: from, end: to } = getGlobalSelection();
    const tableMarkdown = createMarkdownTable(cols, rows);
    const prefixNewline = from > 0 && cur[from - 1] !== "\n" ? "\n\n" : "";
    const suffixNewline = to < cur.length && cur[to] !== "\n" ? "\n\n" : "\n";
    const insertText = prefixNewline + tableMarkdown + suffixNewline;
    const nextText = cur.slice(0, from) + insertText + cur.slice(to);
    const cursorInside = from + prefixNewline.length + tableMarkdown.length;
    applyEditPatch({
      text: nextText,
      selectionStart: cursorInside,
      selectionEnd: cursorInside,
      replaceFrom: from,
      replaceTo: to,
      insertText,
    });
  };

  const handleTableAction = (action: "addRow" | "deleteRow" | "addCol" | "deleteCol" | "deleteTable") => {
    const cur = latest.current.body;
    const { start: selStart } = getGlobalSelection();
    const info = detectTableAtCursor(cur, selStart);
    if (!info) return;
    const patch = modifyMarkdownTable(cur, info, action);
    if (patch) {
      applyEditPatch(patch);
    }
  };

  const currentLineType = detectLineType(body, cursorPos);
  const currentListStyle = detectListStyleAtCursor(body, cursorPos);
  const activeBulletStyle = currentListStyle.bulletStyle ?? bulletStyle;
  const activeOrderedStyle = currentListStyle.orderedStyle ?? orderedStyle;

  const missingMediaCount = warnings
    .filter((w) => w.code === "MISSING_MEDIA")
    .reduce((n, w) => n + w.ids.length, 0);
  const missingCardCount = warnings
    .filter((w) => w.code === "MISSING_CARD")
    .reduce((n, w) => n + w.ids.length, 0);

  const [openMenu, setOpenMenu] = useState<"bullet" | "ordered" | null>(null);
  const [tablePickerOpen, setTablePickerOpen] = useState(false);

  // 反白圖標列：位置由 LiveSegmentEditor 回報；停頓 150ms 才顯示（拖曳選取時不閃爍），收合或失焦立即隱藏
  const [selBubble, setSelBubble] = useState<{ segStart: number; left: number; top: number } | null>(null);
  const selTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const selPendingSegRef = useRef<number | null>(null);

  // 反白圖標列的實際位置：要等它渲染後量到真實寬高才算得出來（假設固定寬度會讓左側被裁掉）
  const bubbleRef = useRef<HTMLDivElement>(null);
  const [bubblePos, setBubblePos] = useState<{ left: number; top: number } | null>(null);
  useLayoutEffect(() => {
    const el = bubbleRef.current;
    const parent = el?.offsetParent;
    if (!selBubble || !el || !(parent instanceof HTMLElement)) {
      setBubblePos(null);
      return;
    }
    const boxW = scrollContainerRef.current?.clientWidth ?? parent.clientWidth;
    const left = Math.max(8, Math.min(selBubble.left - el.offsetWidth / 2, boxW - el.offsetWidth - 8));
    // 預設放在反白範圍下方（沿用回報的位置）；上方放得下就改放上方，不蓋住往下延伸選取的文字
    let top = selBubble.top + 6;
    const sel = window.getSelection();
    const first = sel && sel.rangeCount > 0 && !sel.isCollapsed ? sel.getRangeAt(0).getClientRects()[0] : undefined;
    const box = scrollContainerRef.current?.getBoundingClientRect();
    if (first && first.height > 0 && box && first.top - box.top >= el.offsetHeight + 12) {
      top = first.top - parent.getBoundingClientRect().top - parent.clientTop - el.offsetHeight - 6;
    }
    setBubblePos({ left, top });
  }, [selBubble, lineMenu]);

  const reportSelectionRect = useCallback((segStart: number, rect: { left: number; bottom: number } | null) => {
    if (!rect) {
      // 只清掉「自己段落」的待顯示與已顯示；別的段落剛接手時，舊段落的失焦回報不能蓋掉它
      if (selPendingSegRef.current === segStart && selTimerRef.current) {
        clearTimeout(selTimerRef.current);
        selTimerRef.current = null;
        selPendingSegRef.current = null;
      }
      setSelBubble((cur) => (cur && cur.segStart === segStart ? null : cur));
      return;
    }
    if (selTimerRef.current) clearTimeout(selTimerRef.current);
    selPendingSegRef.current = segStart;
    selTimerRef.current = setTimeout(() => {
      selTimerRef.current = null;
      selPendingSegRef.current = null;
      setSelBubble({ segStart, left: rect.left, top: rect.bottom });
    }, 150);
  }, []);

  useEffect(
    () => () => {
      if (selTimerRef.current) clearTimeout(selTimerRef.current);
    },
    [],
  );

  // 切換預覽會銷毀所有 view（不會回報 null），回到編輯時不可殘留舊位置
  useEffect(() => {
    setSelBubble(null);
  }, [previewing]);

  const bubbleBtnStyle: React.CSSProperties = {
    width: 26,
    height: 26,
    padding: 0,
    display: "inline-flex",
    alignItems: "center",
    justifyContent: "center",
    fontSize: 14,
  };

  // 浮動工具列開關時，子選單一律回到收合
  useEffect(() => {
    setOpenMenu(null);
  }, [lineMenu]);

  // 點到分割按鈕以外的地方就收起子選單（工具列本身的關閉邏輯仍由 lineMenu 的 effect 負責）
  useEffect(() => {
    if (!openMenu) return;
    const onDown = (e: MouseEvent) => {
      if (!(e.target as HTMLElement | null)?.closest("[data-split]")) setOpenMenu(null);
    };
    window.addEventListener("mousedown", onDown);
    return () => window.removeEventListener("mousedown", onDown);
  }, [openMenu]);

  useEffect(() => {
    if (!tablePickerOpen) return;
    const onDown = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest("[data-table-picker]") && !target?.closest("[data-table-btn]")) {
        setTablePickerOpen(false);
      }
    };
    window.addEventListener("mousedown", onDown);
    return () => window.removeEventListener("mousedown", onDown);
  }, [tablePickerOpen]);

  const activeBulletMeta = BULLET_STYLE_OPTIONS.find((o) => o.style === activeBulletStyle);
  const activeOrderedMeta = ORDERED_STYLE_OPTIONS.find((o) => o.style === activeOrderedStyle);


  // 反白圖標列一消失就收起子選單，下次出現不會殘留展開狀態
  useEffect(() => {
    if (!selBubble) setOpenMenu(null);
  }, [selBubble]);

  // 行首 `::` 面板與反白圖標列共用：改這一份，兩邊同步
  const renderListSplits = () => (
    <>
      <SplitMenuButton
        open={openMenu === "bullet"}
        onToggle={() => setOpenMenu((m) => (m === "bullet" ? null : "bullet"))}
        main={<BulletListIcon />}
        mainTitle={`套用或取消項目符號（目前：${activeBulletMeta?.label ?? ""}）`}
        mainActive={currentLineType === "ul"}
        menuLabel="選擇項目符號樣式"
        onMain={() => handleToolbarLineType("ul", { bulletStyle: activeBulletStyle })}
      >
        {BULLET_STYLE_OPTIONS.map((o, i) => (
          <button
            key={o.style}
            type="button"
            role="menuitemradio"
            aria-checked={activeBulletStyle === o.style}
            aria-label={o.label}
            title={o.label}
            className={activeBulletStyle === o.style ? "on" : ""}
            style={{ minWidth: 28 }}
            onClick={() => {
              setBulletStyle(o.style);
              setOpenMenu(null);
              handleToolbarLineType("ul", { bulletStyle: o.style });
            }}
          >
            {styleGlyph(BULLET_GLYPHS, BULLET_STYLE_OPTIONS.length, i, o.label)}
          </button>
        ))}
      </SplitMenuButton>

      <SplitMenuButton
        open={openMenu === "ordered"}
        onToggle={() => setOpenMenu((m) => (m === "ordered" ? null : "ordered"))}
        main={<NumberedListIcon />}
        mainTitle={`套用或取消編號清單（目前：${activeOrderedMeta?.label ?? ""}）`}
        mainActive={currentLineType === "ol"}
        menuLabel="選擇編號清單樣式"
        onMain={() => handleToolbarLineType("ol", { orderedStyle: activeOrderedStyle })}
      >
        {ORDERED_STYLE_OPTIONS.map((o, i) => (
          <button
            key={o.style}
            type="button"
            role="menuitemradio"
            aria-checked={activeOrderedStyle === o.style}
            aria-label={o.label}
            title={o.label}
            className={activeOrderedStyle === o.style ? "on" : ""}
            style={{ minWidth: 28 }}
            onClick={() => {
              setOrderedStyle(o.style);
              setOpenMenu(null);
              handleToolbarLineType("ol", { orderedStyle: o.style });
            }}
          >
            {styleGlyph(ORDERED_GLYPHS, ORDERED_STYLE_OPTIONS.length, i, o.label)}
          </button>
        ))}
      </SplitMenuButton>
    </>
  );

  // 螢光筆色點＋移除；沒有反白時整排變灰不能點，不假裝成功
  const renderHighlightDots = (enabled: boolean) => (
    <>
      {HIGHLIGHT_COLOR_OPTIONS.map((c) => (
        <button
          key={c.color}
          type="button"
          disabled={!enabled}
          aria-label={`螢光筆：${c.label}`}
          title={enabled ? `螢光筆：${c.label}` : "先反白要上色的文字"}
          onClick={() => handleToolbarHighlight(c.color)}
          style={{
            width: 20,
            height: 20,
            padding: 0,
            borderRadius: "50%",
            background: c.dotColor,
            border: highlightColor === c.color ? "2px solid var(--text)" : "1px solid var(--line)",
            cursor: enabled ? "pointer" : "not-allowed",
            opacity: enabled ? 1 : 0.35,
          }}
        />
      ))}
      <button
        type="button"
        disabled={!enabled}
        aria-label="移除螢光筆"
        title={enabled ? "移除螢光筆" : "先反白要上色的文字"}
        style={{ ...bubbleBtnStyle, opacity: enabled ? 1 : 0.35 }}
        onClick={() => handleToolbarHighlight(null)}
      >
        ⊘
      </button>
    </>
  );

  const lineMenuHasSelection =
    lineMenu !== null &&
    (() => {
      const s = getGlobalSelection();
      return s.end > s.start;
    })();

  const renderFormatControls = () => (
    <>
      <span role="group" aria-label="段落格式" style={{ display: "inline-flex", gap: 2 }}>
        {LINE_TYPE_BUTTONS.map((btn) => (
          <button
            key={btn.type}
            type="button"
            className={currentLineType === btn.type ? "on" : ""}
            aria-pressed={currentLineType === btn.type}
            onClick={() => handleToolbarLineType(btn.type)}
          >
            {btn.label}
          </button>
        ))}
      </span>

      <span role="group" aria-label="清單" style={{ display: "inline-flex", alignItems: "center", gap: 4 }}>
        {renderListSplits()}

        <button
          type="button"
          aria-label="增加縮排"
          title="增加縮排（Tab）"
          onClick={() => handleToolbarIndent(1)}
          disabled={currentLineType !== "ul" && currentLineType !== "ol"}
        >
          ⇥
        </button>
        <button
          type="button"
          aria-label="減少縮排"
          title="減少縮排（Shift+Tab）"
          onClick={() => handleToolbarIndent(-1)}
          disabled={currentLineType !== "ul" && currentLineType !== "ol"}
        >
          ⇤
        </button>
      </span>

      <span role="group" aria-label="螢光筆顏色" style={{ display: "inline-flex", alignItems: "center", gap: 4 }}>
        {renderHighlightDots(lineMenuHasSelection)}
      </span>

      <span role="group" aria-label="插入" style={{ display: "inline-flex", alignItems: "center", gap: 4 }}>
        {allowMention && (
          <button type="button" onClick={openMentionFromToolbar}>
            @ 引用
          </button>
        )}
        <button
          type="button"
          onClick={insertCodeBlock}
          title="在卡片中插入可命名的代碼區塊"
          style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
        >
          <CodePlusStrokeIcon size={13} />
          代碼塊
        </button>
        <span style={{ position: "relative", display: "inline-flex" }}>
          <button
            type="button"
            data-table-btn
            className={detectTableAtCursor(latest.current.body, cursorPos) ? "on" : ""}
            onClick={() => setTablePickerOpen((o) => !o)}
            title="建立或管理表格（Word 式選取欄列）"
            style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
          >
            <TableStrokeIcon size={13} />
            表格 ▾
          </button>
          <TableGridPicker
            open={tablePickerOpen}
            onClose={() => setTablePickerOpen(false)}
            onInsert={insertTable}
            inTable={Boolean(detectTableAtCursor(latest.current.body, cursorPos))}
            onAction={handleTableAction}
          />
        </span>
        {detectTableAtCursor(latest.current.body, cursorPos) && (
          <span role="group" aria-label="表格快捷" style={{ display: "inline-flex", alignItems: "center", gap: 2 }}>
            <button
              type="button"
              style={{ fontSize: 11, padding: "2px 6px" }}
              onClick={() => handleTableAction("addRow")}
              title="在下方增加一列"
            >
              ＋列
            </button>
            <button
              type="button"
              style={{ fontSize: 11, padding: "2px 6px" }}
              onClick={() => handleTableAction("deleteRow")}
              title="刪除游標所在列"
            >
              ➖列
            </button>
            <button
              type="button"
              style={{ fontSize: 11, padding: "2px 6px" }}
              onClick={() => handleTableAction("addCol")}
              title="在右側增加一欄"
            >
              ＋欄
            </button>
            <button
              type="button"
              style={{ fontSize: 11, padding: "2px 6px" }}
              onClick={() => handleTableAction("deleteCol")}
              title="刪除游標所在欄"
            >
              ➖欄
            </button>
          </span>
        )}
        <button
          type="button"
          onClick={handleToolbarFoldSection}
          title="將選取內容設定為可收摺章節"
          style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
        >
          <FolderStrokeIcon size={13} />
          收摺章節
        </button>
        <button
          type="button"
          onClick={() => setCodePatchOpen(true)}
          title="對卡片內的代碼塊或外部代碼執行精確定位與自動取代"
          style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
        >
          <CrosshairStrokeIcon size={13} />
          定位取代
        </button>
      </span>
    </>
  );

  // 切換收摺／展開：只改開標籤，用實際的 ">" 位置界定，不假設標籤寫法（大小寫、空白）
  const toggleDetailsOpen = (seg: Extract<BodySegment, { kind: "details" }>) => {
    const cur = latest.current.body;
    const tagEnd = cur.indexOf(">", seg.rawStart) + 1;
    onBody(cur.slice(0, seg.rawStart) + (seg.isOpen ? "<details>" : "<details open>") + cur.slice(tagEnd));
  };

  // 解除收摺：整個區塊還原成「標題＋空行＋內文」的一般文字
  const unwrapDetailsSeg = (seg: Extract<BodySegment, { kind: "details" }>) => {
    const cur = latest.current.body;
    const unwrapped = seg.content ? `${seg.summary}\n\n${seg.content}` : seg.summary;
    applyEditPatch({
      text: cur.slice(0, seg.rawStart) + unwrapped + cur.slice(seg.rawEnd),
      selectionStart: seg.rawStart,
      selectionEnd: seg.rawStart + unwrapped.length,
      replaceFrom: seg.rawStart,
      replaceTo: seg.rawEnd,
      insertText: unwrapped,
    });
  };

  // 大綱跳轉：用內文位移定位，不比對畫面文字（編輯模式的 CodeMirror 不會渲染 h1~h6／summary 元素）
  const jumpToOutlineItem = (item: OutlineItem) => {
    const box = scrollContainerRef.current;
    if (!box) return;
    const cur = latest.current.body;
    const lines = cur.split("\n");
    let offset = 0;
    for (let i = 0; i < item.lineIndex && i < lines.length; i++) offset += lines[i].length + 1;

    const enclosing = splitBodySegments(cur).find(
      (s): s is Extract<BodySegment, { kind: "details" }> =>
        s.kind === "details" && offset >= s.rawStart && offset < s.rawEnd,
    );
    // 收摺章節本身，或位在已收摺章節內的標題：內文沒有渲染，只能捲到章節方塊
    if (enclosing && (item.kind === "details" || !enclosing.isOpen)) {
      box
        .querySelector<HTMLElement>(`[data-details-start="${enclosing.rawStart}"]`)
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }

    placeSelection(cur, offset, offset);
    requestAnimationFrame(() => {
      const sel = window.getSelection();
      if (!sel || sel.rangeCount === 0) return;
      const range = sel.getRangeAt(0);
      const host =
        range.startContainer instanceof Element ? range.startContainer : range.startContainer.parentElement;
      const rect = range.getClientRects()[0] ?? host?.getBoundingClientRect();
      // 拿不到可信座標就不動，不猜
      if (!rect || (rect.top === 0 && rect.height === 0) || rect.height > 80) return;
      box.scrollTo({ top: box.scrollTop + rect.top - box.getBoundingClientRect().top - 24, behavior: "smooth" });
    });
  };

  // 收摺章節內文編輯器的事件；start 是該內文在整份 body 的全域起點（內容與一般文字段的處理相同）
  const detailsHandlers = (
    start: number,
  ): Pick<
    ComponentProps<typeof LiveSegmentEditor>,
    "onFocus" | "onSelectionChange" | "onSelectionRect" | "onToggleLineMenu" | "onDocChange" | "onKeyDown" | "onPaste" | "onDropFiles"
  > => ({
    onFocus: () => {
      const h = segRefs.current.get(start);
      if (h) textRef.current = h;
    },
    onSelectionChange: (from) => setCursorPos(start + from),
    onSelectionRect: (rect) => reportSelectionRect(start, rect),
    onToggleLineMenu: (rect) => {
      setLineMenu((cur) =>
        cur && cur.segStart === start && Math.abs(cur.lineTop - rect.lineTop) < 4
          ? null
          : { segStart: start, lineTop: rect.lineTop, lineBottom: rect.lineBottom },
      );
    },
    onDocChange: (val, prevLen, cursor) => {
      setLineMenu(null);
      const cur = latest.current.body;
      const prevBodyLen = cur.length;
      const nextBody = cur.slice(0, start) + val + cur.slice(start + prevLen);
      const globalPos = start + cursor;
      onBody(nextBody);
      setCursorPos(globalPos);
      requestAnimationFrame(keepCaretComfortable);
      if (allowMention && nextBody.length >= prevBodyLen && globalPos > 0 && nextBody[globalPos - 1] === "@") {
        const trig = detectAtTrigger(nextBody, globalPos);
        if (trig && trig.query === "") {
          setMentionState({ replaceFrom: trig.atIndex, replaceTo: globalPos, initialQuery: "" });
        }
      }
    },
    onKeyDown: (e, from, to) => {
      if (e.isComposing || e.keyCode === 229) return false;
      const gStart = start + from;
      const gEnd = start + to;
      if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey) {
        const k = e.key.toLowerCase();
        if (k === "b") {
          applyEditPatch(applyInlineWrap(latest.current.body, gStart, gEnd, "**", "粗體文字"));
          return true;
        }
        if (k === "u") {
          applyEditPatch(applyInlineWrap(latest.current.body, gStart, gEnd, "++", "底線文字"));
          return true;
        }
      }
      if (e.key === "Tab") {
        const patch = indentListLines(latest.current.body, gStart, gEnd, e.shiftKey ? -1 : 1);
        if (!patch) return false;
        applyEditPatch(patch);
        return true;
      }
      if (e.key === "Enter" && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
        const patch = handleListEnter(latest.current.body, gStart, gEnd);
        if (!patch) return false;
        applyEditPatch(patch);
        requestAnimationFrame(keepCaretComfortable);
        return true;
      }
      return false;
    },
    onPaste: (e, from, to) => {
      const cd = e.clipboardData;
      if (!cd) return false;
      const gFrom = start + from;
      const gTo = start + to;
      if (cd.files.length) {
        const files = takeFiles(cd.files);
        if (files.length) void uploadFiles(files, gFrom);
        return true;
      }
      if (plainPaste) return false;
      if (extractCodeBlocks(latest.current.body).some((b) => gFrom >= b.contentStart && gFrom <= b.contentEnd)) {
        return false;
      }
      const transformed = pasteTransform(cd.getData("text/plain"), cd.getData("text/html"));
      if (transformed === null) return false;
      const cur = latest.current.body;
      const nextCursor = gFrom + transformed.length;
      applyEditPatch({
        text: cur.slice(0, gFrom) + transformed + cur.slice(gTo),
        selectionStart: nextCursor,
        selectionEnd: nextCursor,
        replaceFrom: gFrom,
        replaceTo: gTo,
        insertText: transformed,
      });
      return true;
    },
    onDropFiles: (e, at) => {
      const dt = e.dataTransfer;
      if (!dt || !dt.files.length) return false;
      const files = takeFiles(dt.files);
      if (files.length) void uploadFiles(files, start + at);
      return true;
    },
  });

  return (
    <div className="editor" onKeyDown={onEditorKeyDown}>
      <div className="editor-head">
        <input
          className="title-input"
          value={title}
          placeholder="卡片標題"
          onChange={(e) => onTitle(e.target.value)}
          aria-label="卡片標題"
        />
        <span className={`status ${status}`} data-testid="save-status">
          {uploading > 0 ? `上傳中（${uploading}）…` : STATUS_TEXT[status]}
        </span>
        <button
          type="button"
          className={`preview-toggle-btn${previewing ? " on" : ""}`}
          style={{ fontSize: 11, padding: "2px 8px", marginLeft: 6, display: "inline-flex", alignItems: "center", gap: 4 }}
          onClick={() => {
            setPreviewing((p) => {
              const next = !p;
              if (next) {
                setMentionState(null);
                setLineMenu(null);
              }
              return next;
            });
          }}
        >
          {previewing ? (
            <>
              <EditStrokeIcon size={12} />
              返回編輯
            </>
          ) : (
            <>
              <EyeStrokeIcon size={12} />
              預覽
            </>
          )}
        </button>
        {!previewing && (
          <button
            type="button"
            className={findOpen ? "on" : ""}
            style={{ fontSize: 11, padding: "2px 8px", marginLeft: 6, display: "inline-flex", alignItems: "center", gap: 4 }}
            onClick={() => (findOpen ? closeFind() : openFind())}
            title="在全文中尋找（Ctrl+F）"
          >
            <SearchStrokeIcon size={12} />
            尋找
          </button>
        )}
      </div>
      {status === "conflict" && (
        <div className="banner danger" role="alert">
          這張卡片已在別處被修改，你的修改尚未儲存。
          <button onClick={onReload}>重新載入（捨棄我的修改）</button>
          <button onClick={() => void copyMine()}>複製我的內容</button>
        </div>
      )}
      {status === "error" && (
        <div className="banner danger" role="alert">
          儲存失敗：{errorMsg}（內容仍保留在這裡）
          <button onClick={() => void saveRef.current?.()}>重試</button>
        </div>
      )}
      {missingMediaCount > 0 && (
        <div className="banner warn" role="alert">
          內文引用了 {missingMediaCount} 個不存在的媒體。
        </div>
      )}
      {missingCardCount > 0 && (
        <div className="banner warn" role="alert">
          內文引用了 {missingCardCount} 張不存在的卡片。
        </div>
      )}
      {findOpen && !previewing && (
        <div
          className="find-bar"
          role="search"
          style={{
            display: "flex",
            alignItems: "center",
            gap: 6,
            padding: "4px 8px",
            margin: "4px 0",
            border: "1px solid var(--line, #334155)",
            borderRadius: 6,
            background: "var(--panel, #1e293b)",
          }}
        >
          <input
            ref={findInputRef}
            value={findQuery}
            onChange={(e) => changeFindQuery(e.target.value)}
            onKeyDown={(e) => {
              if (e.nativeEvent.isComposing || e.keyCode === 229) return;
              if (e.key === "Enter") {
                e.preventDefault();
                stepFind(e.shiftKey ? -1 : 1);
              } else if (e.key === "Escape") {
                // 只關尋找列，不讓 Esc 冒泡到 App 把整個中央編輯關掉
                e.preventDefault();
                e.stopPropagation();
                closeFind();
              }
            }}
            placeholder="在全文中尋找（Enter 下一個，Shift+Enter 上一個）"
            aria-label="在全文中尋找"
            style={{ flex: 1, minWidth: 0 }}
          />
          <span className="muted" style={{ fontSize: 12, whiteSpace: "nowrap" }} aria-live="polite">
            {!findQuery ? "" : findMatches.length === 0 ? "找不到" : `${findCur + 1} / ${findMatches.length}`}
          </span>
          <button type="button" onClick={() => stepFind(-1)} disabled={findMatches.length === 0} aria-label="上一個" title="上一個（Shift+Enter）">
            ▲
          </button>
          <button type="button" onClick={() => stepFind(1)} disabled={findMatches.length === 0} aria-label="下一個" title="下一個（Enter）">
            ▼
          </button>
          <button type="button" onClick={closeFind} aria-label="關閉尋找" title="關閉（Esc）">
            ✕
          </button>
        </div>
      )}



      {!previewing && mentionState && (
        <MentionPopup
          currentCardId={card.id}
          initialQuery={mentionState.initialQuery}
          onSelect={handleSelectMention}
          onCancel={() => {
            setMentionState(null);
            textRef.current?.focus();
          }}
          report={report}
        />
      )}

      {codePatchOpen && createPortal(
        <CodeReplaceModal
          cardBody={body}
          cursorPos={cursorPos}
          initialSmartPaste={initialSmartPaste}
          onClose={() => {
            setCodePatchOpen(false);
            onClearInitialSmartPaste?.();
          }}
          onApplyPatch={(patch) => {
            applyEditPatch(patch);
            onClearInitialSmartPaste?.();
            if (card.file_path) setFilePrompt({ writing: false, result: null });
          }}
        />,
        document.body,
      )}

      {filePrompt && (() => {
        const saveReady = status === "saved" && uploading === 0;
        const saveBroken = status === "error" || status === "conflict";
        // 彈窗掛到 document.body：脫離編輯器所在面板的層疊情境，不再被頂部視圖切換列蓋住
        return createPortal(
          <div className="modal" role="dialog" aria-label="寫入綁定檔案">
            <div className="modal-card" style={{ maxWidth: 460 }}>
              <h4 style={{ margin: 0 }}>寫入綁定檔案？</h4>
              <div style={{ margin: "8px 0", fontSize: 13 }}>
                <div>代碼已取代並更新到卡片。此卡片綁定了本機檔案：</div>
                <div style={{ fontFamily: "monospace", fontSize: 12, wordBreak: "break-all", margin: "4px 0" }}>
                  {card.file_path}
                </div>
              </div>
              {filePrompt.result ? (
                <div style={{ fontSize: 13 }}>{filePrompt.result}</div>
              ) : !saveReady ? (
                <div className="muted" style={{ fontSize: 12 }}>
                  {saveBroken
                    ? `卡片尚未存入資料庫（${STATUS_TEXT[status]}），無法寫入檔案`
                    : "等待卡片儲存完成…"}
                </div>
              ) : null}
              <div className="modal-actions" style={{ marginTop: 12 }}>
                <button type="button" onClick={() => setFilePrompt(null)} disabled={filePrompt.writing}>
                  {filePrompt.result ? "關閉" : "不寫入"}
                </button>
                {!filePrompt.result && (
                  <button
                    type="button"
                    className="primary"
                    disabled={!saveReady || filePrompt.writing}
                    onClick={() => void writeBoundFile()}
                    style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
                  >
                    {filePrompt.writing ? (
                      "寫入中…"
                    ) : (
                      <>
                        <ZapStrokeIcon size={13} />
                        寫入檔案
                      </>
                    )}
                  </button>
                )}
                {filePrompt.result && onReturnToBoard && (
                  <button
                    type="button"
                    className="primary"
                    onClick={() => {
                      setFilePrompt(null);
                      setCodePatchOpen(false);
                      onReturnToBoard();
                    }}
                  >
                    關閉並回到白板
                  </button>
                )}
              </div>
            </div>
          </div>,
          document.body,
        );
      })()}

      <div
        ref={scrollContainerRef}
        className="editor-content-scroll"
        onScroll={checkScrollBottom}
        style={{
          position: "relative",
          maxHeight: compact ? 260 : "calc(100vh - 280px)",
          minHeight: compact ? 120 : 320,
          overflowY: "auto",
          overflowX: "hidden",
        }}
      >
        {!previewing ? (
          (() => {
            const segments = splitBodySegments(body);
            return (
            <div
              className="live-editor"
              style={{
                minHeight: compact ? 120 : 320,
                paddingLeft: 26,
                paddingBottom: bottomPadVh ? `${bottomPadVh}vh` : undefined,
                cursor: "text",
                display: "flex",
                flexDirection: "column",
                position: "relative",
              }}
                onClick={(e) => {
                  if (e.target === e.currentTarget) {
                    const allTextSegs = segments.filter((s): s is Extract<BodySegment, { kind: "text" }> => s.kind === "text");
                    const lastText = allTextSegs[allTextSegs.length - 1];
                    if (lastText) {
                      const h = segRefs.current.get(lastText.start);
                      if (h) {
                        textRef.current = h;
                        h.focus();
                        h.setSelection(lastText.text.length, lastText.text.length);
                      }
                    }
                  }
                }}
                onDragOver={(e) => {
                  if (e.dataTransfer.types.includes("Files")) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = "copy";
                  }
                }}
                onDrop={(e) => {
                  const dt = e.dataTransfer;
                  if (!dt || !dt.files.length) return;
                  e.preventDefault();
                  e.stopPropagation();
                  const files = takeFiles(dt.files);
                  if (files.length) {
                    void uploadFiles(files, latest.current.body.length);
                  }
                }}
              >
                {lineMenu && (() => {
                  const isAbove = lineMenu.lineTop >= 75;
                  return (
                    <div
                      className="editor-toolbar floating-line-toolbar"
                      role="toolbar"
                      aria-label="行內浮動格式工具列"
                      style={{
                        position: "absolute",
                        left: 26,
                        width: "max-content",
                        maxWidth: "calc(100% - 36px)",
                        top: isAbove ? lineMenu.lineTop - 6 : lineMenu.lineBottom + 6,
                        transform: isAbove ? "translateY(-100%)" : undefined,
                        zIndex: 30,
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "flex-start",
                      gap: 6,
                      padding: "6px 8px",
                      background: "var(--panel, #1e293b)",
                      border: "1px solid var(--line, #475569)",
                      borderRadius: 6,
                      boxShadow: "0 4px 14px rgba(0, 0, 0, 0.28)",
                    }}
                    onMouseDown={(e) => {
                      if ((e.target as HTMLElement).tagName !== "SELECT" && (e.target as HTMLElement).tagName !== "INPUT") {
                        e.preventDefault();
                      }
                    }}
                  >
                    {renderFormatControls()}
                  </div>
                  );
                })()}

                {selBubble && !lineMenu && (
                  <div
                    ref={bubbleRef}
                    className="selection-bubble editor-toolbar"
                    role="toolbar"
                    aria-label="文字格式快捷"
                    style={{
                      position: "absolute",
                      // 量到實際寬高前先隱藏，避免先出現在錯的位置再跳過去
                      visibility: bubblePos ? "visible" : "hidden",
                      left: bubblePos?.left ?? 0,
                      top: bubblePos?.top ?? selBubble.top + 6,
                      width: "max-content",
                      maxWidth: "calc(100% - 16px)",
                      zIndex: 30,
                      display: "flex",
                      flexWrap: "wrap",
                      alignItems: "center",
                      gap: 6,
                      padding: 6,
                      background: "var(--panel, #1e293b)",
                      border: "1px solid var(--line, #475569)",
                      borderRadius: 8,
                      boxShadow: "0 4px 14px rgba(0, 0, 0, 0.28)",
                    }}
                    onMouseDown={(e) => e.preventDefault()}
                  >
                    <div style={{ display: "flex", alignItems: "center", gap: 3 }}>
                      <button
                        type="button"
                        aria-label="粗體"
                        title="粗體（Ctrl+B）"
                        style={{ ...bubbleBtnStyle, fontWeight: 700 }}
                        onClick={() => handleToolbarInlineWrap("**", "粗體文字")}
                      >
                        B
                      </button>
                      <button
                        type="button"
                        aria-label="底線"
                        title="底線（Ctrl+U）"
                        style={{ ...bubbleBtnStyle, textDecoration: "underline" }}
                        onClick={() => handleToolbarInlineWrap("++", "底線文字")}
                      >
                        U
                      </button>
                      <button
                        type="button"
                        aria-label="收摺章節"
                        title="將選取內容轉為收摺章節"
                        style={{ ...bubbleBtnStyle, fontSize: 12, width: "auto", padding: "0 6px", gap: 4 }}
                        onClick={handleToolbarFoldSection}
                      >
                        <FolderStrokeIcon size={13} />
                        收摺
                      </button>
                      <span
                        aria-hidden="true"
                        style={{ width: 1, height: 18, margin: "0 2px", background: "var(--line, #475569)" }}
                      />
                      {renderHighlightDots(true)}
                    </div>
                    <div style={{ display: "flex", alignItems: "center", gap: 4 }}>{renderListSplits()}</div>
                  </div>
                )}

                {segments.map((seg, idx) => {
                  if (seg.kind === "media") {
                    return (
                      <div
                        key={`media-${seg.mediaId}-${seg.rawStart}`}
                        style={{
                          margin: "6px 0",
                          padding: "4px 6px",
                          borderRadius: 6,
                          background: "var(--bg)",
                          border: "1px solid var(--line, #334155)",
                        }}
                      >
                        <MediaEmbed
                          id={seg.mediaId}
                          explicitWidth={seg.explicitWidth}
                          onChangeWidth={(w) => {
                            const { baseAlt } = extractWidthFromAlt(seg.alt);
                            const nextToken = `![${baseAlt}|${w}](media:${seg.mediaId})`;
                            const cur = latest.current.body;
                            onBody(cur.slice(0, seg.rawStart) + nextToken + cur.slice(seg.rawEnd));
                          }}
                          onRemove={() => {
                            const cur = latest.current.body;
                            onBody(cur.slice(0, seg.removeStart) + cur.slice(seg.removeEnd));
                          }}
                        />
                      </div>
                    );
                  }

                  if (seg.kind === "details") {
                    return (
                      <div
                        key={`details-${idx}`}
                        className="editor-details-block"
                        data-details-start={seg.rawStart}
                        style={{
                          margin: "8px 0",
                          borderRadius: 6,
                          border: "1px solid var(--line, rgba(148, 163, 184, 0.35))",
                          background: "var(--panel-sub, rgba(0, 0, 0, 0.02))",
                          overflow: "hidden",
                        }}
                      >
                        <div
                          style={{
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "space-between",
                            padding: "6px 10px",
                            background: "var(--code-head-bg, rgba(0, 0, 0, 0.04))",
                            borderBottom: seg.isOpen ? "1px solid var(--line, rgba(148, 163, 184, 0.2))" : "none",
                            userSelect: "none",
                            cursor: "pointer",
                          }}
                          onClick={() => toggleDetailsOpen(seg)}
                        >
                          <span style={{ fontWeight: 600, fontSize: 13, display: "flex", alignItems: "center", gap: 6 }}>
                            <span style={{ fontSize: 10 }}>{seg.isOpen ? "▼" : "▶"}</span>
                            <span>{seg.summary}</span>
                          </span>
                          <button
                            type="button"
                            style={{
                              display: "inline-flex",
                              alignItems: "center",
                              gap: 4,
                              fontSize: 11,
                              padding: "2px 8px",
                              color: "var(--muted)",
                              cursor: "pointer",
                            }}
                            title="解除收摺（還原為一般文字）"
                            aria-label="解除收摺"
                            onClick={(e) => {
                              e.stopPropagation();
                              unwrapDetailsSeg(seg);
                            }}
                          >
                            <svg
                              width="12"
                              height="12"
                              viewBox="0 0 16 16"
                              fill="none"
                              stroke="currentColor"
                              strokeWidth="1.5"
                              strokeLinecap="round"
                              strokeLinejoin="round"
                              aria-hidden="true"
                            >
                              <path d="M2 8h2M7 8h2M12 8h2" />
                              <polyline points="5.5 4.5 8 2 10.5 4.5" />
                              <polyline points="5.5 11.5 8 14 10.5 11.5" />
                            </svg>
                            解除
                          </button>
                        </div>
                        {seg.isOpen && (
                          <div style={{ padding: "6px 10px" }}>
                            <LiveSegmentEditor
                              ref={(h) => {
                                if (h) segRefs.current.set(seg.contentStart, h);
                                else segRefs.current.delete(seg.contentStart);
                              }}
                              value={seg.content}
                              start={seg.contentStart}
                              placeholder="章節內容…"
                              ariaLabel={`章節「${seg.summary}」內容`}
                              {...detailsHandlers(seg.contentStart)}
                            />
                          </div>
                        )}
                      </div>
                    );
                  }

                  return (
                    <LiveSegmentEditor
                      key={`text-${idx}`}
                      ref={(h) => {
                        if (h) {
                          segRefs.current.set(seg.start, h);
                          if (idx === 0 && !textRef.current) textRef.current = h;
                        } else {
                          segRefs.current.delete(seg.start);
                        }
                      }}
                      value={seg.text}
                      start={seg.start}
                      placeholder={
                        idx === 0
                          ? "內文（Markdown）。可直接貼上或拖入圖片、影片，或輸入 @ 引用其他卡片。"
                          : "繼續輸入段落內容（支援 Markdown 語法）…"
                      }
                      ariaLabel={idx === 0 ? "卡片內文" : `卡片內文段落 ${idx + 1}`}
                      find={
                        findOpen && findQuery
                          ? {
                              query: findQuery,
                              current:
                                findCur >= 0 && findMatches[findCur] >= seg.start && findMatches[findCur] < seg.end
                                  ? findMatches[findCur] - seg.start
                                  : null,
                            }
                          : undefined
                      }
                      onFocus={() => {
                        const h = segRefs.current.get(seg.start);
                        if (h) textRef.current = h;
                      }}
                      onSelectionChange={(from) => setCursorPos(seg.start + from)}
                      onSelectionRect={(rect) => reportSelectionRect(seg.start, rect)}
                      onToggleLineMenu={(rect) => {
                        setLineMenu((cur) =>
                          cur && cur.segStart === seg.start && Math.abs(cur.lineTop - rect.lineTop) < 4
                            ? null
                            : { segStart: seg.start, lineTop: rect.lineTop, lineBottom: rect.lineBottom },
                        );
                      }}
                      onDocChange={(val, prevLen, cursor) => {
                        setLineMenu(null);
                        // prevLen 是變動前的段落長度：不依賴渲染時的 seg.end，連續兩次變動也不會用到過期範圍
                        const cur = latest.current.body;
                        const prevBodyLen = cur.length;
                        const nextBody = cur.slice(0, seg.start) + val + cur.slice(seg.start + prevLen);
                        const globalPos = seg.start + cursor;
                        onBody(nextBody);
                        setCursorPos(globalPos);
                        requestAnimationFrame(keepCaretComfortable);
                        if (allowMention && nextBody.length >= prevBodyLen && globalPos > 0 && nextBody[globalPos - 1] === "@") {
                          const trig = detectAtTrigger(nextBody, globalPos);
                          if (trig && trig.query === "") {
                            setMentionState({
                              replaceFrom: trig.atIndex,
                              replaceTo: globalPos,
                              initialQuery: "",
                            });
                          }
                        }
                      }}
                      onKeyDown={(e, from, to) => {
                        if (e.isComposing || e.keyCode === 229) return false;
                        const gStart = seg.start + from;
                        const gEnd = seg.start + to;
                        if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey) {
                          const k = e.key.toLowerCase();
                          if (k === "b") {
                            applyEditPatch(applyInlineWrap(latest.current.body, gStart, gEnd, "**", "粗體文字"));
                            return true;
                          }
                          if (k === "u") {
                            applyEditPatch(applyInlineWrap(latest.current.body, gStart, gEnd, "++", "底線文字"));
                            return true;
                          }
                        }
                        if (e.key === "Tab") {
                          const patch = indentListLines(latest.current.body, gStart, gEnd, e.shiftKey ? -1 : 1);
                          if (!patch) return false;
                          applyEditPatch(patch);
                          return true;
                        }
                        if (e.key === "Enter" && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
                          const patch = handleListEnter(latest.current.body, gStart, gEnd);
                          if (!patch) return false;
                          applyEditPatch(patch);
                          requestAnimationFrame(keepCaretComfortable);
                          return true;
                        }
                        return false;
                      }}
                      onPaste={(e, from, to) => {
                        const cd = e.clipboardData;
                        if (!cd) return false;
                        const gFrom = seg.start + from;
                        const gTo = seg.start + to;
                        if (cd.files.length) {
                          const files = takeFiles(cd.files);
                          if (files.length) void uploadFiles(files, gFrom);
                          return true;
                        }
                        // 文獻：不做任何 HTML 轉換，交給編輯器原生的純文字貼上
                        if (plainPaste) return false;
                        // 游標在代碼圍欄內：一律走原生純文字貼上，不經 HTML 重建，避免代碼被改寫
                        if (extractCodeBlocks(latest.current.body).some((b) => gFrom >= b.contentStart && gFrom <= b.contentEnd)) {
                          return false;
                        }
                        const transformed = pasteTransform(cd.getData("text/plain"), cd.getData("text/html"));
                        if (transformed === null) return false;
                        const cur = latest.current.body;
                        const nextText = cur.slice(0, gFrom) + transformed + cur.slice(gTo);
                        const nextCursor = gFrom + transformed.length;
                        applyEditPatch({
                          text: nextText,
                          selectionStart: nextCursor,
                          selectionEnd: nextCursor,
                          replaceFrom: gFrom,
                          replaceTo: gTo,
                          insertText: transformed,
                        });
                        return true;
                      }}
                      onDropFiles={(e, at) => {
                        const dt = e.dataTransfer;
                        if (!dt || !dt.files.length) return false;
                        const files = takeFiles(dt.files);
                        if (files.length) void uploadFiles(files, seg.start + at);
                        return true;
                      }}
                    />
                  );
                })}
              </div>
            );
          })()
        ) : (
          <div
            className="preview"
            data-testid="editor-preview"
            style={{ minHeight: compact ? 120 : 320 }}
          >
            <Markdown source={body} onOpenCard={onOpenCard} />
          </div>
        )}

        {scrollbarDots.length > 0 && (
          <div
            className="scrollbar-dots-rail nodrag"
            aria-hidden="true"
            style={{
              position: "sticky",
              top: 10,
              float: "right",
              width: 8,
              height: "calc(100% - 80px)",
              marginRight: -6,
              zIndex: 35,
              pointerEvents: "none",
            }}
          >
            {scrollbarDots.map((dot) => (
              <div
                key={dot.id}
                title={`${"#".repeat(dot.level)} ${dot.title}`}
                onClick={(e) => {
                  e.stopPropagation();
                  const box = scrollContainerRef.current;
                  if (!box) return;
                  const targetY = (dot.topPercent / 100) * box.scrollHeight;
                  box.scrollTo({ top: Math.max(0, targetY - 24), behavior: "smooth" });
                }}
                style={{
                  position: "absolute",
                  top: `${dot.topPercent}%`,
                  right: 1,
                  width: dot.level === 1 ? 8 : dot.level === 2 ? 6 : 5,
                  height: dot.level === 1 ? 8 : dot.level === 2 ? 6 : 5,
                  borderRadius: "50%",
                  background: "var(--accent, #60a5fa)",
                  boxShadow: "0 0 3px rgba(0, 0, 0, 0.6)",
                  cursor: "pointer",
                  pointerEvents: "auto",
                  opacity: 0.85,
                  transform: "translateY(-50%)",
                }}
              />
            ))}
          </div>
        )}

        {/* 右下角的大綱面板與兩顆工具鈕收進同一個直排容器：靠容器對齊，不再各自用 bottom 數字湊位置 */}
        <div
          style={{
            position: "sticky",
            bottom: 10,
            float: "right",
            marginRight: 10,
            zIndex: 45,
            display: "flex",
            flexDirection: "column",
            alignItems: "flex-end",
            gap: 8,
          }}
        >
        {outlineOpen && (
          <div
            className="editor-outline-popover nodrag"
            role="dialog"
            aria-label="章節大綱與層級管理"
            style={{
              width: 290,
              maxHeight: 340,
              display: "flex",
              flexDirection: "column",
              background: "var(--panel, #1e293b)",
              border: "1px solid var(--line, #475569)",
              borderRadius: 8,
              boxShadow: "0 8px 24px rgba(0, 0, 0, 0.4)",
              padding: 10,
              boxSizing: "border-box",
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div
              style={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                marginBottom: 8,
                paddingBottom: 6,
                borderBottom: "1px solid var(--line, #334155)",
              }}
            >
              <span style={{ fontSize: 12, fontWeight: 600, display: "inline-flex", alignItems: "center", gap: 6 }}>
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="1.8"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  aria-hidden="true"
                >
                  <line x1="2" y1="3.5" x2="14" y2="3.5" />
                  <line x1="6" y1="8" x2="14" y2="8" />
                  <line x1="6" y1="12.5" x2="14" y2="12.5" />
                </svg>
                章節大綱與層級管理
              </span>
              <button
                type="button"
                onClick={() => setOutlineOpen(false)}
                style={{ fontSize: 11, padding: "1px 6px", cursor: "pointer" }}
              >
                ✕ 關閉
              </button>
            </div>
            <div style={{ flex: 1, overflowY: "auto", minHeight: 0, display: "flex", flexDirection: "column", gap: 4 }}>
              {(() => {
                const outline = extractOutlineItems(body);
                if (outline.length === 0) {
                  return (
                    <div className="muted" style={{ fontSize: 12, padding: "8px 4px", lineHeight: 1.5 }}>
                      目前內文無標題或收摺章節。
                      <br />
                      反白文字後點擊工具列「📁 收摺」即可建立。
                    </div>
                  );
                }
                return outline.map((item) => (
                  <div
                    key={item.id}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "3px 6px",
                      borderRadius: 4,
                      background: "rgba(255, 255, 255, 0.03)",
                      fontSize: 12,
                      paddingLeft: Math.min(60, 6 + (item.level - 1) * 14),
                    }}
                  >
                    <span
                      style={{
                        flex: 1,
                        cursor: "pointer",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                        whiteSpace: "nowrap",
                        marginRight: 6,
                        color: item.level === 1 ? "var(--text)" : "var(--muted, #94a3b8)",
                        fontWeight: item.level <= 2 ? 600 : 400,
                      }}
                      title="點擊跳轉至此標題"
                      onClick={() => jumpToOutlineItem(item)}
                    >
                      {item.kind === "details" ? "▸ " : "• "}
                      {item.title}
                    </span>
                    <span style={{ display: "inline-flex", alignItems: "center", gap: 2, flexShrink: 0 }}>
                      <span className="muted" style={{ fontSize: 10, marginRight: 2 }}>
                        H{item.level}
                      </span>
                      <button
                        type="button"
                        style={{ fontSize: 10, padding: "1px 4px", cursor: "pointer" }}
                        title="提升層級（例如 H2 升為 H1）"
                        disabled={item.level <= 1}
                        onClick={() => {
                          const patch = adjustOutlineLevel(latest.current.body, item, -1);
                          if (patch) applyEditPatch(patch);
                        }}
                      >
                        ◀
                      </button>
                      <button
                        type="button"
                        style={{ fontSize: 10, padding: "1px 4px", cursor: "pointer" }}
                        title="降低層級（設為下層子標題）"
                        disabled={item.level >= 6}
                        onClick={() => {
                          const patch = adjustOutlineLevel(latest.current.body, item, 1);
                          if (patch) applyEditPatch(patch);
                        }}
                      >
                        ▶
                      </button>
                    </span>
                  </div>
                ));
              })()}
            </div>
          </div>
        )}

        <button
          type="button"
          className="outline-toggle-btn nodrag"
          onClick={() => setOutlineOpen((o) => !o)}
          onMouseDown={(e) => e.preventDefault()}
          title="開啟章節大綱與層級管理"
          aria-label="章節大綱與層級管理"
          style={{
            width: 28,
            height: 28,
            padding: 0,
            display: "inline-flex",
            alignItems: "center",
            justifyContent: "center",
            borderRadius: 6,
            background: outlineOpen ? "var(--accent, #60a5fa)" : "var(--panel, #1e293b)",
            color: outlineOpen ? "#fff" : "var(--muted, #64748b)",
            border: "1px solid var(--line, #334155)",
            boxShadow: "0 1px 4px rgba(0, 0, 0, 0.12)",
            opacity: 0.9,
            cursor: "pointer",
          }}
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.8"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <line x1="2" y1="3.5" x2="14" y2="3.5" />
            <line x1="6" y1="8" x2="14" y2="8" />
            <line x1="6" y1="12.5" x2="14" y2="12.5" />
          </svg>
        </button>

        {showScrollBottom && (
          <button
            type="button"
            className="scroll-to-bottom-btn"
            onClick={scrollToBottom}
            onMouseDown={(e) => e.preventDefault()}
            title="滾動至最底部"
            aria-label="滾動至最底部"
            style={{
              width: 28,
              height: 28,
              padding: 0,
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              borderRadius: 6,
              background: "var(--panel, #1e293b)",
              color: "var(--muted, #64748b)",
              border: "1px solid var(--line, #334155)",
              boxShadow: "0 1px 4px rgba(0, 0, 0, 0.12)",
              opacity: 0.85,
              cursor: "pointer",
            }}
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              strokeWidth="1.8"
              strokeLinecap="round"
              strokeLinejoin="round"
              aria-hidden="true"
            >
              <line x1="8" y1="2.5" x2="8" y2="11.5" />
              <polyline points="4.5 8.5 8 12 11.5 8.5" />
              <line x1="4" y1="14" x2="12" y2="14" />
            </svg>
          </button>
        )}
        </div>
      </div>
    </div>
  );
}

// ---- 表格偵測、Word 式選取與行列智慧增減 ----

interface TableCursorInfo {
  tableStartOffset: number;
  tableEndOffset: number;
  lines: string[];
  currentRowIndex: number;
  currentColIndex: number;
}

function detectTableAtCursor(body: string, cursor: number): TableCursorInfo | null {
  if (!body) return null;
  const lines = body.split("\n");
  const lineStarts: number[] = [];
  let acc = 0;
  let targetLine = -1;

  for (let i = 0; i < lines.length; i++) {
    lineStarts.push(acc);
    const lineLen = lines[i].length;
    if (cursor >= acc && cursor <= acc + lineLen) {
      targetLine = i;
    }
    acc += lineLen + 1;
  }
  if (targetLine === -1) return null;

  const isTableRow = (s: string) => {
    const t = s.trim();
    return t.startsWith("|") && t.endsWith("|") && t.length >= 2;
  };

  if (!isTableRow(lines[targetLine])) return null;

  let startLine = targetLine;
  while (startLine > 0 && isTableRow(lines[startLine - 1])) {
    startLine--;
  }
  let endLine = targetLine;
  while (endLine < lines.length - 1 && isTableRow(lines[endLine + 1])) {
    endLine++;
  }

  const tableLines = lines.slice(startLine, endLine + 1);
  if (tableLines.length < 2) return null;

  const isSep = /^\s*\|(\s*:?-+:?\s*\|)+\s*$/.test(tableLines[1]);
  if (!isSep) return null;

  const tableStartOffset = lineStarts[startLine];
  const lastLineOffset = lineStarts[endLine];
  const tableEndOffset = lastLineOffset + lines[endLine].length;

  const currentRowIndex = targetLine - startLine;
  const curLineText = lines[targetLine];
  const cursorInLine = Math.max(0, cursor - lineStarts[targetLine]);
  const prefixWithoutEscapes = curLineText.slice(0, cursorInLine).replace(/\\\|/g, "");
  const pipeMatches = prefixWithoutEscapes.match(/\|/g);
  const currentColIndex = pipeMatches ? Math.max(0, pipeMatches.length - 1) : 0;

  return {
    tableStartOffset,
    tableEndOffset,
    lines: tableLines,
    currentRowIndex,
    currentColIndex,
  };
}

function createMarkdownTable(cols: number, rows: number): string {
  const c = Math.max(1, cols);
  const r = Math.max(2, rows);
  const header = "| " + Array.from({ length: c }, (_, i) => `標題 ${i + 1}`).join(" | ") + " |";
  const sep = "| " + Array.from({ length: c }, () => "---").join(" | ") + " |";
  const dataRows: string[] = [];
  for (let i = 0; i < r - 1; i++) {
    dataRows.push("| " + Array.from({ length: c }, () => "  ").join(" | ") + " |");
  }
  return [header, sep, ...dataRows].join("\n");
}

function modifyMarkdownTable(
  body: string,
  info: TableCursorInfo,
  action: "addRow" | "deleteRow" | "addCol" | "deleteCol" | "deleteTable",
): EditPatch | null {
  const { lines, currentRowIndex, currentColIndex, tableStartOffset, tableEndOffset } = info;
  if (action === "deleteTable") {
    const nextBody = body.slice(0, tableStartOffset) + body.slice(tableEndOffset);
    return {
      text: nextBody,
      selectionStart: tableStartOffset,
      selectionEnd: tableStartOffset,
      replaceFrom: tableStartOffset,
      replaceTo: tableEndOffset,
      insertText: "",
    };
  }

  const parseRow = (line: string) => {
    const trimmed = line.trim();
    if (!trimmed.startsWith("|") || !trimmed.endsWith("|")) return [];
    return trimmed.slice(1, -1).split("|").map((c) => c.trim());
  };
  const formatRow = (cells: string[]) => "| " + cells.map((c) => (c.length ? c : "  ")).join(" | ") + " |";

  const headerCells = parseRow(lines[0]);
  const colCount = Math.max(1, headerCells.length);
  const newLines = [...lines];

  if (action === "addRow") {
    const insertIdx = Math.max(2, currentRowIndex + 1);
    const newRow = formatRow(Array.from({ length: colCount }, () => "  "));
    newLines.splice(insertIdx, 0, newRow);
  } else if (action === "deleteRow") {
    if (newLines.length <= 3) {
      return modifyMarkdownTable(body, info, "deleteTable");
    }
    if (currentRowIndex === 0 || currentRowIndex === 1) {
      newLines.splice(2, 1);
    } else {
      newLines.splice(currentRowIndex, 1);
    }
  } else if (action === "addCol") {
    const targetCol = Math.min(colCount, currentColIndex + 1);
    for (let i = 0; i < newLines.length; i++) {
      const cells = parseRow(newLines[i]);
      if (i === 0) {
        cells.splice(targetCol, 0, `標題 ${colCount + 1}`);
      } else if (i === 1) {
        cells.splice(targetCol, 0, "---");
      } else {
        cells.splice(targetCol, 0, "  ");
      }
      newLines[i] = formatRow(cells);
    }
  } else if (action === "deleteCol") {
    if (colCount <= 1) {
      return modifyMarkdownTable(body, info, "deleteTable");
    }
    const targetCol = Math.min(colCount - 1, currentColIndex);
    for (let i = 0; i < newLines.length; i++) {
      const cells = parseRow(newLines[i]);
      cells.splice(targetCol, 1);
      newLines[i] = formatRow(cells);
    }
  }

  const nextTableStr = newLines.join("\n");
  const nextBody = body.slice(0, tableStartOffset) + nextTableStr + body.slice(tableEndOffset);
  const newCursor = Math.min(nextBody.length, tableStartOffset + nextTableStr.length);

  return {
    text: nextBody,
    selectionStart: newCursor,
    selectionEnd: newCursor,
    replaceFrom: tableStartOffset,
    replaceTo: tableEndOffset,
    insertText: nextTableStr,
  };
}

function TableGridPicker(props: {
  open: boolean;
  onClose(): void;
  onInsert(cols: number, rows: number): void;
  inTable: boolean;
  onAction(action: "addRow" | "deleteRow" | "addCol" | "deleteCol" | "deleteTable"): void;
}) {
  const { open, onClose, onInsert, inTable, onAction } = props;
  const [hoverR, setHoverR] = useState(0);
  const [hoverC, setHoverC] = useState(0);

  if (!open) return null;

  const MAX_ROWS = 8;
  const MAX_COLS = 8;

  return (
    <div
      role="menu"
      data-table-picker
      style={{
        position: "absolute",
        top: "100%",
        left: 0,
        marginTop: 4,
        zIndex: 35,
        padding: 10,
        background: "var(--panel, #1e293b)",
        border: "1px solid var(--line, #475569)",
        borderRadius: 6,
        boxShadow: "0 6px 18px rgba(0, 0, 0, 0.32)",
        minWidth: 170,
      }}
      onMouseDown={(e) => e.stopPropagation()}
    >
      <div style={{ fontSize: 12, fontWeight: 600, marginBottom: 6, display: "flex", justifyContent: "space-between" }}>
        <span>{hoverR > 0 && hoverC > 0 ? `${hoverC} × ${hoverR} 表格` : "選取表格欄列"}</span>
        <span className="muted" style={{ fontWeight: 400, fontSize: 11 }}>Word 式選取</span>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: `repeat(${MAX_COLS}, 16px)`,
          gap: 3,
          marginBottom: 8,
          cursor: "pointer",
        }}
        onMouseLeave={() => {
          setHoverR(0);
          setHoverC(0);
        }}
      >
        {Array.from({ length: MAX_ROWS * MAX_COLS }).map((_, idx) => {
          const r = Math.floor(idx / MAX_COLS) + 1;
          const c = (idx % MAX_COLS) + 1;
          const active = r <= hoverR && c <= hoverC;
          return (
            <div
              key={idx}
              onMouseEnter={() => {
                setHoverR(r);
                setHoverC(c);
              }}
              onClick={() => {
                onInsert(c, r);
                onClose();
              }}
              style={{
                width: 16,
                height: 16,
                border: "1px solid " + (active ? "var(--accent, #60a5fa)" : "var(--line, #475569)"),
                borderRadius: 2,
                background: active ? "rgba(96, 165, 250, 0.35)" : "rgba(255, 255, 255, 0.05)",
                transition: "background 0.1s, border-color 0.1s",
              }}
            />
          );
        })}
      </div>

      {inTable && (
        <div style={{ borderTop: "1px solid var(--line, #475569)", paddingTop: 8, marginTop: 4 }}>
          <div style={{ fontSize: 11, color: "var(--muted, #94a3b8)", marginBottom: 4 }}>目前表格快捷操作：</div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 4 }}>
            <button
              type="button"
              style={{ fontSize: 11, padding: "3px 4px" }}
              onClick={() => {
                onAction("addRow");
                onClose();
              }}
            >
              ➕ 下方增列
            </button>
            <button
              type="button"
              style={{ fontSize: 11, padding: "3px 4px" }}
              onClick={() => {
                onAction("deleteRow");
                onClose();
              }}
            >
              ➖ 刪除此列
            </button>
            <button
              type="button"
              style={{ fontSize: 11, padding: "3px 4px" }}
              onClick={() => {
                onAction("addCol");
                onClose();
              }}
            >
              ➕ 右側增欄
            </button>
            <button
              type="button"
              style={{ fontSize: 11, padding: "3px 4px" }}
              onClick={() => {
                onAction("deleteCol");
                onClose();
              }}
            >
              ➖ 刪除此欄
            </button>
          </div>
          <button
            type="button"
            className="danger"
            style={{ fontSize: 11, padding: "2px 6px", width: "100%", marginTop: 6 }}
            onClick={() => {
              onAction("deleteTable");
              onClose();
            }}
          >
            刪除整個表格
          </button>
        </div>
      )}
    </div>
  );
}

// ---- 多代碼塊掃描、模式 B 智慧拆解與唯一性定位取代 ----

interface ParsedCodeBlock {
  index: number;
  info: string;
  label: string;
  content: string;
  contentStart: number;
  contentEnd: number;
  lineCount: number;
}

// 與 fencedRanges 同一套逐行規則：開頭行以 3 個以上反引號起頭（可縮排、可帶說明），
// 結尾行只能是不少於開頭長度的反引號；沒有結尾的圍欄不算代碼塊（不把後面整份內文當代碼）
export function extractCodeBlocks(markdown: string): ParsedCodeBlock[] {
  const blocks: ParsedCodeBlock[] = [];
  let open: { len: number; info: string; contentStart: number } | null = null;
  let pos = 0;
  while (pos <= markdown.length) {
    let nl = markdown.indexOf("\n", pos);
    if (nl < 0) nl = markdown.length;
    const t = markdown.slice(pos, nl).trim();
    if (open === null) {
      if (t.startsWith("```")) {
        let len = 0;
        while (t[len] === "`") len++;
        const info = t.slice(len).trim();
        // 說明文字裡還有反引號的是行內程式碼（例如單行 ```x```），不是圍欄
        if (!info.includes("`")) open = { len, info, contentStart: nl + 1 };
      }
    } else if (t.length >= open.len && t.replace(/`/g, "") === "") {
      const contentEnd = pos > open.contentStart ? pos - 1 : pos;
      const content = markdown.slice(open.contentStart, contentEnd);
      const colonIdx = open.info.indexOf(":");
      const label =
        colonIdx >= 0 ? open.info.slice(colonIdx + 1).trim() : open.info || "代碼塊 #" + String(blocks.length + 1);
      blocks.push({
        index: blocks.length,
        info: open.info,
        label,
        content,
        contentStart: open.contentStart,
        contentEnd,
        lineCount: content.split("\n").length,
      });
      open = null;
    }
    pos = nl + 1;
  }
  return blocks;
}

function normalizeCodeText(s: string): string {
  return s.replace(/\r\n/g, "\n").replace(/\r/g, "\n").replace(/\u00A0/g, " ");
}

export interface PatchPair {
  findText: string;
  replaceText: string;
}

export interface BoardReplaceFileItem {
  cardId: string;
  cardTitle: string;
  fileName: string;
  filePath: string;
  cardBody: string;
  updatedAt: string;
  targetBlockIndex: number | null;
  manualSource: string;
  pairs: PatchPair[];
  activePairIndex: number;
  completed?: boolean;
}

// 識別網頁複製 AI 代碼塊時常見的頂部單行語言標籤（例如 "TypeScript", "tsx", "python", "Copy code" 等）
const AI_LANG_HEADER_RE =
  /^(typescript|javascript|ts|tsx|js|jsx|python|py|sql|sqlite|json|html|css|scss|bash|sh|shell|yaml|yml|toml|markdown|md|diff|plaintext|text|c|cpp|csharp|java|go|rust|ruby|php|swift|kotlin)(\s+(copy(\s+code)?|複製(\s*代碼|\s*程式碼)?))?$/i;

// 識別 AI 代碼塊下方常見的說明段落或下一小節標題（無圍欄複製時應從此行起截斷）
function isAiTrailingProseLine(line: string): boolean {
  const t = line.trim();
  if (!t) return false;
  if (
    /^(原因|問題原因|說明|注意|備註|為什麼|驗證方式|下一步|修改說明|目標檔案)\s*[：:]/.test(t) ||
    /^#{1,6}\s+(檢查點|步驟|檔案|修改|\d+\.)/.test(t) ||
    /^(檢查點\s*\d+|【[A-Z0-9一二三四五六七八九十]+】)/.test(t) ||
    /^[-*]{3,}\s*$/.test(t)
  ) {
    return true;
  }
  const cleanTitle = t.replace(/^#{1,6}\s*/, "").replace(/`/g, "").trim();
  if (
    /^(?:[a-zA-Z0-9_.-]+[\\/])*[a-zA-Z0-9_.-]+\.(ts|tsx|js|jsx|py|sql|json|css|scss|md|html|yaml|yml|toml|rs|go)\s*([（(][^）)]*[）)])?$/.test(cleanTitle)
  ) {
    return true;
  }
  return false;
}

// 統一淨化器：同時支援「有 ``` 圍欄」與「無圍欄」，並剝除前後提示贅詞與保留開頭縮排
// 加 export 只是讓其他模組可重用，行為不變；沒有其他檔案要 import 就可以跳過這一組。
export function stripOuterFence(raw: string): string {
  const FENCE = "`".repeat(3);
  const trimBlank = (arr: string[]): string[] => {
    let a = arr;
    while (a.length > 0 && a[0].trim() === "") a = a.slice(1);
    while (a.length > 0 && a[a.length - 1].trim() === "") a = a.slice(0, -1);
    return a;
  };
  let lines = trimBlank(normalizeCodeText(raw).split("\n"));
  if (lines.length === 0) return "";

  // Case A: 首尾有 ``` 圍欄
  if (lines.length >= 2) {
    const first = lines[0].trim();
    const last = lines[lines.length - 1].trim();
    if (first.startsWith(FENCE) && last.length >= 3 && last.replace(/`/g, "") === "") {
      return trimBlank(lines.slice(1, -1)).join("\n");
    }
  }

  // Case B: 無圍欄，剝除首行語言標籤（如 TypeScript / Copy code）
  while (lines.length > 0) {
    const first = lines[0].trim();
    if (
      AI_LANG_HEADER_RE.test(first) ||
      /^(copy(\s+code)?|複製(\s*代碼|\s*程式碼)?)$/i.test(first)
    ) {
      lines = trimBlank(lines.slice(1));
    } else {
      break;
    }
  }

  // 剝除首部常見提示詞贅字（如「貼出實際替換區段...」、「貼出完整可直接...」）
  while (lines.length > 0) {
    const first = lines[0].trim();
    if (
      /^(貼出實際替換|貼出完整可直接|請貼出|以下是|替換說明)/.test(first) ||
      isAiTrailingProseLine(first)
    ) {
      lines = trimBlank(lines.slice(1));
    } else {
      break;
    }
  }

  // 剝除尾部的說明文字或下一個檔案標題（如「原因：...」）
  let cutIdx = lines.length;
  for (let i = 0; i < lines.length; i++) {
    if (isAiTrailingProseLine(lines[i])) {
      cutIdx = i;
      break;
    }
  }
  lines = trimBlank(lines.slice(0, cutIdx));
  return lines.join("\n");
}

// 原因：舊版用全文正規表示式補換行，會在代碼內含標記字串（常數、註解）處誤切，也不認 -01 編號。
// 改為逐行比對「獨立標記行」，圍欄內一律略過，所以代碼裡的標記字樣不會再被當成指令。
export function normalizeSmartPasteInput(rawInput: string): string {
  const text = normalizeCodeText(rawInput);
  const FENCE = "`".repeat(3);
  const LANGS =
    "typescript|javascript|ts|tsx|js|jsx|python|py|sql|sqlite|json|html|css|scss|bash|sh|shell|yaml|yml|toml|markdown|md|diff|plaintext|text|c|cpp|csharp|java|go|rust|ruby|php|swift|kotlin";

  // (?![A-Za-z0-9])：避免 ts 先吃掉 tsx、js 先吃掉 jsx／json 而把代碼第一個字母切掉
  const markerLineRe = new RegExp(
    `^[ \\t]*[#*>\`\\-\\t 0-9.:：]*` +
      `(【(?:尋找這段代碼|替換為以下代碼)】)` +
      `\\*{0,2}` +
      `(?:[ \\t]*(?:[-–—#:：_][ \\t]*\\d+|[（(]\\d+[）)]))?` +
      `\\*{0,2}` +
      `(?:[ \\t]*(${LANGS})(?![A-Za-z0-9])(?:[ \\t]*(?:copy(?:[ \\t]*code)?|複製(?:[ \\t]*代碼|[ \\t]*程式碼)?))?)?` +
      `[ \\t:：]*` +
      `(.*)$`,
    "i",
  );

  const lines = text.split("\n");
  const out: string[] = [];
  let fenceLen = 0;

  for (const line of lines) {
    const t = line.trim();
    if (fenceLen > 0) {
      out.push(line);
      if (t.length >= fenceLen && t.replace(/`/g, "") === "") fenceLen = 0;
      continue;
    }
    if (t.startsWith(FENCE)) {
      let n = 0;
      while (t[n] === "`") n++;
      fenceLen = n;
      out.push(line);
      continue;
    }

    let cur = line;
    const at = line.search(/【(?:尋找這段代碼|替換為以下代碼)】/);
    if (at > 0 && line.slice(0, at).replace(/[#*>`\-\t 0-9.:：]/g, "") !== "") {
      out.push(line.slice(0, at).trimEnd());
      cur = line.slice(at);
    }

    const m = markerLineRe.exec(cur);
    if (m) {
      const marker = m[1];
      const hasLang = Boolean(m[2]);
      const rest = m[3] ?? "";
      if (rest.trim() === "") {
        out.push(marker);
        continue;
      }
      if (hasLang) {
        out.push(marker);
        out.push(rest);
        continue;
      }
    }
    out.push(cur);
  }

  return out.join("\n");
}

export function parseAiPatchPairs(rawInput: string): PatchPair[] {
  const text = normalizeSmartPasteInput(rawInput);
  const findMarker = "【尋找這段代碼】";
  const replaceMarker = "【替換為以下代碼】";
  const FENCE = "`".repeat(3);
  const lines = text.split("\n");

  const marks: { kind: "find" | "replace"; line: number }[] = [];
  let fenceLen = 0;
  for (let i = 0; i < lines.length; i++) {
    const t = lines[i].trim();
    if (fenceLen > 0) {
      if (t.length >= fenceLen && t.replace(/`/g, "") === "") fenceLen = 0;
      continue;
    }
    if (t.startsWith(FENCE)) {
      let n = 0;
      while (t[n] === "`") n++;
      fenceLen = n;
      continue;
    }
    if (t === findMarker) marks.push({ kind: "find", line: i });
    else if (t === replaceMarker) marks.push({ kind: "replace", line: i });
  }

  const takeBody = (from: number, to: number): string => {
    let sawFence = false;
    let k = from;
    while (k < to) {
      const t = lines[k].trim();
      if (!t.startsWith(FENCE)) {
        k++;
        continue;
      }
      sawFence = true;
      let n = 0;
      while (t[n] === "`") n++;
      let e = k + 1;
      while (e < to && !(lines[e].trim().length >= n && lines[e].trim().replace(/`/g, "") === "")) e++;
      const body = lines.slice(k + 1, e).join("\n").replace(/^\n+|\n+$/g, "");
      if (body.trim().length > 0) return body;
      k = e + 1;
    }
    if (sawFence) return "";
    return stripOuterFence(lines.slice(from, to).join("\n"));
  };

  const pairs: PatchPair[] = [];
  let m = 0;
  while (m < marks.length) {
    const rm = marks[m + 1];
    if (marks[m].kind !== "find" || !rm || rm.kind !== "replace") {
      m++;
      continue;
    }
    const nextIdx = marks.findIndex((x, k) => k > m + 1 && x.kind === "find");
    const segEnd = nextIdx >= 0 ? marks[nextIdx].line : lines.length;

    const findBody = takeBody(marks[m].line + 1, rm.line);
    const replaceBody = takeBody(rm.line + 1, segEnd);
    if (findBody.trim().length > 0) {
      pairs.push({ findText: findBody, replaceText: replaceBody });
    }
    m = nextIdx >= 0 ? nextIdx : marks.length;
  }

  return pairs;
}

export function findUniqueRange(
  source: string,
  target: string,
): { status: "ok"; start: number; end: number } | { status: "not_found" } | { status: "ambiguous"; count: number } {
  if (!target) return { status: "not_found" };
  // Stage 1: 直接精確字串比對
  let count = 0;
  let firstIdx = -1;
  let pos = 0;
  while (pos <= source.length) {
    const idx = source.indexOf(target, pos);
    if (idx < 0) break;
    if (count === 0) firstIdx = idx;
    count += 1;
    pos = idx + Math.max(1, target.length);
  }
  if (count === 1) {
    return { status: "ok", start: firstIdx, end: firstIdx + target.length };
  }
  if (count > 1) {
    return { status: "ambiguous", count };
  }

  // 建立行位移索引
  const srcLines = source.split("\n");
  const tgtLines = target.split("\n");
  if (tgtLines.length === 0 || tgtLines.length > srcLines.length) {
    return { status: "not_found" };
  }
  const lineOffsets: number[] = [];
  let acc = 0;
  for (let i = 0; i < srcLines.length; i++) {
    lineOffsets.push(acc);
    acc += srcLines[i].length + 1;
  }

  // Stage 2: 忽略每行行尾多餘空白比對
  const stage2Matches: { start: number; end: number }[] = [];
  for (let i = 0; i <= srcLines.length - tgtLines.length; i++) {
    let match = true;
    for (let j = 0; j < tgtLines.length; j++) {
      if (srcLines[i + j].trimEnd() !== tgtLines[j].trimEnd()) {
        match = false;
        break;
      }
    }
    if (match) {
      const startOffset = lineOffsets[i];
      const lastLineIdx = i + tgtLines.length - 1;
      const endOffset = lineOffsets[lastLineIdx] + srcLines[lastLineIdx].length;
      stage2Matches.push({ start: startOffset, end: endOffset });
    }
  }

  if (stage2Matches.length === 1) {
    return { status: "ok", start: stage2Matches[0].start, end: stage2Matches[0].end };
  }
  if (stage2Matches.length > 1) {
    return { status: "ambiguous", count: stage2Matches.length };
  }

  // Stage 3: 智慧縮排容錯比對（解決反白複製第一行前綴空格遺失、或整體縮排層級不同的問題）
  const stage3Matches: { start: number; end: number }[] = [];
  for (let i = 0; i <= srcLines.length - tgtLines.length; i++) {
    let match = true;
    for (let j = 0; j < tgtLines.length; j++) {
      if (srcLines[i + j].trim() !== tgtLines[j].trim()) {
        match = false;
        break;
      }
    }
    if (match) {
      const startOffset = lineOffsets[i];
      const lastLineIdx = i + tgtLines.length - 1;
      const endOffset = lineOffsets[lastLineIdx] + srcLines[lastLineIdx].length;
      stage3Matches.push({ start: startOffset, end: endOffset });
    }
  }

  if (stage3Matches.length === 1) {
    return { status: "ok", start: stage3Matches[0].start, end: stage3Matches[0].end };
  }
  if (stage3Matches.length > 1) {
    return { status: "ambiguous", count: stage3Matches.length };
  }

  return { status: "not_found" };
}

// 智慧縮排對齊：若原代碼具有前綴縮排，但貼上的取代代碼第一行缺少縮排，自動對齊原版縮排深度
export function alignIndent(originalBlock: string, replacementCode: string): string {
  const origFirstLine = originalBlock.split("\n")[0] ?? "";
  const repLines = replacementCode.split("\n");
  if (!repLines.length) return replacementCode;
  const origIndentMatch = /^([ \t]+)/.exec(origFirstLine);
  const repIndentMatch = /^([ \t]+)/.exec(repLines[0]);
  const origIndent = origIndentMatch ? origIndentMatch[1] : "";
  const repIndent = repIndentMatch ? repIndentMatch[1] : "";

  if (origIndent && !repIndent) {
    return repLines.map((l) => (l.trim().length > 0 ? origIndent + l : l)).join("\n");
  }
  return replacementCode;
}

export function applyCodePatches(
  originalCode: string,
  pairs: PatchPair[],
): { ok: true; resultCode: string; appliedCount: number } | { ok: false; error: string } {
  if (pairs.length === 0) {
    return { ok: false, error: "請先輸入【定位代碼】或貼上 AI 修改指令" };
  }
  let working = normalizeCodeText(originalCode);
  for (let i = 0; i < pairs.length; i++) {
    const p = pairs[i];
    const cleanFind = stripOuterFence(p.findText);
    const cleanReplace = stripOuterFence(p.replaceText);
    const tag = pairs.length > 1 ? "第 " + String(i + 1) + " 組修改：" : "";
    if (!cleanFind.trim()) {
      return { ok: false, error: tag + "定位代碼不可為空白" };
    }
    const loc = findUniqueRange(working, cleanFind);
    if (loc.status === "not_found") {
      return {
        ok: false,
        error: tag + "在原版代碼中找不到指定的【定位代碼】（匹配 0 處）。請確認是否選錯代碼塊，或定位代碼是否被截斷。",
      };
    }
    if (loc.status === "ambiguous") {
      return {
        ok: false,
        error:
          tag +
          "【定位代碼】在原版中出現了 " +
          String(loc.count) +
          " 處，無法唯一鎖定。請在定位代碼中多包含前後 1～2 行上下文。",
      };
    }
    const matchedSource = working.slice(loc.start, loc.end);
    const alignedReplace = alignIndent(matchedSource, cleanReplace);
    working = working.slice(0, loc.start) + alignedReplace + working.slice(loc.end);
  }
  return { ok: true, resultCode: working, appliedCount: pairs.length };
}

export function CodeReplaceModal(props: {
  cardBody: string;
  cursorPos: number;
  initialSmartPaste?: string | null;
  boardFiles?: BoardReplaceFileItem[];
  onApplyBoardFiles?(
    files: BoardReplaceFileItem[],
    onProgress: (updatedFiles: BoardReplaceFileItem[]) => void,
  ): Promise<{ ok: boolean; error?: string; details?: string[] }>;
  onClose(): void;
  onApplyPatch(patch: EditPatch): void;
}) {
  const { cardBody, cursorPos, initialSmartPaste, boardFiles, onApplyBoardFiles, onClose, onApplyPatch } = props;
  const isBoardMode = Boolean(boardFiles && boardFiles.length > 0 && onApplyBoardFiles);
  const blocks = extractCodeBlocks(cardBody);
  const fenceLines =
    blocks.length === 0
      ? cardBody.split("\n").flatMap((l, i) => (l.trim().startsWith("```") ? [`第 ${i + 1} 行：${l.trim().slice(0, 40)}`] : []))
      : [];

  const initialTarget = () => {
    const hit = blocks.find((b) => cursorPos >= b.contentStart && cursorPos <= b.contentEnd);
    if (hit) return String(hit.index);
    return blocks.length > 0 ? "0" : "__new__";
  };

  const [fileEntries, setFileEntries] = useState<BoardReplaceFileItem[]>(() => boardFiles ?? []);
  const [activeFileIdx, setActiveFileIdx] = useState(0);
  const [executing, setExecuting] = useState(false);

  const [targetKey, setTargetKey] = useState<string>(initialTarget);
  const [newBlockName, setNewBlockName] = useState("Board.tsx");
  const [manualSource, setManualSource] = useState("");
  const [smartInput, setSmartInput] = useState("");
  const [pairs, setPairs] = useState<PatchPair[]>([{ findText: "", replaceText: "" }]);
  const [activePairIndex, setActivePairIndex] = useState(0);
  const [feedback, setFeedback] = useState<{ kind: "ok" | "err" | "warn"; msg: string; details?: string[] } | null>(null);

  const safeFileIdx = fileEntries.length > 0 ? Math.min(activeFileIdx, fileEntries.length - 1) : 0;
  const activeBoardFile = isBoardMode ? fileEntries[safeFileIdx] ?? null : null;

  const selectedBlock = isBoardMode
    ? activeBoardFile && activeBoardFile.targetBlockIndex !== null
      ? extractCodeBlocks(activeBoardFile.cardBody).find((b) => b.index === activeBoardFile.targetBlockIndex) ?? null
      : null
    : targetKey === "__new__"
      ? null
      : blocks.find((b) => String(b.index) === targetKey) ?? null;

  const activeSourceCode = isBoardMode
    ? selectedBlock
      ? selectedBlock.content
      : activeBoardFile?.manualSource ?? ""
    : selectedBlock
      ? selectedBlock.content
      : manualSource;

  const activePairs = isBoardMode ? activeBoardFile?.pairs ?? [{ findText: "", replaceText: "" }] : pairs;
  const currentPairIdx = isBoardMode ? activeBoardFile?.activePairIndex ?? 0 : activePairIndex;
  const currentPair = activePairs[currentPairIdx] || { findText: "", replaceText: "" };

  const setActivePairs = (updater: (prev: PatchPair[]) => PatchPair[]) => {
    if (isBoardMode) {
      setFileEntries((prev) =>
        prev.map((f, idx) => (idx === safeFileIdx ? { ...f, pairs: updater(f.pairs), completed: false } : f)),
      );
    } else {
      setPairs(updater);
    }
  };

  const setCurrentPairIndex = (nextIdx: number) => {
    if (isBoardMode) {
      setFileEntries((prev) => prev.map((f, idx) => (idx === safeFileIdx ? { ...f, activePairIndex: nextIdx } : f)));
    } else {
      setActivePairIndex(nextIdx);
    }
  };

  const updateCurrentPair = (nextFind: string, nextReplace: string) => {
    setActivePairs((prev) => {
      const next = [...prev];
      next[currentPairIdx] = { findText: nextFind, replaceText: nextReplace };
      return next;
    });
  };

  useEffect(() => {
    if (!initialSmartPaste) return;
    const formatted = normalizeSmartPasteInput(initialSmartPaste);
    setSmartInput(formatted);
    if (isBoardMode) {
      const totalPairs = (boardFiles ?? []).reduce((sum, f) => sum + f.pairs.length, 0);
      setFeedback({
        kind: "ok",
        msg: `已由白板定位載入 ${(boardFiles ?? []).length} 個已連動檔案（共 ${totalPairs} 組修改），可直接套用取代並寫入檔案。`,
      });
      return;
    }
    const parsed = parseAiPatchPairs(formatted);
    const hasDoubleArrow = initialSmartPaste.includes(">>");
    const arrowNote = hasDoubleArrow
      ? "提示：貼上內容偵測到「>>」，請確認是否誤含引用標記或未清理字元。\n"
      : "";
    if (parsed.length > 0) {
      setPairs(parsed);
      setActivePairIndex(0);
      setFeedback({
        kind: hasDoubleArrow ? "warn" : "ok",
        msg: `${arrowNote}已自動載入並解析 ${parsed.length} 組【尋找／替換】指令！`,
      });
    } else {
      const cleanRaw = stripOuterFence(initialSmartPaste);
      if (cleanRaw.trim()) {
        setPairs([{ findText: cleanRaw, replaceText: "" }]);
        setActivePairIndex(0);
        setFeedback({
          kind: hasDoubleArrow ? "warn" : "ok",
          msg: `${arrowNote}已將貼上的代碼段落載入至智慧貼上區與第 1 組【定位代碼】，請在右側輸入欲取代的新代碼。`,
        });
      }
    }
    for (const b of blocks) {
      if (b.label && initialSmartPaste.includes(b.label)) {
        setTargetKey(String(b.index));
        break;
      }
    }
  }, [initialSmartPaste]);

  const handleSmartPasteChange = (val: string) => {
    const formatted = normalizeSmartPasteInput(val);
    setSmartInput(formatted);
    setFeedback(null);
    const hasDoubleArrow = val.includes(">>");
    const arrowNote = hasDoubleArrow
      ? "提示：貼上內容偵測到「>>」，請確認是否誤含引用標記或標籤。\n"
      : "";

    if (isBoardMode) {
      const parsedPairs = parseAiPatchPairs(formatted);
      if (parsedPairs.length > 0) {
        const workingSources = fileEntries.map((f) => {
          const fBlocks = extractCodeBlocks(f.cardBody);
          const fBlock =
            f.targetBlockIndex !== null
              ? fBlocks.find((b) => b.index === f.targetBlockIndex) ?? null
              : null;
          return normalizeCodeText(fBlock ? fBlock.content : f.manualSource);
        });
        const assignedPairs: PatchPair[][] = fileEntries.map(() => []);
        const routeErrors: string[] = [];

        for (let i = 0; i < parsedPairs.length; i++) {
          const p = parsedPairs[i];
          const cleanFind = stripOuterFence(p.findText);
          const cleanReplace = stripOuterFence(p.replaceText);
          if (!cleanFind.trim()) continue;

          const okIndices: number[] = [];
          const ambIndices: number[] = [];
          for (let fIdx = 0; fIdx < fileEntries.length; fIdx++) {
            const loc = findUniqueRange(workingSources[fIdx], cleanFind);
            if (loc.status === "ok") okIndices.push(fIdx);
            else if (loc.status === "ambiguous") ambIndices.push(fIdx);
          }

          if (ambIndices.length > 0) {
            routeErrors.push(`• 第 ${i + 1} 組在「${fileEntries[ambIndices[0]].fileName}」內出現多處重複匹配，無法唯一鎖定`);
          } else if (okIndices.length === 0) {
            routeErrors.push(`• 第 ${i + 1} 組在已載入的 ${fileEntries.length} 個檔案中找不到任何匹配代碼`);
          } else if (okIndices.length > 1) {
            const names = okIndices.map((idx) => fileEntries[idx].fileName).join("、");
            routeErrors.push(`• 第 ${i + 1} 組同時符合多個檔案（${names}），無法唯一判定`);
          } else {
            const targetIdx = okIndices[0];
            const loc = findUniqueRange(workingSources[targetIdx], cleanFind);
            if (loc.status === "ok") {
              const matchedSource = workingSources[targetIdx].slice(loc.start, loc.end);
              workingSources[targetIdx] =
                workingSources[targetIdx].slice(0, loc.start) +
                alignIndent(matchedSource, cleanReplace) +
                workingSources[targetIdx].slice(loc.end);
            }
            assignedPairs[targetIdx].push(p);
          }
        }

        const totalAssigned = assignedPairs.reduce((s, arr) => s + arr.length, 0);
        if (totalAssigned > 0) {
          setFileEntries((prev) =>
            prev.map((f, idx) =>
              assignedPairs[idx].length > 0
                ? { ...f, pairs: assignedPairs[idx], activePairIndex: 0, completed: false }
                : f,
            ),
          );
        }

        if (routeErrors.length > 0) {
          setFeedback({
            kind: "err",
            msg: `${arrowNote}部分組別無法依代碼比對分配（若新增了未在本次定位清單中的檔案，請關閉彈窗並從白板重新定位）：`,
            details: routeErrors,
          });
        } else {
          setFeedback({
            kind: hasDoubleArrow ? "warn" : "ok",
            msg: `${arrowNote}已依代碼內容比對重新解析並分配 ${totalAssigned} 組【尋找／替換】指令至對應檔案！`,
          });
        }
      }
      return;
    }

    const parsed = parseAiPatchPairs(formatted);
    if (parsed.length > 0) {
      setPairs(parsed);
      setActivePairIndex(0);
      setFeedback({
        kind: hasDoubleArrow ? "warn" : "ok",
        msg: `${arrowNote}已成功解析 ${parsed.length} 組【尋找／替換】指令並淨化格式！可切換上方組別標籤查看每一組細節。`,
      });
    } else if (hasDoubleArrow) {
      setFeedback({
        kind: "warn",
        msg: "提示：貼上內容偵測到「>>」，請確認是否為誤貼入的引用符號或標記。",
      });
    }
  };

  const handleFindChange = (val: string) => {
    // 移除過度攔截：定位代碼框必須忠實接收使用者的輸入（即使代碼內含「【尋找這段代碼】」字串常數）
    updateCurrentPair(val, currentPair.replaceText);
    setFeedback(null);
  };

  const handleReplaceChange = (val: string) => {
    updateCurrentPair(currentPair.findText, val);
    setFeedback(null);
  };

  const handleVerifyAllFiles = () => {
    if (isBoardMode) {
      const details: string[] = [];
      let firstErrorFileIdx = -1;
      let firstErrorPairIdx = 0;
      let totalPairs = 0;

      for (let fIdx = 0; fIdx < fileEntries.length; fIdx++) {
        const entry = fileEntries[fIdx];
        const entryBlocks = extractCodeBlocks(entry.cardBody);
        const entryBlock =
          entry.targetBlockIndex !== null
            ? entryBlocks.find((b) => b.index === entry.targetBlockIndex) ?? null
            : null;
        const src = entryBlock ? entryBlock.content : entry.manualSource;
        const validPairs = entry.pairs.filter((p) => p.findText.trim().length > 0);

        if (!src.trim()) {
          details.push(`• [${entry.fileName}]：原版代碼為空，無法驗證`);
          if (firstErrorFileIdx < 0) firstErrorFileIdx = fIdx;
          continue;
        }
        if (validPairs.length === 0) {
          details.push(`• [${entry.fileName}]：尚未輸入任何定位代碼`);
          if (firstErrorFileIdx < 0) firstErrorFileIdx = fIdx;
          continue;
        }

        let working = normalizeCodeText(src);
        for (let pIdx = 0; pIdx < validPairs.length; pIdx++) {
          totalPairs++;
          const p = validPairs[pIdx];
          const cleanFind = stripOuterFence(p.findText);
          const cleanReplace = stripOuterFence(p.replaceText);
          const loc = findUniqueRange(working, cleanFind);

          if (loc.status === "not_found") {
            details.push(`• [${entry.fileName}] 第 ${pIdx + 1} 組：找不到指定代碼（匹配 0 處）`);
            if (firstErrorFileIdx < 0) {
              firstErrorFileIdx = fIdx;
              firstErrorPairIdx = pIdx;
            }
          } else if (loc.status === "ambiguous") {
            details.push(`• [${entry.fileName}] 第 ${pIdx + 1} 組：出現 ${loc.count} 處重複匹配，無法唯一鎖定`);
            if (firstErrorFileIdx < 0) {
              firstErrorFileIdx = fIdx;
              firstErrorPairIdx = pIdx;
            }
          } else {
            const lineNum = working.slice(0, loc.start).split("\n").length;
            details.push(`• [${entry.fileName}] 第 ${pIdx + 1} 組：唯一匹配（約第 ${lineNum} 行，長度 ${cleanFind.length} 字元）`);
            const matchedSource = working.slice(loc.start, loc.end);
            working = working.slice(0, loc.start) + alignIndent(matchedSource, cleanReplace) + working.slice(loc.end);
          }
        }
      }

      if (firstErrorFileIdx >= 0) {
        setActiveFileIdx(firstErrorFileIdx);
        setFileEntries((prev) =>
          prev.map((f, idx) => (idx === firstErrorFileIdx ? { ...f, activePairIndex: firstErrorPairIdx } : f)),
        );
        setFeedback({
          kind: "err",
          msg: `測試未全數通過（共 ${fileEntries.length} 個檔案）：`,
          details,
        });
      } else {
        setFeedback({
          kind: "ok",
          msg: `所有檔案定位驗證全部符合（共 ${fileEntries.length} 個檔案，合計 ${totalPairs} 組修改）！可安心執行取代。`,
          details,
        });
      }
      return;
    }

    if (!activeSourceCode.trim()) {
      setFeedback({ kind: "err", msg: "原版代碼全文目前為空，請先選擇代碼塊或貼上原版全文。" });
      return;
    }
    const validPairs = pairs.filter((p) => p.findText.trim().length > 0);
    if (validPairs.length === 0) {
      setFeedback({ kind: "err", msg: "目前無有效的定位代碼，請先輸入【定位代碼】。" });
      return;
    }

    let working = normalizeCodeText(activeSourceCode);
    const details: string[] = [];
    let hasError = false;

    for (let i = 0; i < validPairs.length; i++) {
      const p = validPairs[i];
      const cleanFind = stripOuterFence(p.findText);
      const cleanReplace = stripOuterFence(p.replaceText);
      const loc = findUniqueRange(working, cleanFind);

      if (loc.status === "not_found") {
        details.push(`• 第 ${i + 1} 組：找不到指定代碼（匹配 0 處）`);
        hasError = true;
      } else if (loc.status === "ambiguous") {
        details.push(`• 第 ${i + 1} 組：出現 ${loc.count} 處重複匹配，無法唯一鎖定`);
        hasError = true;
      } else {
        const lineNum = working.slice(0, loc.start).split("\n").length;
        details.push(`• 第 ${i + 1} 組：唯一匹配（約第 ${lineNum} 行，長度 ${cleanFind.length} 字元）`);
        const matchedSource = working.slice(loc.start, loc.end);
        working = working.slice(0, loc.start) + alignIndent(matchedSource, cleanReplace) + working.slice(loc.end);
      }
    }

    if (hasError) {
      setFeedback({
        kind: "err",
        msg: `定位驗證未全數符合（共 ${validPairs.length} 組）：`,
        details,
      });
    } else {
      setFeedback({
        kind: "ok",
        msg: `所有檔案定位驗證全部符合（共 ${validPairs.length} 組）！可安心執行取代。`,
        details,
      });
    }
  };

  const handleExecute = async () => {
    if (isBoardMode && onApplyBoardFiles) {
      if (executing) return;
      for (let fIdx = 0; fIdx < fileEntries.length; fIdx++) {
        const entry = fileEntries[fIdx];
        if (entry.completed) continue;
        const entryBlocks = extractCodeBlocks(entry.cardBody);
        const entryBlock =
          entry.targetBlockIndex !== null
            ? entryBlocks.find((b) => b.index === entry.targetBlockIndex) ?? null
            : null;
        const src = entryBlock ? entryBlock.content : entry.manualSource;
        if (!src.trim()) {
          setActiveFileIdx(fIdx);
          setFeedback({ kind: "err", msg: `檔案「${entry.fileName}」的原版代碼為空，無法執行取代。` });
          return;
        }
        const validPairs = entry.pairs.filter((p) => p.findText.trim().length > 0);
        const check = applyCodePatches(src, validPairs);
        if (!check.ok) {
          setActiveFileIdx(fIdx);
          setFeedback({ kind: "err", msg: `[${entry.fileName}] ${check.error}` });
          return;
        }
      }

      setExecuting(true);
      setFeedback(null);
      try {
        const result = await onApplyBoardFiles(fileEntries, (updated) => {
          setFileEntries(updated);
        });
        if (!result.ok) {
          const firstIncomplete = fileEntries.findIndex((f) => !f.completed);
          if (firstIncomplete >= 0) setActiveFileIdx(firstIncomplete);
          setFeedback({
            kind: "err",
            msg: result.error || "部分檔案寫入未完成",
            details: result.details,
          });
        }
      } finally {
        setExecuting(false);
      }
      return;
    }

    if (!activeSourceCode.trim()) {
      setFeedback({ kind: "err", msg: "原版代碼全文目前為空，請先選擇代碼塊或貼上原版全文。" });
      return;
    }
    const validPairs = pairs.filter((p) => p.findText.trim().length > 0);
    const res = applyCodePatches(activeSourceCode, validPairs);
    if (!res.ok) {
      setFeedback({ kind: "err", msg: res.error });
      return;
    }

    try {
      await navigator.clipboard.writeText(res.resultCode);
    } catch {
      /* 剪貼簿失敗不阻礙寫回卡片 */
    }

    if (selectedBlock) {
      const from = selectedBlock.contentStart;
      const to = selectedBlock.contentEnd;
      const nextBody = cardBody.slice(0, from) + res.resultCode + cardBody.slice(to);
      const nextCursor = from + res.resultCode.length;
      onApplyPatch({
        text: nextBody,
        selectionStart: nextCursor,
        selectionEnd: nextCursor,
        replaceFrom: from,
        replaceTo: to,
        insertText: res.resultCode,
      });
    } else {
      const cleanName = newBlockName.trim().replace(/\s+/g, "_");
      const extIdx = cleanName.lastIndexOf(".");
      const ext = extIdx >= 0 ? cleanName.slice(extIdx + 1).toLowerCase() : "tsx";
      const header = cleanName ? "```" + (ext || "tsx") + ":" + cleanName : "```tsx";
      const prefix = cardBody.length > 0 && !cardBody.endsWith("\n") ? "\n\n" : cardBody.length > 0 ? "\n" : "";
      const insertBlock = prefix + header + "\n" + res.resultCode + "\n```\n";
      const from = cardBody.length;
      const nextBody = cardBody + insertBlock;
      onApplyPatch({
        text: nextBody,
        selectionStart: nextBody.length,
        selectionEnd: nextBody.length,
        replaceFrom: from,
        replaceTo: from,
        insertText: insertBlock,
      });
      setTargetKey(String(blocks.length));
      setManualSource("");
    }

    setSmartInput("");
    setPairs([{ findText: "", replaceText: "" }]);
    setActivePairIndex(0);

    setFeedback({
      kind: "ok",
      msg: `已成功套用 ${res.appliedCount} 處代碼取代並更新至卡片！最新全文已複製至剪貼簿，輸入框已自動清空，可直接貼上下一組代碼。`,
    });
  };

  const handleClearCurrent = () => {
    updateCurrentPair("", "");
    setFeedback(null);
  };

  const currentDisplayFileName = isBoardMode
    ? activeBoardFile?.fileName ?? "未指定檔案"
    : selectedBlock
      ? selectedBlock.label
      : newBlockName.trim() || "外部原版全文";

  return (
    <div className="modal" role="dialog" aria-label="代碼自動定位與取代" style={{ padding: 12 }}>
      <div
        className="modal-card"
        style={{
          width: "96vw",
          maxWidth: "96vw",
          height: "96vh",
          maxHeight: "96vh",
          display: "flex",
          flexDirection: "column",
          padding: "16px 20px",
          boxSizing: "border-box",
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", flexShrink: 0, gap: 12 }}>
          <h4 style={{ margin: 0, display: "inline-flex", alignItems: "center", gap: 6 }}>
            <ZapStrokeIcon size={16} />
            代碼自動定位與取代
          </h4>

          {isBoardMode && activeBoardFile && (
            <div
              style={{
                display: "inline-flex",
                alignItems: "center",
                gap: 8,
                padding: "4px 10px",
                background: "var(--bg)",
                border: "1px solid var(--line)",
                borderRadius: 8,
              }}
            >
              <button
                type="button"
                disabled={executing || safeFileIdx <= 0}
                onClick={() => {
                  setActiveFileIdx((i) => Math.max(0, i - 1));
                  setFeedback(null);
                }}
                title="切換至上一檔（保留各檔案手動修改的定位／取代代碼）"
                style={{ display: "inline-flex", alignItems: "center", gap: 4, padding: "2px 8px", fontSize: 12 }}
              >
                <ChevronLeftStrokeIcon size={13} />
                上一檔
              </button>
              <span style={{ display: "inline-flex", alignItems: "center", gap: 6, fontSize: 13, fontWeight: 600 }}>
                <FileCodeStrokeIcon size={14} />
                <span>{activeBoardFile.fileName}</span>
                <span className="muted" style={{ fontWeight: 400, fontSize: 12 }}>
                  （{safeFileIdx + 1} / {fileEntries.length}）
                </span>
                {activeBoardFile.completed && (
                  <span className="facet-badge" style={{ background: "var(--hl-green-bg)", color: "var(--text)" }}>
                    已寫入
                  </span>
                )}
              </span>
              <button
                type="button"
                disabled={executing || safeFileIdx >= fileEntries.length - 1}
                onClick={() => {
                  setActiveFileIdx((i) => Math.min(fileEntries.length - 1, i + 1));
                  setFeedback(null);
                }}
                title="切換至下一檔（保留各檔案手動修改的定位／取代代碼）"
                style={{ display: "inline-flex", alignItems: "center", gap: 4, padding: "2px 8px", fontSize: 12 }}
              >
                下一檔
                <ChevronRightStrokeIcon size={13} />
              </button>
            </div>
          )}

          <button
            type="button"
            onClick={onClose}
            disabled={executing}
            style={{ padding: "3px 10px", display: "inline-flex", alignItems: "center", gap: 4 }}
            title="關閉彈窗"
          >
            <CloseStrokeIcon size={13} />
            關閉
          </button>
        </div>

        <div style={{ flex: 1, display: "flex", flexDirection: "column", minHeight: 0, overflowY: "auto", gap: 10, marginTop: 10 }}>
          {isBoardMode && activeBoardFile ? (
            <div
              style={{
                display: "flex",
                flexWrap: "wrap",
                alignItems: "center",
                justifyContent: "space-between",
                gap: 8,
                padding: "6px 10px",
                borderRadius: 6,
                background: "var(--bg)",
                border: "1px solid var(--line)",
                fontSize: 12,
                flexShrink: 0,
              }}
            >
              <span style={{ display: "inline-flex", alignItems: "center", gap: 6 }}>
                <FileCodeStrokeIcon size={14} />
                <strong>目標檔案：{activeBoardFile.fileName}</strong>
                <span className="muted">（對應卡片：{activeBoardFile.cardTitle || "（無標題）"}）</span>
              </span>
              <span className="muted" style={{ fontFamily: "monospace", fontSize: 11 }}>
                {activeBoardFile.filePath}
              </span>
            </div>
          ) : (
            <>
              <div className="field-row" style={{ flexShrink: 0 }}>
                <span className="muted">① 選擇目標代碼塊（原版全文來源）：</span>
                <div style={{ display: "flex", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
                  <select
                    value={targetKey}
                    onChange={(e) => {
                      setTargetKey(e.target.value);
                      setFeedback(null);
                    }}
                    aria-label="選擇目標代碼塊"
                    style={{ flex: 1, minWidth: 240 }}
                  >
                    {blocks.map((b) => (
                      <option key={b.index} value={String(b.index)}>
                        {"區塊 #" + String(b.index + 1) + "：" + b.label + "（" + String(b.lineCount) + " 行）"}
                      </option>
                    ))}
                    <option value="__new__">手動貼上外部原版全文（取代後存為卡片新代碼塊）</option>
                  </select>
                  {targetKey === "__new__" && (
                    <input
                      value={newBlockName}
                      onChange={(e) => setNewBlockName(e.target.value)}
                      placeholder="新代碼塊檔名（如 Board.tsx）"
                      style={{ width: 200 }}
                    />
                  )}
                </div>
              </div>

              {blocks.length === 0 && (
                <div className="banner warn" role="alert" style={{ flexShrink: 0, flexDirection: "column", alignItems: "flex-start" }}>
                  {fenceLines.length === 0 ? (
                    <div>卡片內文（{cardBody.length} 字）沒有任何以反引號開頭的圍欄行：這張卡片裡沒有代碼塊，或定位取代開在別張卡片上。</div>
                  ) : (
                    <>
                      <div>內文有 {fenceLines.length} 行圍欄標記，但沒有成功配對成代碼塊（可能缺少結尾圍欄）：</div>
                      {fenceLines.slice(0, 6).map((l) => (
                        <div key={l} style={{ fontFamily: "monospace", fontSize: 12 }}>
                          {l}
                        </div>
                      ))}
                    </>
                  )}
                </div>
              )}
              {targetKey === "__new__" ? (
                <label className="field-row" style={{ flexShrink: 0 }}>
                  <span className="muted">貼上原版（全文代碼）：</span>
                  <textarea
                    rows={6}
                    value={manualSource}
                    onChange={(e) => {
                      setManualSource(e.target.value);
                      setFeedback(null);
                    }}
                    placeholder="在此貼上要被修改的完整原始檔案代碼..."
                    style={{
                      fontFamily: "monospace",
                      fontSize: 12,
                      resize: "vertical",
                      minHeight: 120,
                      width: "100%",
                      boxSizing: "border-box",
                    }}
                  />
                </label>
              ) : (
                <div className="muted" style={{ fontSize: 12, flexShrink: 0 }}>
                  已鎖定卡片內「{selectedBlock?.label}」（共 {String(selectedBlock?.lineCount ?? 0)} 行）。連續取代時將自動在此最新內容上即時更新。
                </div>
              )}
            </>
          )}

          {isBoardMode && activeBoardFile && activeBoardFile.targetBlockIndex === null && (
            <label className="field-row" style={{ flexShrink: 0 }}>
              <span className="muted">此卡片內尚無匹配代碼塊，請貼上「{activeBoardFile.fileName}」原版全文代碼：</span>
              <textarea
                rows={5}
                value={activeBoardFile.manualSource}
                onChange={(e) => {
                  const val = e.target.value;
                  setFileEntries((prev) =>
                    prev.map((f, idx) => (idx === safeFileIdx ? { ...f, manualSource: val, completed: false } : f)),
                  );
                  setFeedback(null);
                }}
                placeholder="在此貼上要被修改的完整原始檔案代碼..."
                style={{
                  fontFamily: "monospace",
                  fontSize: 12,
                  resize: "vertical",
                  minHeight: 100,
                  width: "100%",
                  boxSizing: "border-box",
                }}
              />
            </label>
          )}

          <label className="field-row" style={{ flexShrink: 0 }}>
            <span className="muted">
              ② 智慧貼上區（直接貼上 AI 回覆，自動拆解並剝除空代碼塊、Markdown 標題與圍欄）：
            </span>
            <textarea
              rows={6}
              value={smartInput}
              onChange={(e) => handleSmartPasteChange(e.target.value)}
              placeholder="貼上 AI 回覆段落（自動解析一組或多組【尋找／替換】區塊）..."
              style={{
                fontFamily: "monospace",
                fontSize: 12,
                resize: "vertical",
                minHeight: 130,
                width: "100%",
                boxSizing: "border-box",
                lineHeight: 1.45,
              }}
            />
          </label>

          {activePairs.length > 1 && (
            <div style={{ display: "flex", gap: 6, alignItems: "center", margin: "4px 0", flexWrap: "wrap", flexShrink: 0 }}>
              <span className="muted" style={{ fontSize: 12 }}>
                {currentDisplayFileName} 組別切換：
              </span>
              {activePairs.map((_, idx) => (
                <button
                  key={idx}
                  type="button"
                  className={currentPairIdx === idx ? "primary" : ""}
                  style={{ fontSize: 11, padding: "2px 8px" }}
                  onClick={() => {
                    setCurrentPairIndex(idx);
                    setFeedback(null);
                  }}
                >
                  第 {idx + 1} 組
                </button>
              ))}
            </div>
          )}

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, flex: 1, minHeight: 260 }}>
            <label className="field-row" style={{ margin: 0, display: "flex", flexDirection: "column", height: "100%" }}>
              <span className="muted">
                定位代碼（{currentDisplayFileName} · 第 {currentPairIdx + 1}/{activePairs.length} 組）：
              </span>
              <textarea
                rows={12}
                value={currentPair.findText}
                onChange={(e) => handleFindChange(e.target.value)}
                placeholder="要被取代的舊代碼片段..."
                style={{
                  fontFamily: "monospace",
                  fontSize: 12,
                  resize: "vertical",
                  flex: 1,
                  minHeight: 200,
                  width: "100%",
                  boxSizing: "border-box",
                  lineHeight: 1.45,
                }}
              />
            </label>
            <label className="field-row" style={{ margin: 0, display: "flex", flexDirection: "column", height: "100%" }}>
              <span className="muted">
                取代代碼（{currentDisplayFileName} · 第 {currentPairIdx + 1}/{activePairs.length} 組）：
              </span>
              <textarea
                rows={12}
                value={currentPair.replaceText}
                onChange={(e) => handleReplaceChange(e.target.value)}
                placeholder="要換上的新代碼片段..."
                style={{
                  fontFamily: "monospace",
                  fontSize: 12,
                  resize: "vertical",
                  flex: 1,
                  minHeight: 200,
                  width: "100%",
                  boxSizing: "border-box",
                  lineHeight: 1.45,
                }}
              />
            </label>
          </div>
        </div>

        {feedback && (
          <div
            className={"banner " + (feedback.kind === "err" ? "danger" : "warn")}
            role="alert"
            style={{ marginTop: 8, alignItems: "flex-start" }}
          >
            {feedback.kind === "warn" && <AlertTriangleStrokeIcon size={15} />}
            <div style={{ flex: 1 }}>
              <div>{feedback.msg}</div>
              {feedback.details && feedback.details.length > 0 && (
                <div style={{ marginTop: 4, fontSize: 12, fontFamily: "monospace", lineHeight: 1.5 }}>
                  {feedback.details.map((d, i) => (
                    <div key={i}>{d}</div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        <div className="modal-actions" style={{ marginTop: 12, justifyContent: "space-between" }}>
          <div style={{ display: "flex", gap: 8 }}>
            <button
              type="button"
              onClick={handleVerifyAllFiles}
              disabled={executing}
              style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
            >
              <SearchCheckStrokeIcon size={14} />
              測試所有檔案是否符合
            </button>
            <button
              type="button"
              onClick={handleClearCurrent}
              disabled={executing}
              title="僅清除當前正在檢視的這一組的定位代碼與取代代碼（保留智慧貼上區與原版代碼）"
              style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
            >
              <EraserStrokeIcon size={14} />
              清空輸入框
            </button>
          </div>
          <div style={{ display: "flex", gap: 8 }}>
            <button type="button" onClick={onClose} disabled={executing}>
              關閉
            </button>
            <button
              type="button"
              className="primary"
              onClick={() => void handleExecute()}
              disabled={executing}
              style={{ display: "inline-flex", alignItems: "center", gap: 4 }}
            >
              <ZapStrokeIcon size={14} />
              {executing
                ? "寫入中…"
                : isBoardMode
                  ? "套用取代並寫入檔案"
                  : "套用取代（更新卡片代碼）"}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}