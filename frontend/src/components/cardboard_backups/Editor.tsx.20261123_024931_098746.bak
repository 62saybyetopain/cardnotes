type Status = "saved" | "dirty" | "saving" | "error" | "conflict";

interface Props {
  card: CardDetail;
  // 文獻編輯用（皆為選填，未傳＝卡片行為）：
  // save 取代 api.patchCard；allowMention=false 關閉 @ 引用（文獻之間沒有連結，原文裡的 @ 也不該跳彈窗）；
  // pasteTransform 取代預設的 transformPasteContent（它只保留清單，其餘格式都會消失）；回傳 null＝交給瀏覽器原生純文字貼上
  // plainPaste=true 貼上一律走純文字（目前沒有呼叫端使用）
  save?(patch: { title: string; body: string }, expectedUpdatedAt: string): Promise<CardDetail>;
  allowMention?: boolean;
  plainPaste?: boolean;
  pasteTransform?(plainText: string, htmlText: string): string | null;
  compact?: boolean;
  hideTopToolbar?: boolean;
  initialSmartPaste?: string | null;
  onClearInitialSmartPaste?(): void;
  initialFind?: string | null; // 從搜尋結果進來時帶入的搜尋詞：開啟尋找列並跳到第一筆
  onClearInitialFind?(): void;
  onSaved(card: CardDetail): void;
  onReload(): void;
  onLinkAdded?(sourceId: string, targetId: string, extra?: Partial<BoardLink>): void;
  onOpenCard?(cardId: string): void;
  onDirtyChange?(dirty: boolean): void;
  // 中央編輯器專用：寫檔成功後的「關閉並回到白板」；沒傳（右側面板）就不顯示該按鈕
  onReturnToBoard?(): void;
  report(e: unknown, prefix?: string): void;
}

type BodySegment =
  | { kind: "text"; text: string; start: number; end: number }
  | {
      kind: "media";
      mediaId: string;
      alt: string;
      explicitWidth?: string;
      rawStart: number;
      rawEnd: number;
      removeStart: number;
      removeEnd: number;
    }
  | {
      kind: "details";
      isOpen: boolean;
      rawTag: string;
      summary: string;
      content: string;
      rawStart: number;
      rawEnd: number;
      contentStart: number;
      contentEnd: number;
    };

const INLINE_MEDIA_RE = /!\[([^\]]*)\]\(media:([0-9a-fA-F-]{36})\)/g;
// 收摺章節：先比對開標籤＋summary，再以巢狀深度找對應的 </details>（不用惰性比對，巢狀時才不會提早結束）
const DETAILS_OPEN_RE = /<details(\s+open)?>\s*<summary>([\s\S]*?)<\/summary>/gi;
const DETAILS_TAG_RE = /<details(?:\s+open)?>|<\/details>/gi;

// 圍欄代碼塊的範圍（含開頭與結尾行）：收摺標籤出現在代碼裡只是代碼文字，不能切段
function fencedRanges(body: string): [number, number][] {
  const FENCE = "`".repeat(3);
  const ranges: [number, number][] = [];
  let open = -1;
  let openLen = 0;
  let pos = 0;
  while (pos <= body.length) {
    let nl = body.indexOf("\n", pos);
    if (nl < 0) nl = body.length;
    const t = body.slice(pos, nl).trim();
    if (open < 0) {
      if (t.startsWith(FENCE)) {
        openLen = 0;
        while (t[openLen] === "`") openLen++;
        open = pos;
      }
    } else if (t.length >= openLen && t.replace(/`/g, "") === "") {
      ranges.push([open, nl]);
      open = -1;
    }
    pos = nl + 1;
  }
  if (open >= 0) ranges.push([open, body.length]);
  return ranges;
}

// CodeMirror 會把 \r\n 視為單一換行，若 body 留著 \r，全域字元位移會與 view 錯位；載入時統一成 \n
function normalizeNewlines(s: string): string {
  return s.replace(/\r\n?/g, "\n");
}

function extractWidthFromAlt(alt: string): { baseAlt: string; width?: string } {
  const pipeIdx = alt.lastIndexOf("|");
  if (pipeIdx < 0) return { baseAlt: alt };
  const raw = alt.slice(pipeIdx + 1).trim();
  const baseAlt = alt.slice(0, pipeIdx);
  if (/^\d+(px|%)?$/.test(raw)) {
    return { baseAlt, width: raw.endsWith("px") || raw.endsWith("%") ? raw : `${raw}px` };
  }
  return { baseAlt: alt };
}

type RawMatchItem =
  | { kind: "media"; index: number; end: number; alt: string; mediaId: string }
  | {
      kind: "details";
      index: number;
      end: number;
      isOpen: boolean;
      rawTag: string;
      summary: string;
      content: string;
      contentStart: number;
      contentEnd: number;
    };

function splitBodySegments(body: string): BodySegment[] {
  const allMatches: RawMatchItem[] = [];

  let m: RegExpExecArray | null;
  INLINE_MEDIA_RE.lastIndex = 0;
  while ((m = INLINE_MEDIA_RE.exec(body)) !== null) {
    allMatches.push({
      kind: "media",
      index: m.index,
      end: m.index + m[0].length,
      alt: m[1] ?? "",
      mediaId: m[2],
    });
  }

  const fences = fencedRanges(body);
  const inFence = (i: number) => fences.some(([a, b]) => i >= a && i < b);

  DETAILS_OPEN_RE.lastIndex = 0;
  while ((m = DETAILS_OPEN_RE.exec(body)) !== null) {
    if (inFence(m.index)) continue;
    const summaryEnd = m.index + m[0].length;
    let depth = 1;
    let closeStart = -1;
    let t: RegExpExecArray | null;
    DETAILS_TAG_RE.lastIndex = summaryEnd;
    while ((t = DETAILS_TAG_RE.exec(body)) !== null) {
      if (inFence(t.index)) continue;
      depth += t[0].startsWith("</") ? -1 : 1;
      if (depth === 0) {
        closeStart = t.index;
        break;
      }
    }
    // 沒有對應的 </details>：保持一般文字，不切段
    if (closeStart < 0) continue;
    const closeEnd = closeStart + "</details>".length;

    // 內文區間必須與 body 逐字對應（LiveSegmentEditor 以全域位移改寫 body）：只收掉頭尾換行，不另做 trim
    let contentStart = summaryEnd;
    let contentEnd = closeStart;
    while (contentStart < contentEnd && body[contentStart] === "\n") contentStart++;
    while (contentEnd > contentStart && body[contentEnd - 1] === "\n") contentEnd--;

    allMatches.push({
      kind: "details",
      index: m.index,
      end: closeEnd,
      isOpen: Boolean(m[1]),
      rawTag: m[1] ? "<details open>" : "<details>",
      summary: m[2].replace(/<[^>]+>/g, "").trim() || "章節內容",
      content: body.slice(contentStart, contentEnd),
      contentStart,
      contentEnd,
    });
    DETAILS_OPEN_RE.lastIndex = closeEnd;
  }

  if (allMatches.length === 0) {
    return [{ kind: "text", text: body, start: 0, end: body.length }];
  }

  allMatches.sort((a, b) => a.index - b.index);

  const segments: BodySegment[] = [];
  let prevEnd = 0;

  for (const hit of allMatches) {
    // 落在前一個區塊（例如收摺章節）內部的項目，由該區塊的內文編輯器負責
    if (hit.index < prevEnd) continue;

    // 沿用原本圖片的規則：區塊前後各一個換行屬於分隔，不放進文字段；
    // 文字段每次都建立（可為空），游標才能落在圖片、章節的前後
    const sepBefore = hit.index > prevEnd && body[hit.index - 1] === "\n" ? 1 : 0;
    const textEnd = hit.index - sepBefore;
    segments.push({
      kind: "text",
      text: body.slice(prevEnd, textEnd),
      start: prevEnd,
      end: textEnd,
    });

    const sepAfter = hit.end < body.length && body[hit.end] === "\n" ? 1 : 0;
    if (hit.kind === "media") {
      const { width } = extractWidthFromAlt(hit.alt);
      segments.push({
        kind: "media",
        mediaId: hit.mediaId,
        alt: hit.alt,
        explicitWidth: width,
        rawStart: hit.index,
        rawEnd: hit.end,
        removeStart: hit.index - sepBefore,
        removeEnd: sepBefore === 0 ? hit.end + sepAfter : hit.end,
      });
    } else {
      segments.push({
        kind: "details",
        isOpen: hit.isOpen,
        rawTag: hit.rawTag,
        summary: hit.summary,
        content: hit.content,
        rawStart: hit.index,
        rawEnd: hit.end,
        contentStart: hit.contentStart,
        contentEnd: hit.contentEnd,
      });
    }
    prevEnd = hit.end + sepAfter;
  }

  segments.push({
    kind: "text",
    text: body.slice(prevEnd),
    start: prevEnd,
    end: body.length,
  });
  return segments;
}

// 全文尋找：只在文字段落內找（圖片語法不算、命中不跨段），回傳命中的全域位移。找的是 body 字串，不是 DOM
function findInBody(text: string, query: string): number[] {
  if (!query) return [];
  const out: number[] = [];
  for (const s of splitBodySegments(text)) {
    if (s.kind !== "text") continue;
    for (const r of findRanges(s.text, query)) out.push(s.start + r.from);
  }
  return out;
}

// 分割按鈕：左側主按鈕直接套用，右側 ▾ 展開樣式選單；兩者貼合成同一個控制項，避免被誤認為兩個獨立功能
function SplitMenuButton(props: {
  open: boolean;
  onToggle(): void;
  main: React.ReactNode;
  mainTitle: string;
  mainActive?: boolean;
  menuLabel: string;
  onMain(): void;
  children: React.ReactNode;
}) {
  const { open, onToggle, main, mainTitle, mainActive, menuLabel, onMain, children } = props;
  return (
    <span data-split style={{ position: "relative", display: "inline-flex" }}>
      <button
        type="button"
        className={mainActive ? "on" : ""}
        aria-pressed={mainActive}
        title={mainTitle}
        onClick={onMain}
        style={{ borderTopRightRadius: 0, borderBottomRightRadius: 0 }}
      >
        {main}
      </button>
      <button
        type="button"
        aria-label={menuLabel}
        aria-expanded={open}
        title={menuLabel}
        onClick={onToggle}
        style={{
          borderTopLeftRadius: 0,
          borderBottomLeftRadius: 0,
          marginLeft: -1,
          padding: "0 5px",
          fontSize: 10,
        }}
      >
        ▾
      </button>
      {open && (
        <div
          role="menu"
          style={{
            position: "absolute",
            top: "100%",
            left: 0,
            marginTop: 4,
            zIndex: 5,
            display: "flex",
            alignItems: "center",
            gap: 4,
            padding: 6,
            background: "var(--panel, #1e293b)",
            border: "1px solid var(--line, #475569)",
            borderRadius: 6,
            boxShadow: "0 4px 14px rgba(0, 0, 0, 0.28)",
          }}
        >
          {children}
        </div>
      )}
    </span>
  );
}

