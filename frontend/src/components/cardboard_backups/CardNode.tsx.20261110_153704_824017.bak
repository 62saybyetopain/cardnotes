import { Handle, NodeResizer, Position, type Node, type NodeProps } from "@xyflow/react";
import { useEffect, useRef, useState, type MouseEvent as ReactMouseEvent } from "react";
import { createPortal } from "react-dom";
import type { BoardElsewhere } from "../types";
import { ErrorBoundary } from "./ErrorBoundary";
import { Markdown } from "./Markdown";

export interface CardNodeData extends Record<string, unknown> {
  title: string;
  body: string;
  updatedAt?: string;
  sized: boolean;
  onResizeEnd: (cardId: string, p: { x: number; y: number; width: number; height: number }) => void;
  onResetSize: (cardId: string) => void;
  onFitHeight: (cardId: string, fullH: number) => void;
  onOpenCard?: (cardId: string) => void;
  elsewhere?: BoardElsewhere; // 僅電腦端；沒有或兩邊都空就不顯示徽章
  onOpenBoard?: (boardId: string) => void;
  report?: (e: unknown, prefix?: string) => void;
}
export type CardFlowNode = Node<CardNodeData, "card">;

// 內容全文所需的卡片高度＝標題／內距等固定部分＋內文自然高度。
// 暫時解除內文的 flex／max-height 再讀 scrollHeight，同步量完立刻還原（不會閃一幀）。
function measureFullHeight(node: HTMLElement, body: HTMLElement): number {
  const chrome = node.offsetHeight - body.clientHeight;
  const prevFlex = body.style.flex;
  const prevMax = body.style.maxHeight;
  body.style.flex = "none";
  body.style.maxHeight = "none";
  const natural = body.scrollHeight;
  body.style.flex = prevFlex;
  body.style.maxHeight = prevMax;
  // 原因：offsetHeight／scrollHeight 都是四捨五入的整數，而標題、內文行高是小數，合計最多差約 1px，
  // 差 1px 就會冒出滑桿；多留 2px 吃掉誤差。底邊雙擊的「是否已是全文高度」判斷用的是同一個值，切換結果不變。
  return Math.max(80, Math.ceil(chrome + natural) + 2);
}

// 「這張卡片也在其他白板」徽章。清單用 portal 畫在畫布外：卡片有 overflow 與縮放，放在節點內會被裁掉或跟著縮放。
// 同支＝目前白板的祖先或後代問題白板；他支＝其餘（不含已封存）。判定在後端 boards.py::_elsewhere，這裡只顯示。
// @depends-on ../types.ts::BoardElsewhere / Board.tsx::toNode（elsewhere、onOpenBoard 由它帶入）
function ElsewhereBadge({ elsewhere, onOpenBoard }: { elsewhere?: BoardElsewhere; onOpenBoard?: (boardId: string) => void }) {
  const btnRef = useRef<HTMLButtonElement>(null);
  const popRef = useRef<HTMLDivElement>(null);
  const [pos, setPos] = useState<{ left: number; top?: number; bottom?: number } | null>(null);

  useEffect(() => {
    if (!pos) return;
    const close = () => setPos(null);
    const down = (e: PointerEvent) => {
      const t = e.target as Node;
      if (popRef.current?.contains(t) || btnRef.current?.contains(t)) return;
      close();
    };
    const key = (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
    };
    const wheel = (e: WheelEvent) => {
      if (!popRef.current?.contains(e.target as Node)) close();
    };
    document.addEventListener("pointerdown", down, true);
    document.addEventListener("keydown", key);
    window.addEventListener("wheel", wheel, { capture: true, passive: true });
    return () => {
      document.removeEventListener("pointerdown", down, true);
      document.removeEventListener("keydown", key);
      window.removeEventListener("wheel", wheel, true);
    };
  }, [pos]);

  if (!elsewhere) return null;
  const same = elsewhere.same.length;
  const other = elsewhere.other.length;
  if (same + other === 0) return null;

  const toggle = () => {
    if (pos) {
      setPos(null);
      return;
    }
    const r = btnRef.current?.getBoundingClientRect();
    if (!r) return;
    const left = Math.max(4, Math.min(r.left, window.innerWidth - 290));
    setPos(r.bottom + 270 <= window.innerHeight ? { left, top: r.bottom + 4 } : { left, bottom: window.innerHeight - r.top + 4 });
  };

  const section = (title: string, list: BoardElsewhere["same"]) =>
    list.length === 0 ? null : (
      <div key={title}>
        <div className="muted" style={{ fontSize: 11, padding: "2px 4px" }}>
          {title}（{list.length}）
        </div>
        {list.map((b) => (
          <button
            key={b.id}
            type="button"
            disabled={!onOpenBoard}
            title={b.name}
            onClick={() => {
              setPos(null);
              onOpenBoard?.(b.id);
            }}
            style={{
              display: "block",
              width: "100%",
              textAlign: "left",
              background: "transparent",
              border: 0,
              color: "inherit",
              padding: "4px 6px",
              borderRadius: 5,
              fontSize: 12,
              cursor: onOpenBoard ? "pointer" : "default",
              overflow: "hidden",
              textOverflow: "ellipsis",
              whiteSpace: "nowrap",
            }}
          >
            {b.name}
          </button>
        ))}
      </div>
    );

  return (
    <>
      <button
        ref={btnRef}
        type="button"
        className="nodrag nopan"
        onClick={(e) => {
          e.stopPropagation();
          toggle();
        }}
        onDoubleClick={(e) => e.stopPropagation()}
        title={`這張卡片也出現在其他白板：同支 ${same} 塊（上層或下層問題）、他支 ${other} 塊。點擊查看`}
        aria-label={`也在其他白板：同支 ${same}、他支 ${other}`}
        aria-expanded={!!pos}
        style={{
          display: "inline-flex",
          alignItems: "center",
          gap: 4,
          flexShrink: 0,
          padding: "1px 6px",
          fontSize: 11,
          lineHeight: "16px",
          borderRadius: 10,
          border: "1px solid var(--line, #475569)",
          background: "transparent",
          color: "var(--text)",
          opacity: 0.85,
          cursor: "pointer",
          whiteSpace: "nowrap",
        }}
      >
        <svg
          width={12}
          height={12}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2.4"
          strokeLinecap="round"
          strokeLinejoin="round"
          aria-hidden="true"
          style={{ flexShrink: 0 }}
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        同支 {same}／他支 {other}
      </button>
      {pos &&
        createPortal(
          <div
            ref={popRef}
            className="nodrag nopan"
            role="menu"
            onClick={(e) => e.stopPropagation()}
            onDoubleClick={(e) => e.stopPropagation()}
            style={{
              position: "fixed",
              left: pos.left,
              top: pos.top,
              bottom: pos.bottom,
              zIndex: 1000,
              width: 280,
              maxHeight: 260,
              overflowY: "auto",
              padding: 6,
              borderRadius: 8,
              background: "var(--panel, #1e293b)",
              border: "1px solid var(--line, #475569)",
              boxShadow: "0 6px 24px rgba(0,0,0,0.35)",
              color: "var(--text)",
            }}
          >
            {section("同支（上層或下層問題）", elsewhere.same)}
            {section("他支（其他白板，不含已封存）", elsewhere.other)}
          </div>,
          document.body,
        )}
    </>
  );
}

export function CardNode({ id, data, selected }: NodeProps<CardFlowNode>) {
  const nodeRef = useRef<HTMLDivElement>(null);
  const bodyRef = useRef<HTMLDivElement>(null);

  // 雙擊縮放把手：四角＝回預設大小；底邊＝量出全文高度交給 Board 切換（目前狀態由 Board 判斷）。
  // 任何把手的雙擊都攔截冒泡，避免被當成「雙擊卡片」而開啟編輯。
  const onDoubleClick = (e: ReactMouseEvent<HTMLDivElement>) => {
    const ctl = (e.target as HTMLElement).closest(".react-flow__resize-control");
    if (!ctl) return;
    e.stopPropagation();
    if (ctl.classList.contains("handle")) {
      data.onResetSize(id);
    } else if (ctl.classList.contains("bottom") && nodeRef.current && bodyRef.current) {
      data.onFitHeight(id, measureFullHeight(nodeRef.current, bodyRef.current));
    }
  };

  return (
    <ErrorBoundary fallback={<div className="card-node card-error">此卡片顯示失敗（{id.slice(0, 8)}）</div>}>
      <div
        ref={nodeRef}
        onDoubleClick={onDoubleClick}
        className={`card-node${selected ? " selected" : ""}${data.sized ? " sized" : ""}`}
      >
        <NodeResizer
          minWidth={180}
          minHeight={80}
          isVisible={true}
          onResizeEnd={(_e, p) => data.onResizeEnd(id, p)}
        />
        <Handle type="target" position={Position.Left} />

        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "flex-start",
            gap: 6,
            marginBottom: "0.5rem",
          }}
        >
          <div
            className="card-title"
            style={{
              fontSize: "1.15rem",
              fontWeight: 700,
              lineHeight: 1.35,
              wordBreak: "break-word",
              flex: 1,
            }}
          >
            {data.title || "（無標題）"}
          </div>
          <ElsewhereBadge elsewhere={data.elsewhere} onOpenBoard={data.onOpenBoard} />
        </div>
        <div className="card-body" ref={bodyRef}>
          <Markdown source={data.body} onOpenCard={data.onOpenCard} />
        </div>

        <Handle type="source" position={Position.Right} />
      </div>
    </ErrorBoundary>
  );
}
