const IMPORTERS=[
  {id:'mineru',label:'MinerU layout.json',detect:b=>!!(b.json&&b.json.pdf_info),blocks:(b,pre)=>fromMineru(b.json,pre)},
  {id:'text',label:'文字／Markdown',detect:b=>!!b.text,blocks:(b,pre)=>fromText(b.text,pre)}
