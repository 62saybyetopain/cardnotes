function fromText(t, scopePrefix){
  const out=[];
  for(let l of nrm(t).split(/\r?\n/)){
    l=l.trim().replace(/^#+\s*/,'');if(!l)continue;
    let m;
    if(/^<table/i.test(l))out.push({t:'tbl',id:'',html:l});
