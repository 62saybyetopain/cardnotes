}
function validate(p){
  const is=[],E=(no,m)=>is.push({lv:'e',no,m}),W=(no,m)=>is.push({lv:'w',no,m});
  const nos=p.questions.map(q=>q.no),mx=Math.max(0,...nos),seen={};
  nos.forEach(n=>{if(seen[n])E(n,'題號重複');seen[n]=1});
  for(let n=1;n<=mx;n++)if(!seen[n])E(n,'缺少這個題號');
// 原因：題幹內的「1. 2. 3.」會被當成新題，後面整段題目併進前一題，切出的題數比答案表少卻不會有任何缺號警告。
if(p.keyMax>mx)E(mx+1,'答案表有 '+p.keyMax+' 題，但只切出 '+mx+' 題：後面的題目可能被併進第 '+mx+' 題，請檢查');
  const cnt={};p.questions.forEach(q=>{if(q.options.length)cnt[q.options.length]=(cnt[q.options.length]||0)+1});
  const mode=+(Object.entries(cnt).sort((a,b)=>b[1]-a[1])[0]||[4])[0];
  const have=new Set(p.have||[]),hasExp=p.source!=='compose'&&p.questions.some(q=>q.exp);
  const miss=(no,bl)=>bl.forEach(b=>{if(b.id&&!b.html&&!have.has(b.id))W(no,'圖片檔缺失：'+b.id.slice(0,16))});
  p.questions.forEach(q=>{
    if(!q.options.length)W(q.no,'選項無法自動切出，改以原始內容顯示、用字母按鈕作答');
    else if(q.options.length!==mode)W(q.no,'選項數為 '+q.options.length+'，多數題為 '+mode);
    if(!q.key)W(q.no,'缺少答案');
    else if(q.options.length&&![...q.key].every(c=>q.options.some(o=>o.k===c)))E(q.no,'答案 '+q.key+' 不在選項內');
    miss(q.no,q.blocks);miss(q.no,q.exp||[]);
    if(hasExp&&!q.exp)W(q.no,'這份考卷有詳解，但這題沒有切到詳解');
  });
  p.passages.forEach(x=>miss(x.from,x.blocks));
  p.issues=is;return is;
}

function importBundle(b,name,paperId){
  const pid=paperId||uid();
  const imp=IMPORTERS.find(i=>i.detect(b));if(!imp)throw Error('找不到可用的格式。請選 MinerU 的 layout.json（或 zip），或貼上文字。');
  const res=assemble(imp.blocks(b,pid),b.key);
  // 原因：注意事項沒遇到結束句時，原訊息只說「題號請用 1.」，會誤導使用者去改題號；直接說出真正原因。
  if(!res.questions.length)throw Error('找不到題目。'+(res.noticeOpen?'「注意事項」區段一直沒有遇到結束句（含「翻閱試題本作答」或「開始作答」的那一行），之後的內容全被略過。':'題號請用「1.」「1、」開頭。'));
  const imgs=Object.keys(b.images||{});
  const autoKeyImgs=imgs.filter(id=>/答案|ans|key/i.test(id));
  const p={id:pid,name,created:new Date().toISOString(),stage:1,graded:false,source:imp.id,keyMax:res.keyMax,keyAll:res.keyAll,expSpare:res.expSpare,have:imgs,keyImgs:autoKeyImgs,eqImgs:b.json?eqImgIds(b.json,pid).filter(id=>imgs.includes(id)):[],passages:res.passages,
    // 原因：非選擇題獨立存放，不進 questions，統計、卡片、組卷都不會碰到。
    nm:(res.nm||[]).map(n=>({...n,mine:'',ok:''})),
    questions:res.questions.map(q=>({...q,mine:'',st:'',sub:'',chap:'',cons:[],guess:false,cause:'',why:'',right:'',fix:'',optNotes:{}}))};
  validate(p);return p;
}
/*PARSE_END*/

/* ---------- storage: IndexedDB (state + image blobs) ---------- */
// 原因：subjs＝考卷清單的分類順序（含還沒有考卷的空分類）；每份考卷自己的分類存在 p.subj。
// @depends-on save()／buildBackupBlob()／restore()：subjs 與 p.subj 要同步出現在這三處，漏一處備份還原就會靜默丟失分類。
const S={papers:[],points:{},tree:[],subjs:[],th:3,url:'',cf:'',cardMap:{},mediaMap:{},cur:null,view:'list',bkMin:15,bkOn:false,bkLastRev:0,bkLastTime:'',bkDirName:''};
const CAUSES=['概念不清','記憶缺漏','題意誤讀','選項陷阱','粗心','計算錯誤'];
let PENDING=null;const U={},MEM={},CARDV={};
let DIR_HANDLE=null,DIR_NEED_PERM=false,BK_TIMER=null;

// 原因：作答／檢討頁沒有 #msg，錯誤會被吞；錯誤另外顯示在固定提示條（點一下關閉），任何頁面與捲動位置都看得到。
const msg=(t,isErr)=>{
  const m=document.querySelector('#msg');
  if(m){m.textContent=t;m.style.color=isErr?'var(--red)':'inherit';m.style.fontWeight=isErr?'700':'normal'}
  let o=document.querySelector('#toast');
  if(!t){if(o)o.remove();return}
  if(m&&!isErr)return;
  if(!o){o=document.createElement('div');o.id='toast';o.style.cssText='position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:10;padding:10px 12px;border-radius:8px;background:var(--card);border:1px solid var(--line);cursor:pointer';o.onclick=()=>o.remove();document.body.appendChild(o)}
  o.textContent=t;o.style.color=isErr?'var(--red)':'var(--ink)';o.style.fontWeight=isErr?'700':'400';
  clearTimeout(msg.tm);if(!isErr)msg.tm=setTimeout(()=>o.remove(),4000);
};

const reportDbErr=e=>{
  console.error("IndexedDB error", e);
  const isQuota=e&&(e.name==='QuotaExceededError'||e.code===22||(e.message&&/quota/i.test(e.message)));
  msg(isQuota?'儲存失敗（瀏覽器儲存空間已滿）：請先回清單頁匯出備份，刪除舊考卷後再重新載入。':'本機資料庫儲存失敗：'+(e&&e.message||e),true);
};

const db=new Promise((res,rej)=>{try{const r=indexedDB.open('exam-review',1);r.onupgradeneeded=()=>{r.result.createObjectStore('kv');r.result.createObjectStore('assets')};r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)}catch(e){rej(e)}});
db.catch(reportDbErr);

const tx=(st,mode,fn)=>db.then(d=>new Promise((res,rej)=>{
  const t=d.transaction(st,mode),r=fn(t.objectStore(st));
  t.oncomplete=()=>res(r?r.result:undefined);
  t.onerror=()=>rej(t.error);
  // 原因：容量不足通常只在 commit 時觸發 abort；不補這行 Promise 永遠不結算，錯誤被吞。
  t.onabort=()=>rej(t.error||new Error('交易被中止'));
}));
const aGet=id=>tx('assets','readonly',s=>s.get(id));

let LOADED=false,REV=0;
// 原因：save() 每次整包覆蓋。(1)載入沒成功就存，會用空資料蓋掉舊資料；(2)另一個分頁已寫入較新版本時再存，會蓋掉對方的作答。兩者都拒絕並大聲報錯。
const save=()=>{
  if(!LOADED){msg('資料尚未成功載入，已拒絕儲存以免覆蓋舊資料，請重新整理',true);return Promise.resolve()}
  return db.then(d=>new Promise((res,rej)=>{
    const t=d.transaction('kv','readwrite'),s=t.objectStore('kv'),g=s.get('state');
    let conflict=false,next=0;
    g.onsuccess=()=>{
      const cur=g.result;
      if(cur&&(cur.rev||0)!==REV){conflict=true;t.abort();return}
      next=REV+1;
      s.put({rev:next,papers:S.papers,points:S.points,tree:S.tree,subjs:S.subjs,shuf:S.shuf,n1:S.n1,n2:S.n2,th:S.th,cf:S.cf,cardMap:S.cardMap,mediaMap:S.mediaMap,skip:S.skip,bkMin:S.bkMin,bkOn:S.bkOn,bkLastRev:S.bkLastRev,bkLastTime:S.bkLastTime,bkDirName:S.bkDirName},'state');
    };
    t.oncomplete=()=>{REV=next;res()}; // 原因：容量不足在 commit 才 abort；REV 若在 request 成功時就前進，失敗後每次存檔都會誤報「另一個分頁已更新」。
    t.onabort=()=>{
      if(conflict){msg('偵測到另一個分頁已更新資料，為避免覆蓋已停止儲存。請先回清單頁按「匯出備份」保留本頁內容，再關閉其他分頁並重新整理。',true);res()}
      else rej(t.error||new Error('交易被中止'));
    };
  })).catch(reportDbErr);
};

function fix(){
  // 原因：舊版把「沒作答」判成錯並存了下來，單靠補丁 A 清不掉；非手動標記、沒作答卻是錯的紀錄，一律還原成未判，並明確提示筆數。
  let n=0;
  S.papers.forEach(p=>{
    if(p.stage>2)p.stage=2;
    // 原因：修復多次重做導致考卷名稱疊加「重做・」與重複日期的歷史資料
    if(/^(?:重做・){2,}/.test(p.name)||/(?:・\d{1,2}[\/月]\d{1,2}日?){2,}$/.test(p.name)){
      const base=p.name.replace(/^(?:重做・)+/,'').replace(/(?:・\d{1,2}[\/月]\d{1,2}日?)+$/,'');
      const lastDate=(p.name.match(/・\d{1,2}[\/月]\d{1,2}日?$/)||[''])[0];
      p.name='重做・'+base+lastDate;
    }
    p.questions.forEach(q=>{q.sub=q.sub||'';q.chap=q.chap||'';q.cons=q.cons||[];q.guess=!!q.guess;if(!q.mine&&!q.manual&&q.st==='x'){q.st='';n++}});
  });
  if(n)msg('已修正 '+n+' 題「沒作答卻被判錯」的紀錄，這些題不再計入統計',false);
}
async function load(){try{const v=await tx('kv','readonly',s=>s.get('state'));if(v){Object.assign(S,v);REV=v.rev||0;fix()}LOADED=true;try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(e){}}catch(e){reportDbErr(e);}}
async function loadAssets(p){
  const ids=new Set();[...p.questions,...p.passages,...(p.nm||[])].forEach(x=>[...x.blocks,...(x.exp||[])].forEach(b=>{if(b.id)ids.add(b.id)}));
  orph(p).forEach(id=>ids.add(id)); // 原因：未使用的圖也要先載入，補圖面板才有縮圖可看。
  for(const id of ids){
    if(U[id])continue;
    const b=MEM[id]||await aGet(id).catch(()=>null);
    if(b){MEM[id]=b;U[id]=URL.createObjectURL(b)}
  }
}

/* ---------- helpers ---------- */
const $=s=>document.querySelector(s);
/* ---------- theme ---------- */
// 原因：主題由 <html data-theme> 決定（與卡片軟體同一套寫法）；選擇存在 localStorage，存不進去要明說，不然使用者以為會記住。
const THEME_KEY='exam-theme';
const themeNow=()=>document.documentElement.getAttribute('data-theme')==='light'?'light':'dark';
function setTheme(t,persist){
  document.documentElement.setAttribute('data-theme',t);
  if(persist){try{localStorage.setItem(THEME_KEY,t)}catch(e){msg('無法記住主題設定（瀏覽器禁止本機儲存），重新整理後會恢復',true)}}
}
const ICON={
  sun:'<svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  moon:'<svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>'
};
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const P=()=>S.papers.find(p=>p.id===S.cur);
const norm=s=>[...String(s).toUpperCase().replace(/\s/g,'')].sort().join('');
const cid=(p,q)=>'exam:'+p.id+':q'+q.no;
const qtext=q=>q.blocks.filter(b=>b.t==='text'||b.t==='code').map(b=>b.v).join('\n');
const LET=p=>{const s=new Set();p.questions.forEach(q=>q.options.forEach(o=>s.add(o.k)));return s.size?[...s].sort():[...'ABCD']};
const safe=h=>h.replace(/<(?!\/?(?:table|thead|tbody|tr|td|th)\b)[^>]*>/gi,'').replace(/<(table|thead|tbody|tr|td|th)\b([^>]*)>/gi,(m,t,a)=>'<'+t+(a.match(/(?:row|col)span="\d+"/g)||[]).map(x=>' '+x).join('')+'>');
function blk(b,pre){
  if(b.t==='text')return'<p class="stem">'+(pre||'')+esc(b.v)+'</p>';
  if(b.t==='code')return'<pre>'+esc(b.v)+'</pre>';
  if(U[b.id])return'<img class="fig" data-a="zoom" data-src="'+U[b.id]+'" src="'+U[b.id]+'" alt="">';
  if(b.html)return'<div class="tbl">'+safe(b.html)+'</div>';
  return'<p class="miss">圖片缺失：'+esc((b.id||'').slice(0,16))+'</p>';
}
function blks(a,pre){let u=pre||'';return a.map(b=>{const h=blk(b,u);if(b.t==='text')u='';return h}).join('')+u}
const wr=(p,q)=>{const w=(p.issues||[]).filter(i=>i.no===q.no);return w.length?'<p class="wr">⚠ '+esc(w.map(i=>i.m).join('；'))+'</p>':''};

/* ---------- stats and tags ---------- */
const tnode=sub=>S.tree.find(s=>s.n===sub);
const chapsOf=sub=>(tnode(sub)||{c:[]}).c.map(c=>c.n);
const allCons=()=>[...new Set(S.tree.flatMap(s=>s.c.flatMap(c=>c.k)))];
const homeOf=n=>{for(const s of S.tree)for(const c of s.c)if(c.k.includes(n))return{sub:s.n,chap:c.n};return{}};
function ensure(sub,chap,con){
  let s=tnode(sub);if(sub&&!s){s={n:sub,c:[]};S.tree.push(s)}
  if(!s||!chap)return;
  let c=s.c.find(x=>x.n===chap);if(!c){c={n:chap,k:[]};s.c.push(c)}
  if(con&&!allCons().includes(con))c.k.push(con);
}
function setTag(p,i,f,v){
  // 原因：原版會把後面「沒概念、值相同」的題全部連動代入，Q1 填完整份考卷就都被標成同一個章節，統計失真；改成每題只改自己。
  const q=p.questions[i];
  if(q[f]===v)return;
  const was=q.cons;
  q[f]=v;if(f==='sub')q.chap='';
  // 原因：改章節通常是改正歸屬，概念本身沒有錯，清空只會逼使用者重打。改成概念跟著搬到新章節；概念在樹裡只有一個家，所以先從舊章節移除、再掛到新章節。
  // 例外：這個概念還有別題在用（不含同一題在其他考卷的副本，它們會跟著同步）就不能同時屬於兩個章節，這題先移除並大聲說明。改科目、或章節被清空時沒有章節可掛，維持清空。
  if(f==='chap'&&v&&was.length){
    const tw=new Set(twins(p,q).map(a=>a[1])),lost=[];
    q.cons=was.filter(k=>{
      if(S.papers.some(x=>x.questions.some(y=>y!==q&&!tw.has(y)&&y.cons.includes(k)))){lost.push(k);return false}
      S.tree.forEach(s=>s.c.forEach(c=>{const j=c.k.indexOf(k);if(j>=0)c.k.splice(j,1)}));
      return true;
    });
    ensure(q.sub,v);q.cons.forEach(k=>ensure(q.sub,v,k));
    if(lost.length)msg('概念「'+lost.join('、')+'」在原章節還有其他題在用，一個概念只能屬於一個章節，這題已先移除它；要保留請改用不同的概念名稱。',true);
    return;
  }
  q.cons=[];
  if(f==='sub')ensure(v);else ensure(q.sub,v);
}
const qidOf=(p,q)=>q.qid||cid(p,q);
const twins=(p,q)=>{const id=qidOf(p,q),r=[];S.papers.forEach(x=>x.questions.forEach(y=>{if(y!==q&&qidOf(x,y)===id)r.push([x,y])}));return r};
function syncEdit(p,q,f,v){
  const tw=twins(p,q),oo=o=>o.o||o.k;
  if(f.startsWith('eb:')){const j=+f.slice(3);q.blocks[j].v=v;tw.forEach(([x,y])=>{if(y.blocks[j])y.blocks[j].v=v})}
  else if(f.startsWith('pb:')){
    const j=+f.slice(3),ps=po(p,q),pk=ps.oid||p.id+':'+ps.id;ps.blocks[j].v=v;
    S.papers.forEach(x=>x.passages.forEach(z=>{if(z!==ps&&(z.oid||x.id+':'+z.id)===pk&&z.blocks[j])z.blocks[j].v=v}));
  }else if(f.startsWith('eo:')){
    const o=q.options.find(z=>z.k===f.slice(3));o.v=v;
    tw.forEach(([x,y])=>{const m=y.options.find(z=>oo(z)===oo(o));if(m)m.v=v});
  }else if(f.startsWith('ex:')){
    const j=+f.slice(3);q.exp[j].v=v;tw.forEach(([x,y])=>{if(y.exp&&y.exp[j])y.exp[j].v=v});
  }else if(f==='key'){
    const ks=[...new Set(v.toUpperCase().replace(/[^A-H]/g,''))],orig=ks.map(k=>{const o=q.options.find(z=>z.k===k);return o?oo(o):k});
    q.key=ks.sort().join('');delete q.manual;
    tw.forEach(([x,y])=>{y.key=orig.map(ol=>{const m=y.options.find(z=>oo(z)===ol);return m?m.k:ol}).sort().join('');delete y.manual});
  }
  new Set([p,...tw.map(a=>a[0])]).forEach(x=>{validate(x);if(f==='key'&&(x===p||x.graded))grade(x)});
}
const tagsOf=q=>JSON.stringify([q.sub,q.chap,q.cons]);
// 原因：概念在樹裡只有一個家；沒有任何題目還在用、也沒寫常錯重點的，留著會讓它卡在舊章節，換章節後無法在新章節重建。空章節與空科目一併清理。
function pruneCons(){
  const qs=S.papers.flatMap(p=>p.questions);
  const used=new Set(qs.flatMap(q=>q.cons)),uSub=new Set(qs.map(q=>q.sub).filter(Boolean)),uChap=new Set(qs.filter(q=>q.sub&&q.chap).map(q=>q.sub+'\u0001'+q.chap));
  S.tree.forEach(s=>{
    s.c.forEach(c=>{c.k=c.k.filter(k=>used.has(k)||S.points[k])});
    s.c=s.c.filter(c=>c.k.length||uChap.has(s.n+'\u0001'+c.n));
  });
  S.tree=S.tree.filter(s=>s.c.length||uSub.has(s.n));
}
function withSync(p,fn){
  const b=p.questions.map(tagsOf);fn();
  p.questions.forEach((q,i)=>{if(tagsOf(q)!==b[i])twins(p,q).forEach(([x,y])=>{y.sub=q.sub;y.chap=q.chap;y.cons=[...q.cons]})});
  pruneCons();
}
function renameTag(t,sub,old,nw){
  nw=(nw||'').trim();if(!nw||nw===old)return;
  const qs=S.papers.flatMap(p=>p.questions);
  if(t==='s'){
    qs.forEach(q=>{if(q.sub===old)q.sub=nw});
    const a=tnode(old),b=tnode(nw);
    if(!b)a.n=nw;
    else{a.c.forEach(c=>{const d=b.c.find(x=>x.n===c.n);if(d)d.k.push(...c.k.filter(k=>!d.k.includes(k)));else b.c.push(c)});S.tree=S.tree.filter(x=>x!==a)}
  }else if(t==='c'){
    qs.forEach(q=>{if(q.sub===sub&&q.chap===old)q.chap=nw});
    const s=tnode(sub),a=s.c.find(x=>x.n===old),b=s.c.find(x=>x.n===nw);
    if(!b)a.n=nw;
    else{b.k.push(...a.k.filter(k=>!b.k.includes(k)));s.c=s.c.filter(x=>x!==a)}
  }else{
    const hOld=homeOf(old),hNew=homeOf(nw);
    if(hNew.sub&&(hNew.sub!==hOld.sub||hNew.chap!==hOld.chap))return msg('概念「'+nw+'」已屬於「'+hNew.sub+' / '+hNew.chap+'」，不能跨章節合併。請先將題目改到相同章節。',true);
    qs.forEach(q=>{if(q.cons.includes(old))q.cons=[...new Set(q.cons.map(k=>k===old?nw:k))]});
    const had=allCons().includes(nw);
    S.tree.forEach(s=>s.c.forEach(c=>{const i=c.k.indexOf(old);if(i<0)return;if(had)c.k.splice(i,1);else c.k[i]=nw}));
    if(S.points[old]!=null){S.points[nw]=[S.points[nw],S.points[old]].filter(Boolean).join('\n');delete S.points[old]}
  }
}
function groups(){
  const m={},tOf=p=>p.gradedAt||p.created||'';
  [...S.papers].sort((a,b)=>a.created<b.created?-1:1).forEach(p=>p.questions.forEach(q=>{const k=q.qid||cid(p,q);(m[k]=m[k]||{id:k,all:[]}).all.push({p,q})}));
  return Object.values(m).map(g=>{g.att=g.all.filter(x=>x.q.st).sort((a,b)=>tOf(a.p)<tOf(b.p)?-1:tOf(a.p)>tOf(b.p)?1:0);g.canon=g.all[0].q;g.first=g.att[0];g.last=g.att[g.att.length-1];return g}).filter(g=>g.att.length);
}
function agg(){
  const a={s:{},c:{},k:{},u:0,cause:{}};
  const add=(o,k,q)=>{const r=o[k]=o[k]||{n:0,w:0,g:0};r.n++;if(q.st==='x')r.w++;else if(q.guess)r.g++};
  groups().forEach(g=>{
    const f=g.first.q,t=g.canon;
    if(!t.cons.length)a.u++;
    if(t.sub)add(a.s,t.sub,f);
    if(t.chap)add(a.c,t.sub+'\u0001'+t.chap,f);
    t.cons.forEach(k=>add(a.k,k,f));
    if(f.st==='x'){const c=f.cause||'未填';a.cause[c]=(a.cause[c]||0)+1}
  });
  return a;
}
const weak=g=>g.last.q.st==='x'||!!g.last.q.guess;
const everWeak=g=>g.att.some(x=>x.q.st==='x'||x.q.guess);
function pick(k){
  const n1=S.n1??15,n2=S.n2??10,gs=groups().filter(g=>!k||g.canon.cons.includes(k)),tOf=p=>(p.gradedAt||p.created||'').slice(0,10);
  const wPool=gs.filter(weak);
  for(let i=wPool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[wPool[i],wPool[j]]=[wPool[j],wPool[i]]}
  const a=wPool.sort((x,y)=>tOf(y.last.p).localeCompare(tOf(x.last.p))).slice(0,n1);
  const rest=gs.filter(g=>everWeak(g)&&!a.includes(g));
  for(let i=rest.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[rest[i],rest[j]]=[rest[j],rest[i]]}
  const b=n2>0?rest.slice(0,n2+Math.max(0,n1-a.length)):[];
  return[...a,...b].sort((x,y)=>{const u=x.all[0].p.created,v=y.all[0].p.created;return u===v?x.canon.no-y.canon.no:u<v?-1:1});
}
const cleanPaperName=s=>String(s||'未命名考卷').replace(/^(?:重做・)+/,'').replace(/(?:・\d{1,2}[\/月]\d{1,2}日?)+$/,'').trim();
const compose=k=>{const picks=pick(k);return picks.length?build(picks,'錯題重做・'+(k||'全部')):null};
const resit=p=>build(p.questions.map(q=>({id:q.qid||cid(p,q),last:{p,q},canon:q,all:[{p,q}],from:q.from})),'重做・'+cleanPaperName(p.name));
function build(picks,label){
  const d=new Date().toLocaleDateString('zh-TW',{month:'numeric',day:'numeric'});
  const allHave=new Set(S.papers.flatMap(p=>p.have||[]));
  const np={id:uid(),name:label+'・'+d,created:new Date().toISOString(),stage:1,graded:false,source:'compose',
    have:[],passages:[],questions:[]};
  // 原因：衍生考卷（重做、抽題）沿用原卷科目；挑出的題目來自不同科目時沒有單一科目可沿用，放「未分類」而不是亂猜。
  const sj=[...new Set(picks.map(g=>g.all[0].p.subj||''))];
  np.subj=sj.length===1?sj[0]:'';
  const pm={};
  picks.forEach(g=>{
    const{p,q}=g.last,t=g.canon,o=g.all[0];
    const c=JSON.parse(JSON.stringify(q));
    Object.assign(c,{no:np.questions.length+1,qid:g.id,sub:t.sub,chap:t.chap,cons:[...t.cons],mine:'',st:'',manual:false,guess:false,cause:'',why:'',right:'',fix:'',optNotes:{},from:g.from||(o.p.name+' 第 '+t.no+' 題')});
    if(S.shuf!==false&&c.options.length>1&&!c.options.some(x=>/以上皆|以上均|皆是|皆非|皆正確|皆錯誤|皆不|上述|同上|選項|[(（][A-H][)）]/.test(x.v))){
      const idx=c.options.map((_,i)=>i),old=c.options,m={};
      for(let i=idx.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idx[i],idx[j]]=[idx[j],idx[i]]}
      c.options=idx.map((oi,ni)=>{m[old[oi].k]=old[ni].k;return{k:old[ni].k,v:old[oi].v,o:old[oi].o||old[oi].k}});
      c.key=[...c.key].map(x=>m[x]||x).sort().join('');
    }
    const ps=po(p,q);
    if(ps){
      const key=ps.oid||p.id+':'+ps.id;
      if(!pm[key]){pm[key]=JSON.parse(JSON.stringify(ps));pm[key].id='c'+np.passages.length+uid();pm[key].from=c.no;pm[key].oid=key;np.passages.push(pm[key])}
      pm[key].to=c.no;c.pid=pm[key].id;
    }else delete c.pid;
    np.questions.push(c);
  });
  np.have=[...new Set([...np.questions,...np.passages].flatMap(x=>[...x.blocks,...(x.exp||[])].filter(b=>b.id&&allHave.has(b.id)).map(b=>b.id)))];
  validate(np);return np;
}
const ids=bl=>bl.filter(b=>b.id).map(b=>b.id);
const tg=(sub,chap,cons)=>[...(chap?[{axis:'location',name:chap,facet:sub||null}]:sub?[{axis:'location',name:sub,facet:null}]:[]),...cons.map(n=>({axis:'concept',name:n}))];
const tblText=h=>(h.match(/<tr[^>]*>.*?<\/tr>/gis)||[]).map(r=>[...r.matchAll(/<t[dh][^>]*>(.*?)<\/t[dh]>/gis)].map(m=>m[1].replace(/<[^>]*>/g,'').trim()).join(' ｜ ')).join('\n');
const mdBlocks=(bl,have)=>bl.map(b=>b.t==='text'?b.v:b.t==='code'?'```\n'+b.v+'\n```':(b.id&&have.has(b.id))?'![](exam-asset:'+b.id+')':b.html?tblText(b.html):'（圖片缺失）').join('\n\n');

function buildCards(only){
  const now=new Date().toISOString(),cards=[],a=agg(),scope=new Set();
  groups().forEach(g=>{
    // 原因：一次只匯出一份考卷的卡片（有 only 時）：只處理這份考卷有作答紀錄的題目；重點卡只含這些題目的概念。
    if(only){if(!g.att.some(x=>x.p===only))return;g.canon.cons.forEach(k=>scope.add(k))}
    // 原因：使用者在檢討頁勾選「不匯出成卡片」的題目。只影響本頁匯出；卡片軟體端已存在的卡片不動，cardMap 紀錄保留，取消勾選後可繼續更新同一張。
    if(S.skip&&S.skip[g.id])return;
    const curQ = only ? (g.all.find(x=>x.p===only)||{}).q : g.last.q;
    const hasWrong = g.att.some(x=>x.q.st==='x');
    const hasGuess = g.att.some(x=>x.q.guess);
    const hasNotes = g.att.some(x=>x.q.cause||x.q.why||x.q.right||x.q.fix||Object.values(x.q.optNotes||{}).some(Boolean));
    const hasAppend = !!(curQ && curQ.appendNote && curQ.appendNote.trim());
    if(!hasWrong && !hasGuess && !hasNotes && !hasAppend) return;

    const t=g.canon, o=g.all[0], nw=g.att.filter(x=>x.q.st==='x').length;
    const p=o.p, ps=po(p,t);

    // 原因：重做卷的選項會被打亂，optNotes 與 mine 用的是「當次顯示的字母」，卡片卻以原卷選項顯示；先轉回原始字母（o.o||o.k）再對回原卷選項，筆記與作答才不會貼錯選項。
    const oo=o=>o.o||o.k, toOrig=(qq,ks)=>[...ks].map(k=>{const o=qq.options.find(z=>z.k===k);return o?oo(o):k});
    let cause='', why='', right='', fix='';
    const mergedOptNotes={};
    for(const att of g.att){
      if(att.q.cause) cause=att.q.cause;
      if(att.q.why) why=att.q.why;
      if(att.q.right) right=att.q.right;
      if(att.q.fix) fix=att.q.fix;
      Object.entries(att.q.optNotes||{}).forEach(([k,v])=>{if(v&&v.trim())mergedOptNotes[toOrig(att.q,k)[0]]=v.trim()});
    }

    const opts=t.options.map(x=>x.k+'. '+x.v).join('\n');
    const notes=t.options.filter(x=>mergedOptNotes[oo(x)]).map(x=>x.k+'：'+mergedOptNotes[oo(x)]).join('\n');
    const front=qtext(t)+(opts?'\n'+opts:''),ref=o.p.name+' 第 '+t.no+' 題';
    const lastQ=g.last.q;
    const mineC=toOrig(lastQ,lastQ.mine||'').map(ol=>{const o=t.options.find(z=>oo(z)===ol);return o?o.k:ol}).sort().join('');
    const back=['正解：'+(t.key||'?')+'（最新作答：'+(mineC||'未答')+'）',
      '作答 '+g.att.length+' 次、錯 '+nw+' 次'+(g.att.some(x=>x.q.guess)?'（含猜對紀錄）':''),
      cause&&'錯因：'+cause,
      why&&'我為什麼選錯：'+why,
      right&&'正確的理由：'+right,
      fix&&'下次判斷：'+fix,
      notes&&'選項筆記：\n'+notes
    ].filter(Boolean).join('\n');

    const ctx=ps?ps.blocks.filter(b=>b.t==='text').map(b=>b.v).join('\n'):'';
    const have=new Set([...(p.have||[]),...Object.keys(MEM)]);
    const body=(ps?'**題組**\n\n'+mdBlocks(ps.blocks,have)+'\n\n':'')+'**題目**\n\n'+mdBlocks(t.blocks,have)+(t.options.length?'\n\n'+t.options.map(x=>'- '+x.k+'. '+x.v).join('\n'):'')+'\n\n**解析**\n\n'+back.split('\n').join('\n\n');

    cards.push({
      id:g.id,
      type:'wrong-question',
      card_type:'question',
      curation_status:'inbox',
      title:ref,
      front,
      back,
      context:ctx,
      body,
      assets:[...ids(t.blocks),...(ps?ids(ps.blocks):[])],
      tags:tg(t.sub,t.chap,t.cons),
      sources:[ref],
      created_at:o.p.created,
      updated_at:now,
      curQ,
      appNote:curQ&&curQ.appendNote?curQ.appendNote.trim():'',
      appSynced:curQ?curQ.appendSyncedText||'':''
    });
  });

  Object.keys(a.k).forEach(t=>{
    if(only&&!scope.has(t))return;
    if(!S.points[t])return;
    const h=homeOf(t);
    cards.push({
      id:'exam:point:'+t,
      type:'key-point',
      card_type:'concept',
      curation_status:'inbox',
      title:t+'：常錯重點',
      front:t+'常錯在哪？',
      back:S.points[t],
      context:'',
      body:S.points[t],
      assets:[],
      tags:tg(h.sub,h.chap,[t]),
      sources:['錯題彙整'],
      created_at:now,
      updated_at:now
    });
  });
  return cards;
}

const tn=t=>(t.facet?t.facet+'/':'')+t.name;
// 原因：考卷名、概念名含逗號或「: 」時，未加引號的 YAML 會被拆成多項或解析失敗；JSON 字串是合法的 YAML 雙引號字串。
const toMd=c=>c.map(x=>'---\nid: '+JSON.stringify(x.id)+'\ncard_type: '+x.card_type+'\ntitle: '+JSON.stringify(x.title)+'\ntags: ['+x.tags.map(t=>JSON.stringify(tn(t))).join(', ')+']\nsources: ['+x.sources.map(s=>JSON.stringify(s)).join(', ')+']\n---\n\n'+x.body.replace(/exam-asset:([^)\s]+)/g,'images/$1')+'\n').join('\n');
function show(t){
  $('#out').value=t;$('#out').hidden=false; // 原因：輸出框預設隱藏，Markdown／JSON 匯出時才顯示。
  try{navigator.clipboard.writeText(t).then(()=>msg('已複製到剪貼簿'),()=>msg('請手動全選複製'))}catch(e){msg('請手動全選複製')}
}
const getAsset=async id=>MEM[id]||await aGet(id).catch(()=>null);

/* ---- card app bridge ---- */
let EXT={chaps:{},cons:[]};
const cn=()=>{try{return window.opener&&window.opener.__cardnoteApi||null}catch(e){return null}};
const tagList=async api=>{const r=await api.listTags();return Array.isArray(r)?r:(r.tags||r.items||[])};
const isLoc=t=>t.axis==='location'||t.axis==='domain';
const same=(a,b)=>String(a).trim().toLowerCase()===String(b).trim().toLowerCase();

async function loadExt(){
  const api=cn();if(!api)return;
  try{
    const tags=await tagList(api),roots=tags.filter(t=>isLoc(t)&&!t.parent_id);
    // 原因：科目只來自考卷自己的資料；卡片軟體的櫃子是另一套分類（筆記主題），拿來當建議會讓人選到後寫進科目樹，之後寫卡時又依同名重用，把考卷的卡歸進不相干的櫃子。
    EXT={chaps:{},cons:tags.filter(t=>t.axis==='concept').map(t=>t.name)};
    roots.forEach(r=>{EXT.chaps[r.name]=tags.filter(t=>isLoc(t)&&t.parent_id===r.id).map(t=>t.name)});
    render();
  }catch(e){}
}

async function pushToCardnote(cards,ctx){
  const api=cn();if(!api)throw Error('請從卡片軟體左側欄開啟本頁（需與卡片軟體同源）');
  const rep=[],out={c:0,u:0,s:0,e:0},F=window.opener.File;
  // 原因：本機紀錄（cardMap）存不下去時，往卡片軟體寫的卡片會變成沒有記錄的重複卡；先試存一次，存不了就在任何遠端寫入之前停下。
  const rv=REV;await save();
  if(REV===rv)throw Error('本機資料無法存檔（原因見提示），為避免卡片軟體端重複建卡，沒有寫入任何卡片');
  const tags=await tagList(api);
  const mkLoc=async(name,pid)=>{
    let t=tags.find(x=>isLoc(x)&&(x.parent_id||null)===(pid||null)&&same(x.name,name));
    if(!t){t=await api.createTag(name,'location',pid||null);tags.push(t);rep.push('新建'+(pid?'抽屜：':'櫃子：')+name)}
    return t;
  };
  const conIds={};
  const mkCon=async name=>{
    if(conIds[name])return conIds[name];
    // 原因：同名（或同別名）的概念標籤可能同時存在於不同維度；find／candidates[0] 會悄悄接到任意一個，卡片就掛到錯的概念上。改成明確失敗，請使用者先在卡片軟體合併或改名。
    const hits=tags.filter(x=>x.axis==='concept'&&(same(x.name,name)||(x.aliases||[]).some(a=>same(a,name))));
    if(hits.length>1)throw Error('概念「'+name+'」在卡片軟體有 '+hits.length+' 個同名或同別名的標籤（維度：'+hits.map(h=>h.facet||'未設').join('、')+'），請先到卡片軟體合併或改名');
    let t=hits[0];
    if(!t){
      const r=await api.resolveTag(name,'concept');
      if(r.tag&&(r.status==='exact_tag'||r.status==='exact_alias'))t=r.tag;
      else if(r.status==='ambiguous')throw Error('概念「'+name+'」在卡片軟體有多個同名標籤，請先合併或改名');
      else{
        t=await api.createTag(name,'concept',null);tags.push(t); // 原因：維度輸入框已移除，不再傳這個參數，免得舊值在看不見的地方影響新標籤。
        rep.push('新建概念：'+name+(r.candidates&&r.candidates.length?'（相似的既有標籤：'+r.candidates.map(c=>c.name).join('、')+'，可到卡片軟體合併）':''));
      }
    }
    return conIds[name]=t.id;
  };
  const up=async id=>{
    if(S.mediaMap[id])return S.mediaMap[id];
    const b=await ctx.getAsset(id);if(!b)return null;
    const m=await api.uploadMedia(new F([await b.arrayBuffer()],id,{type:b.type||'image/jpeg'}));
    return S.mediaMap[id]=m.id;
  };
  // 原因：S.mediaMap 只記「上傳過」，不驗證卡片軟體裡那張圖還在（媒體被清理、換了卡片軟體實例、備份還原都會讓它過期）。
  // @depends-on cards.py::card_detail（patch 回傳的 warnings 帶 code='MISSING_MEDIA' 與 ids；後端不驗證 media 是否存在，只以此回報）
  const chkMedia=(u,c,body)=>{
    const bad=new Set((u.warnings||[]).filter(w=>w.code==='MISSING_MEDIA').flatMap(w=>w.ids||[]).map(x=>String(x).toLowerCase()));
    if(!bad.size)return;
    for(const k of Object.keys(S.mediaMap))if(bad.has(String(S.mediaMap[k]).toLowerCase()))delete S.mediaMap[k];
    // 原因：基準必須等於「剛寫進卡片的內容」。清成只剩 {id} 會讓重試無法分辨卡片端有沒有被改過，而直接覆蓋。
    S.cardMap[c.id]={id:u.id,ua:u.updated_at,title:c.title,body,tags:(S.cardMap[c.id]||{}).tags||[]};
    throw Error('卡片引用的圖片在卡片軟體裡不存在，已清除這些圖片的上傳紀錄；請重新同步一次');
  };

  for(const c of cards){
    try{
      let body=c.body;
      for(const id of new Set([...body.matchAll(/exam-asset:([^)\s]+)/g)].map(m=>m[1]))){
        const mid=await up(id);
        if(!mid)throw Error('圖片 '+id.slice(-24)+' 本機找不到，這張卡未寫入'); // 原因：原本把壞掉的內文當成功寫進卡片；此時還沒有任何遠端寫入，改成失敗可安全重試。
body=body.split('![](exam-asset:'+id+')').join('![](media:'+mid+')');
      }
      const tagIds=[];
      for(const t of c.tags){
        if(t.axis==='location'){const root=t.facet?await mkLoc(t.facet,null):null;tagIds.push((await mkLoc(t.name,root&&root.id)).id)}
        else tagIds.push(await mkCon(t.name));
      }
      const rec=S.cardMap[c.id];
      // 原因：getCard 任何錯誤都當成「卡片不存在」，斷線時會重複建卡；只有明確的 404 才視為不存在，其餘算這張失敗。（假設錯誤物件有 status 或 message 含 404，請依你的 API 實際回傳調整）
      // @depends-on cards.py::get_card + errors.py（卡片不存在回 ErrorCode.NOT_FOUND；錯誤物件的 status 或 code 至少一個要能辨識，否則「刪除後重建」會被當成失敗）
      let cur=null;if(rec&&rec.id){try{cur=await api.getCard(rec.id)}catch(e){if(e&&(e.status===404||e.code==='NOT_FOUND'||/404|not.?found/i.test(e.message||'')))cur=null;else throw e}}
      let id;
      if(cur){
        // 原因：沒有同步基準（舊版寫入）就無法證明卡片軟體端沒被修改；以前當成「沒改」直接覆蓋，現在略過並說明。pending 是本頁剛建的空卡，不受此限。
        if(!rec.pending&&(rec.title===undefined||rec.body===undefined)){
          out.s++;
          rep.push('略過（沒有同步基準，無法確認卡片軟體端沒被修改；要重建請先在卡片軟體刪除這張卡）：'+c.title);
          continue;
        }
        const timeSame = rec.ua && cur.updated_at && rec.ua === cur.updated_at;
        const titleModified = !timeSame && rec.title !== undefined && cur.title !== rec.title;
        const bodyModified = !timeSame && rec.body !== undefined && cur.body !== rec.body;
        if(titleModified || bodyModified){
          if(c.appNote && c.appNote !== c.appSynced){
            const dStr = new Date().toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
            const appendBlock = '\n\n---\n**【重做訂正補充・' + c.title + '】**（' + dStr + ' 作答：' + (c.curQ && c.curQ.mine ? c.curQ.mine : '未答') + '，正解：' + (c.curQ && c.curQ.key ? c.curQ.key : '無') + '）\n' + c.appNote;
            const newBody = cur.body + appendBlock;
            const u = await api.patchCard(cur.id, { body: newBody }, cur.updated_at);
            id = u.id;
            chkMedia(u, c, newBody);
            if(c.curQ) c.curQ.appendSyncedText = c.appNote;
            S.cardMap[c.id] = { id, ua: u.updated_at, title: cur.title, body: newBody, tags: rec.tags || [] };
            if(CARDV[c.id]) { CARDV[c.id].body = newBody; CARDV[c.id].ua = u.updated_at; }
            const prevTags = rec.tags || [];
            const have = new Set((u.tags || cur.tags || []).map(t => t.id));
            for(const t of tagIds) if(!have.has(t)) await api.assignTag(id, t);
            for(const t of prevTags) if(!tagIds.includes(t) && have.has(t)) await api.unassignTag(id, t);
            S.cardMap[c.id].tags = tagIds;
            out.u++;
            rep.push('已追加補充：' + c.title);
          } else {
            out.s++;
            rep.push('略過（卡片內文已在卡片軟體被修改' + (c.appSynced ? '，補充內容已同步過' : '') + '）：' + c.title);
          }
          continue;
        }
        // 原因：建卡後 patch 失敗的卡（pending）還沒寫過 card_type／curation_status，補寫時要帶上；一般更新不帶，免得蓋掉使用者在卡片軟體改過的類型與整理狀態。
        // 原因：sources 只在建卡（含補寫 pending）時寫入；更新時不送，卡片軟體端自己加的來源才不會被蓋掉。
        // @depends-on cards.py::patch_card + schemas.py::CardPatch（expected_updated_at 不符回 STALE_VERSION；sources 不送＝保留原值、送陣列＝整份取代，上限 20 筆、每筆 2000 字；title 上限 500 字；body 原樣存入、不做 strip）
        const first=rec.pending?{card_type:c.card_type,curation_status:c.curation_status,sources:c.sources}:{};
        const u=await api.patchCard(cur.id,{title:c.title,body,...first},cur.updated_at);
        id=u.id;
        chkMedia(u,c,body);
        // 原因：基準要在 patch 成功當下更新；放在 assignTag 之後的話，assignTag 失敗會讓下次同步把自己剛寫的內文誤判成「在卡片軟體被修改」而永遠略過。
        // 原因：只移除「上次同步由本頁加上」的標籤（prevTags）；使用者在卡片軟體自己加的標籤不在紀錄裡，不會被動到。
        // 紀錄先存新舊聯集，移除全部完成後才縮成新集合：移除到一半失敗時，重試仍知道還有哪些舊標籤要移。
        const prevTags=rec.tags||[];
        S.cardMap[c.id]={id,ua:u.updated_at,title:c.title,body,tags:[...new Set([...prevTags,...tagIds])]};
        const have=new Set((u.tags||cur.tags||[]).map(t=>t.id));
        for(const t of tagIds)if(!have.has(t))await api.assignTag(id,t);
        for(const t of prevTags)if(!tagIds.includes(t)&&have.has(t))await api.unassignTag(id,t);
        S.cardMap[c.id].tags=tagIds;
        out.u++;
      }else{
        const d=await api.createCard(tagIds);
        // 原因：createCard 已在卡片軟體建出空卡；先記下 id，patch 失敗時重試才會接手這張卡，不會每重試一次就多建一張。
        S.cardMap[c.id]={id:d.id,pending:1};
        const u=await api.patchCard(d.id,{title:c.title,body,card_type:c.card_type,curation_status:c.curation_status,sources:c.sources},d.updated_at);
        id=u.id;
        chkMedia(u,c,body);
        S.cardMap[c.id]={id,ua:u.updated_at,title:c.title,body,tags:tagIds};
        out.c++;
      }
    // 原因：cardMap 原本只在迴圈結束後存，中途關頁會丟紀錄；存檔失敗時再往下寫卡片軟體會讓下次同步重複建卡，save() 已顯示原因，這裡直接中止。
    const r0=REV;await save();
    if(REV===r0){rep.push('已中止：本機紀錄存檔失敗（原因見提示），這張之後的卡片都沒有處理');out.e++;break}
    }catch(e){out.e++;rep.push('失敗：'+c.title+'：'+(e&&e.message||e))}
  }
  save();loadExt();
  if(window.opener){
    try{window.opener.dispatchEvent(new CustomEvent("cardnote:refresh"))}catch(e){}
    try{window.opener.postMessage({type:"CARDNOTE_EXAM_SYNC"},"*")}catch(e){}
  }
  const o=$('#out');if(o&&rep.length){o.value=rep.join('\n');o.hidden=false} // 原因：同步記錄有內容才顯示，沒內容就不要冒出空框。
  msg('完成：新增 '+out.c+'、更新 '+out.u+'、略過 '+out.s+(out.e?'、失敗 '+out.e:'')+(rep.length?'（詳見下方記錄）':''), out.e>0);
}

// 原因：卡片軟體端的內文通常比考卷筆記完整，而被改過的卡同步時會略過；這裡只唯讀取回來顯示在檢討頁，不寫回任何一邊。
// 「已修改」的判斷與 pushToCardnote 相同（和上次同步寫入的基準 rec.title／rec.body 比），兩邊不會互相矛盾。
async function loadCardView(p,silent){
  const api=cn();if(!api)return(!silent&&msg('請從卡片軟體左側欄開啟本頁（需與卡片軟體同源）',true));
  const r={mod:0,same:0,gone:0,err:0};
  const targets=p.questions.map(q=>({k:qidOf(p,q),rec:S.cardMap[qidOf(p,q)]})).filter(x=>x.rec&&x.rec.id);
  if(!targets.length){if(!silent)msg('本份考卷尚未建立過卡片');return}
  await Promise.all(targets.map(async({k,rec})=>{
    try{
      const cur=await api.getCard(rec.id);
      const timeSame=rec.ua&&cur.updated_at&&rec.ua===cur.updated_at;
      const modified=!timeSame&&((rec.title!==undefined&&cur.title!==rec.title)||(rec.body!==undefined&&cur.body!==rec.body));
      CARDV[k]={st:'ok',modified,title:cur.title,body:cur.body,ua:cur.updated_at};
      if(modified)r.mod++;else r.same++;
    }catch(e){
      if(e&&(e.status===404||e.code==='NOT_FOUND')){CARDV[k]={st:'gone'};r.gone++}
      else{CARDV[k]={st:'err',msg:(e&&e.message)||String(e)};r.err++}
    }
  }));
  const y=scrollY;render();scrollTo(0,y);
  if(!silent)msg('對照完成：卡片軟體端已修改 '+r.mod+'、未修改 '+r.same+'、已不存在 '+r.gone+(r.err?'、讀取失敗 '+r.err:''),r.err>0);
}
const SINKS={
  markdown:{label:'Markdown',run:async c=>show(toMd(c))},
  json:{label:'JSON',run:async c=>show(JSON.stringify({schema:'exam-review.cards/v3',cards:c},null,2))},
  cardnote:{label:'寫入卡片軟體',run:(c,ctx)=>pushToCardnote(c,ctx)}
};
async function sink(s){
  const p=P();
  if(!p){msg('請先進入一份考卷，再到它的「彙整」步驟匯出；一次只匯出一份考卷的卡片',true);return}
  // 原因：寫入卡片軟體要跑一段時間，使用者會以為卡住而再按一次；兩輪同時跑時，cardMap 要等建卡完成才記錄，會各建出同一題的卡。
  if(sink.busy){msg('上一次寫入還在進行中，請等它結束',true);return}
  const c=buildCards(p);msg('');
  sink.busy=true;
  try{
  await SINKS[s].run(c,{getAsset});
  const n=new Set(c.flatMap(x=>x.assets)).size;
  if(s!=='cardnote'&&n)msg('文字匯出不含圖片：這批卡片引用 '+n+' 張圖，內文只留下 images/ 連結。要帶圖請用「寫入卡片軟體」。',true);
}catch(e){msg('失敗：'+e.message, true)}finally{sink.busy=false}
}

/* ---------- import UI (Batch folder & ZIP support) ---------- */
async function collect(list,open){
  const items=[],zips=[];
  for(const f of list){
    if(/\.zip$/i.test(f.name)){
      // 原因：選檔時不展開 zip（JSZip 會把整個 zip 讀進記憶體，50 份同時展開會撐爆分頁）；只記下檔案，匯入時（open=true）一份一份展開、處理完就釋放。
      if(!open){zips.push(f);continue}
      if(!window.JSZip)throw Error('JSZip 載入失敗，請改選解壓後的檔案');
      const z=await JSZip.loadAsync(f);
      const zipPkg=f.name.replace(/\.zip$/i,'');
      for(const e of Object.values(z.files)){
        if(!e.dir)items.push({name:e.name.split('/').pop(),relPath:e.name,blob:await e.async('blob'),pkg:zipPkg});
      }
    }else{
      const p=f.webkitRelativePath||f.name;
      items.push({name:p.split('/').pop(),relPath:p,blob:f,pkg:''});
    }
  }

  // 辨識所有題卷錨點（layout.json 或非答案之 markdown/txt）
  const anchors=[];
  for(let i=0;i<items.length;i++){
    const it=items[i];
    if(it.name.endsWith('.json')){
      try{
        const j=JSON.parse(await it.blob.text());
        if(j&&j.pdf_info)anchors.push({type:'json',json:j,item:it});
      }catch(e){
        // 原因：layout.json 損毀時整份考卷會悄悄消失；其他 json（model.json 等）本來就不是錨點，維持略過。
        if(/layout/i.test(it.name))throw Error('「'+it.relPath+'」不是有效的 JSON：'+(e&&e.message||e));
      }
    // 原因：母資料夾裡的 README.md 會被當成考卷錨點，且 ancDir 前綴會吃掉全部子資料夾的檔案。
    }else if(/\.(md|txt)$/i.test(it.name)&&!/答案|ans|key|^readme/i.test(it.name)){
      anchors.push({type:'text',item:it});
    }
  }

  // 原因：設計是「一個資料夾＝一份考卷」。layout.json 與 full.md 同在一個資料夾時會匯入兩份；每個資料夾只留一個錨點，優先 layout.json。
  const dirOf=a=>a.item.pkg+'|'+a.item.relPath.slice(0,a.item.relPath.lastIndexOf('/')+1);
  const rank=a=>a.type==='json'?(/^layout\.json$/i.test(a.item.name)?0:1):2;
  const best={};
  anchors.forEach(a=>{const k=dirOf(a);if(!best[k]||rank(a)<rank(best[k]))best[k]=a});
  anchors.splice(0,anchors.length,...Object.values(best));
  const lazy=zips.map(f=>({name:f.name.replace(/\.zip$/i,''),lazyZip:f}));
  if(!anchors.length&&lazy.length)return lazy;
  if(!anchors.length){
    // 回退至傳統純文字處理
    const b={name:items[0]?items[0].name.replace(/\.\w+$/,''):'未命名考卷',images:{},text:null,json:null,key:''};
    for(const it of items){
      if(/\.(jpe?g|png|gif|webp|svg|bmp)$/i.test(it.name))b.images[it.name]=it.blob;
      else if(/\.(md|txt)$/i.test(it.name)){
        const tx=await it.blob.text();
        if(/答案|ans|key/i.test(it.name))b.key=(b.key?b.key+'\n':'')+tx;
        else if(!b.text||tx.length>b.text.length)b.text=tx;
      }
    }
    return [b];
  }

  const bundles=[];
  for(const anc of anchors){
    const it=anc.item;
    const ancDir=it.relPath.includes('/') ? it.relPath.slice(0,it.relPath.lastIndexOf('/')+1) : '';
    const segs=ancDir.replace(/\/$/,'').split('/').filter(s=>s&&!/^(?:auto|vlm|txt|ocr|output)$/i.test(s));
    const stem=it.name.replace(/\.\w+$/,'');
    const paperName=segs.length?segs[segs.length-1]:(!/^(?:layout|full|content|output)$/i.test(stem)?stem:'');
    // 原因：一個資料夾＝一份考卷，科目＝它的上一層資料夾；直接選單一考卷資料夾（沒有上一層）或來自 zip 時不分類。
    const b={name:(anchors.length===1?it.pkg||paperName:paperName||it.pkg)||'未命名考卷',images:{},text:null,json:anc.type==='json'?anc.json:null,key:'',subj:it.pkg?'':(segs.length>1?segs[segs.length-2]:'')};
    if(anc.type==='text')b.text=await it.blob.text();

    for(const file of items){
      const matchPkg = anc.item.pkg ? file.pkg === anc.item.pkg : !file.pkg;
      // 原因：zip 根目錄放 layout.json、圖片在 images/ 時 ancDir 為空，舊寫法只收不含 "/" 的檔案，images/ 底下全被排除。
      const matchDir = !ancDir || file.relPath.startsWith(ancDir);
      if(!matchPkg || !matchDir) continue;

      if(/\.(jpe?g|png|gif|webp|svg|bmp)$/i.test(file.name)){
        b.images[file.name]=file.blob;
      }else if(/\.(md|txt)$/i.test(file.name)&&/答案|ans|key/i.test(file.name)){
        const ktx=await file.blob.text();
        b.key=(b.key?b.key+'\n':'')+ktx;
      }
    }
    bundles.push(b);
  }
  return [...bundles,...lazy];
}

async function create(){
  // 原因：已移除貼上純文字與答案輸入框；沒選檔案就按「建立」要明說，不能去讀不存在的欄位而丟出例外。
  if(!PENDING||!PENDING.length)return msg('請先選擇考卷資料夾或 zip', true);
  const bundles=PENDING;
  const nm=$('#nm').value.trim();
  // 原因：(1)一份失敗不該中止整批，成功的要照樣存檔並顯示，失敗的逐份大聲列出；(2)不再改動 PENDING（圖片鍵改存在副本），重試才不會疊上第二層前綴；(3)先確認解析成功再寫圖，並確認圖片真的寫入成功，失敗就不加入該份考卷。
  const made=[],failed=[];
  for(const top of bundles){
    // 原因：lazyZip 到這裡才展開，一次只留一份在記憶體；展開失敗只算這個 zip 失敗，不影響其他份。
    let units;
    try{units=top.lazyZip?await collect([top.lazyZip],true):[top]}
    catch(e){failed.push('「'+top.name+'」：'+(e&&e.message||e));continue}
  for(const src of units){
    const isSingle=bundles.length===1&&units.length===1;
    const name=(isSingle&&nm)||src.name||'未命名考卷';
    const key=src.key||'';
    const pid=uid(),scoped={};
    for(const raw in src.images)scoped[pid+'__'+raw]=src.images[raw];
    try{
      const p=importBundle({...src,images:scoped,key},name,pid);
      p.subj=src.subj||'';
      // 原因：同一份考卷的圖片放在同一個 transaction 寫入，減少 50 份匯入時的交易開銷，且中途失敗不會留下半套孤兒圖。
      const entries=Object.entries(scoped);
      if(entries.length)await tx('assets','readwrite',s=>{for(const [id,blob] of entries)s.put(blob,id)});
      made.push(p);
    }catch(e){failed.push('「'+name+'」：'+(e&&e.message||e))}
  }
  }
  if(!made.length)return msg('匯入失敗（共 '+failed.length+' 份）：'+failed.join('；'),true);
  const prevPapers=[...S.papers],prevCur=S.cur,prevView=S.view,prevSubjs=[...S.subjs];
  S.papers.unshift(...made);
  // 原因：批次遇到的新科目接在分類清單最後；存檔失敗時下面一併還原，不留下沒有考卷的空分類。
  made.forEach(x=>{if(x.subj&&!S.subjs.includes(x.subj))S.subjs.push(x.subj)});
  const one=made.length===1&&!failed.length;
  S.cur=one?made[0].id:null;S.view=one?'paper':'list';
  const r0=REV;await save();
  if(REV===r0){
    S.papers=prevPapers;S.subjs=prevSubjs;S.cur=prevCur;S.view=prevView;
    const orphanIds=made.flatMap(p=>p.have||[]);
    if(orphanIds.length)tx('assets','readwrite',s=>{for(const id of orphanIds)s.delete(id)}).catch(()=>{});
    return;
  }
  PENDING=null;if(one)await loadAssets(made[0]);render();scrollTo(0,0);
  msg('成功匯入 '+made.length+' 份考卷'+(failed.length?'；失敗 '+failed.length+' 份：'+failed.join('；'):''),failed.length>0);
}

/* ---------- backup & restore ---------- */
let RS=null;
async function buildBackupBlob(){
  if(!window.JSZip)throw new Error('JSZip 載入失敗，無法備份。請確認網路連線與檔頭的 script 網址。');
  const z=new JSZip(),lost=[];
  z.file('exam.json',JSON.stringify({v:1,papers:S.papers,points:S.points,tree:S.tree,subjs:S.subjs,th:S.th,n1:S.n1,n2:S.n2,shuf:S.shuf,cf:S.cf,cardMap:S.cardMap,mediaMap:S.mediaMap,skip:S.skip,bkMin:S.bkMin,bkOn:S.bkOn,bkDirName:S.bkDirName}));
  for(const id of new Set(S.papers.flatMap(p=>p.have||[]))){const b=await getAsset(id);if(b)z.file('images/'+id,b);else lost.push(id)}
  const blob=await z.generateAsync({type:'blob'});
  return {blob, lost};
}

async function backup(){
  try{
    const {blob, lost}=await buildBackupBlob();
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);a.download='exam-review-backup-'+new Date().toISOString().slice(0,10)+'.zip';
    document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),5000);
    msg(lost.length?'備份已下載，但有 '+lost.length+' 張圖片本機找不到、未包含（例：'+lost.slice(0,3).join('、')+'）':'備份已下載（'+S.papers.length+' 份考卷）',lost.length>0);
  }catch(e){msg('備份失敗：'+(e&&e.message||e),true)}
}

async function restore(file){
  const z=await JSZip.loadAsync(file),f=z.file('exam.json');
  if(!f)throw Error('不是考卷備份檔（缺少 exam.json）');
  const d=JSON.parse(await f.async('string'));
  const imgs=[];
  for(const e of Object.values(z.files)){
    if(e.dir||!e.name.startsWith('images/'))continue;
    imgs.push([e.name.slice(7),await e.async('blob')]);
  }
  if(imgs.length)await tx('assets','readwrite',s=>{for(const [id,b] of imgs)s.put(b,id)});
  Object.keys(MEM).forEach(k=>delete MEM[k]);Object.keys(U).forEach(k=>{URL.revokeObjectURL(U[k]);delete U[k]});
  const snap={papers:S.papers,points:S.points,tree:S.tree,subjs:S.subjs,th:S.th,n1:S.n1,n2:S.n2,shuf:S.shuf,cf:S.cf,cardMap:S.cardMap,mediaMap:S.mediaMap,skip:S.skip,cur:S.cur,view:S.view,bkMin:S.bkMin,bkOn:S.bkOn,bkLastRev:S.bkLastRev,bkLastTime:S.bkLastTime,bkDirName:S.bkDirName};
  Object.assign(S,{papers:d.papers||[],points:d.points||{},tree:d.tree||[],subjs:d.subjs||[],th:d.th||3,n1:d.n1,n2:d.n2,shuf:d.shuf,cf:d.cf||'',cardMap:d.cardMap||{},mediaMap:d.mediaMap||{},skip:d.skip||{},bkMin:d.bkMin||S.bkMin||15,bkOn:false,bkLastRev:0,bkLastTime:'',bkDirName:d.bkDirName||S.bkDirName||'',cur:null,view:'list'});
  fix();const r0=REV;await save();
  if(REV===r0){Object.assign(S,snap);throw Error('還原失敗：無法寫入本機資料庫（原因見上一則錯誤），已維持原資料')}
  await gcAssets();
}

async function runAutoBackup(force){
  if(!DIR_HANDLE)return;
  try{
    const perm=await DIR_HANDLE.queryPermission({mode:'readwrite'});
    if(perm!=='granted'){DIR_NEED_PERM=true;render();return}
    DIR_NEED_PERM=false;
    const re=/^exam-backup-\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}\.zip$/;
    const existing=[];
    for await(const [name,h] of DIR_HANDLE.entries()){
      if(h.kind==='file'&&re.test(name))existing.push(name);
    }
    existing.sort();
    if(!force&&existing.length>=3&&S.bkLastRev===REV)return;

    const pad=n=>String(n).padStart(2,'0'),now=new Date();
    const fn=`exam-backup-${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}_${pad(now.getHours())}-${pad(now.getMinutes())}-${pad(now.getSeconds())}.zip`;
    const {blob}=await buildBackupBlob();
    const fh=await DIR_HANDLE.getFileHandle(fn,{create:true});
    const w=await fh.createWritable();
    await w.write(blob);
    await w.close();

    existing.push(fn);existing.sort();
    while(existing.length>3){
      const oldName=existing.shift();
      try{await DIR_HANDLE.removeEntry(oldName)}catch(e){}
    }
    S.bkLastRev=REV;
    S.bkLastTime=now.toLocaleTimeString('zh-TW',{hour12:false});
    await save();
    render();
  }catch(e){
    console.error('Auto backup failed',e);
    msg('定時備份失敗：'+(e&&e.message||e),true);
  }
}

function scheduleAutoBackup(){
  if(BK_TIMER){clearInterval(BK_TIMER);BK_TIMER=null}
  if(S.bkOn&&DIR_HANDLE&&!DIR_NEED_PERM){
    const ms=Math.max(1,S.bkMin||15)*60*1000;
    BK_TIMER=setInterval(()=>runAutoBackup(false),ms);
  }
}

async function pickBackupDir(){
  if(!window.showDirectoryPicker)return msg('您的瀏覽器不支援本機資料夾直接寫入（請使用 Chrome / Edge 等），請改用手動下載備份',true);
  try{
    const h=await window.showDirectoryPicker({mode:'readwrite'});
    DIR_HANDLE=h;DIR_NEED_PERM=false;
    S.bkDirName=h.name;S.bkOn=true;
    await tx('kv','readwrite',s=>s.put(h,'bk_dir'));
    await save();
    scheduleAutoBackup();
    await runAutoBackup(true);
    msg('已綁定資料夾「'+h.name+'」並完成首次備份');
  }catch(e){
    if(e.name!=='AbortError')msg('選取資料夾失敗：'+(e&&e.message||e),true);
  }
}

async function restoreBackupPerm(){
  if(!DIR_HANDLE)DIR_HANDLE=await tx('kv','readonly',s=>s.get('bk_dir')).catch(()=>null);
  if(!DIR_HANDLE)return pickBackupDir();
  try{
    const p=await DIR_HANDLE.requestPermission({mode:'readwrite'});
    if(p==='granted'){
      DIR_NEED_PERM=false;scheduleAutoBackup();await runAutoBackup(true);render();
      msg('已恢復「'+(S.bkDirName||DIR_HANDLE.name)+'」備份權限並執行備份');
    }else{msg('未取得資料夾寫入權限',true)}
  }catch(e){msg('權限恢復失敗：'+(e&&e.message||e),true)}
}

async function initAutoBackup(){
  try{
    DIR_HANDLE=await tx('kv','readonly',s=>s.get('bk_dir'));
    if(DIR_HANDLE){
      const p=await DIR_HANDLE.queryPermission({mode:'readwrite'});
      DIR_NEED_PERM=(p!=='granted');
      if(!DIR_NEED_PERM)scheduleAutoBackup();
    }
  }catch(e){}
}
async function gcAssets(){
  const keep=new Set(S.papers.flatMap(p=>[...(p.have||[]),...[...p.questions,...p.passages].flatMap(x=>[...x.blocks,...(x.exp||[])].map(b=>b.id).filter(Boolean))]));
  Object.keys(MEM).forEach(id=>{if(!keep.has(id))delete MEM[id]});
  Object.keys(U).forEach(id=>{if(!keep.has(id)){URL.revokeObjectURL(U[id]);delete U[id]}});
  try{
    const all=await tx('assets','readonly',s=>s.getAllKeys());
    const del=(all||[]).filter(id=>!keep.has(id));
    if(del.length)await tx('assets','readwrite',s=>{for(const id of del)s.delete(id)});
  }catch(e){}
}

/* ---------- views ---------- */
const rb=(t,sub,o)=>'<button class="ghost" data-a="ren" data-t="'+t+'" data-sub="'+esc(sub)+'" data-o="'+esc(o)+'">✎</button>';
const rnE=(t,sub,o)=>S.ren&&S.ren.t===t&&S.ren.sub===sub&&S.ren.o===o?'<div class="mk"><input id="rn" value="'+esc(o)+'"><button class="pri" data-a="rok">確定</button><button data-a="rcx">取消</button></div><small>改成已存在的名稱就會合併</small>':'';
const renOpen=(sub,ch)=>!!S.ren&&((S.ren.t==='c'&&S.ren.sub===sub&&S.ren.o===ch.n)||(S.ren.t==='k'&&ch.k.includes(S.ren.o)));
const dl=(id,a)=>'<datalist id="'+id+'">'+[...new Set(a)].filter(Boolean).map(x=>'<option value="'+esc(x)+'">').join('')+'</datalist>';
const stepper=n=>'<nav>'+['作答','檢討','彙整'].map((t,i)=>'<button data-a="st" data-n="'+(i+1)+'" class="'+(n===i+1?'on':'')+'"'+(i&&(P()||{}).started?' disabled title="作答中，交卷後才能進入"':'')+'>'+(i+1)+' '+t+'</button>').join('')+'</nav>';
// 原因：「重做・」與日期是附加標記，不該和考卷名稱一樣醒目。只在顯示時拆開，資料裡的名稱字串不動，所以備份、匯出、cleanPaperName 與 fix() 的比對都不受影響。
const nameHtml=n=>{
  const m=String(n).match(/^((?:錯題重做|重做|抽題)・)?([\s\S]*?)(?:・(\d{1,2}[\/月]\d{1,2}日?))?$/);
  return esc(m[2])+(m[1]?'<em class="nt">'+esc(m[1].slice(0,-1))+'</em>':'')+(m[3]?'<em class="nd">'+esc(m[3])+'</em>':'');
};
// 原因：分類順序以 S.subjs 為準；萬一有考卷的 subj 不在清單裡也要顯示出來，不能讓考卷從清單上消失。
const subjNames=()=>[...new Set([...S.subjs,...S.papers.map(p=>p.subj||'').filter(Boolean)])];
function paperRow(p){
  const w=p.questions.filter(q=>q.st==='x').length;
  // 原因：stage 預設是 1，所以每份沒碰過的考卷都顯示「作答中」；改成已按開始作答、或確實有作答（舊資料）且尚未交卷才顯示。
  const st=p.stage>1?'檢討中・錯 '+w:(p.started||p.questions.some(q=>q.mine))?'作答中':'';
  // data-a="stop"：點下拉選單時不要觸發整列的「開啟考卷」。
  const sel='<select data-a="stop" data-f="psubj" data-id="'+p.id+'" title="移到分類" aria-label="移到分類">'+['',...subjNames()].map(s=>'<option value="'+esc(s)+'"'+((p.subj||'')===s?' selected':'')+'>'+esc(s||'未分類')+'</option>').join('')+'</select>';
  return'<div class="row" data-a="open" data-id="'+p.id+'"><b>'+nameHtml(p.name)+'</b><span>'+p.questions.length+' 題'+(st?'・'+st:'')+'</span>'+sel+'<button class="ghost" data-a="redo" data-id="'+p.id+'">再做一次</button><button class="ghost" data-a="del" data-id="'+p.id+'">'+(S.delc===p.id?'再按一次確認刪除':'刪除')+'</button></div>';
}
function subjList(){
  return[...subjNames(),''].map(g=>{
    const ps=S.papers.filter(p=>(p.subj||'')===g);
    if(!g&&!ps.length)return'';
    const shut=!!(S.gclose&&S.gclose[g]);
    return'<h2 class="gh" data-a="gtog" data-g="'+esc(g)+'">'+(shut?'▸ ':'▾ ')+esc(g||'未分類')+' <small>'+ps.length+' 份</small>'+(g&&!ps.length?' <button class="ghost" data-a="sdel" data-g="'+esc(g)+'">刪除分類</button>':'')+'</h2>'+
      (shut?'':ps.length?ps.map(p=>paperRow(p)).join(''):'<p class="empty">這個分類還沒有考卷。</p>');
  }).join('');
}
function vList(){
  const topDashboard=
    '<div class="dash-board">'+
      '<div class="dash-sec">'+
        '<h3>考卷與學習</h3>'+
        '<div class="dash-row">'+
          '<button class="pri" data-a="imp">＋ 匯入考卷</button>'+
          '<button data-a="ana">分析</button>'+
          '<button data-a="sum">錯題彙整與匯出</button>'+
        '</div>'+
      '</div>'+
      '<div class="dash-sec">'+
        '<h3>資料備份與定時循環</h3>'+
        '<div class="dash-row">'+
          '<button data-a="bk">匯出備份（zip）</button>'+
          '<label class="btn" style="margin:0">選擇備份檔還原<input type="file" accept=".zip" data-restore hidden></label>'+
        '</div>'+
        '<div class="dash-row" style="margin-top:8px;padding-top:8px;border-top:1px dashed var(--line)">'+
          '<button data-a="bkdir">📁 '+(S.bkDirName?esc(S.bkDirName):'瀏覽指定備份資料夾')+'</button>'+
          '<span>每 <input class="num" type="number" min="1" data-f="bkmin" value="'+(S.bkMin||15)+'"> 分鐘</span>'+
          '<button data-a="bktoggle" class="'+(S.bkOn?'on pri':'')+'">'+(S.bkOn?'定時備份中（點擊停止）':'啟動定時備份')+'</button>'+
        '</div>'+
        (DIR_NEED_PERM&&S.bkDirName?'<div style="margin-top:8px"><button class="pri" data-a="bkperm" style="background:var(--warn);border-color:var(--warn);color:#fff">⚠️ 點擊恢復「'+esc(S.bkDirName)+'」寫入授權並備份</button></div>':'')+
        '<div class="hint" style="font-size:12px;margin-top:6px">循環保留最新 3 份（格式：年月日_時分秒.zip）'+(S.bkLastTime?'・上次自動備份：'+S.bkLastTime:'')+'</div>'+
      '</div>'+
    '</div>';

  return'<header><h1>考卷複習</h1></header>'+topDashboard+
  '<div class="dash-row" style="margin:0 0 8px"><input id="ns" style="flex:1 1 8em;width:auto;margin:0" placeholder="新分類名稱（例：國）"><button data-a="subjadd">建立分類</button></div>'+
  (S.papers.length||S.subjs.length?subjList():'<p class="empty">還沒有考卷。先匯入題目與答案，就能開始作答。</p>')+
  (RS?'<p>已選：'+esc(RS.name)+' <button class="pri" data-a="rsok">確認覆蓋目前資料並還原</button></p><span id="msg"></span>':'<span id="msg"></span>');
}

const vImport=()=>'<header><h2>匯入考卷</h2><button data-a="home">返回</button></header>'+
'<label>考卷名稱（只套用在單份匯入；批次由資料夾或 zip 檔名自動命名）<input id="nm" placeholder="留空則用資料夾名稱"></label>'+
'<label>選擇匯入方式（一個考卷資料夾＝一份考卷，內含 layout.json 或 full.md 與圖片）</label>'+
'<div class="mk"><label class="btn">單份：選一個考卷資料夾<input type="file" webkitdirectory data-pick="single" hidden></label>'+
'<label class="btn">批次：選母資料夾（每個子資料夾一份）<input type="file" webkitdirectory data-pick="batch" hidden></label>'+
'<label class="btn">zip：MinerU 壓縮檔（可多選）<input type="file" multiple accept=".zip" data-pick="zip" hidden></label></div>'+
'<p class="hint" id="sel">尚未選擇檔案</p>'+
'<button class="pri" data-a="create">建立並開始作答</button> <span id="msg"></span>';

const iss=p=>{
  const a=p.issues||[];if(!a.length)return'<p class="hint">自動檢查：沒有發現問題。</p>';
  const e=a.filter(i=>i.lv==='e').length;
  return'<details><summary>自動檢查：'+e+' 個錯誤、'+(a.length-e)+' 個提醒</summary>'+a.map(i=>'<div>'+(i.lv==='e'?'✗':'⚠')+' 第 '+i.no+' 題：'+esc(i.m)+(/缺少這個題號|答案表有/.test(i.m)?' <button class="ghost" data-a="addq" data-no="'+i.no+'">＋建立第 '+i.no+' 題</button>':'')+'</div>').join('')+'<label class="btn">補匯入圖片<input type="file" multiple accept="image/*" data-supp hidden></label></details>';
};
// 原因：MinerU 的圖片檔名是雜湊值，人無法知道哪張該放哪題；列出「檔案在、但沒有任何題目使用」的圖片（排除表格 HTML 內嵌的），讓人看縮圖後指定題號。
const orph=p=>{
  if(p.source==='compose')return[];
  const used=new Set(),html=[];
  [...p.questions,...p.passages,...(p.nm||[])].forEach(x=>[...x.blocks,...(x.exp||[])].forEach(b=>{if(b.id)used.add(b.id);if(b.html)html.push(b.html)}));
  // 原因：公式截圖（eqImgs）已經有 LaTeX 文字了，不需要再補進題目；列出來只會干擾。
  const src=html.join(''),raw=id=>id.includes('__')?id.slice(id.indexOf('__')+2):id,eq=new Set(p.eqImgs||[]);
  return(p.have||[]).filter(id=>!used.has(id)&&!eq.has(id)&&!src.includes(raw(id)));
};
const orphUI=p=>{
  const keySet=new Set(p.keyImgs||[]);
  const o=orph(p).filter(id=>!keySet.has(id));if(!o.length)return'';
  return'<details open><summary>未被使用的圖片 '+o.length+' 張（檔案在，但沒有放進任何題目或詳解）</summary>'+o.map(id=>'<div class="tg">'+(U[id]?'<img class="fig" data-a="zoom" data-src="'+U[id]+'" src="'+U[id]+'" alt="">':'<p class="miss">圖片讀取失敗：'+esc(id.slice(-24))+'</p>')+'<div class="mk">加到第 <input class="num" type="number" min="1" max="'+p.questions.length+'"> 題 <button data-a="useorph" data-id="'+esc(id)+'">加入題目</button> <button data-a="useorphx" data-id="'+esc(id)+'">加入詳解</button> <button data-a="setkeyimg" data-id="'+esc(id)+'">設為檢討答案圖</button></div></div>').join('')+'</details>';
};

const keyImgUI=p=>{
  const imgs=(p.keyImgs||[]).filter(id=>U[id]);
  if(!imgs.length)return'';
  return'<details open class="dash-sec" style="margin:8px 0;background:var(--card);border:1.5px solid var(--accent)"><summary style="font-weight:700;color:var(--accent);cursor:pointer">📋 官方參考答案圖（點擊展開／點圖可放大核對）</summary>'+
    imgs.map(id=>'<div style="margin-top:8px"><img class="fig" data-a="zoom" data-src="'+U[id]+'" src="'+U[id]+'" alt="參考答案" style="max-height:260px;object-fit:contain"><div class="mk"><button class="ghost" data-a="rmkeyimg" data-id="'+esc(id)+'">✕ 移除這張答案圖</button></div></div>').join('')+'</details>';
};
const ta=(f,i,v,ph)=>'<textarea data-f="'+f+'" data-i="'+i+'" placeholder="'+ph+'">'+esc(v)+'</textarea>';
const ref=q=>q.from?'<small>'+esc(q.from)+'</small>':'';
const eb=i=>'<button class="ghost" data-a="edit" data-i="'+i+'">✎ 編輯</button>';
const imgDel=(a,i,j,b,t)=>'<div class="mk">'+(U[b.id]?'<img src="'+U[b.id]+'" alt="" style="max-height:56px;max-width:120px;background:#fff;border-radius:4px">':'')+'<button class="ghost" data-a="'+a+'" data-i="'+i+'" data-j="'+j+'">✕ 移除'+t+'</button></div>';
function editPanel(p,q,i,k){
  const ps=po(p,q),first=ps&&(!p.questions[i-1]||p.questions[i-1].pid!==q.pid);
  const et=(f,v,l)=>'<small>'+l+'</small><textarea data-f="'+f+'" data-i="'+i+'">'+esc(v)+'</textarea>';
  return'<div class="ed">'+(first?ps.blocks.map((b,j)=>b.t==='text'||b.t==='code'?et('pb:'+j,b.v,'題組文字'):b.t==='img'?imgDel('rmpimg',i,j,b,'題組圖片 '+(j+1)):'').join(''):'')+
  q.blocks.map((b,j)=>b.t==='text'||b.t==='code'?et('eb:'+j,b.v,'題幹'):'').join('')+(q.blocks.some(b=>b.t==='text')?'':'<button class="ghost" data-a="addtxt" data-i="'+i+'">＋補題幹文字</button>')+
  (q.exp||[]).map((b,j)=>b.t==='text'?et('ex:'+j,b.v,'詳解文字'):'').join('')+'<div class="mk"><button class="ghost" data-a="addxtxt" data-i="'+i+'">＋補詳解文字</button></div><small>補詳解圖片（接在詳解最後）</small><input type="file" accept="image/*" multiple data-addximg data-i="'+i+'">'+
  q.options.map(o=>'<small>選項 '+o.k+'</small><input data-f="eo:'+o.k+'" data-i="'+i+'" value="'+esc(o.v)+'">').join('')+
  '<div class="mk"><button class="ghost" data-a="addopt" data-i="'+i+'">＋新增選項</button>'+(q.options.length?'<button class="ghost" data-a="rmopt" data-i="'+i+'">✕ 移除最後一個選項（'+q.options[q.options.length-1].k+'）</button>':'')+'<button class="ghost" data-a="resplit" data-i="'+i+'">用題幹文字重新切選項</button></div>'+
  (k?'<small>正解（字母）</small><input data-f="key" data-i="'+i+'" value="'+esc(q.key)+'">':'')+
  // 原因：MinerU 漏切的圖沒有位址可對，改成直接把截圖或相簿圖接在這一題後面（接在最後；選項整張被漏掉時，可截圖整個選項區）。
  '<small>補圖片（接在題目最後）</small><input type="file" accept="image/*" multiple data-addimg data-i="'+i+'">'+
  q.blocks.map((b,j)=>b.t==='img'?imgDel('rmimg',i,j,b,'題目圖片 '+(j+1)):'').join('')+
  (q.exp||[]).map((b,j)=>b.t==='img'?imgDel('rmximg',i,j,b,'詳解圖片 '+(j+1)):'').join('')+'</div>';
}
// 原因：datalist 依欄位目前文字過濾，填了「商業概論」就看不到其他科目，要改選得先刪字。改成輸入框（手打）旁加一顆下拉鈕，永遠列出科目樹的全部科目；兩者都走同一個 data-f="sub"，寫入路徑不變。占位項 disabled，不會被選成「清空科目」。
const tagBox=(q,i)=>'<div class="tg"><div class="mk"><input class="grow" data-f="sub" data-i="'+i+'" value="'+esc(q.sub)+'" placeholder="科目（手動輸入，或點右邊選擇）">'+
  '<select class="pk" data-f="sub" data-i="'+i+'" title="列出所有科目" aria-label="選擇科目"><option value="" disabled selected hidden>▾</option>'+S.tree.map(s=>'<option value="'+esc(s.n)+'">'+(s.n===q.sub?'✓ ':'')+esc(s.n)+'</option>').join('')+'</select></div>'+
  '<input list="ch'+i+'" data-f="chap" data-i="'+i+'" value="'+esc(q.chap)+'" '+(q.sub?'':'disabled ')+'placeholder="'+(q.sub?'章節':'先選科目，才能填章節')+'">'+dl('ch'+i,[...chapsOf(q.sub),...(EXT.chaps[q.sub]||[])])+
  (q.cons.length?'<div class="mk">'+q.cons.map(k=>'<button class="chip" data-a="rmcon" data-i="'+i+'" data-k="'+esc(k)+'">'+esc(k)+' ✕</button>').join('')+'</div>':'')+
  '<input list="cons" data-f="con" data-i="'+i+'" value="" '+(q.chap?'':'disabled ')+'placeholder="'+(q.chap?'＋概念（知識點），Enter 加入':'先選章節，才能加概念')+'"></div>';

const cardBlock=(p,q)=>{
  const v=CARDV[qidOf(p,q)];
  if(!v)return'';
  if(v.st==='gone')return'<p class="wr">卡片軟體端這張卡已不存在（下次同步會重新建立）。</p>';
  if(v.st==='err')return'<p class="wr">讀取卡片軟體端失敗：'+esc(v.msg)+'</p>';
  return'';
};
// 原因：對／錯是對答案時自動批改的結果，不是要使用者按的開關；改成唯讀標籤並註明來源（自動／手動改判）。沒有正解時無法自動批改，才直接給手動按鈕。
const stBadge=(q,i)=>{
  if(!q.key)return'<span class="vg"><span class="vb">無正解・請手動判定</span><span class="seg">'+
    '<button class="o '+(q.st==='o'?'on':'')+'" data-a="mark" data-i="'+i+'" data-v="o">對</button>'+
    '<button class="x '+(q.st==='x'?'on':'')+'" data-a="mark" data-i="'+i+'" data-v="x">錯</button></span></span>';
  const c=q.st==='o'?['o','✓ 答對']:q.st==='x'?['x','✗ 答錯']:['',q.mine?'未判定':'未作答・不計入統計'];
  return'<span class="vg"><span class="vb '+c[0]+'">'+c[1]+'</span>'+(q.manual?'<em class="vm">手動改判</em>':'<em class="va">自動批改</em>')+'</span>';
};
// 只列「會改變結果」的選項；有正解才能恢復自動批改。
const stMenu=(q,i)=>{
  if(!q.key)return'';
  const b=(a,v,t)=>'<button data-a="'+a+'" data-i="'+i+'"'+(v?' data-v="'+v+'"':'')+'>'+t+'</button>';
  return'<small class="mh">手動改判（覆蓋自動批改）</small>'+(q.st!=='o'?b('mark','o','改判為「對」'):'')+(q.st!=='x'?b('mark','x','改判為「錯」'):'')+(q.manual?b('auto','','恢復自動批改'):'');
};
// 原因：詳解很長、算式又多，預設收起；展開時才畫內容並排版，平常不佔 KaTeX 的時間。展開狀態只記在記憶體（不存檔），render() 整頁重畫後仍維持。
const EXPO=new Set();
const LOCKED=new Set(['edit','addq','addtxt','addxtxt','addopt','rmopt','resplit','rmimg','rmximg','rmpimg','useorph','useorphx','setkeyimg','rmkeyimg']);
// 原因：原檔缺詳解編號時，內容是依換頁位置推測歸給這題的；提醒放在展開的詳解裡，不放進自動檢查（那邊的提醒沒辦法解除，會一直掛著）。
const expBody=q=>(q.expInf?'<p class="wr">⚠ 原檔沒有這題詳解的編號，以下是依圖片或換頁位置推測歸給這題的內容，請核對。</p>':'')+
  (q.expGap?'<p class="wr">⚠ 原檔缺少第 '+q.expGap.join('、')+' 題詳解的編號，又找不到可切開的位置，那幾題的詳解可能被併在這一題裡，請核對。</p>':'')+(q.expLead?'<p class="wr">⚠ 最上方是依位置歸給這一題的「題組詳解」（文章翻譯／圖表），原檔沒有它的題號，請核對。</p>':'')+blks(q.exp);
const expUI=(p,q)=>{
  if(!q.exp||!q.exp.length)return'';
  const k=p.id+':'+q.no,open=EXPO.has(k);
  return'<details class="exp" data-p="'+esc(p.id)+'" data-no="'+q.no+'"'+(open?' open':'')+'><summary>📖 詳解</summary><div class="expb">'+(open?expBody(q):'')+'</div></details>';
};
document.addEventListener('toggle',e=>{
  const d=e.target;if(!d.classList||!d.classList.contains('exp'))return;
  const k=d.dataset.p+':'+d.dataset.no;
  if(!d.open){EXPO.delete(k);return}
  EXPO.add(k);
  const b=d.querySelector('.expb');if(!b||b.firstChild)return;
  const p=S.papers.find(x=>x.id===d.dataset.p),q=p&&p.questions.find(x=>String(x.no)===d.dataset.no);
  if(q&&q.exp){b.innerHTML=expBody(q);renderMath(b)}
},true);
function rev(p,q,i){
  const ps=po(p,q),w=q.st==='x',k=qidOf(p,q),cv=CARDV[k],isMod=cv&&cv.modified;
  const hasAnyNotes=q.cause||q.why||q.right||q.fix||q.appendNote||Object.values(q.optNotes||{}).some(Boolean);
  const showDirectly=w||q.guess||isMod;
  const isSynced=q.appendSyncedText&&q.appendSyncedText===(q.appendNote||'').trim();
  const causeField='<input list="causes" data-f="cause" data-i="'+i+'" value="'+esc(q.cause)+'" placeholder="錯因（可選或自填）">';
  const modFields=!isMod?'':'<p class="wr" style="font-weight:600;margin:6px 0">⚡ 卡片軟體端已修改內文：訂正區已自動切換為對照與追加模式，本次補充將追加於卡片尾端。</p>'+
    causeField+
    '<details open><summary>卡片軟體端既有內容（唯讀）</summary><div style="max-height:220px;overflow-y:auto;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:8px;margin:4px 0;white-space:pre-wrap;font-size:13px"><b>'+esc((cv&&cv.title)||'')+'</b>\n\n'+esc(((cv&&cv.body)||'').replace(/!\[[^\]]*\]\(media:[^)]*\)/g,'[圖片]'))+'</div></details>'+
    ta('appnote',i,q.appendNote||'','本次重做訂正補充（同步時將以追加形式附加於卡片軟體尾端）')+
    (isSynced?'<small class="hint">✓ 已於上次同步追加至卡片軟體</small>':'');
  const normalFields=causeField+
    ta('why',i,q.why,'我為什麼會選這個？')+ta('right',i,q.right,'正確的理由（題目哪裡該注意、選項為何對或錯）')+ta('fix',i,q.fix,'一句話：下次怎麼判斷')+
    (q.options.length?'<details'+(Object.values(q.optNotes||{}).some(Boolean)?' open':'')+'><summary>選項筆記（選填）</summary>'+q.options.map(o=>'<input data-f="o:'+o.k+'" data-i="'+i+'" value="'+esc(q.optNotes[o.k]||'')+'" placeholder="選項 '+o.k+' 為什麼對／錯">').join('')+'</details>':'');
  const notesContent=isMod?modFields:normalFields;

  return'<article id="q'+q.no+'" class="'+(w?'ng':'')+'">'+(ps?'<details><summary>題組文章</summary>'+blks(ps.blocks)+'</details>':'')+ref(q)+blks(q.blocks,'<b>'+q.no+'.</b> ')+wr(p,q)+
  q.options.map(o=>'<div class="opt '+(q.key.includes(o.k)?'k':q.mine.includes(o.k)?'m':'')+'"><b>'+o.k+'</b>'+esc(o.v)+'</div>').join('')+
  '<div class="mk vrow">'+stBadge(q,i)+
  '<span class="vs">我的 <b>'+esc(q.mine||'—')+'</b>・正解 <b>'+esc(q.key||'無')+'</b></span>'+
  '<div class="vr">'+(S.skip&&S.skip[k]?'<em class="nd" title="這題不會寫入卡片軟體">不匯出</em>':'')+
  '<label class="tgl" title="猜對的題目，仍會算進弱點與組卷"><input type="checkbox" data-f="guess" data-i="'+i+'"'+(q.guess?' checked':'')+'>猜的</label>'+
  '<details class="more"><summary class="'+(S.edit===p.id+':'+i?'on':'')+'" aria-label="更多">⋯</summary><div class="more-menu">'+eb(i)+stMenu(q,i)+
  '<label class="ck"><input type="checkbox" data-f="skip" data-i="'+i+'"'+(S.skip&&S.skip[k]?' checked':'')+'>不匯出成卡片</label></div></details></div></div>'+expUI(p,q)+tagBox(q,i)+
  (showDirectly ? notesContent : '<details'+(hasAnyNotes?' open':'')+'><summary>＋加入學習／訂正筆記（選填）</summary>'+notesContent+'</details>')+
  cardBlock(p,q)+(S.edit===p.id+':'+i?editPanel(p,q,i,1):'')+'</article>';
}

const qnavUI=p=>{
  const qs=p.questions;if(!qs||qs.length<=1)return'';
  const isS1=p.stage===1;
  const btns=qs.map(q=>{
    const cls=isS1?(q.mine?'done':''):(q.st==='o'?'ok':q.st==='x'?'ng':'');
    return'<button class="'+cls+'" data-a="jump" data-no="'+q.no+'">'+q.no+'</button>';
  }).join('');
  return'<details class="qnav"><summary>#'+(isS1?'作答題號':'檢討題號')+'</summary><div class="qnav-menu">'+btns+'</div></details>';
};

// 原因：非選擇題是手寫作答，無法自動批改；獨立放在 p.nm，不進 q.st／groups()／buildCards，才不會污染錯題統計。檢討頁只提供參考答案與自評，自評只存在這裡。
const nmUI=(p,rv)=>{
  const a=p.nm||[];if(!a.length)return'';
  let sec=null;
  return'<h2>非選擇題（手寫作答，不自動批改、不計入統計）</h2>'+a.map((n,i)=>{
    const head=n.sec!==sec?(sec=n.sec,n.sec?'<p class="hint"><b>'+esc(n.sec)+'</b>'+(n.ins&&n.ins.length?'：'+esc(n.ins.join(' ')):'')+'</p>':''):'';
    return head+'<article id="nm'+i+'">'+blks(n.blocks,'<b>'+n.no+'.</b> ')+
      '<textarea data-f="nmmine" data-i="'+i+'" placeholder="作答區">'+esc(n.mine)+'</textarea>'+
      (rv?(n.exp&&n.exp.length?'<div class="exp"><small>參考答案</small>'+blks(n.exp)+'</div>':'<p class="wr">原檔沒有切到這題的參考答案</p>')+
        '<div class="mk"><button class="o '+(n.ok==='o'?'on':'')+'" data-a="nmmark" data-i="'+i+'" data-v="o">我寫對了</button><button class="x '+(n.ok==='x'?'on':'')+'" data-a="nmmark" data-i="'+i+'" data-v="x">我寫錯了</button></div>':'')+'</article>';
  }).join('');
};
function vPaper(){
  const p=P(),qs=p.questions,L=LET(p);
  const h='<header><h2>'+nameHtml(p.name)+'</h2><button data-a="home">返回</button></header>'+stepper(p.stage)+(p.started?'':iss(p)+orphUI(p));
  if(p.stage===1)return h+'<p class="hint">正解已隱藏。按「開始作答」後會鎖定檢討、彙整與編輯，作答完按「交卷」解除並進入檢討。</p><div class="mk" style="margin:0 0 8px"><button class="pri" data-a="start"'+(p.started?' disabled':'')+'>開始作答</button><button class="pri" data-a="submit"'+(p.started?'':' disabled')+'>交卷</button>'+(p.started?'<small>作答中：檢討、彙整與編輯已鎖定</small>':'')+'</div>'+qs.map((q,i)=>{
    const ps=po(p,q),first=ps&&(!qs[i-1]||qs[i-1].pid!==q.pid);
    return(first?'<article class="ps"><small>題組：第 '+ps.from+'–'+ps.to+' 題</small>'+blks(ps.blocks)+'</article>':'')+
    '<article id="q'+q.no+'">'+ref(q)+blks(q.blocks,'<b>'+q.no+'.</b> ')+wr(p,q)+
    (q.options.length?q.options.map(o=>'<button class="opt '+(q.mine.includes(o.k)?'sel':'')+'" data-a="pick" data-i="'+i+'" data-k="'+o.k+'"><b>'+o.k+'</b>'+esc(o.v)+'</button>').join(''):
    '<div class="mk">'+L.map(k=>'<button class="opt lt '+(q.mine.includes(k)?'sel':'')+'" data-a="pick" data-i="'+i+'" data-k="'+k+'"><b>'+k+'</b></button>').join('')+'</div>')+
    (p.started?'':eb(i)+(S.edit===p.id+':'+i?editPanel(p,q,i,0):''))+'</article>';
  }).join('')+nmUI(p,0)+(p.started?'<button class="pri" data-a="submit">交卷</button>':'<button class="pri" data-a="st" data-n="2">對答案</button>')+qnavUI(p);
  const c=s=>qs.filter(q=>q.st===s).length,fl=S.filt||'x',nx=c('x'),no=c('o'),nu=qs.filter(q=>!q.cons.length).length;
  const list=qs.map((q,i)=>[q,i]).filter(([q])=>fl==='all'||(fl==='x'?q.st==='x':fl==='o'?q.st==='o':!q.cons.length));
  return h+keyImgUI(p)+dl('cons',[...allCons(),...EXT.cons])+dl('causes',CAUSES)+
  // 原因：沒作答的題不計入統計，要明說，免得又被當成「全對」或「全錯」而沒發現。
  (qs.some(q=>!q.mine&&!q.st)?'<p class="wr">有 '+qs.filter(q=>!q.mine&&!q.st).length+' 題沒作答，不會計入統計；要算錯請手動改判為錯（在該題的 ⋯ 選單）。</p>':'')+
  '<p>對 '+no+'・錯 '+nx+'・未判 '+c('')+'</p><div class="mk">'+[['x','錯題 '+nx],['o','答對 '+no],['all','全部 '+qs.length],['u','未標概念 '+nu]].map(([v,t])=>'<button class="'+(fl===v?'on':'')+'" data-a="filt" data-v="'+v+'">'+t+'</button>').join('')+(qs.some(q=>S.cardMap[qidOf(p,q)])?'<button data-a="cardview">對照卡片軟體端</button>':'')+'</div>'+
  '<p class="hint">每一題都要標單元／概念（含答對的），彙整才算得出錯率。每題各自標記，不會連動到其他題。 <button class="ghost" data-a="cleartags">'+(S.delc==='t'+p.id?'再按一次確認清除（其他考卷的同一題也會一起清掉）':'清除本卷所有標籤（其他考卷的同一題也會一起清掉）')+'</button></p>'+
  (list.length?list.map(([q,i])=>rev(p,q,i)).join(''):'<p class="empty">這個篩選下沒有題目。</p>')+nmUI(p,1)+'<button class="pri" data-a="st" data-n="3">前往彙整</button>'+qnavUI(p);
}

function vSum(){
  const a=agg(),c=P()?buildCards(P()):[],W=r=>r?r.w+r.g:0;
  const fm=r=>r?'錯 '+r.w+(r.g?'・猜 '+r.g:'')+' / 考 '+r.n:'未考';
  return'<header><h2>錯題彙整</h2><div class="mk"><button data-a="ana">分析</button><button data-a="home">返回</button></div></header>'+(P()?stepper(3):'')+
  '<p>弱點門檻 <input class="num" type="number" min="1" data-f="th" value="'+S.th+'"> 次以上（錯題加猜對，跨所有考卷）</p>'+
  (a.u?'<p class="wr">還有 '+a.u+' 題已批改但沒標概念，不會算進概念統計。</p>':'')+
  (S.tree.length?S.tree.map(s=>'<details open class="sj"><summary><b>'+esc(s.n)+'</b> <small>'+fm(a.s[s.n])+'</small> '+rb('s','',s.n)+'</summary>'+rnE('s','',s.n)+s.c.map(ch=>
    '<details class="ch"'+(ch.k.some(k=>W(a.k[k])>=S.th)||renOpen(s.n,ch)?' open':'')+'><summary>'+esc(ch.n)+' <small>'+fm(a.c[s.n+'\u0001'+ch.n])+'</small> '+rb('c',s.n,ch.n)+'</summary>'+rnE('c',s.n,ch.n)+ch.k.map(k=>{
      const r=a.k[k],hi=W(r)>=S.th;
      return'<div class="cn '+(hi?'hi':'')+'">'+esc(k)+' <small>'+fm(r)+'</small> '+rb('k','',k)+'</div>'+rnE('k','',k)+(hi?'<textarea data-f="pt" data-g="'+esc(k)+'" placeholder="這個概念常錯在哪、下次怎麼判斷">'+esc(S.points[k]||'')+'</textarea>':'');
    }).join('')+'</details>').join('')+'</details>').join(''):'<p class="empty">還沒有標籤。在「檢討」為題目標上科目、章節和概念後，這裡會出現樹狀統計。</p>')+
  '<h2>匯出成卡片</h2><p><small>'+(P()?'僅匯出「'+esc(P().name)+'」相關的卡片：':'尚未進入考卷（請從考卷的「彙整」步驟進入才能匯出）：')+'錯題卡 '+c.filter(x=>x.type==='wrong-question').length+' 張、重點卡 '+c.filter(x=>x.type==='key-point').length+' 張。科目＝櫃子、章節＝抽屜（location 軸），概念＝concept 標籤；同名標籤會重用。</small></p>'+
  '<div class="mk">'+Object.entries(SINKS).map(([k,s])=>'<button data-a="sink" data-s="'+k+'">'+s.label+'</button>').join('')+'</div>'+
  '<p><small>'+(cn()?'已連線到卡片軟體，可直接寫入。':'未偵測到卡片軟體：請從卡片軟體左側欄開啟本頁。')+'</small></p>'+
  // 原因：輸出框平常是空的、看起來像沒用的填空區；改成隱藏，匯出或同步有內容時才顯示。
  '<textarea id="out" rows="8" readonly hidden></textarea><span id="msg"></span>';
}

// 原因：原本科目、章節、概念各自獨立，勾了章節會把其他科目整科排除，也抽不到沒分章節的題。改成科目與章節是一棵樹（勾科目＝整科，勾章節＝只抽那幾章），並用一行白話寫出目前條件與符合題數。
const SEP='│';
const cat=()=>S.cat||(S.cat={y:[],l:[],k:[],n:10,all:false});
const yearOf=p=>(String(p.name).match(/(\d{2,4})\s*(?:學年度|年度|學年|年)/)||[])[1]||'';
const leafOf=g=>(g.canon.sub||'')+SEP+(g.canon.chap||'');
const catHit=(g,f,skip)=>(skip==='y'||!f.y.length||f.y.includes(yearOf(g.all[0].p)))&&
  (skip==='l'||!f.l.length||f.l.includes(leafOf(g)))&&
  (skip==='k'||!f.k.length||g.canon.cons.some(x=>f.k.includes(x)));
const catLabel=c=>[...c.y.map(y=>(y||'無')+'年度'),...new Set(c.l.map(x=>x.split(SEP)[0]||'未標科目')),...c.k].join('、').slice(0,24)||'全部';
function catLeaves(gs){
  // 科目、章節依「彙整」樹的順序排，沒在樹裡的（例如未標科目、未分章節）排最後。
  const order=S.tree.map(s=>s.n),m={},rk=(o,x)=>o.indexOf(x)<0?999:o.indexOf(x);
  gs.forEach(g=>{const s=g.canon.sub||'',c=g.canon.chap||'';(m[s]=m[s]||new Set()).add(c)});
  return Object.keys(m).sort((a,b)=>rk(order,a)-rk(order,b)).map(s=>{
    const t=tnode(s),o=t?t.c.map(x=>x.n):[];
    return{s,cs:[...m[s]].sort((a,b)=>rk(o,a)-rk(o,b))};
  });
}
function catSec(gs){
  const c=cat(),pool=gs.filter(g=>c.all||everWeak(g)),hit=pool.filter(g=>catHit(g,c));
  const n=(d,fn)=>pool.filter(g=>catHit(g,c,d)&&fn(g)).length;
  const lv=catLeaves(gs),yrs=[...new Set(gs.map(g=>yearOf(g.all[0].p)))].sort(),cons=[...new Set(gs.flatMap(g=>g.canon.cons))];
  const chk=(d,v,label,k)=>'<label class="ck"><input type="checkbox" data-f="cat" data-d="'+d+'" data-v="'+esc(v)+'"'+(c[d].includes(v)?' checked':'')+'>'+esc(label)+' <small>'+k+'</small></label>';
  const tree=lv.map(({s,cs})=>{
    const ks=cs.map(x=>s+SEP+x),sel=ks.filter(k=>c.l.includes(k)).length,part=sel>0&&sel<ks.length;
    return'<div class="cat-s"><label class="ck"><input type="checkbox" data-f="catsub" data-v="'+esc(s)+'"'+(sel===ks.length?' checked':'')+(part?' data-ind="1"':'')+'><b>'+esc(s||'（未標科目）')+'</b> <small>'+n('l',g=>(g.canon.sub||'')===s)+' 題'+(part?'・已選 '+sel+'/'+ks.length+' 章':'')+'</small></label>'+
      '<div class="cat-c">'+cs.map((x,i)=>chk('l',ks[i],x||'（未分章節）',n('l',g=>leafOf(g)===ks[i]))).join('')+'</div></div>';
  }).join('');
  const sc=lv.map(({s,cs})=>{const sel=cs.filter(x=>c.l.includes(s+SEP+x));return sel.length?(s||'未標科目')+(sel.length===cs.length?'（整科）':'：'+sel.map(x=>x||'未分章節').join('、')):''}).filter(Boolean);
  const rule='年度：'+(c.y.length?c.y.map(y=>(y||'無')+' 年度').join('或'):'不限')+'　科目章節：'+(sc.length?sc.join('；'):'不限')+'　概念：'+(c.k.length?c.k.join('或'):'不限');
  return'<h2>依類別抽題組卷</h2>'+
  '<p><small>勾選要練習的類別，系統從符合的題目中隨機抽題。年度、科目章節、概念三組條件要同時成立；同一組裡勾多個，符合其中一個即可；整組都沒勾＝不限。數字是在其他條件下符合的題數。</small></p>'+
  '<p><b>抽題範圍</b></p><div class="mk">'+[[false,'只抽錯過或猜對過的',gs.filter(everWeak).length],[true,'全部題目（含一直答對的）',gs.length]].map(([v,t,k])=>'<button class="'+(c.all===v?'on':'')+'" data-a="catpool" data-v="'+v+'">'+t+' '+k+'</button>').join('')+'</div>'+
  '<p><b>年度</b></p><div class="mk">'+yrs.map(y=>chk('y',y,y?y+' 年度':'（無年度）',n('y',g=>yearOf(g.all[0].p)===y))).join('')+'</div>'+
  '<p><b>科目與章節</b> <small>勾科目＝整科；展開勾章節＝只抽那幾章</small></p>'+(tree||'<small>還沒有標科目</small>')+
  (cons.length?'<p><b>概念</b></p><div class="mk">'+cons.map(k=>chk('k',k,k,n('k',g=>g.canon.cons.includes(k)))).join('')+'</div>':'')+
  '<p class="hint">目前條件：'+esc(rule)+'</p>'+
  '<p>抽 <input class="num" type="number" min="1" data-f="catn" value="'+c.n+'"> 題　<small>符合 '+hit.length+' 題'+(hit.length&&hit.length<c.n?'，題數不足，會全部抽出':'')+'</small></p>'+
  '<div class="mk"><button class="pri" data-a="catcompose"'+(hit.length?'':' disabled')+'>組成考卷（'+Math.min(c.n,hit.length)+' 題）</button><button data-a="catclear">清除勾選</button></div>';
}

function vAna(){
  const hd='<header><h2>分析</h2><div class="mk"><button data-a="sum">彙整</button><button data-a="home">返回</button></div></header>';
  const gs=groups(),a=agg();
  if(!gs.length)return hd+'<p class="empty">還沒有批改過的題目。在作答頁按「對答案」後，這裡會顯示跨考卷的統計。</p>';
  const pct=(w,n)=>n?Math.round(100*w/n):0,fs=gs.map(g=>g.first.q);
  const nw=fs.filter(q=>q.st==='x').length,ng=fs.filter(q=>q.st!=='x'&&q.guess).length;
  const stillX=gs.filter(g=>g.last.q.st==='x').length,still=gs.filter(weak).length,ever=gs.filter(everWeak).length;
  const row=(l,r,btn)=>{const wk=r.w+r.g;return'<div class="br"><span title="'+esc(l)+'">'+esc(l)+'</span><progress max="100" value="'+pct(wk,r.n)+'"></progress><b>'+r.w+(r.g?'+'+r.g:'')+'/'+r.n+'（'+pct(wk,r.n)+'%）</b>'+(btn||'')+'</div>'};
  const srt=o=>Object.entries(o).sort((x,y)=>{const[p,q]=[x[1],y[1]],rp=pct(p.w+p.g,p.n),rq=pct(q.w+q.g,q.n);return(S.sort==='rate'?(rq-rp)||(q.n-p.n):((q.w+q.g)-(p.w+p.g))||(rq-rp))});
  const sec=(t,o,fn,max)=>'<h2>'+t+'</h2>'+(Object.keys(o).length?srt(o).slice(0,max||99).map(fn).join(''):'<p class="empty">還沒有資料。</p>');
  const rep=gs.map(g=>({g,n:g.att.length,w:g.att.filter(x=>x.q.st==='x').length})).filter(x=>x.n>=2&&x.w).sort((x,y)=>pct(y.w,y.n)-pct(x.w,x.n)||y.n-x.n);
  const cs=Object.entries(a.cause).sort((x,y)=>y[1]-x[1]);
  return hd+
  '<p>已批改 '+gs.length+' 題（同一題只算一次）：首次作答錯 '+nw+' 題（'+pct(nw,gs.length)+'%）、猜對 '+ng+' 題；最近一次仍答錯 '+stillX+' 題、猜對 '+(still-stillX)+' 題。</p>'+
  '<p>組卷：最近弱點 <input class="num" type="number" min="0" data-f="n1" value="'+(S.n1??15)+'"> 題（最近一次仍答錯或猜對，共 '+still+' 題可選）＋ 隨機抽 <input class="num" type="number" min="0" data-f="n2" value="'+(S.n2??10)+'"> 題（曾經錯過或猜對，共 '+ever+' 題）</p>'+
  '<button class="pri" data-a="compose" data-k=""'+(ever?'':' disabled')+'>組成考卷</button> <span id="msg"></span>'+
  '<br><label class="ck"><input type="checkbox" data-f="shuf"'+(S.shuf!==false?' checked':'')+'>打亂選項順序（避免記住位置）</label>'+
  '<p><small>比例都以每題「首次作答」計算，重做不重複計入；數字是「錯＋猜對／考過」。排序：</small></p>'+
  '<div class="mk">'+[['cnt','錯題數'],['rate','錯誤率']].map(([v,t])=>'<button class="'+((S.sort||'cnt')===v?'on':'')+'" data-a="sort" data-v="'+v+'">'+t+'</button>').join('')+'</div>'+
  sec('科目',a.s,([k,r])=>row(k,r))+
  sec('章節',a.c,([k,r])=>row(k.replace('\u0001',' / '),r),20)+
  sec('概念（知識點）',a.k,([k,r])=>row(k,r,'<button class="ghost" data-a="compose" data-k="'+esc(k)+'">抽出</button>'),30)+
  '<h2>錯誤原因</h2><p><small>占首次作答錯題的比例</small></p>'+(cs.length?cs.map(([k,v])=>row(k,{w:v,g:0,n:nw})).join(''):'<p class="empty">還沒有錯題。</p>')+
  '<h2>同一題反覆錯</h2>'+(rep.length?rep.map(({g,n,w})=>{
    const t=g.canon,ex=(t.blocks.find(b=>b.t==='text')||{v:''}).v.slice(0,36);
    return'<div class="br"><span title="'+esc(g.all[0].p.name+' 第 '+t.no+' 題')+'">'+esc(g.all[0].p.name+' 第 '+t.no+' 題')+'</span><progress max="100" value="'+pct(w,n)+'"></progress><b>錯 '+w+'/'+n+' 次・最近'+(g.last.q.st==='x'?'錯':'對')+'</b></div><small>'+esc(ex)+'…</small>';
  }).join(''):'<p class="empty">還沒有重做過而且錯過的題目。用上面的按鈕把錯題組成考卷再做一次，就會累積這份紀錄。</p>')+catSec(gs);
}

function renderMath(el){
  if(!window.renderMathInElement)return;
  try{renderMathInElement(el||document.getElementById('app'),{delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false}],throwOnError:false,strict:false})}catch(e){console.warn('KaTeX',e)}
}
function render(){
  $('#app').innerHTML=S.view==='import'?vImport():S.view==='sum'?vSum():S.view==='ana'?vAna():S.view==='paper'&&P()?vPaper():vList();
  document.querySelectorAll('input[data-ind]').forEach(e=>{e.indeterminate=true});
  // 原因：深淺切換鈕放進每個畫面標題列的最右邊；統一在這裡加，免得五個 view 各寫一份。
  const h=document.querySelector('#app header');
  if(h){
    const light=themeNow()==='light',b=document.createElement('button');
    b.className='icon-btn';b.dataset.a='theme';b.title=light?'切換成深色模式':'切換成淺色模式';b.setAttribute('aria-label',b.title);
    b.innerHTML=light?ICON.moon:ICON.sun;h.appendChild(b);
  }
  renderMath();
}
function grade(p){
  p.questions.forEach(q=>{if(q.key&&!q.manual)q.st=!q.mine?'':norm(q.mine)===norm(q.key)?'o':'x'});
  p.graded=true;p.gradedAt=new Date().toISOString();
}

/* ---------- events ---------- */
document.addEventListener('click',async e=>{
  // 原因：⋯ 選單是原生 details，點外面不會自己收；不收的話會蓋住下面的科目欄。
  document.querySelectorAll('.more[open]').forEach(m=>{if(!m.contains(e.target))m.removeAttribute('open')});
  const t=e.target.closest('[data-a]');if(!t)return;
  const d=t.dataset,p=P(),q=p&&p.questions[d.i],y=scrollY;
  if(d.a==='ren')e.preventDefault();
  if(d.a==='stop')return; // 原因：下拉選單在整列的點擊範圍內，不攔下來點一下就會開啟考卷、選單也會被重畫掉。
  if(d.a!=='del'&&d.a!=='cleartags')S.delc=null; // 原因：「清除標籤」也要兩段確認，其他任何動作都該取消確認狀態。
  if(d.a==='sink')return sink(d.s);
  if(d.a==='create')return create();
  if(d.a==='cardview'){await loadCardView(p);scrollTo(0,y);return}
  // 原因：切主題不必存資料、也不該跳回頁首，只重畫並保留捲動位置。
  if(d.a==='theme'){setTheme(themeNow()==='light'?'dark':'light',true);render();scrollTo(0,y);return}
  if(d.a==='zoom'){const o=document.createElement('div');o.id='lb';o.dataset.a='unzoom';o.innerHTML='<img src="'+d.src+'" alt="">';document.body.appendChild(o);return}
  if(d.a==='unzoom'){t.remove();return}
  // 原因：作答中（已按開始作答、尚未交卷）不得進入檢討／彙整，也不得編輯；按鈕已隱藏或停用，這裡再擋一次，避免舊畫面或鍵盤操作繞過。
  if(p&&p.started&&(LOCKED.has(d.a)||(d.a==='st'&&+d.n!==1))){msg('作答中，交卷後才能使用',true);return}
  switch(d.a){
    case'imp':S.view='import';PENDING=null;break;
    case'bk':await backup();return;
    case'rsok':{try{await restore(RS);RS=null}catch(err){render();msg(err.message, true);return}break}
    case'home':S.view='list';S.cur=null;break;
    case'sum':S.view='sum';break;
    case'open':S.cur=d.id;S.view='paper';await loadAssets(P());if(P()&&P().stage===2)loadCardView(P(),true);break;
    case'del':if(S.delc===d.id){S.papers=S.papers.filter(x=>x.id!==d.id);S.delc=null;pruneCons();gcAssets()}else S.delc=d.id;break;
    case'redo':{const np=resit(S.papers.find(x=>x.id===d.id));S.papers.unshift(np);S.cur=np.id;S.view='paper';await loadAssets(np);break}
    case'bkdir':await pickBackupDir();break;
    case'bkperm':await restoreBackupPerm();break;
    case'bktoggle':
      if(!S.bkOn){
        if(!DIR_HANDLE)await pickBackupDir();
        else if(DIR_NEED_PERM)await restoreBackupPerm();
        else{S.bkOn=true;save();scheduleAutoBackup();await runAutoBackup(true);render()}
      }else{
        S.bkOn=false;if(BK_TIMER){clearInterval(BK_TIMER);BK_TIMER=null}save();render();
      }
      break;
    case'ren':S.ren={t:d.t,sub:d.sub,o:d.o};break;
    case'rcx':S.ren=null;break;
    case'rok':{const r=S.ren;renameTag(r.t,r.sub,r.o,$('#rn').value);S.ren=null;break}
    case'catpool':cat().all=d.v==='true';break;
    case'catclear':{const c=cat();c.y=[];c.l=[];c.k=[];break}
    case'catcompose':{
      // 原因：題目由類別條件自動隨機抽，不逐題自選；組成後依考卷時間與題號排序。
      const c=cat(),pool=groups().filter(g=>(c.all||everWeak(g))&&catHit(g,c));
      if(!pool.length){msg('沒有符合的題目',true);return}
      for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]]}
      const picks=pool.slice(0,c.n).sort((x,y)=>{const u=x.all[0].p.created,v=y.all[0].p.created;return u===v?x.canon.no-y.canon.no:u<v?-1:1});
      const np=build(picks,'抽題・'+catLabel(c));
      S.papers.unshift(np);S.cur=np.id;S.view='paper';await loadAssets(np);break}
    case'st':{
      const n=+d.n;
      if(n===3){S.view='sum';break}
      S.view='paper';if(n===2&&!p.graded)grade(p);p.stage=n;if(n===2)loadCardView(p,true);break;
    }
    case'ana':S.view='ana';break;
    case'gtog':S.gclose=S.gclose||{};if(S.gclose[d.g])delete S.gclose[d.g];else S.gclose[d.g]=1;break;
    case'subjadd':{
      const n=$('#ns').value.trim();
      if(!n||n==='未分類'){msg('請輸入分類名稱（不能空白，也不能叫「未分類」，那是沒分類考卷的固定標題）',true);return}
      if(subjNames().includes(n)){msg('分類「'+n+'」已經存在',true);return}
      S.subjs.push(n);break}
    case'sdel':{
      if(S.papers.some(x=>(x.subj||'')===d.g)){msg('分類「'+d.g+'」底下還有考卷，請先把它們移到其他分類',true);return}
      S.subjs=S.subjs.filter(x=>x!==d.g);break}
    case'sort':S.sort=d.v;break;
    case'compose':{const np=compose(d.k);if(!np){msg('沒有符合的題目', true);return}S.papers.unshift(np);S.cur=np.id;S.view='paper';await loadAssets(np);break}
    case'start':p.started=true;p.stage=1;S.edit=null;break;
    case'submit':{p.started=false;if(!p.graded)grade(p);p.stage=2;loadCardView(p,true);break}
    case'rmpimg':{
      const ps=po(p,q),b=ps&&ps.blocks[+d.j];if(!b||b.t!=='img')break;
      const pk=ps.oid||p.id+':'+ps.id;
      S.papers.forEach(x=>{x.passages.forEach(z=>{if(z===ps||(z.oid||x.id+':'+z.id)===pk)z.blocks=z.blocks.filter(y=>y.id!==b.id)});validate(x)});
      break}
    case'edit':{const k=p.id+':'+d.i;S.edit=S.edit===k?null:k;break}
    case'filt':S.filt=d.v;break;
    case'rmcon':withSync(p,()=>{q.cons=q.cons.filter(x=>x!==d.k)});break;
    case'pick':{
      const multi=q.key.length>1||(!q.key&&/多選|複選|不只一個/.test(qtext(q)));
      let s=q.mine?q.mine.split(''):[];
      s=s.includes(d.k)?s.filter(x=>x!==d.k):multi?[...s,d.k]:[d.k];
      q.mine=s.sort().join('');delete q.manual;p.graded=false;break;
    }
    // 原因：補圖是「指定題號」而非「對檔名」；同一題的重做卷（twins）一併補上，匯出卡片與備份才拿得到。
    case'useorph':{
      const n=+t.parentElement.querySelector('input').value,qq=p.questions.find(x=>x.no===n);
      if(!qq){msg('請先輸入有效的題號',true);return}
      [[p,qq],...twins(p,qq)].forEach(([x,y])=>{y.blocks.push({t:'img',id:d.id,html:'',u:1});if(!x.have.includes(d.id))x.have.push(d.id);validate(x)});
      break}
    case'useorphx':{
      const n=+t.parentElement.querySelector('input').value,qq=p.questions.find(x=>x.no===n);
      if(!qq){msg('請先輸入有效的題號',true);return}
      [[p,qq],...twins(p,qq)].forEach(([x,y])=>{(y.exp=y.exp||[]).push({t:'img',id:d.id,html:'',u:1});if(!x.have.includes(d.id))x.have.push(d.id);validate(x)});
      break}
    case'addq':{
      const n=+d.no;if(p.questions.some(x=>x.no===n))break;
      const ps=p.passages.find(x=>x.from<=n&&n<=x.to),sp=(p.expSpare||{})[n];
      const nq={no:n,blocks:[],options:[],key:(p.keyAll||{})[n]||'',mine:'',st:'',sub:'',chap:'',cons:[],guess:false,cause:'',why:'',right:'',fix:'',optNotes:{}};
      if(ps)nq.pid=ps.id;
      if(sp){nq.exp=JSON.parse(JSON.stringify(sp.exp));if(sp.inf)nq.expInf=true;if(sp.gap)nq.expGap=sp.gap;if(sp.lead)nq.expLead=true}
      let at=p.questions.findIndex(x=>x.no>n);if(at<0)at=p.questions.length;
      p.questions.splice(at,0,nq);p.graded=false;validate(p);
      S.edit=p.id+':'+at;if(p.stage===2)S.filt='all';
      save();render();const el=$('#q'+n);if(el)el.scrollIntoView({block:'start'});return;
    }
    case'addtxt':[[p,q],...twins(p,q)].forEach(([x,y])=>{y.blocks.unshift({t:'text',v:''});validate(x)});break;
    case'addxtxt':[[p,q],...twins(p,q)].forEach(([x,y])=>{(y.exp=y.exp||[]).push({t:'text',v:''});validate(x)});EXPO.add(p.id+':'+q.no);break;
    case'addopt':{
      const k=[...'ABCDEFGH'].find(x=>!q.options.some(o=>o.k===x));
      if(!k){msg('選項最多 8 個',true);return}
      q.options.push({k,v:''});q.options.sort((a,b)=>a.k<b.k?-1:1);validate(p);break}
    case'rmopt':{const o=q.options.pop();if(o)delete q.optNotes[o.k];validate(p);break}
    case'resplit':{
      const j=q.blocks.map(b=>b.t).lastIndexOf('text');
      if(j<0){msg('這題還沒有題幹文字，請先按「補題幹文字」並貼上題目',true);return}
      const r=splitOpts(q.blocks[j].v);
      if(r.opts.length<2){msg('題幹文字裡找不到 (A)(B)… 這樣的選項標記，切不出選項',true);return}
      q.blocks[j].v=wrapBareLatex(r.stem);q.options=r.opts.map(o=>({k:o.k,v:wrapBareLatex(o.v)}));validate(p);break}
    case'rmximg':{
      const b=q.exp&&q.exp[+d.j];if(!b||b.t!=='img')break;
      [[p,q],...twins(p,q)].forEach(([x,y])=>{y.exp=(y.exp||[]).filter(z=>z.id!==b.id);if(!y.exp.length)delete y.exp;validate(x)});
      break}
    case'rmimg':{
      const b=q.blocks[+d.j];if(!b||b.t!=='img')break;
      [[p,q],...twins(p,q)].forEach(([x,y])=>{y.blocks=y.blocks.filter(z=>z.id!==b.id);validate(x)});
      break}
    case'setkeyimg':{
      p.keyImgs=p.keyImgs||[];
      if(!p.keyImgs.includes(d.id))p.keyImgs.push(d.id);
      break;
    }
    case'rmkeyimg':{
      p.keyImgs=(p.keyImgs||[]).filter(id=>id!==d.id);
      break;
    }
    case'cleartags':
      if(S.delc==='t'+p.id){withSync(p,()=>p.questions.forEach(z=>{z.sub='';z.chap='';z.cons=[]}));S.delc=null}else S.delc='t'+p.id;
      break;
    case'mark':q.st=d.v;q.manual=1;p.gradedAt=new Date().toISOString();break;
    case'auto':delete q.manual;grade(p);break;
    case'nmmark':{const n=p.nm[+d.i];n.ok=n.ok===d.v?'':d.v;break}
    case'jump':{
      let el=$('#q'+d.no);
      if(!el&&S.filt&&S.filt!=='all'){S.filt='all';render();el=$('#q'+d.no)}
      if(el){el.scrollIntoView({behavior:'smooth',block:'start'});t.closest('details')?.removeAttribute('open')}
      return;
    }
  }
  save();render();
  if(['pick','mark','auto','nmmark','edit','start','rmpimg','addopt','rmopt','resplit','addtxt','addxtxt','rmcon','rmimg','useorph','useorphx','rmximg','sort','ren','rok','rcx','catpool','catclear','gtog','subjadd','sdel','del'].includes(d.a))scrollTo(0,y);else scrollTo(0,0);
});

document.addEventListener('change',async e=>{
  const t=e.target;
  if(t.dataset.restore!==undefined){RS=t.files[0]||null;render();return}
  if(t.dataset.pick!==undefined){
    // 原因：選檔失敗（例如 zip 損毀）時舊的 PENDING 還在，畫面卻顯示錯誤，按「建立」會悄悄匯入上一次選的檔案。
    PENDING=null;
    try{
      PENDING=await collect(t.files);
    }catch(err){$('#sel').textContent='尚未選擇檔案';return msg(err.message, true)}
    // 原因：「單份」入口選到含多份考卷的資料夾（層級選錯）時要明說並擋下，不悄悄當批次匯入。
    if(t.dataset.pick==='single'&&PENDING.length!==1){const n=PENDING.length;PENDING=null;$('#sel').textContent='尚未選擇檔案';return msg('這個資料夾底下有 '+n+' 份考卷，「單份」一次只能匯入一份。要匯入多份請改用「批次：選母資料夾」。',true)}
    const cnt=Array.isArray(PENDING)?PENDING.length:PENDING?1:0;
    const names=Array.isArray(PENDING)?PENDING.map(b=>(b.subj?b.subj+'／':'')+b.name).join('、'):PENDING?PENDING.name:'';
    $('#sel').textContent='已選 '+cnt+' 份（zip 到匯入時才展開檢查）：'+names;
    return;
  }
  if(t.dataset.supp!==undefined){
    const p=P();
    // 原因：舊卷圖片 ID 沒有前綴、組卷沿用原卷前綴，一律用 p.id 當前綴永遠對不上；改依區塊裡實際的 ID 比對檔名，對不上就報錯而不是靜默。
    for(const f of t.files){
      const hit=new Set();
      [...p.questions,...p.passages].forEach(x=>[...x.blocks,...(x.exp||[])].forEach(b=>{if(b.id&&(b.id===f.name||b.id.endsWith('__'+f.name)))hit.add(b.id)}));
      if(!hit.size){msg('找不到對應的圖片位置：'+f.name,true);continue}
      // 原因：與補入圖片（addimg）一致，先確認寫進 IndexedDB 才標記為已有；原本 aSet 不等待也吞掉失敗，標記了卻沒存進去。
      for(const id of hit){
        try{await tx('assets','readwrite',s=>s.put(f,id))}catch(err){reportDbErr(err);continue}
        MEM[id]=f;if(!p.have.includes(id))p.have.push(id);
      }
    }
    validate(p);await loadAssets(p);save();render();return;
  }
  // 原因：補入的圖先寫進 IndexedDB 並確認成功才接到題目，失敗就報錯、不留空殼；檔名只留副檔名，避免空白與中文讓卡片匯出的 exam-asset: 連結斷掉。
  if(t.dataset.addimg!==undefined){
    const p=P(),q=p&&p.questions[t.dataset.i];if(!q)return;
    const tw=twins(p,q);
    for(const f of t.files){
      const id=p.id+'__u'+uid()+((f.name.match(/\.\w+$/)||['.png'])[0]);
      try{await tx('assets','readwrite',s=>s.put(f,id))}catch(err){reportDbErr(err);break}
      MEM[id]=f;
      [[p,q],...tw].forEach(([x,y])=>{y.blocks.push({t:'img',id,html:'',u:1});if(!x.have.includes(id))x.have.push(id)});
    }
    t.value='';validate(p);tw.forEach(([x])=>validate(x));await loadAssets(p);await save();render();return;
  }
  if(t.dataset.addximg!==undefined){
    const p=P(),q=p&&p.questions[t.dataset.i];if(!q)return;
    const tw=twins(p,q);
    for(const f of t.files){
      const id=p.id+'__u'+uid()+((f.name.match(/\.\w+$/)||['.png'])[0]);
      try{await tx('assets','readwrite',s=>s.put(f,id))}catch(err){reportDbErr(err);break}
      MEM[id]=f;
      [[p,q],...tw].forEach(([x,y])=>{(y.exp=y.exp||[]).push({t:'img',id,html:'',u:1});if(!x.have.includes(id))x.have.push(id)});
    }
    EXPO.add(p.id+':'+q.no);t.value='';validate(p);tw.forEach(([x])=>validate(x));await loadAssets(p);await save();render();return;
  }
  const f=t.dataset.f;if(!f)return;
  const p=P(),q=p&&p.questions[t.dataset.i];
  if(f==='pt')S.points[t.dataset.g]=t.value;
  else if(f==='psubj'){const x=S.papers.find(z=>z.id===t.dataset.id);if(!x)return msg('找不到這份考卷，沒有移動',true);x.subj=t.value}
  else if(f==='th')S.th=Math.max(1,+t.value||3);
  else if(f==='cat'){const a=cat()[t.dataset.d],v=t.dataset.v,i=a.indexOf(v);if(t.checked&&i<0)a.push(v);else if(!t.checked&&i>=0)a.splice(i,1)}
  else if(f==='catsub'){
    // 勾科目＝把它底下全部章節一起勾起來或取消；半選狀態點一下＝全選。
    const c=cat(),s=t.dataset.v,ks=catLeaves(groups()).filter(x=>x.s===s).flatMap(x=>x.cs.map(ch=>s+SEP+ch));
    c.l=t.checked?[...new Set([...c.l,...ks])]:c.l.filter(k=>!ks.includes(k));
  }
  else if(f==='catn')cat().n=Math.max(1,Math.floor(+t.value)||1);
  else if(f==='bkmin'){S.bkMin=Math.max(1,Math.floor(+t.value)||1);scheduleAutoBackup()}
  else if(f==='n1'||f==='n2')S[f]=Math.max(0,Math.floor(+t.value)||0);
  else if(f==='shuf')S.shuf=t.checked;
  else if(f==='guess')q.guess=t.checked;
  else if(f==='skip'){S.skip=S.skip||{};const k=qidOf(p,q);if(t.checked)S.skip[k]=1;else delete S.skip[k]}
  else if(f==='appnote')q.appendNote=t.value;
  else if(f==='sub'||f==='chap')withSync(p,()=>setTag(p,+t.dataset.i,f,t.value.trim()));
  else if(f==='con'){
    const v=t.value.trim(),h=homeOf(v);
    // 原因：概念在樹裡只有一個家；已屬於別的章節時，原本會悄悄掛上去，樹與統計就不一致。改成大聲拒絕。
    if(v&&h.sub&&(h.sub!==q.sub||h.chap!==q.chap))msg('概念「'+v+'」已屬於「'+h.sub+' / '+h.chap+'」，不能掛在另一個章節。請改用不同名稱，或先把那邊的題目改掉。',true);
    else if(v&&!q.cons.includes(v))withSync(p,()=>{ensure(q.sub,q.chap,v);q.cons.push(v)});
  }
  // 原因：沒有這行，nmmine 會落到最後的 else q[f]=t.value，把作答寫成第 i 題的 q.nmmine 垃圾欄位。
  else if(f==='nmmine'){const n=p&&p.nm&&p.nm[t.dataset.i];if(!n)return;n.mine=t.value}
  else if(f.startsWith('o:'))q.optNotes[f.slice(2)]=t.value;
  else if(/^(eb|pb|eo|ex):/.test(f)||f==='key')syncEdit(p,q,f,t.value);
  else q[f]=t.value;
  const y=scrollY;
  save();if(['th','sub','chap','con','key','cat','catsub','catn','guess','skip','psubj'].includes(f)||/^(eb|pb|eo|ex):/.test(f)){render();scrollTo(0,y)}
});

// 原因：筆記原本只在 change（離開輸入框）才寫入；打字到一半關頁、切換 App 或重新整理時 change 不會觸發，整段筆記會消失且沒有任何提示。改成邊打邊更新記憶體、停手後存檔，頁面隱藏時立刻存。
let SAVE_TM=0;
const flushSave=()=>{if(SAVE_TM){clearTimeout(SAVE_TM);SAVE_TM=0;save()}};
document.addEventListener('input',e=>{
  const t=e.target,f=t.dataset&&t.dataset.f;if(!f)return;
  if(f==='sub'||f==='chap'){
    const box=t.closest('.tg');
    if(box){
      const ch=box.querySelector('[data-f="chap"]'),cn=box.querySelector('[data-f="con"]');
      if(f==='sub'&&ch){ch.disabled=!t.value.trim();ch.placeholder=ch.disabled?'先選科目，才能填章節':'章節'}
      if(f==='chap'&&cn){cn.disabled=!t.value.trim();cn.placeholder=cn.disabled?'先選章節，才能加概念':'＋概念（知識點），Enter 加入'}
    }
    return;
  }
  const p=P(),q=p&&p.questions[t.dataset.i];
  if(f==='pt')S.points[t.dataset.g]=t.value;
  else if(q&&(f==='why'||f==='right'||f==='fix'||f==='cause'||f==='appnote'))q[f==='appnote'?'appendNote':f]=t.value;
  else if(q&&f.startsWith('o:'))q.optNotes[f.slice(2)]=t.value;
  else if(f==='nmmine'){const n=p&&p.nm&&p.nm[t.dataset.i];if(!n)return;n.mine=t.value}
  else return;
  clearTimeout(SAVE_TM);SAVE_TM=setTimeout(()=>{SAVE_TM=0;save()},800);
});
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')flushSave()});
addEventListener('pagehide',flushSave);
window.ExamReview={buildCards,SINKS,IMPORTERS,render,state:()=>S,pushToCardnote};
// 原因：handler 或 render 丟例外時畫面不更新、使用者看不到任何訊息；至少讓它大聲報錯。
addEventListener('error',e=>msg('未預期的錯誤：'+(e.message||e),true));
addEventListener('unhandledrejection',e=>msg('未預期的錯誤：'+((e.reason&&e.reason.message)||e.reason),true));
load().then(async()=>{if(location.hash==='#import')S.view='import';await initAutoBackup();render();loadExt()});
render();
</script>
</body>
</html>