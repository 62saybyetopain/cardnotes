function fromMineru(j, scopePrefix){
  const out=[];
  j.pdf_info.forEach((pg,pi)=>{if(pi>0)out.push({t:'brk'});pg.para_blocks.forEach(b=>{
    // 原因：頁首過濾（y≤62）會誤殺貼在頁面最上緣、只有一行的「14. …」詳解或題目；開頭是題號的區塊一律保留。
    if(pi>0&&b.bbox&&b.bbox[3]<=62&&(b.type==='title'||b.type==='text')&&!/^\s*\d{1,3}\s*[.．、](?!\d)/.test(linesOf(b)[0]||''))return;
