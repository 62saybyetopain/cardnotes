<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>考卷複習</title>
<script>
/* 原因：主題要在畫面出現前就決定，否則會先閃一下錯的顏色。優先序：自己存過的選擇 > 從卡片軟體開啟時沿用它的主題 > 系統偏好。 */
(function(){var t=null;try{t=localStorage.getItem('exam-theme')}catch(e){}
if(t!=='light'&&t!=='dark'){try{var o=window.opener&&window.opener.document.documentElement.getAttribute('data-theme');if(o==='light'||o==='dark')t=o}catch(e){}}
if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';
document.documentElement.setAttribute('data-theme',t)})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js" onload="window.renderMath&&renderMath()"></script>
<style>
/* 原因：色彩 token 沿用卡片軟體（深色為預設、淺色用 data-theme="light"），讓兩個網頁看起來是同一套；舊變數名稱留作別名，因為程式裡的行內樣式（提示條、msg）還在用。 */
:root,[data-theme="dark"]{--bg:#17181a;--panel:#1f2023;--line:#34363a;--text:#e6e6e6;--muted:#9a9ea6;--accent:#6c9bff;--accent-soft:#24304a;--danger:#ff7b6b;--warn:#e0b24f;--card:#26272b;--sidebar:#1f2023;--ok:#34d399;--code-bg:rgba(15,23,42,.55);color-scheme:dark}
[data-theme="light"]{--bg:#ebe9e3;--sidebar:#e2dfd8;--panel:#f5f3ee;--card:#faf8f4;--line:#cfccc2;--text:#2c2a26;--muted:#625f58;--accent:#1d4ed8;--accent-soft:#d8e2f6;--danger:#b91c1c;--warn:#92400e;--ok:#15803d;--code-bg:#ebe8e0;color-scheme:light}
:root{--ink:var(--text);--sub:var(--muted);--paper:var(--bg);--red:var(--danger);--grn:var(--ok);--blue:var(--accent);--sel:var(--accent-soft);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,"Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;overscroll-behavior-y:none}
#app{max-width:720px;margin:0 auto;padding:16px 16px 64px}

/* 標題列：標題靠左撐開，按鈕與切換鈕靠右 */
header{display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--line)}
header>:first-child{flex:1;min-width:0}
h1,h2{margin:20px 0 8px;font-size:13px;font-weight:600;color:var(--muted)}
header h1,header h2{margin:0;font-size:16px;font-weight:700;color:var(--accent);letter-spacing:.02em}

/* 按鈕、輸入框：與卡片軟體相同的 panel 底、6px 圓角、hover 變 accent 邊 */
button,.btn{font:inherit;color:inherit;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:3px 9px;cursor:pointer}
button:hover,.btn:hover{border-color:var(--accent)}
button:disabled{opacity:.45;cursor:not-allowed}
.btn{display:inline-block;margin:6px 0}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.pri{background:var(--accent);color:#fff;border-color:var(--accent)}
.ghost{border:0;background:transparent;color:var(--muted);padding:0 4px}
.ghost:hover{color:var(--accent)}
.icon-btn{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;flex-shrink:0}
.ui-icon{flex-shrink:0}
input,textarea{width:100%;font:inherit;color:inherit;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:5px 8px;margin:4px 0}
input:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
input[type=checkbox],input[type=radio]{accent-color:var(--accent)}
input.num{width:4.5em}
input[type=file]{border:0;background:none;padding:4px 0;box-shadow:none}
textarea{min-height:64px;resize:vertical}
label{display:block;margin:12px 0 4px;font-weight:500}
details{margin:6px 0}
summary{cursor:pointer;color:var(--muted)}
.mk{display:flex;gap:6px;align-items:center;flex-wrap:wrap}

/* 作答／檢討／彙整 三步驟：沿用卡片軟體 tabs 的選取樣式 */
nav{display:flex;gap:4px;margin:0 0 14px;overflow-x:auto}
nav button{flex:1;white-space:nowrap}
nav .on{background:var(--accent-soft);border-color:var(--accent);color:var(--accent);font-weight:600}
.mk>button.on{background:var(--accent-soft);border-color:var(--accent);font-weight:600}

/* 考卷清單 */
.row{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:center;padding:10px 12px;margin:0 0 6px;background:var(--card);border:1px solid var(--line);border-radius:10px;cursor:pointer;transition:border-color .15s ease}
.row:hover{border-color:color-mix(in srgb,var(--accent) 55%,var(--line))}
.row span{color:var(--muted);flex:1;font-size:12px}
/* 「重做」「抽題」與日期只是附加標記：小字、淡色、不加粗，和考卷名稱拉開主從。用 em 而不是 span，避免被上一行 .row span 蓋掉。 */
.nt,.nd{font-style:normal;font-weight:400;font-size:11px;line-height:1.6;letter-spacing:0;white-space:nowrap;margin-left:6px;vertical-align:middle;color:var(--muted)}
.nt{padding:0 6px;border:1px solid var(--line);border-radius:10px}
/* 原因：考卷清單依科目分組，標題列可點擊收合；分類下拉選單放在每列右側。 */
.gh{cursor:pointer;user-select:none}
.row select{font:inherit;font-size:12px;color:var(--muted);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:1px 4px;max-width:8em}

/* 題目卡：比照卡片軟體的卡片；題組文章比照文獻卡片（扁平、無陰影、accent 邊） */
article{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:12px;padding:12px 14px;margin:0 0 12px;box-shadow:0 4px 16px rgba(0,0,0,.08),0 1px 3px rgba(0,0,0,.05)}
article.ng{border-left-color:var(--danger)}
article.ps{background:color-mix(in srgb,var(--panel) 80%,var(--bg));border:1.5px solid color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:none}
.stem{white-space:pre-wrap;margin:0 0 8px;font-size:15px;line-height:1.6}
.exp{margin:8px 0;border:1px solid var(--line);border-radius:8px;padding:6px 10px;background:var(--panel)}
.exp>summary{font-weight:600;color:var(--accent)}
.expb{margin-top:8px}
.expb .stem{font-size:14px;color:var(--text)}
pre{background:var(--code-bg);border:1px solid var(--line);border-radius:8px;padding:8px;overflow-x:auto;margin:0 0 8px;font:12px/1.5 ui-monospace,"SF Mono",Menlo,monospace}
.fig{display:block;max-width:100%;margin:8px 0;background:#fff;border-radius:6px;cursor:zoom-in}
.miss,.wr{color:var(--danger);font-size:13px;margin:4px 0}

/* 選項：選取＝accent 柔底、正解＝綠、我選錯＝紅 */
.opt{display:flex;gap:10px;width:100%;text-align:left;margin:4px 0;border:1px solid var(--line);border-radius:8px;padding:6px 12px;background:var(--panel)}
.opt b{min-width:1.2em}
.opt.sel{background:var(--accent-soft);border-color:var(--accent)}
.opt.k{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 14%,var(--card))}
.opt.m{border-color:var(--danger);background:color-mix(in srgb,var(--danger) 12%,var(--card))}
.lt{width:auto;min-width:3em;justify-content:center}
.mk .o.on{background:color-mix(in srgb,var(--ok) 22%,var(--panel));border-color:var(--ok);font-weight:600}
.mk .x.on{background:color-mix(in srgb,var(--danger) 20%,var(--panel));border-color:var(--danger);font-weight:600}
/* 檢討頁每題操作列：左＝判定（每題都看）、中＝作答摘要、右＝猜的（偶爾）與 ⋯（很少用的維護／匯出設定） */
.vrow{gap:6px 10px}
.seg{display:inline-flex}
.seg button{margin:0;padding:3px 14px;border-radius:0}
.seg button+button{margin-left:-1px}
.seg button:first-child{border-radius:6px 0 0 6px}
.seg button:last-child{border-radius:0 6px 6px 0}
.seg button:hover,.seg button.on{position:relative;z-index:1}
.vs{color:var(--muted);font-size:13px}
.vs b{color:var(--text)}
/* 科目欄：手打輸入框＋一顆永遠列出全部科目的下拉鈕（datalist 會依已填文字過濾，改選要先刪字） */
.tg .grow{flex:1 1 0;min-width:0;width:auto}
.pk{flex:0 0 auto;width:34px;margin:4px 0;padding:5px 0;text-align:center;text-align-last:center;font:inherit;color:var(--muted);background:var(--panel);border:1px solid var(--line);border-radius:6px;cursor:pointer;-webkit-appearance:none;appearance:none}
.pk:hover{border-color:var(--accent);color:var(--accent)}
.pk option{color:var(--text);background:var(--card)}
/* 對／錯是自動批改的結果：做成唯讀標籤並標示來源；手動改判才用橘框特別標出 */
.vg{display:inline-flex;align-items:center;gap:6px}
.vb{display:inline-flex;align-items:center;padding:2px 10px;border:1px solid var(--line);border-radius:12px;font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap}
.vb.o{color:var(--ok);border-color:var(--ok);background:color-mix(in srgb,var(--ok) 14%,var(--card))}
.vb.x{color:var(--danger);border-color:var(--danger);background:color-mix(in srgb,var(--danger) 12%,var(--card))}
.va,.vm{font-style:normal;font-size:11px;white-space:nowrap}
.va{color:var(--muted)}
.vm{padding:0 6px;border:1px solid var(--warn);border-radius:10px;color:var(--warn);font-weight:600}
.mh{display:block;margin-top:4px;padding:6px 8px 2px;border-top:1px solid var(--line);font-size:11px}
.vr{display:flex;align-items:center;gap:6px;margin-left:auto}
.vr .nd{margin:0;font-style:normal;font-size:11px;white-space:nowrap;color:var(--warn)}
.tgl{position:relative;display:inline-flex;align-items:center;margin:0;padding:2px 10px;border:1px solid var(--line);border-radius:12px;font-size:12px;font-weight:400;color:var(--muted);cursor:pointer;user-select:none}
.tgl input{position:absolute;opacity:0;width:0;height:0;margin:0;padding:0;border:0}
.tgl:hover{border-color:var(--accent)}
.tgl:has(input:checked){background:color-mix(in srgb,var(--warn) 18%,var(--panel));border-color:var(--warn);color:var(--text)}
.tgl:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
.more{position:relative;margin:0}
.more summary{list-style:none;display:inline-flex;align-items:center;justify-content:center;width:30px;height:26px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--muted);cursor:pointer;user-select:none;line-height:1}
.more summary::-webkit-details-marker{display:none}
.more summary:hover,.more[open] summary,.more summary.on{border-color:var(--accent);color:var(--accent)}
.more-menu{position:absolute;right:0;top:calc(100% + 4px);z-index:5;min-width:170px;display:flex;flex-direction:column;gap:2px;padding:6px;background:var(--card);border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.more-menu .ck,.more-menu button{display:flex;align-items:center;min-height:32px;padding:4px 8px;border:0;background:transparent;border-radius:6px;white-space:nowrap;text-align:left}
.more-menu .ck:hover,.more-menu button:hover{background:var(--accent-soft)}

.tbl{overflow-x:auto;margin:0 0 8px}
table{border-collapse:collapse;width:100%}
td,th{padding:6px 8px;border:1px solid var(--line);text-align:left}
th{background:var(--panel)}
.hi{color:var(--danger);font-weight:700}
.empty,.hint,small{color:var(--muted)}
.empty{padding:16px 4px}
#lb{position:fixed;inset:0;z-index:9;background:rgba(0,0,0,.88);display:flex;align-items:center;justify-content:center;overflow:auto;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(16px + env(safe-area-inset-bottom,0px));cursor:zoom-out}
#lb img{max-width:100%;max-height:100%;background:#fff}
.ck{display:inline-flex;align-items:center;gap:4px;margin:0;font-weight:400}
.ck input{width:auto;margin:0}
button.chip{background:var(--accent-soft);border:0;border-radius:12px;padding:1px 10px;font-size:12px}
.ed small,.tg small{display:block;margin-top:6px}
.tg{margin-top:8px}
progress{width:100%;height:8px;accent-color:var(--danger)}
.br{display:grid;grid-template-columns:minmax(6em,30%) 1fr auto auto;gap:8px;align-items:center;margin:6px 0}
.br span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* 彙整：科目＞章節＞概念三層（上一輪加的） */
details.sj{margin:14px 0;padding-top:6px;border-top:1px solid var(--line)}
details.sj>summary{font-size:15px;font-weight:700;color:var(--text)}
details.ch{margin:6px 0 6px 12px;padding-left:12px;border-left:2px solid var(--accent)}
details.ch>summary{color:var(--text)}
.cn{margin:2px 0 2px 8px;font-size:13px;color:var(--muted)}
.cn.hi{color:var(--danger)}
/* 依類別抽題的樹（上一輪加的） */
.cat-s{margin:6px 0;padding:6px 0;border-top:1px solid var(--line)}
.cat-c{display:flex;flex-wrap:wrap;gap:4px 14px;margin:4px 0 0 22px}

/* 觸控裝置：與卡片軟體一樣加大點擊熱區 */
@media (pointer:coarse){button:not(.ghost):not(.chip),.btn{min-height:38px}.stem{font-size:16px}}

/* 整合功能面板 */
.dash-board{display:flex;flex-direction:column;gap:10px;margin:0 0 16px}
.dash-sec{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
.dash-sec h3{margin:0 0 8px;font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.02em}
.dash-row{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center}

/* 浮動題號快速定位選單 */
.qnav{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:8}
.qnav summary{list-style:none;background:var(--accent);color:#fff;font-weight:600;font-size:13px;padding:7px 14px;border-radius:20px;box-shadow:0 3px 12px rgba(0,0,0,.25);cursor:pointer;user-select:none;display:inline-flex;align-items:center;gap:4px}
.qnav summary::-webkit-details-marker{display:none}
.qnav[open] summary{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.qnav-menu{position:absolute;bottom:calc(100% + 8px);right:0;max-height:50vh;width:260px;background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.3);overflow-y:auto;padding:8px;display:grid;grid-template-columns:repeat(5,1fr);gap:4px}
.qnav-menu button{padding:6px 0;font-size:12px;font-weight:600;border-radius:6px;border:1px solid var(--line);background:var(--panel);color:var(--text);cursor:pointer}
.qnav-menu button.done{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.qnav-menu button.ok{background:color-mix(in srgb,var(--ok) 22%,var(--panel));border-color:var(--ok);color:var(--ok)}
.qnav-menu button.ng{background:color-mix(in srgb,var(--danger) 20%,var(--panel));border-color:var(--danger);color:var(--danger)}
</style>
</head>
<body>
<div id="app"></div>
<script>
/*PARSE_START*/
const uid=()=>Math.random().toString(36).slice(2,9);
// 原因：原寫法直接刪掉 <sub>/<sup>，41₁₆ 變成「4116」；數字轉成 Unicode 上下標，其他內容以 _()、^() 保留，才不會悄悄改變題意。
const SUBD='₀₁₂₃₄₅₆₇₈₉',SUPD='⁰¹²³⁴⁵⁶⁷⁸⁹';
const nrm=s=>String(s).normalize('NFC').replace(/[\u2E80-\u2FDF]/g,c=>c.normalize('NFKC'))
  .replace(/<sub>([^<]*)<\/sub>/gi,(m,t)=>/^\d+$/.test(t)?[...t].map(d=>SUBD[d]).join(''):'_('+t+')')
  .replace(/<sup>([^<]*)<\/sup>/gi,(m,t)=>/^\d+$/.test(t)?[...t].map(d=>SUPD[d]).join(''):'^('+t+')')
  .replace(/<\/?(?:sub|sup)>/gi,'');
const jn=(a,b)=>/[A-Za-z0-9]$/.test(a)&&/^[A-Za-z0-9]/.test(b)?a+' '+b:a+b;
const base=s=>String(s||'').split('/').pop();
// 原因：MinerU 把公式放在 type 為 inline_equation / interline_equation 的 span，content 不帶 $；不包起來，渲染層就認不出邊界。
const mathSpan=s=>{
  const c=s.content||'';
  if(!/equation/i.test(s.type||''))return c;
  const t=c.trim().replace(/\s*\n\s*/g,' ');
  if(!t||t[0]==='$')return c;
  return /interline/i.test(s.type)?'$$'+t+'$$':'$'+t+'$';
};
// 原因：MinerU 會把一串算式切成好幾個連續的 inline_equation span（2x^{2}+7x+3\leq0 與 \Rightarrow… 各一段）；各自包 $ 會變成 $a$$b$，$$ 又會被當成顯示模式的分隔符。連續的算式 span 先合併成一個。
const lineText=sp=>{
  const o=[];let eq=null;
  const fl=()=>{if(eq!==null){const t=eq.trim().replace(/\s*\n\s*/g,' ');if(t)o.push('$'+t+'$');eq=null}};
  sp.forEach(s=>{
    const c=s.content||'';
    if(/inline_equation/i.test(s.type||'')&&c.trim()&&c.trim()[0]!=='$')eq=eq===null?c:eq+' '+c;
    else{fl();o.push(mathSpan(s))}
  });
  fl();return o.join('');
};
// 原因：MinerU 常把整段算式（x^{2}-8x+5(\alpha-\beta)=0、\overrightarrow{OS}）當純文字輸出，不帶 $；只包反斜線指令會留下沒包的 x^{2}。
// 做法：掃出「可能是算式」的連續片段（英數、運算符號、LaTeX 指令；遇到中文、全形標點或換行就斷開；\text{…}、\begin…\end 整組視為一體），片段內有 LaTeX 特徵才整段包成 $…$。已經有 $ 的片段不動，所以重複執行結果不變。
const MCH=/[A-Za-z0-9 \t\\^_{}()\[\]=+\-*\/<>|.,:;'!?]/;
const groupEnd=(s,i)=>{let d=0;for(let j=i;j<s.length;j++){if(s[j]==='\\'){j++;continue}if(s[j]==='{')d++;else if(s[j]==='}'&&--d===0)return j+1}return -1};
const envEnd=(s,i,name)=>{const o='\\begin{'+name+'}',c='\\end{'+name+'}';let d=0,j=i;while(j<s.length){if(s.startsWith(o,j)){d++;j+=o.length}else if(s.startsWith(c,j)){j+=c.length;if(--d===0)return j}else j++}return s.length};
const wrapRun=r=>{
  if(!/\\[A-Za-z]|[\^_]\{|[A-Za-z0-9)\]}]\^[0-9A-Za-z]|[A-Za-z]_[0-9A-Za-z]/.test(r))return r;
  const m=/^([ \t]*(?:[(（](?:[A-Ha-h]|\d{1,2})[)）][ \t]*)?)([\s\S]*?)([ \t.,;:]*)$/.exec(r);
  return m[2]?m[1]+'$'+m[2]+'$'+m[3]:r;
};
const wrapRuns=s=>{
  let out='',run='';
  const end=()=>{out+=wrapRun(run);run=''};
  for(let i=0;i<s.length;){
    const c=s[i];
    if(c==='\\'){
      let m=/^\\begin\{([A-Za-z*]+)\}/.exec(s.slice(i,i+40));
      if(m){const e=envEnd(s,i,m[1]);run+=s.slice(i,e);i=e;continue}
      m=/^\\[A-Za-z]+/.exec(s.slice(i,i+40));
      if(m){run+=m[0];i+=m[0].length;while(s[i]==='{'){const e=groupEnd(s,i);if(e<0)break;run+=s.slice(i,e);i=e}continue}
      run+=s.slice(i,i+2);i+=2;continue;
    }
    if(MCH.test(c)){run+=c;i++;continue}
    end();out+=c;i++;
  }
  end();return out;
};
